{
  // Copia este archivo como appsettings.json (junto a agente-rfid.exe) y completalo.
  // Aqui NO va el lector: su IP, puerto, antenas y potencia salen de la ficha tecnica del producto-equipo
  // (Configuracion general > RFID) y el agente los lee de la API (GET api/v1/rfid/equipos).

  "Api": {
    // Direccion de la API, con http o https.
    "BaseUrl": "https://servidor:5001/",
    // Usuario de servicio del agente: un rol que SOLO tenga la aplicacion RFID, pantalla "Emision de TAG",
    // con los botones Ver (GET), "Grabar etiquetas" (POST) y "Anular" (PUT).
    "Usuario": "AGENTE_RFID",
    // La contrasena NO va en este archivo: se toma de la variable de entorno que diga VariablePassword.
    "VariablePassword": "KONSOLUTIONS_AGENTE_PASSWORD",
    // Solo para probar con un certificado propio. En produccion, false.
    "AceptarCertificadoInvalido": false,
    "TimeoutSegundos": 30
  },

  "Agente": {
    // Esta estacion: el CODIGO del producto-PC donde corre este agente (el mismo que elegiste en Configuracion general > RFID como "estacion donde corre el agente").
    // Con ella el agente encuentra solo su lector. Si no la pones, usa --equipo CODIGO_DEL_PRODUCTO_EQUIPO.
    "Estacion": "ACTPCSREC000000000000001",
    // El producto-equipo de ESTA PC (tambien se puede dar con --equipo). La estacion es una sola para todos los equipos de la ERP: si en la ERP hay
    // un lector Impinj Y una impresora Zebra (o mas de un lector), la estacion sola no alcanza y el agente NO adivina: pon aqui el codigo del producto-equipo.
    "CodProductoEquipo": null,
    // Segundos que espera un chip frente al lector antes de avisar y seguir esperando (5 a 3600).
    "EsperaChipSegundos": 120,
    // Segundos que espera a que retires el chip ya grabado antes de seguir (1 a 600).
    "RetiroChipSegundos": 30,
    // Intentos extra de grabar y leer de vuelta el EPC antes de darlo por fallido (0 a 10).
    "Reintentos": 3,
    // Si falla tras los reintentos: anular la etiqueta (libera el chip) y reponerla. false = solo avisa y la deja enrolada.
    "AnularSiFalla": true,
    // Carpeta de los logs (un archivo por dia).
    "CarpetaLogs": "logs"
  },

  "Impinj": {
    // LLRP: 5084 en los Speedway (R220/R420) y en el R700.
    "PuertoPorOmision": 5084,
    // Potencia de escritura si la ficha del equipo no trae TX POWER (10 a 33 dBm). Baja a proposito: se graba un chip a la vez, de cerca.
    "PotenciaPorOmisionDbm": 20,
    // Cuanto dura cada lectura del campo para ver que chips hay (100 a 5000 ms).
    "VentanaLecturaMs": 600,
    // Cuanto se espera al lector en una lectura o escritura de memoria (500 a 30000 ms).
    "TiempoOperacionMs": 4000,
    // Pedir el TID junto con el EPC (FastID, chips Monza 4 y mas nuevos). Si no se puede, el TID se lee aparte.
    "PedirFastId": true
  },

  // Impresora Zebra con RFID (ZD621R, ZT411R...). Su IP y puerto salen de la ficha del producto-equipo; la plantilla de la etiqueta (archivo .zpl) sale de
  // Configuracion general > RFID (ruta + archivo); si no hay plantilla se usa una etiqueta basica.
  // ATENCION: los textos de los comandos de abajo NO se probaron contra una impresora real. Si la tuya contesta distinto, se corrigen aqui, sin recompilar:
  // "agente-rfid diagnostico" muestra lo que contesta de verdad. En la plantilla se pueden usar: @EPC @TID @PRODUCTO @DESCRIPCION @LOTE @CANTIDAD @UM @CODIGO
  "Zebra": {
    // Puerto de impresion TCP de las Zebra, si la ficha del equipo no trae puerto.
    "PuertoPorOmision": 9100,
    "TiempoConexionMs": 4000,
    // Cuanto se espera la respuesta a una consulta (~HS, ~HI, getvar...).
    "TiempoRespuestaMs": 3000,
    // Cuanto se espera a que la impresora termine una etiqueta y devuelva lo que leyo del chip.
    "TiempoImpresionMs": 20000,
    // Pausa entre un intento de leer el TID y el siguiente mientras se espera una etiqueta.
    "PausaLecturaMs": 500,
    // El TID tiene que traer al menos estos bits (un Monza 4/5 tiene 96; los 32 primeros son iguales en todos los chips y no sirven para identificar).
    "TidBitsMinimos": 96,
    // Comandos que preceden a la lectura del TID para poner la etiqueta sobre la antena. Vacio = no hace falta.
    "ComandosPosicionar": [],
    // Comandos SGD que mandan leer el TID de la etiqueta que esta sobre la antena (no sacan la etiqueta).
    "ComandosLeerTid": [
      "! U1 setvar \"rfid.tag.read.content\" \"tid\"",
      "! U1 setvar \"rfid.tag.read.execute\" \"\""
    ],
    // Consultas SGD con el resultado de esa lectura; se queda con la primera respuesta que sea un TID.
    "ConsultasResultadoTid": [
      "! U1 getvar \"rfid.tag.read.result_line1\"",
      "! U1 getvar \"rfid.tag.read.result_line2\""
    ],
    // ZPL que graba el EPC: {epc} = los hexadecimales, {bytes} = su largo en bytes. Si tu plantilla ya trae su propio ^RFW, no se agrega.
    "EscribirEpc": "^RFW,H,2,{bytes},1^FD{epc}^FS",
    // ZPL que lee de vuelta el EPC y el TID y los manda al agente (^HV). Los encabezados #EPC= y #TID= no se cambian.
    "LeerDeVuelta": "^RFR,H,2,{bytes},1^FN1^FS^HV1,,#EPC=^FS^RFR,H,0,12,2^FN2^FS^HV2,,#TID=^FS",
    // Contadores de etiquetas buenas y malas (void): el agente compara antes y despues de cada etiqueta.
    "ConsultaContadorValidas": "! U1 getvar \"odometer.rfid.valid_resettable\"",
    "ConsultaContadorVoid": "! U1 getvar \"odometer.rfid.void_resettable\""
  },

  // Servicio de impresion ("agente-rfid servicio"): atiende el boton Imprimir de la web (Emision de TAG). Se queda preguntando a la API si hay un trabajo para
  // sus impresoras, imprime las etiquetas una a una y va avisando el avance. Como servicio de Windows: ver LEEME_SERVICIO.txt. El usuario de la API es el mismo
  // del agente (Ver GET, "Grabar etiquetas" POST y "Anular" PUT alcanzan: reclamar es POST; avance y cierre son PUT).
  "Servicio": {
    // Cada cuantos segundos pregunta a la API si hay un trabajo nuevo cuando no tiene ninguno (1 a 300).
    "PollSegundos": 5,
    // Mientras imprime, cada cuantos segundos avisa a la API que sigue vivo (5 a 60). Asi la web ve el avance y el servicio se entera de que piden cancelar.
    // La API da por caido un servicio que pasa 3 minutos sin avisar y entrega su trabajo de nuevo.
    "LatidoSegundos": 20,
    // Cuanto espera una etiqueta con chip sobre la antena de la impresora antes de volver a mirar (5 a 600).
    "EsperaEtiquetaSegundos": 30,
    // Cuantas esperas seguidas sin etiqueta dan el trabajo por fallido: se acabo el rollo, o las etiquetas no traen chip (1 a 20).
    "EsperasSinEtiqueta": 2,
    // Las impresoras (codigos de producto-equipo) que atiende este servicio. Vacio = la de Agente.CodProductoEquipo (o --equipo en la linea de comandos).
    "Equipos": []
  }
}
