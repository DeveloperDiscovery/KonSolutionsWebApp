        {
            var cfg = _miConfigUsuario ?? new KONSolutions.Shared.Models.Estandar.ConfiguracionUsuario { COD_USUARIO = _codUsuario };
            cfg.TAS_ZOOM_WEB = _zoomPct;
            _miConfigUsuario = cfg;
            await CfgUsuarioSvc.SaveAsync(cfg);
        }
        catch { }
    }

    /// <summary>Persiste el estilo de menú elegido como preferencia del usuario, para que se
    /// vuelva a aplicar automáticamente la próxima vez que inicie sesión.</summary>
    private async Task GuardarEstiloMenuUsuarioAsync(EstiloMenu estilo)
    {
        try
        {
            var tipo = TipoMenuPorEstilo(estilo);
            if (tipo is null) return; // sin catálogo configurado para este estilo, no hay nada que guardar
            var cfg = _miConfigUsuario ?? new KONSolutions.Shared.Models.Estandar.ConfiguracionUsuario { COD_USUARIO = _codUsuario };
            cfg.COD_TIPO_MENU_OPCIONES = tipo.COD_TIPO_MENU_OPCIONES;
            _miConfigUsuario = cfg;
            await CfgUsuarioSvc.SaveAsync(cfg);
        }
        catch { }
    }

    /// <summary>Deduce el EstiloMenu (Lateral/Circular/Tiles) a partir de la descripción del
    /// tipo de menú en el catálogo ESTANDAR.TIPOS_MENU_OPCIONES, por palabra clave.</summary>
    private static EstiloMenu? EstiloDesdeDescripcion(string? des)
    {
        var n = (des ?? "").ToUpperInvariant();
        if (n.Contains("CIRCULAR")) return EstiloMenu.Circular;
        if (n.Contains("TILE"))     return EstiloMenu.Tiles;
        if (n.Contains("LATERAL"))  return EstiloMenu.Lateral;
        return null;
    }

    private EstiloMenu? EstiloDesdeCod(string? cod)
    {
        if (string.IsNullOrWhiteSpace(cod)) return null;
        var t = _tiposMenu.FirstOrDefault(x => x.COD_TIPO_MENU_OPCIONES == cod);
        return EstiloDesdeDescripcion(t?.DES_TIPO_MENU_OPCIONES);
    }

    private KONSolutions.Shared.Models.Estandar.TipoMenuOpciones? TipoMenuPorEstilo(EstiloMenu e)
        => _tiposMenu.FirstOrDefault(t => EstiloDesdeDescripcion(t.DES_TIPO_MENU_OPCIONES) == e);

    /// <summary>Ícono del TIPO de una notificación.
    ///
    /// Antes cada notificación traía su propia copia del ícono: el SP lo devolvía en cada
    /// fila, así que cuarenta pendientes de tres tipos mandaban el mismo PNG cuarenta veces,
    /// cada 20 segundos. Ahora el detalle no lo trae y se resuelve acá contra el resumen,
    /// que tiene UNA fila por tipo.
    ///
    /// Si no se encuentra —un tipo que ya no está en el resumen— devuelve null y quien lo
    /// llama cae al ícono genérico de Material, que es lo que ya hacía cuando no había
    /// imagen.</summary>
    private byte[]? IconoDeTipo(string? codTipoNotificacion) =>
        string.IsNullOrWhiteSpace(codTipoNotificacion)
            ? null
            : _notifResumen.FirstOrDefault(r => r.COD_TIPO_NOTIFICACION == codTipoNotificacion)?.IMG_ICONO;

    /// <summary>Ícono base64 del catálogo para este estilo de menú, si existe (para mostrarlo
    /// en el selector de estilo del menú de usuario, en vez del ícono fijo de Material).</summary>
    private string? IconoBase64PorEstilo(EstiloMenu e)
    {
        var t = TipoMenuPorEstilo(e);
        return t?.IMG_ICONO is { Length: > 0 } bytes ? Convert.ToBase64String(bytes) : null;
    }

    private async Task CargarConfiguracionGeneralAsync()
    {
        try
        {
            // GetParaLayoutAsync y no GetCurrentAsync: el mismo registro completo pero SIN
            // los bytes de los dos logos, que ahora se piden por URL y el navegador cachea.
            // Traerlos acá costaba 9 932 ms en cada arranque.
            var cfg = await CfgGeneralSvc.GetParaLayoutAsync();
            if (cfg is null) return;
            if (!string.IsNullOrWhiteSpace(cfg.DES_NOMBRE_EMPRESA))
                _nombreEmpresa = cfg.DES_NOMBRE_EMPRESA;
            if (!string.IsNullOrWhiteSpace(cfg.DES_NOMBRE_APLICACION))
            {
                _nombreApp = cfg.DES_NOMBRE_APLICACION;
            }

            // Los logos pasan a ser una URL. Se asignan solo si el flag dice que existen:
            // así los @if de la pantalla siguen decidiendo igual que antes entre la imagen
            // y su alternativa, sin haber bajado un byte para averiguarlo.
            // Las ramas else NO sobran: el logo de aplicación ya venía puesto desde el
            // arranque del splash, así que si la configuración dice que no hay imagen hay
            // que BORRARLO. Sin esto quedaría una URL que responde 204 y la pantalla
            // mostraría un hueco en vez del ícono de respaldo.
            if (cfg.FLG_TIENE_LOGO_EMPRESA)
                _logoEmpresa = CfgGeneralSvc.UrlLogoEmpresa(cfg.DES_VERSION_LOGO_EMPRESA);
            else
                _logoEmpresa = null;

            if (cfg.FLG_TIENE_LOGO_APLICACION)
            {
                _logoApp = CfgGeneralSvc.UrlLogoAplicacion(cfg.DES_VERSION_LOGO_APLICACION);
                try { await JS.InvokeVoidAsync("cursorBusy.setIcono", _logoApp); } catch { }
            }
            else
            {
                _logoApp = null;
            }

            // Aplica TODA la Configuración General (colores de grilla, foco, fuentes, etc.)
            // al AppConfig y la persiste — antes esto solo pasaba si el usuario entraba
            // manualmente a la pantalla "Configuración General" y grababa; con localStorage
            // recién limpiado (o un navegador/equipo nuevo) la app arrancaba con los
            // valores por defecto hasta esa visita manual. Ahora se aplica ya al arrancar.
            // La copia en base64 del logo (menú de tiles, pantalla de carga, bloqueo): ver ConfigService.SincronizarLogoAplicacionAsync.
            await ConfigSvc.SincronizarLogoAplicacionAsync(cfg, CfgGeneralSvc.DescargarLogoAplicacionAsync);
            ConfigService.MapearDesdeConfiguracionGeneral(cfg, ConfigSvc.Current);
            await ConfigSvc.SaveAsync(ConfigSvc.Current);

            // Actualizar el splash con los datos reales de la BD mientras sigue cargando
            await InvokeAsync(StateHasChanged);

            // Aplicar colores de la BD al MudTheme para que afecten a todos los
            // componentes MudBlazor (botones, selects, chips, etc.)
            var primary      = string.IsNullOrWhiteSpace(cfg.DES_COLOR_PRIMARY)             ? "#b8472d"  : cfg.DES_COLOR_PRIMARY.Trim();
            var secondary    = string.IsNullOrWhiteSpace(cfg.DES_COLOR_SECONDARY)           ? "#4a4a32"  : cfg.DES_COLOR_SECONDARY.Trim();
            var backColor    = string.IsNullOrWhiteSpace(cfg.DES_BACKCOLOR)                 ? "#efe9df"  : cfg.DES_BACKCOLOR.Trim();
            var font         = string.IsNullOrWhiteSpace(cfg.DES_TYPOGRAPHY_CONTROLS_FONT)  ? "Archivo"  : cfg.DES_TYPOGRAPHY_CONTROLS_FONT.Trim();
            _envBack = string.IsNullOrWhiteSpace(cfg.DES_BACKCOLOR_ENVIRONMENT)      ? "#1a1714" : cfg.DES_BACKCOLOR_ENVIRONMENT.Trim();
            _envFore = string.IsNullOrWhiteSpace(cfg.DES_FORECOLOR_ENVIRONMENT)      ? "#ffffff" : cfg.DES_FORECOLOR_ENVIRONMENT.Trim();
            _envFont = string.IsNullOrWhiteSpace(cfg.DES_TYPOGRAPHY_ENVIRONMENT_FONT)? font      : cfg.DES_TYPOGRAPHY_ENVIRONMENT_FONT.Trim();
            var envBack = _envBack;
            var envFore = _envFore;
            var envFont = _envFont;
            // Sincronizar --paper con el color de fondo real de la BD
            // para que los labels outlined siempre tapen el borde con el color correcto
            try { await JS.InvokeVoidAsync("eval", $"document.documentElement.style.setProperty('--paper','{backColor}')"); } catch { }

            _theme = new MudTheme
            {
                PaletteLight = new PaletteLight
                {
                    Primary           = primary,
                    Secondary         = secondary,
                    Background        = backColor,
                    Surface           = "#ffffff",
                    AppbarBackground  = envBack,
                    AppbarText        = envFore,
                    DrawerBackground  = envBack,
                    DrawerText        = envFore,
                    DrawerIcon        = envFore,
                },
                Typography = new Typography
                {
                    Default = new Default { FontFamily = new[] { font,    "sans-serif" } },
                    H6      = new H6      { FontFamily = new[] { envFont, "sans-serif" } },
                    Body1   = new Body1   { FontFamily = new[] { font,    "sans-serif" } },
                    Body2   = new Body2   { FontFamily = new[] { font,    "sans-serif" } },
                }
            };
            if (!string.IsNullOrWhiteSpace(cfg.DES_CULTURE))
            {
                try
                {
                    var stored = await LocalStorage.GetItemAsStringAsync("app-culture");
                    if (stored != cfg.DES_CULTURE)
                    {
                        // Guardar y recargar para que Program.cs aplique el culture antes del primer render
                        await LocalStorage.SetItemAsStringAsync("app-culture", cfg.DES_CULTURE);
                        await JS.InvokeVoidAsync("location.reload");
                        return;
                    }
                    // Ya está aplicado desde Program.cs; refuerzo en memoria por si acaso,
                    // fijando también CurrentCulture del hilo actual (no solo el default
                    // para hilos nuevos), igual que en Program.cs.
                    KONSolutions.Web.Services.CultureHelper.Aplicar(cfg.DES_CULTURE);
                }
                catch { }
            }
        }
        catch { }
    }

    private async Task CargarFotoUsuario()
    {
        try
        {
            var codUsuario = await GetCodUsuarioActualAsync();
            if (string.IsNullOrWhiteSpace(codUsuario)) return;
            var usuario = await UsuarioSvc.GetByIdAsync(codUsuario);
            if (usuario?.IMG_FOTO is { Length: > 0 })
                _fotoUsuario = Convert.ToBase64String(usuario.IMG_FOTO);
        }
        catch (Exception ex)
        {
            // Antes: catch vacío — la excepción desaparecía sin dejar rastro
            // ni siquiera en el log de errores. Mismo tratamiento que los
            // errores de SQL: se registra en errors_*.log vía ErrorLogService.
            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarFotoUsuario));
        }
    }

    private async Task CargarFavoritos()
    {
        if (string.IsNullOrWhiteSpace(_codUsuario)) { _favoritos = new(); return; }
        try
        {
            // UNA sola petición: el SP de favoritos siempre devolvió todo el listado del
            // usuario (ignora la aplicación), así que las N llamadas "en paralelo" que había
            // aquí —una por cada aplicación del menú— eran N respuestas idénticas. Con el tope
            // de ~6 conexiones simultáneas del navegador, se encolaban entre sí y este era el
            // tramo más lento de la carga inicial.
            var favoritos = await FavoritoService.GetTodosAsync(_codUsuario);

            // Índice por (aplicación, opción): evita recorrer _opciones entera por cada
            // favorito, que con muchas opciones era un barrido O(N*M).
            var porClave = _opciones
                .GroupBy(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString()))
                .ToDictionary(g => g.Key, g => g.First());

            var favs = new List<OpcionMenu>();
            foreach (var f in favoritos)
                if (porClave.TryGetValue((f.COD_APLICACION ?? "", f.COD_OPCION_APLICACION ?? ""), out var op))
                    favs.Add(op);
            _favoritos = favs
                .DistinctBy(o => o.COD_OPCION_APLICACION)
                .ToList();

            // Deja el set de favoritos disponible para las pantallas de menú (circular/tiles)
            // que se abren automáticamente al login — así no vuelven a pedirlos por su cuenta.
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarFavoritos));
        }
    }

    // Las fotos de los notificadores se cargan aparte para no demorar el pintado del panel.
    // Va en su propio método async en vez de un ContinueWith: el ContinueWith leía t.Result,
    // así que si la descarga fallaba la excepción se relanzaba DENTRO de la continuación —
    // un Task descartado — y quedaba sin observar. Y esto corre en el polling, o sea que un
    // corte de red lo repetía en cada refresco.
    private async Task PrecargarFotosNotificadoresAsync(IReadOnlyList<string?> cods)
    {
        try
        {
            if (await FotoSvc.PrecargarVariosAsync(cods)) await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            // La foto es decorativa: si falla, la notificación se ve igual. Queda el rastro.
            await ErrorLog.LogAsync(ex, nameof(MainLayout), nameof(PrecargarFotosNotificadoresAsync));
        }
    }

    private bool EsFavorito(OpcionMenu op) =>
        _favoritos.Any(f => f.COD_APLICACION == op.COD_APLICACION && f.COD_OPCION_APLICACION == op.COD_OPCION_APLICACION);

    private void MostrarMenuOpcion(MouseEventArgs e, OpcionMenu op)
    {
        _ctxOpcion = op; _ctxEsFavorito = EsFavorito(op);
        (_ctxX, _ctxY) = CoordenadasMenuContextual(e);
        _ctxOpen = true;
    }

    /// <summary>
    /// Este menú contextual usa position:fixed dentro de #app, que tiene transform:scale()
    /// aplicado por el zoom propio de la app. Un ancestro con transform se vuelve el
    /// "containing block" de sus descendientes fixed (spec CSS), así que las coordenadas
    /// de e.ClientX/Y (reales del viewport) hay que dividirlas entre el factor de zoom
    /// para que el div quede alineado bajo el cursor en cualquier nivel de zoom.
    /// </summary>
    private (double x, double y) CoordenadasMenuContextual(MouseEventArgs e)
    {
        var scale = _zoomPct / 100.0;
        return scale > 0 ? (e.ClientX / scale, e.ClientY / scale) : (e.ClientX, e.ClientY);
    }

    // ── Árbol jerárquico del menú (MDL/CRP/BTN/SPR) ──
    // Cache en memoria del estado expandido para reaccionar sin esperar la
    // llamada async de MenuEstadoService en cada render; se sincroniza al togglear.
    private readonly HashSet<string> _carpetasExpandidas = new();

    // ── Búsqueda del menú lateral ──
    private string _busquedaMenu = "";

    /// <summary>Poda el árbol dejando solo ramas donde el nodo o algún descendiente coincide con la búsqueda.</summary>
    private List<NodoMenu> _arbolMenuFiltrado
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_busquedaMenu)) return _arbolMenu;
            return FiltrarNodos(_arbolMenu, _busquedaMenu);
        }
    }

    private static List<NodoMenu> FiltrarNodos(List<NodoMenu> nodos, string busqueda)
    {
        var resultado = new List<NodoMenu>();
        foreach (var n in nodos)
        {
            var hijosFiltrados = FiltrarNodos(n.Hijos, busqueda);
            var coincide = (n.DES_OPCION_APLICACION ?? "").Contains(busqueda, StringComparison.OrdinalIgnoreCase);
            if (coincide || hijosFiltrados.Count > 0)
            {
                resultado.Add(new NodoMenu
                {
                    COD_OPCION_APLICACION      = n.COD_OPCION_APLICACION,
                    COD_APLICACION             = n.COD_APLICACION,
                    DES_APLICACION             = n.DES_APLICACION,
                    DES_OPCION_APLICACION      = n.DES_OPCION_APLICACION,
                    DES_FORMULARIO             = n.DES_FORMULARIO,
                    COD_TIPO_OPCION_APLICACION = n.COD_TIPO_OPCION_APLICACION,
                    DES_BACKCOLOR_APLICACION   = n.DES_BACKCOLOR_APLICACION,
                    DES_FORECOLOR_APLICACION   = n.DES_FORECOLOR_APLICACION,
                    IMG_ICONO_APLICACION       = n.IMG_ICONO_APLICACION,
                    DES_BACKCOLOR_OPCION       = n.DES_BACKCOLOR_OPCION,
                    DES_FORECOLOR_OPCION       = n.DES_FORECOLOR_OPCION,
                    IMG_ICONO_OPCION           = n.IMG_ICONO_OPCION,
                    Hijos                      = coincide ? n.Hijos : hijosFiltrados
                });
            }
        }
        return resultado;
    }

    /// <summary>Todas las carpetas del árbol filtrado, para que se muestren expandidas mientras se busca.</summary>
    private HashSet<string> _carpetasExpandidasFiltro
    {
        get
        {
            var set = new HashSet<string>();
            void Visitar(IEnumerable<NodoMenu> nodos)
            {
                foreach (var n in nodos)
                {
                    if (n.EsCarpeta) set.Add(n.COD_OPCION_APLICACION);
                    Visitar(n.Hijos);
                }
            }
            Visitar(_arbolMenuFiltrado);
            return set;
        }
    }

    // RenderNodo se reemplazó por un componente recursivo separado (NodoMenuItem.razor),
    // ya que mezclar HTML directo dentro de un RenderFragment construido a mano en C#
    // no es sintaxis Razor válida en archivos .razor.

    /// <summary>Cronometra una tarea y deja su duración en la traza.
    ///
    /// El reloj arranca acá, no cuando se la espera: la tarea ya está en marcha cuando
    /// llega a este método, así que mide lo que de verdad tardó, no lo que se esperó.
    ///
    /// Si la tarea falla, se registra igual con el tiempo y la excepción sigue su camino:
    /// una medición no debe cambiar el comportamiento de lo que mide.</summary>
    private async Task Cronometrar(string nombre, Task tarea)
    {
        var reloj = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            await tarea;
            await ErrorLog.TraceAsync($"CARGA DE MENU · {nombre}: {Dur(reloj.ElapsedMilliseconds)}");
        }
        catch
        {
            await ErrorLog.TraceAsync($"CARGA DE MENU · {nombre}: FALLÓ a los {Dur(reloj.ElapsedMilliseconds)}");
            throw;
        }
    }

    /// <summary>Cuánto se espera a los íconos antes de abrir igual.
    ///
    /// La espera tiene techo A PROPÓSITO. CargarLogosEnSegundoPlanoAsync se traga sus
    /// excepciones, así que siempre termina... salvo que el HTTP se cuelgue, y en esta
    /// aplicación eso no es teórico: el HttpClient espera 100 segundos y ya medimos
    /// llamadas de 99. Sin techo, una carga de íconos lenta deja el splash cien segundos.</summary>
    private const int SegundosMaximoIconos = 15;

    /// <summary>Espera a los íconos, pero no para siempre.
    ///
    /// Si se pasa del techo, la aplicación abre igual y los íconos entran después por el
    /// evento IconosActualizados, que ya existe y ya está enganchado. No se pierde nada:
    /// solo se deja de esperar.</summary>
    private async Task EsperarIconosAsync(Task tIconos)
    {
        var cumplido = await Task.WhenAny(tIconos, Task.Delay(TimeSpan.FromSeconds(SegundosMaximoIconos)));

        if (cumplido != tIconos)
        {
            await ErrorLog.TraceAsync($"CARGA DE MENU · íconos: no llegaron en {SegundosMaximoIconos} s — " +
                                      "se abre el menú y entran cuando lleguen.");
            return;
        }

        // Task.WhenAny NO relanza la excepción de la tarea que terminó: la devuelve y ya.
        // Si quedara sin observar, .NET la reporta después como excepción no controlada, en
        // un momento que no tiene nada que ver con acá. Se la mira y se la descarta: que
        // fallen los íconos no puede impedir que la aplicación abra.
        try { await tIconos; } catch { }
    }

    private async Task CargarEstadoCarpetasAsync()
    {
        try
        {
            // Se lee UNA vez y el árbol se recorre sin awaits.
            //
            // Antes preguntaba carpeta por carpeta con await. El dato ya estaba en memoria
            // —MenuEstadoService lo cachea en la primera llamada—, pero cada await igual
            // cede el control al planificador de WebAssembly y vuelve por la cola de
            // eventos del navegador. Con un menú grande son cientos de idas y vueltas para
            // consultar un HashSet que ya estaba cargado.
            var expandidas = await MenuEstado.ObtenerExpandidasAsync();

            void Visitar(IEnumerable<NodoMenu> nodos)
            {
                foreach (var n in nodos)
                {
                    if (n.EsCarpeta && expandidas.Contains(n.COD_OPCION_APLICACION))
                        _carpetasExpandidas.Add(n.COD_OPCION_APLICACION);
                    Visitar(n.Hijos);
                }
            }
            Visitar(_arbolMenu);
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarEstadoCarpetasAsync));
        }
    }

    private async Task ToggleCarpeta(string codOpcionAplicacion)
    {
        var expandida = !_carpetasExpandidas.Remove(codOpcionAplicacion);
        if (expandida) _carpetasExpandidas.Add(codOpcionAplicacion);
        await MenuEstado.ToggleAsync(codOpcionAplicacion);
        StateHasChanged();
    }

    private void MostrarMenuFavorito(MouseEventArgs e, OpcionMenu op)
    {
        _ctxOpcion = op; _ctxEsFavorito = true;
        (_ctxX, _ctxY) = CoordenadasMenuContextual(e);
        _ctxOpen = true;
    }

    private async Task AgregarFavorito()
    {
        _ctxOpen = false;
        if (_ctxOpcion is null || string.IsNullOrWhiteSpace(_codUsuario)) return;
        await ErrorLog.TraceAsync($"FAVORITOS - Agregar: [{_ctxOpcion.COD_APLICACION}] {_ctxOpcion.DES_OPCION_APLICACION} (usuario={_codUsuario})");
        var ok = await FavoritoService.AgregarAsync(_codUsuario,
            _ctxOpcion.COD_APLICACION.ToString(), _ctxOpcion.COD_OPCION_APLICACION.ToString());
        if (ok)
        {
            // Ya sabemos exactamente qué opción se agregó — actualizar en memoria evita
            // recargar TODAS las apps del menú (antes: N llamadas HTTP en paralelo, una por
            // cada aplicación, solo para reflejar el cambio de una fila).
            if (!_favoritos.Any(o => o.COD_OPCION_APLICACION == _ctxOpcion.COD_OPCION_APLICACION))
                _favoritos.Add(_ctxOpcion);
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
            Snackbar.Add("Agregado a favoritos.", Severity.Success);
        }
        else await ErrorDialogHelper.MostrarAvisoAsync("No se pudo agregar a favoritos.", DialogService, nameof(MainLayout));
    }

    private async Task QuitarFavorito()
    {
        _ctxOpen = false;
        if (_ctxOpcion is null || string.IsNullOrWhiteSpace(_codUsuario)) return;
        await ErrorLog.TraceAsync($"FAVORITOS - Quitar: [{_ctxOpcion.COD_APLICACION}] {_ctxOpcion.DES_OPCION_APLICACION} (usuario={_codUsuario})");
        var ok = await FavoritoService.QuitarAsync(_codUsuario,
            _ctxOpcion.COD_APLICACION.ToString(), _ctxOpcion.COD_OPCION_APLICACION.ToString());
        if (ok)
        {
            _favoritos.RemoveAll(o => o.COD_OPCION_APLICACION == _ctxOpcion.COD_OPCION_APLICACION);
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
            Snackbar.Add("Quitado de favoritos.", Severity.Success);
        }
        else await ErrorDialogHelper.MostrarAvisoAsync("No se pudo quitar de favoritos.", DialogService, nameof(MainLayout));
    }
