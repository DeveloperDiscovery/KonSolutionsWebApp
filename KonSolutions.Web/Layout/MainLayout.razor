    {
        _pinned = !_pinned;
        await LocalStorage.SetItemAsync("sidebarPinned", _pinned);
        // Al desfijar, limpiamos el inline style que pudo dejar el drag del handle
        if (!_pinned)
            try { await JS.InvokeVoidAsync("eval", "var s=document.getElementById('sidebar-main');if(s)s.style.width='';"); } catch { }
        StateHasChanged();
