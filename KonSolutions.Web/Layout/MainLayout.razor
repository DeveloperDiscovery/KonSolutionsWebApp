    // ── Resto del estado ──
    private enum EstiloMenu { Lateral, Circular, Tiles }
    private EstiloMenu _estiloMenu = EstiloMenu.Lateral;
    private List<OpcionMenu> _opciones   = new();
    private List<NodoMenu> _arbolMenu = new();
    // True solo después de que MenuService.CargarAsync() termina — distingue
    // "todavía cargando" (no mostrar nada) de "ya cargó y no hay opciones"
    // (ahí sí mostrar el fallback estático, caso real de falta de permisos).
    private bool _menuCargado;
    private bool _revelandoPersiana;
    private const int PersianaSlats = 16;

    /// <summary>Deja la persiana montada el tiempo justo para que termine su animación
    /// (ver .blind-slat en el CSS: 600ms + el mayor delay escalonado) y luego la desmonta.</summary>
    private async Task OcultarPersianaAsync()
    {
        await Task.Delay(950);
        _revelandoPersiana = false;
        await InvokeAsync(StateHasChanged);
    }
    private int _cargaPct = 0;
    private string _cargaEtapa = "Iniciando...";
    // Tiempo transcurrido de la carga del menú, a la vista en el splash (se refresca cada 200 ms y queda fijo al terminar).
    private readonly System.Diagnostics.Stopwatch _cargaSw = System.Diagnostics.Stopwatch.StartNew();
    private string _cargaTiempo = "0.0 s";
    private System.Threading.Timer? _cargaTimer;
    private void IniciarCronometroCarga()
    {
        _cargaSw.Restart();
        _cargaTimer?.Dispose();
        _cargaTimer = new System.Threading.Timer(_ =>
        {
            _cargaTiempo = $"{_cargaSw.Elapsed.TotalSeconds:0.0} s";
            _ = InvokeAsync(StateHasChanged);
        }, null, 200, 200);
    }
    private void DetenerCronometroCarga()
    {
        _cargaTimer?.Dispose(); _cargaTimer = null;
        _cargaSw.Stop();
        _cargaTiempo = $"{_cargaSw.Elapsed.TotalSeconds:0.0} s";
    }

    private void Etapa(string texto, int pct)
    {
        _cargaEtapa = texto;
        _cargaPct = pct;
        StateHasChanged();
    }
    // NOTA: ya no es un bool `static` en memoria — ese enfoque forzaba logout también al
    // DUPLICAR una pestaña, porque cada pestaña de Blazor WASM corre su propia instancia y
    // el static arranca en false igual para una pestaña nueva que para una duplicada. Se usa
    // sessionStorage en su lugar: el navegador SÍ copia sessionStorage al duplicar una pestaña
    // (Ctrl+clic derecho > Duplicar), pero NO al abrir una pestaña nueva o pegar la URL — así
    // que esta bandera distingue exactamente "sesión de navegador realmente nueva" (fuerza
    // login, como antes) de "pestaña duplicada de una ya autenticada" (mantiene la sesión).
    private const string StartupFlagKey = "appStartupDone";
    private bool _apiActiva = true;
    private System.Threading.Timer? _healthTimer;
    private System.Threading.Timer? _notifTimer;
    private List<NotificacionResumenTipo> _notifResumen = new();
    private List<NotificacionFlujoItem> _notifDetalle = new();
    private string? _notifTipoAbierto;
    // Notificaciones ya vistas (para detectar cuáles son NUEVAS entre un refresco y el
    // siguiente, y disparar el toast emergente solo para esas — nunca en la primera carga).
    private readonly HashSet<int> _notifVistas = new();
    private bool _notifPrimeraCarga = true;
    private List<OpcionMenu> _favoritos  = new();
    private string           _rol        = "";
    private string           _codUsuario = "";
    private string           _codPerfilUsuario = "";
    private bool             _ctxOpen;
    private bool             _userMenuOpen;
    private bool             _estiloMenuSubmenuOpen;

    private void ToggleUserMenu() { _userMenuOpen = !_userMenuOpen; StateHasChanged(); }

    /// <summary>Refresca el layout (posición del sidebar, etc.) cuando otra pestaña
    /// (p.ej. Configuración de Usuario) guarda cambios que aplican de inmediato.</summary>
    private void OnConfigChanged()
    {
        // Si el usuario acaba de activar "Notificaciones activas" (Configuración de Usuario)
        // y todavía no hay nada cargado, refresca de inmediato en vez de esperar el timer.
        if (ConfigSvc.Current.NotificacionesActivas && _notifResumen.Count == 0)
            _ = CargarNotificacionesAsync();
        _ = ActualizarTecladoVirtualAsync();
        // Un logo de aplicación nuevo (la pantalla de Configuración General avisa por acá al grabar): la cabecera lo pide con su
        // versión nueva y se ve sin cerrar sesión. La ausencia de versión no se toma como "quitaron el logo": este evento también
        // salta antes de que llegue la configuración, y borrarlo ahí dejaría el splash sin imagen.
        if (ConfigSvc.Current.LogoAppVersion is { Length: > 0 } versionLogo)
            _logoApp = CfgGeneralSvc.UrlLogoAplicacion(versionLogo);
