    // ── Zoom (estilo Chrome) ──────────────────────────────────────────────
    private int _zoomPct = 100;
    private static readonly int[] _zoomSteps = { 50, 67, 75, 80, 90, 100, 110, 125, 150, 175, 200 };

    private async Task ZoomIn()
    {
        var next = _zoomSteps.FirstOrDefault(z => z > _zoomPct, 200);
        _zoomPct = next;
        await JS.InvokeVoidAsync("appZoom.set", _zoomPct);
        _ = GuardarZoomUsuarioAsync();
