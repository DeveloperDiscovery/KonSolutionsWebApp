@*
    EncabezadoOrdenable.razor
    --------------------------------------------------------------------------
    Texto de cabecera de columna clicable, con flecha de orden ascendente/
    descendente. Se usa dentro de HeaderTemplate junto a FiltroExcelColumna,
    ya que MudBlazor no genera su propio sort label cuando se reemplaza
    el HeaderTemplate por completo.
*@

@inject EtiquetasService EtiquetasSvc

@* Título y flecha van SEPARADOS (dos elementos, no uno) a propósito: el CSS global
   de las cabeceras con filtro (app.css) manda la flecha a la segunda línea junto
   con el ícono de filtro, y para eso necesita poder tomarla aparte del texto. Si
   los dos vivieran adentro del mismo <span>, no habría forma de moverla sin
   mover el título con ella. *@
<span class="eo-titulo" style="cursor:pointer;user-select:none;white-space:nowrap;" @onclick="@(() => OnClick.InvokeAsync())">
    @TextoEfectivo
</span>
@* Antes esto sólo se dibujaba con Activo=true: mientras la columna no fuera la
   que ordena, no había ningún ícono de orden a la vista, y la única forma de
   descubrir que la columna SE PUEDE ordenar era hacer clic a ciegas. Ahora
   siempre hay un ícono —apagado (gris, doble flecha) cuando no es la columna
   activa, con dirección y color cuando sí lo es— para que el afordance de
   "esto ordena" esté siempre visible en la segunda línea, junto al filtro. *@
<span class="eo-flecha" style="cursor:pointer;" @onclick="@(() => OnClick.InvokeAsync())">
    @if (Activo)
    {
        <MudIcon Icon="@(Ascendente ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                 Style="font-size:.85rem;vertical-align:middle;" />
    }
    else
    {
        <MudIcon Icon="@Icons.Material.Filled.UnfoldMore"
                 Style="font-size:.85rem;vertical-align:middle;opacity:.45;" />
    }
</span>

@code {
    [Parameter] public string Texto { get; set; } = "";
    /// <summary>Nombre de columna/campo (ej. "DES_PRODUCTO") para resolver el texto desde el
    /// Diccionario de Etiquetas cuando no se pasa Texto explícito — Texto siempre gana.</summary>
    [Parameter] public string? Campo { get; set; }
    [Parameter] public bool Activo { get; set; }
    [Parameter] public bool Ascendente { get; set; } = true;
    [Parameter] public EventCallback OnClick { get; set; }

    private string TextoEfectivo => !string.IsNullOrWhiteSpace(Texto)
        ? Texto
        : EtiquetasSvc.Obtener(Campo ?? "", Campo);
}
