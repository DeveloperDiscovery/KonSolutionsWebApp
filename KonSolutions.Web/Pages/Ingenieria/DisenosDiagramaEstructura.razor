@* Diagrama de la estructura de una version (solo lectura): de izquierda a derecha, version -> sectores -> componentes -> insumos,
   y los subensambles se expanden en sus propios niveles (hasta 10). Se dibuja en SVG a partir de los nodos que devuelve la API. *@
@using KONSolutions.Shared.Models.Ingenieria
@inject IJSRuntime JS

<div class="dgm-barra d-flex align-center gap-3 flex-wrap mb-2">
    <MudSwitch T="bool" @bind-Value="VerInsumos" Color="Color.Primary" Label="Mostrar insumos" Class="ma-0" data-opcion="insumos" />
    <MudSwitch T="bool" @bind-Value="VerRutas" Color="Color.Success" Label="Mostrar rutas" Class="ma-0" data-opcion="rutas" />
    <div class="d-flex align-center gap-1" style="min-width:220px;">
        <MudIcon Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" />
        <MudSlider T="int" @bind-Value="_zoom" Min="40" Max="150" Step="10" Style="width:140px;" data-opcion="zoom" />
        <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" />
        <span class="mono" style="font-size:.78rem;">@_zoom%</span>
    </div>
    <div class="dgm-leyenda d-flex gap-2 flex-wrap">
        <span class="dgm-chip dgm-ver">Versión</span><span class="dgm-chip dgm-sec">Sector</span><span class="dgm-chip dgm-com">Componente</span>
        <span class="dgm-chip dgm-ins">Insumo</span><span class="dgm-chip dgm-ens">Subensamble</span><span class="dgm-chip dgm-rut">Ruta / proceso / operación</span>
    </div>
</div>

@if (!_cajas.Any())
{
    <MudText Class="mono pa-4" Style="opacity:.55;">No hay estructura para dibujar.</MudText>
}
else
{
    <div class="dgm-scroll kon-llena" data-diagrama="1">
        <svg xmlns="http://www.w3.org/2000/svg" width="@(_ancho * _zoom / 100)" height="@(_alto * _zoom / 100)" viewBox="0 0 @_ancho @_alto" role="img" aria-label="Diagrama de la estructura">
            @foreach (var c in _cajas.Where(c => c.Padre is not null))
            {
                var p = c.Padre!;
                var x1 = p.X + AnchoCaja; var y1 = p.Y + AltoCaja / 2; var x2 = c.X; var y2 = c.Y + AltoCaja / 2; var mx = (x1 + x2) / 2;
                <path class="dgm-enlace" d="M @x1 @y1 C @mx @y1, @mx @y2, @x2 @y2" fill="none" />
            }
            @foreach (var c in _cajas)
            {
                var li = LineaDe(c.Nodo); var tz = TizadoDe(c.Nodo);
                var ficha = DiagramaFicha.Json(c.Nodo, FormulaDe(c.Nodo), OperacionesDe(c.Nodo), li, tz);
                var marcas = Marcas(c.Nodo, li, tz);
                var w1 = AnchoCaja - 17 - marcas.Count * 17; var w2 = AnchoCaja - 17;
                <g class="@($"dgm-caja {Clase(c.Nodo)}")" transform="translate(@c.X,@c.Y)" data-tipo="@(c.Nodo.TIPO_NODO)" data-nodo="@c.Nodo.ID"
                   data-ficha="@ficha" aria-label="@DiagramaFicha.Texto(ficha)">
                    <rect width="@AnchoCaja" height="@AltoCaja" rx="7" />
                    @* los textos van en un svg anidado del ancho de la caja: lo que no cabe se corta y nunca sale del marco *@
                    <svg x="9" y="0" width="@w1" height="@AltoCaja">
                        @{ var lineas = Envuelve(c.Nodo.DESCRIPCION, w1); }
                        @for (var li2 = 0; li2 < lineas.Count; li2++) { <g><text x="0" y="@(16 + AltoLinea * li2)" class="dgm-t1">@lineas[li2]</text></g> }
                    </svg>
                    <svg x="9" y="0" width="@w2" height="@AltoCaja"><text x="0" y="@(AltoCaja - 8)" class="dgm-t2">@Recorta(Linea2(c.Nodo), Math.Max(6, (int)(w2 / 5.8)))</text></svg>
                    <text x="@(AnchoCaja - 16)" y="16" class="dgm-alerta">@(c.Nodo.FLG_CICLO ? "↻" : c.Nodo.FLG_TRUNCADO ? "…" : "")</text>
                    @for (var m = 0; m < marcas.Count; m++)
                    {
                        <g class="@($"dgm-marca dgm-marca-{marcas[m].Clase}")" transform="translate(@(AnchoCaja - 8 - 15 * (m + 1) - 2 * m),4)" data-marca="@marcas[m].Clase"><circle cx="7" cy="7" r="7" /><text x="7" y="10.6">@marcas[m].Letra</text></g>
                    }
                </g>
            }
        </svg>
    </div>
}

<AltoLlenaEstilos />
<style>
    .dgm-scroll { border:1px solid var(--mud-palette-lines-default); border-radius:8px; background:var(--mud-palette-background-gray); padding:8px; }
    .dgm-enlace { stroke:var(--mud-palette-text-disabled); stroke-width:1.4; }
    .dgm-caja rect { fill:var(--mud-palette-surface); stroke:var(--mud-palette-lines-inputs); stroke-width:1.2; }
    .dgm-caja.dgm-ver rect { fill:var(--mud-palette-primary); stroke:var(--mud-palette-primary); }
    .dgm-caja.dgm-ver text, .dgm-caja.dgm-sec text, .dgm-caja.dgm-com text { fill:#fff; }      /* fondos en tonos de azul: letra blanca */
    .dgm-caja.dgm-sec rect { fill:var(--mud-palette-info-lighten); stroke:var(--mud-palette-info); }
    .dgm-caja.dgm-com rect { fill:var(--mud-palette-secondary-lighten); stroke:var(--mud-palette-secondary); }
