    .dgm-chip.dgm-ver { background:var(--mud-palette-primary); color:var(--mud-palette-primary-text); }
    .dgm-chip.dgm-sec { background:var(--mud-palette-info-lighten); color:#fff; } .dgm-chip.dgm-com { background:var(--mud-palette-secondary-lighten); color:#fff; }
    .dgm-chip.dgm-ens { background:var(--mud-palette-warning-lighten); border-color:var(--mud-palette-warning); }

    /* Ficha (tarjeta) del mouse sobre una caja. La dibuja DiagramaFicha.cs al final del documento, fuera de #app. */
    .dgm-caja { cursor:default; }
    .dgm-ficha { --fc:var(--mud-palette-text-disabled); zoom:var(--app-scale, 1); box-sizing:border-box; width:max-content; min-width:230px; max-width:360px;
        background:var(--mud-palette-surface, #fff); color:var(--mud-palette-text-primary, #222); font-size:12px; line-height:1.35;
        border:1px solid var(--mud-palette-lines-default, #d8d8d8); border-left:6px solid var(--fc); border-radius:8px; padding:9px 12px 10px;
        box-shadow:0 10px 28px rgba(0,0,0,.24), 0 2px 6px rgba(0,0,0,.14); }
    .dgm-ficha-ver { --fc:var(--mud-palette-primary); } .dgm-ficha-sec { --fc:var(--mud-palette-info); } .dgm-ficha-com { --fc:var(--mud-palette-secondary); }
    .dgm-ficha-ens { --fc:var(--mud-palette-warning); } .dgm-ficha-ins { --fc:var(--mud-palette-text-disabled); } .dgm-ficha-rut { --fc:var(--mud-palette-success); }
    .dgm-ficha-cab { display:flex; align-items:center; margin-bottom:5px; }
    .dgm-ficha-tipo { font-size:10px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; padding:1px 8px; border-radius:9px;
        background:color-mix(in srgb, var(--fc) 16%, transparent); border:1px solid color-mix(in srgb, var(--fc) 55%, transparent); }
    .dgm-ficha-titulo { font-size:13px; font-weight:600; overflow-wrap:anywhere; }
    .dgm-ficha-cod { font-family:'Spline Sans Mono', ui-monospace, monospace; font-size:10.5px; opacity:.62; margin-top:1px; overflow-wrap:anywhere; }
    .dgm-ficha-filas { margin-top:7px; border-top:1px solid var(--mud-palette-lines-default, #ddd); padding-top:4px; }
    .dgm-ficha-fila { display:flex; justify-content:space-between; gap:18px; padding:2px 0; }
    .dgm-ficha-fila + .dgm-ficha-fila { border-top:1px dotted color-mix(in srgb, currentColor 18%, transparent); }
    .dgm-ficha-et { opacity:.66; white-space:nowrap; }
    .dgm-ficha-val { font-weight:600; text-align:right; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
    .dgm-ficha-total { display:flex; justify-content:space-between; gap:18px; margin-top:7px; padding:5px 8px; border-radius:6px; font-size:13px; font-weight:700;
        background:color-mix(in srgb, var(--fc) 13%, transparent); }
    .dgm-ficha-form { margin-top:7px; border-top:1px solid var(--mud-palette-lines-default, #ddd); padding-top:4px; }
    .dgm-ficha-sub { font-size:10px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; opacity:.66; margin-bottom:3px; }
    .dgm-ficha-chips { display:flex; flex-wrap:wrap; gap:3px; }
    .dgm-ficha-chip { padding:1px 7px; border-radius:5px; font-size:11.5px; font-weight:600; background:color-mix(in srgb, var(--fc) 16%, transparent); }
    .dgm-ficha-nota { opacity:.8; }
    .dgm-ficha-aviso { margin-top:6px; color:var(--mud-palette-error); font-weight:600; font-size:11px; }
</style>

@code {
    [Parameter] public List<DisenosEstructuraNodo> Nodos { get; set; } = new();
    /// <summary>Las formulas de las lineas (una fila por ficha): se muestran como ficha en el insumo que la tiene.</summary>
    [Parameter] public List<DisenosEstructuraFormulaDiagrama>? Formulas { get; set; }
    /// <summary>Indicadores (insumo pivote, formula, tizado): FILA L por linea y FILA V por version.</summary>
    [Parameter] public List<DisenosEstructuraIndicador>? Indicadores { get; set; }

    private Dictionary<string, DisenosEstructuraIndicador> _indLineas = new(), _indVersiones = new();
    private sealed record Marca(string Clase, string Letra);

    private DisenosEstructuraIndicador? LineaDe(DisenosEstructuraNodo n) =>
        n.TIPO_NODO == "INS" && _indLineas.TryGetValue(DiagramaFicha.ClaveLinea(n.COD_DISENO, n.NUM_VERSION, n.COD_SECTOR_PRODUCTO, n.COD_COMPONENTE_PRODUCTO, n.NUM_SECUENCIA, n.COD_PRODUCTO_COMPONENTE), out var x) ? x : null;

    /// <summary>El tizado es de la version: se ve en la version y en los insumos enlazados a un subensamble que lo tiene.</summary>
    private DisenosEstructuraIndicador? TizadoDe(DisenosEstructuraNodo n)
    {
        DisenosEstructuraIndicador? x = null;
        if (n.TIPO_NODO == "VER") _indVersiones.TryGetValue($"{n.COD_DISENO}|{n.NUM_VERSION}", out x);
        else if (n.TIPO_NODO == "INS" && n.FLG_ENSAMBLE && n.COD_DISENO_ENSAMBLE is not null) _indVersiones.TryGetValue($"{n.COD_DISENO_ENSAMBLE}|{n.NUM_VERSION_ENSAMBLE ?? 0}", out x);
        return x is { NUM_TIZADOS: > 0 } ? x : null;
    }

    private List<Marca> Marcas(DisenosEstructuraNodo n, DisenosEstructuraIndicador? li, DisenosEstructuraIndicador? tz)
    {
        var m = new List<Marca>();
        if (li?.FLG_PIVOT == true) m.Add(new("pivote", "P"));
        if (FormulaDe(n) is not null) m.Add(new("formula", "ƒ"));
        if (tz is not null) m.Add(new("tizado", "T"));
        return m;
    }

    private ILookup<string, DisenosEstructuraFormulaDiagrama> _formulas = Array.Empty<DisenosEstructuraFormulaDiagrama>().ToLookup(_ => "");
    private ILookup<int?, DisenosEstructuraNodo> _hijosTodos = Array.Empty<DisenosEstructuraNodo>().ToLookup(n => n.PARENT_ID);

    private IReadOnlyList<DisenosEstructuraFormulaDiagrama>? FormulaDe(DisenosEstructuraNodo n)
    {
        if (n.TIPO_NODO != "INS") return null;
        var l = _formulas[DiagramaFicha.ClaveLinea(n.COD_DISENO, n.NUM_VERSION, n.COD_SECTOR_PRODUCTO, n.COD_COMPONENTE_PRODUCTO, n.NUM_SECUENCIA, n.COD_PRODUCTO_COMPONENTE)].OrderBy(x => x.NUM_SECUENCIA_FORMULA ?? 0).ToList();
        return l.Count == 0 ? null : l;
    }

    // las operaciones que cuelgan de una ruta, proceso o subproceso, en el orden del arbol
    private IReadOnlyList<DisenosEstructuraNodo>? OperacionesDe(DisenosEstructuraNodo n)
    {
        if (n.TIPO_NODO is not ("RUT" or "PRC" or "SPR")) return null;
        var r = new List<DisenosEstructuraNodo>();
        void Baja(DisenosEstructuraNodo p) { foreach (var h in _hijosTodos[p.ID].OrderBy(x => x.ORDEN, StringComparer.Ordinal)) { if (h.TIPO_NODO == "OPE") r.Add(h); else if (h.TIPO_NODO is "PRC" or "SPR") Baja(h); } }
        Baja(n);
        return r;
    }

    private const int AnchoCaja = 210, SepX = 60, SepY = 12, Margen = 16, MaxLineas = 4, AltoLinea = 14;
    private int AltoCaja = 40;          // el mismo para todas las cajas: crece segun las lineas que necesita el nombre mas largo
    private bool _verInsumos = true;
    private bool VerInsumos { get => _verInsumos; set { if (_verInsumos == value) return; _verInsumos = value; Armar(); } }
    private bool _verRutas = true;
    private bool VerRutas { get => _verRutas; set { if (_verRutas == value) return; _verRutas = value; Armar(); } }
    private static bool EsRuta(DisenosEstructuraNodo n) => n.TIPO_NODO is "RUT" or "PRC" or "SPR" or "OPE";
    private int _zoom = 100;
    private int _ancho, _alto;
    private List<Caja> _cajas = new();

    private sealed class Caja { public DisenosEstructuraNodo Nodo = null!; public Caja? Padre; public int X, Y; public double YCentro; }

    protected override void OnParametersSet() => Armar();

    // la ficha del mouse (DiagramaFicha.cs) se instala una vez; en cada dibujado se oculta la que hubiera abierta
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await DiagramaFicha.IniciarAsync(JS); } catch (JSException) { }
    }

    private void Armar()
    {
        _cajas = new();
        _formulas = (Formulas ?? new()).ToLookup(x => DiagramaFicha.ClaveLinea(x.COD_DISENO, x.NUM_VERSION, x.COD_SECTOR_PRODUCTO, x.COD_COMPONENTE_PRODUCTO, x.NUM_SECUENCIA, x.COD_PRODUCTO_COMPONENTE));
        _indLineas = (Indicadores ?? new()).Where(x => x.FILA == "L").GroupBy(x => DiagramaFicha.ClaveLinea(x.COD_DISENO, x.NUM_VERSION, x.COD_SECTOR_PRODUCTO, x.COD_COMPONENTE_PRODUCTO, x.NUM_SECUENCIA, x.COD_PRODUCTO_COMPONENTE)).ToDictionary(g => g.Key, g => g.First());
        _indVersiones = (Indicadores ?? new()).Where(x => x.FILA == "V").GroupBy(x => $"{x.COD_DISENO}|{x.NUM_VERSION}").ToDictionary(g => g.Key, g => g.First());
        _hijosTodos = Nodos.ToLookup(n => n.PARENT_ID);
        var visibles = Nodos.Where(n => (_verInsumos || n.TIPO_NODO != "INS" || n.FLG_ENSAMBLE) && (_verRutas || !EsRuta(n))).ToList();
        if (visibles.Count == 0) { _ancho = _alto = 0; return; }
        // el nombre se parte en varias lineas (no se trunca): todas las cajas toman el alto del nombre mas largo
        var maxL = 1;
        foreach (var v in visibles) maxL = Math.Max(maxL, Envuelve(v.DESCRIPCION, AnchoCaja - 17 - Marcas(v, LineaDe(v), TizadoDe(v)).Count * 17).Count);
        AltoCaja = 26 + AltoLinea * maxL;
        var hijos = visibles.ToLookup(n => n.PARENT_ID);
        var porId = new Dictionary<int, Caja>();
        var ordenados = visibles.OrderBy(n => n.ORDEN, StringComparer.Ordinal).ToList();
        int hoja = 0;
        void Poner(DisenosEstructuraNodo n, Caja? padre)
        {
            var caja = new Caja { Nodo = n, Padre = padre, X = Margen + (n.PROFUNDIDAD - 1) * (AnchoCaja + SepX) };
            var hs = hijos[n.ID].OrderBy(h => h.ORDEN, StringComparer.Ordinal).ToList();
            _cajas.Add(caja); porId[n.ID] = caja;
            if (hs.Count == 0) { caja.YCentro = Margen + hoja * (AltoCaja + SepY); hoja++; }
            else { foreach (var h in hs) Poner(h, caja); caja.YCentro = (porId[hs.First().ID].YCentro + porId[hs.Last().ID].YCentro) / 2; }
            caja.Y = (int)caja.YCentro;
        }
        foreach (var raiz in ordenados.Where(n => n.PARENT_ID is null)) Poner(raiz, null);
        _ancho = _cajas.Max(c => c.X) + AnchoCaja + Margen;
        _alto = _cajas.Max(c => c.Y) + AltoCaja + Margen;
    }

    private static string Clase(DisenosEstructuraNodo n) =>
        (n.TIPO_NODO switch { "VER" => "dgm-ver", "SEC" => "dgm-sec", "COM" => "dgm-com", "RUT" => "dgm-rut dgm-r", "PRC" => "dgm-rut dgm-r", "SPR" => "dgm-rut dgm-r", "OPE" => "dgm-rut dgm-ope", _ => n.FLG_ENSAMBLE ? "dgm-ens" : "dgm-ins" }) + (n.FLG_BLOQUEADO && n.TIPO_NODO == "VER" ? " dgm-bloq" : "");

    /// <summary>Parte el texto en lineas que caben en <paramref name="ancho"/> px (estimado a 7 px por letra), cortando en espacios; solo si pasa de MaxLineas termina en "…".</summary>
    private static List<string> Envuelve(string? texto, double ancho)
    {
        var max = Math.Max(6, (int)(ancho / 7.0));
        var lineas = new List<string>();
        var actual = "";
        foreach (var palabra0 in (texto ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries))
        {
            var palabra = palabra0;
            while (palabra.Length > max) { if (actual.Length > 0) { lineas.Add(actual); actual = ""; } lineas.Add(palabra[..max]); palabra = palabra[max..]; }
            if (actual.Length == 0) actual = palabra;
            else if (actual.Length + 1 + palabra.Length <= max) actual += " " + palabra;
            else { lineas.Add(actual); actual = palabra; }
        }
        if (actual.Length > 0) lineas.Add(actual);
        if (lineas.Count == 0) lineas.Add("");
        if (lineas.Count > MaxLineas) { lineas = lineas.Take(MaxLineas).ToList(); var u = lineas[^1]; lineas[^1] = (u.Length >= max ? u[..(max - 1)] : u) + "…"; }
        return lineas;
    }

    private static string Recorta(string? s, int max) => string.IsNullOrEmpty(s) ? "" : s.Length <= max ? s : s[..(max - 1)] + "…";

    private static string Linea2(DisenosEstructuraNodo n) => n.TIPO_NODO switch
    {
        "INS" => $"{n.CAN_CONSUMO:0.####} {n.COD_UNIDAD_MEDIDA} · {n.COSTO_TOTAL:N2}",
        "OPE" => $"{n.CAN_LEAD_TIME:0.##} {n.COD_UNIDAD_MEDIDA_TIEMPO}" + (n.FLG_MANUAL == true ? " · manual" : "") + (n.FLG_CONTROL_CALIDAD == true ? " · calidad" : ""),
        "RUT" => "Ruta de producción",
        "PRC" => "Proceso",
        "SPR" => "Subproceso",
        "VER" => $"Costo {n.COSTO_TOTAL:N2}" + (n.FLG_BLOQUEADO ? " · bloqueada" : ""),
        _ => $"{n.COSTO_TOTAL:N2}"
    };

}
