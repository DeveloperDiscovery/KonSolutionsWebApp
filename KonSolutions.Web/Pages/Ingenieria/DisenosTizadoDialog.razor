    private static string Medidas(decimal largo, decimal alto) => $"{largo.ToString("0.#", CultureInfo.CurrentCulture)} × {alto.ToString("0.#", CultureInfo.CurrentCulture)}";

    /// <summary>Vista en miniatura del contorno ("x,y x,y ...") como SVG; vacia si el texto no se puede leer.</summary>
    public static string Mini(string contorno)
    {
        var pts = new List<(double X, double Y)>();
        foreach (var t in (contorno ?? "").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries))
        {
            var xy = t.Split(',');
            if (xy.Length != 2 || !double.TryParse(xy[0], NumberStyles.Float, CultureInfo.InvariantCulture, out var x) || !double.TryParse(xy[1], NumberStyles.Float, CultureInfo.InvariantCulture, out var y)) return "";
            pts.Add((x, y));
        }
        if (pts.Count < 3) return "";
        double minX = pts.Min(p => p.X), maxX = pts.Max(p => p.X), minY = pts.Min(p => p.Y), maxY = pts.Max(p => p.Y);
        double w = Math.Max(maxX - minX, 1e-6), h = Math.Max(maxY - minY, 1e-6);
        var pad = Math.Max(w, h) * 0.04;
        string F(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);
        var puntos = string.Join(" ", pts.Select(p => F(p.X - minX) + "," + F(p.Y - minY)));
        return $"<svg viewBox=\"{F(-pad)} {F(-pad)} {F(w + 2 * pad)} {F(h + 2 * pad)}\" width=\"64\" height=\"44\" preserveAspectRatio=\"xMidYMid meet\"><polygon points=\"{puntos}\" fill=\"#b4c7e8\" stroke=\"#333\" stroke-width=\"{F(Math.Max(w, h) / 60)}\"/></svg>";
    }

