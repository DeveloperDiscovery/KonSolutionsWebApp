@* Catalogo de operaciones (script SQL 120, API ingenieria/operaciones). Una operacion es una pieza de catalogo con nombre propio ("PEGAR CUELLO AL CUERPO"):
   su familia (tipo, que ya trae clase y funcion), su proceso y subproceso, la categoria A-D del personal que la ejecuta y el tipo de maquina. Puede COMPONERSE de otras
   operaciones (arbol reutilizable: se define una vez y se usa en cualquier producto); el tiempo estandar vive solo en las hojas y las compuestas suman a sus hijas. *@
@page "/ingenieria/operaciones"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Ingenieria
@using IngRoute = KONSolutions.Web.Services.ApiRoutes.Ingenieria
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MenuService MenuSvc
@inject AccessLogService AccessLog

<PageTitle>Operaciones · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-2 grid-header-compacto">
    <div class="grid-header-titulo">
        <MudText Typo="Typo.h5">Operaciones</MudText>
        <MudText Class="mono" Style="opacity:.55;font-size:.82rem;">Catálogo de operaciones · @_visibles.Count de @_items.Count</MudText>
    </div>
    <BarraBusqueda @bind-Value="_buscar" OnSearch="@(() => { StateHasChanged(); return Task.CompletedTask; })" Placeholder="Buscar por código, nombre, tipo, categoría..." DebounceInterval="300" MaxWidth="520px" Class="grid-header-search" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridClearFiltersButton OnClear="@(() => _g.Limpiar())" HasFilters="@_g.HayFiltros" />
        <GridRefreshButton OnRefresh="Cargar" />
        @if (_app == "")
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Abrir(null, CrudModo.Create))" data-accion="nuevo">Nueva</MudButton>
        }
        else
        {
            <AccionesBotones CodAplicacion="@_app" CodOpcionAplicacion="@_opcion" Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2 align-center mb-2" data-zona="filtros">
    <MudSelect T="string" @bind-Value="_fProceso" Label="Proceso" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:190px;" data-filtro="proceso">
        @foreach (var p in _procesos) { <MudSelectItem T="string" Value="@p.COD">@p.DES</MudSelectItem> }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_fClase" Label="Clase" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:200px;" data-filtro="clase">
        @foreach (var p in _clases) { <MudSelectItem T="string" Value="@p.COD">@p.DES</MudSelectItem> }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_fCategoria" Label="Categoría" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:150px;" data-filtro="categoria">
        @foreach (var p in _categorias) { <MudSelectItem T="string" Value="@p.COD">@p.COD · @p.DES</MudSelectItem> }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_fMaquina" Label="Máquina" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="max-width:210px;" data-filtro="maquina">
        @foreach (var p in _maquinas) { <MudSelectItem T="string" Value="@p.COD">@p.DES</MudSelectItem> }
    </MudSelect>
    <MudSwitch T="bool" @bind-Value="_soloCompuestas" Label="Solo compuestas" Color="Color.Primary" data-filtro="compuestas" />
    <MudSwitch T="bool" @bind-Value="_sinTiempo" Label="Hojas sin tiempo" Color="Color.Warning" data-filtro="sin-tiempo" />
</div>

@if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" data-error="1">@_error</MudAlert> }

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="operaciones" style="position:relative;">
    <MudDataGrid T="Operacion" Items="_visibles" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="100%" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaPadre" data-grilla="operaciones">
        <Columns>
            <TemplateColumn Title="Código" Sortable="false" Width="95px"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="0" Texto="Código" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.COD_OPERACION</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Operación" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="1" Texto="Operación" OnCambio="Refrescar" /></HeaderTemplate>
                <CellTemplate>
                    <span>@context.Item.DES_OPERACION</span>
                    @if (context.Item.FLG_COMPUESTA) { <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-1" title="@($"Compuesta de {context.Item.CAN_COMPONENTES} componentes")">compuesta · @context.Item.CAN_COMPONENTES</MudChip> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Proceso" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="2" Texto="Proceso" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.DES_PROCESO</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Subproceso" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="3" Texto="Subproceso" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.DES_SUB_PROCESO</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Tipo" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="4" Texto="Tipo" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.DES_TIPO_OPERACION_PRODUCCION</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Clase" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="5" Texto="Clase" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.DES_CLASE_OPERACION_PRODUCCION</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Cat." Sortable="false" Width="70px"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="6" Texto="Cat." OnCambio="Refrescar" /></HeaderTemplate>
                <CellTemplate>@if (!string.IsNullOrEmpty(context.Item.COD_CATEGORIA_OCUPACIONAL)) { <MudChip T="string" Size="Size.Small">@context.Item.COD_CATEGORIA_OCUPACIONAL</MudChip> }</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Máquina" Sortable="false"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="7" Texto="Máquina" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.DES_TIPO_MAQUINA</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Usada en" Sortable="false" Width="90px"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="8" Texto="Usada en" OnCambio="Refrescar" /></HeaderTemplate><CellTemplate>@context.Item.CAN_USADA_EN</CellTemplate></TemplateColumn>
            <TemplateColumn Title="SAM vigente" Sortable="false" Width="130px"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="9" Texto="SAM vigente" OnCambio="Refrescar" /></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.VAL_SAM is { } s) { <span class="mono" title="@(context.Item.NUM_VERSION_VIGENTE is { } nv ? $"versión {nv}" : "suma de sus hojas")">@OperacionesApi.Min(s)@if (context.Item.NUM_VERSION_VIGENTE is { } v) { <span style="opacity:.55;"> v@(v)</span> }</span> }
                    else if (!context.Item.FLG_COMPUESTA) { <MudChip T="string" Size="Size.Small" Color="Color.Warning">sin tiempo</MudChip> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado" Sortable="false" Width="110px"><HeaderTemplate><EncabezadoOF G="_g" Items="_fuente" Col="10" Texto="Estado" OnCambio="Refrescar" /></HeaderTemplate>
                <CellTemplate>@if (!string.IsNullOrEmpty(context.Item.DES_ESTADO)) { <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" /> }</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" Width="260px">
                <CellTemplate>
                    @{ var it = context.Item; }
                    <MudTooltip Text="Árbol, tiempos y resumen">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Ficha(it))" data-accion="ficha" />
                    </MudTooltip>
                    @if (_app == "")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Abrir(it, CrudModo.Update))" data-accion="editar" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Abrir(it, CrudModo.Delete))" data-accion="eliminar" />
                    }
                    else
                    {
                        <AccionesBotones CodAplicacion="@_app" CodOpcionAplicacion="@_opcion" Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b => OnAccionGrilla(it, b))" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin operaciones.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Operacion" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private readonly GridOF<Operacion> _g = new();
    private void Refrescar() { }   // el orden o un filtro de columna cambio: se vuelve a dibujar
    public Operaciones()
    {
        _g.Add(x => x.COD_OPERACION);
        _g.Add(x => x.DES_OPERACION);
        _g.Add(x => x.DES_PROCESO);
        _g.Add(x => x.DES_SUB_PROCESO);
        _g.Add(x => x.DES_TIPO_OPERACION_PRODUCCION);
        _g.Add(x => x.DES_CLASE_OPERACION_PRODUCCION);
        _g.Add(x => x.COD_CATEGORIA_OCUPACIONAL);
        _g.Add(x => x.DES_TIPO_MAQUINA);
        _g.Add(x => x.CAN_USADA_EN.ToString(), x => x.CAN_USADA_EN);
        _g.Add(x => x.VAL_SAM is { } s ? OperacionesApi.Min(s) : (x.FLG_COMPUESTA ? "" : "sin tiempo"), x => x.VAL_SAM);
        _g.Add(x => x.DES_ESTADO);
    }
    // El menu abre cada opcion pasandole estos dos parametros (WorkspaceTabService); sin declararlos la pantalla falla al dibujarse.
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private string _app = "", _opcion = "";
    private List<Operacion> _items = new();
    private List<CatalogoOperacionItem> _procesos = new(), _categorias = new(), _maquinas = new(), _clases = new();
    private string _buscar = "", _error = "";
    private string? _fProceso, _fClase, _fCategoria, _fMaquina;
    private bool _soloCompuestas, _sinTiempo;

    private List<Operacion> _visibles => _g.Visibles(_fuente);
    private List<Operacion> _fuente => _items.Where(o =>
            (string.IsNullOrWhiteSpace(_buscar) || Coincide(o, _buscar))
            && (string.IsNullOrEmpty(_fProceso) || o.COD_PROCESO == _fProceso)
            && (string.IsNullOrEmpty(_fClase) || o.COD_CLASE_OPERACION_PRODUCCION == _fClase)
            && (string.IsNullOrEmpty(_fCategoria) || o.COD_CATEGORIA_OCUPACIONAL == _fCategoria)
            && (string.IsNullOrEmpty(_fMaquina) || o.COD_TIPO_MAQUINA == _fMaquina)
            && (!_soloCompuestas || o.FLG_COMPUESTA)
            && (!_sinTiempo || (!o.FLG_COMPUESTA && o.VAL_SAM is null))).ToList();

    private static bool Coincide(Operacion o, string t) =>
        new[] { o.COD_OPERACION, o.DES_OPERACION, o.DES_TIPO_OPERACION_PRODUCCION, o.DES_SUB_PROCESO, o.DES_CATEGORIA_OCUPACIONAL, o.DES_TIPO_MAQUINA, o.DES_PROCESO }
            .Any(x => x?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false);

    protected override async Task OnInitializedAsync()
    {
        var r = MenuSvc.BuscarCodigosPorFormulario("Ingenieria/Operaciones.razor");
        if (r is not null) (_app, _opcion) = (r.Value.CodAplicacion, r.Value.CodOpcionAplicacion);
        await AccessLog.LogNavegacionAsync("INGENIERIA", "Operaciones");
        await Cargar();
    }

    private async Task Cargar()
    {
        var combos = await OperacionesApi.LeerAsync<Dictionary<string, List<CatalogoOperacionItem>>>(Http, IngRoute.OperacionesCombos);
        if (combos.Data is { } c)
        {
            _procesos = c.GetValueOrDefault("procesos") ?? new();
            _categorias = c.GetValueOrDefault("categorias") ?? new();
            _maquinas = c.GetValueOrDefault("maquinas") ?? new();
            // las clases salen de los tipos de operacion (COD_REGLA lleva la clase de cada tipo)
            _clases = (c.GetValueOrDefault("tipos") ?? new()).Where(t => !string.IsNullOrEmpty(t.COD_REGLA)).Select(t => t.COD_REGLA!).Distinct()
                .Select(k => new CatalogoOperacionItem { COD = k, DES = ClaseNombre(k) }).OrderBy(x => x.DES).ToList();
        }
        var r = await OperacionesApi.LeerAsync<List<Operacion>>(Http, IngRoute.Operaciones);
        _error = r.Ok ? "" : r.Mensaje ?? "No se pudieron leer las operaciones.";
        _items = r.Data ?? new();
        StateHasChanged();
    }

    private static string ClaseNombre(string k) => k switch { "MANUA" => "Manual", "MAQUI" => "Con máquina", "INSPC" => "Inspección y control", "LOGIS" => "Traslado y embalaje", "OBRAC" => "Obra y montaje", _ => k };

    private Task OnAccionHeader(BotonTreeviewItem b) => b.FLG_ACCION_POST == true ? Abrir(null, CrudModo.Create) : Task.CompletedTask;

    private Task OnAccionGrilla(Operacion it, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT == true) return Abrir(it, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(it, CrudModo.Delete);
        if (b.FLG_ACCION_GET == true) return Abrir(it, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(Operacion? it, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva operación",
            CrudModo.Delete => $"Eliminar · {it?.DES_OPERACION}",
            CrudModo.Read => $"Consultar · {it?.DES_OPERACION}",
            _ => $"Editar · {it?.DES_OPERACION}"
        };
        var dlg = await DialogService.ShowAsync<OperacionDialog>(titulo, new DialogParameters { ["Item"] = it, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Cargar();
    }

    private async Task Ficha(Operacion it)
    {
        var dlg = await DialogService.ShowAsync<OperacionFichaDialog>($"{it.COD_OPERACION} · {it.DES_OPERACION}", new DialogParameters { ["Operacion"] = it },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, BackdropClick = false });
        await dlg.Result;
        await Cargar();
    }
}
