@page "/contabilidad/tipos-cuenta-contable"
@attribute [Authorize]
@using TipoCuentaContableModel = KONSolutions.Shared.Models.Contabilidad.TipoCuentaContable
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Cuenta Contable · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Cuenta Contable" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema CONTABILIDAD · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar tipo de cuenta contable..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-cuenta-contable" style="position:relative;">
    <MudDataGrid T="TipoCuentaContableModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("CONTABILIDAD.TIPOS_CUENTA_CONTABLE","COD_TIPO_CUENTA_CONTABLE",70,110)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_CUENTA_CONTABLE" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TipoCuentaContableModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_CUENTA_CONTABLE)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_TIPO_CUENTA_CONTABLE</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Tipo de Cuenta Contable"
                            Width="@Limites.ColWidth("CONTABILIDAD.TIPOS_CUENTA_CONTABLE","DES_TIPO_CUENTA_CONTABLE",150,320)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_CUENTA_CONTABLE" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TipoCuentaContableModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_CUENTA_CONTABLE)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_CUENTA_CONTABLE</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Naturaleza" Width="130">
                <HeaderTemplate><EncabezadoOrdenable Texto="Naturaleza" /></HeaderTemplate>
                <CellTemplate>@context.Item.DES_CUENTA_NATURALEZA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Afecta" Sortable="false" Width="140">
                <CellTemplate>
                    @if (context.Item.FLG_AFECTA_BALANCE == true)
                    {
                        <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" Size="Size.Small" Style="opacity:.8;" /> Balance</div>
                    }
                    else if (context.Item.FLG_AFECTA_RESULTADO == true)
                    {
                        <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Style="opacity:.8;" /> Resultado</div>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TipoCuentaContableModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TipoCuentaContableModel> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<TipoCuentaContableModel> Ordenar(List<TipoCuentaContableModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_CUENTA_CONTABLE).ToList() : items.OrderByDescending(x => x.COD_TIPO_CUENTA_CONTABLE).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_CUENTA_CONTABLE).ToList() : items.OrderByDescending(x => x.DES_TIPO_CUENTA_CONTABLE).ToList(),
        _ => items
    };

    private List<TipoCuentaContableModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<TipoCuentaContableModel> Base(int col) => Aplicar(_items, col);

    private List<TipoCuentaContableModel> Aplicar(List<TipoCuentaContableModel> src, int ex)
    {
        // Sin filtros activos no hay nada que recorrer, y ese es el caso normal: la
        // grilla arranca sin filtros. Cada encabezado llama a este método en CADA
        // redibujado, así que sin esta salida un solo clic recorría la lista entera
        // una vez por columna.
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtros) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<TipoCuentaContableModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_CUENTA_CONTABLE)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_CUENTA_CONTABLE)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // El SP _SEARCH de esta tabla arranca con "WHERE 1 = 1 OR (...)", así que ignora el
    // texto y siempre devuelve todo — por eso se filtra en memoria y no se llama al SP.
    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("CONTABILIDAD", "TiposCuentaContable");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("CONTABILIDAD.TIPOS_CUENTA_CONTABLE", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TipoCuentaContableModel>>>(
                ApiRoutes.Contabilidad.TiposCuentaContable);
            var todos = r?.Data ?? new();
            _items = string.IsNullOrWhiteSpace(_search)
                ? todos
                : todos.Where(x => x.COD_TIPO_CUENTA_CONTABLE.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                || x.DES_TIPO_CUENTA_CONTABLE.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposCuentaContable), nameof(Load));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(TiposCuentaContable));
            _items = new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TipoCuentaContableModel item, BotonTreeviewItem b)
    {
        // Del más específico al más genérico. Un botón de Modificar suele traer
        // marcados GET y PUT a la vez (para editar primero hay que leer), y un
        // Eliminar suele traer GET y DELETE: preguntando por GET primero, esos dos
        // entraban por la rama de consulta y el lápiz y el tacho abrean en sólo
        // lectura. Con DELETE y PUT antes, cada botón hace lo que dice su nombre.
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(TipoCuentaContableModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de cuenta contable",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_CUENTA_CONTABLE}",
            CrudModo.Read   => $"Consultar · {item?.DES_TIPO_CUENTA_CONTABLE}",
            _               => $"Editar · {item?.DES_TIPO_CUENTA_CONTABLE}"
        };
        var dlg = await DialogService.ShowAsync<TiposCuentaContableDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["CodAplicacion"] = CodAplicacion, ["CodOpcionAplicacion"] = CodOpcionAplicacion },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("CONTABILIDAD.TIPOS_CUENTA_CONTABLE", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
