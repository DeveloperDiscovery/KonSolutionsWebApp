@page "/contabilidad/cuentas-naturaleza"
@attribute [Authorize]
@using CuentaNaturalezaModel = KONSolutions.Shared.Models.Contabilidad.CuentaNaturaleza
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Naturaleza de Cuentas · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Naturaleza de Cuentas" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema CONTABILIDAD · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar naturaleza de cuenta..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="cuentas-naturaleza" style="position:relative;">
    <MudDataGrid T="CuentaNaturalezaModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("CONTABILIDAD.CUENTAS_NATURALEZA","COD_CUENTA_NATURALEZA",60,90)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_CUENTA_NATURALEZA" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="CuentaNaturalezaModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_CUENTA_NATURALEZA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_CUENTA_NATURALEZA</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Naturaleza"
                            Width="@Limites.ColWidth("CONTABILIDAD.CUENTAS_NATURALEZA","DES_CUENTA_NATURALEZA",120,220)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_CUENTA_NATURALEZA" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="CuentaNaturalezaModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_CUENTA_NATURALEZA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_CUENTA_NATURALEZA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Naturaleza Alternativa"
                            Width="@Limites.ColWidth("CONTABILIDAD.CUENTAS_NATURALEZA","DES_CUENTA_NATURALEZA_ALTERNATIVA",120,220)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_CUENTA_NATURALEZA_ALTERNATIVA" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="CuentaNaturalezaModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_CUENTA_NATURALEZA_ALTERNATIVA ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_CUENTA_NATURALEZA_ALTERNATIVA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="CuentaNaturalezaModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<CuentaNaturalezaModel> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<CuentaNaturalezaModel> Ordenar(List<CuentaNaturalezaModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_CUENTA_NATURALEZA).ToList() : items.OrderByDescending(x => x.COD_CUENTA_NATURALEZA).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_CUENTA_NATURALEZA).ToList() : items.OrderByDescending(x => x.DES_CUENTA_NATURALEZA).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_CUENTA_NATURALEZA_ALTERNATIVA).ToList() : items.OrderByDescending(x => x.DES_CUENTA_NATURALEZA_ALTERNATIVA).ToList(),
        _ => items
    };

    private List<CuentaNaturalezaModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<CuentaNaturalezaModel> Base(int col) => Aplicar(_items, col);

    private List<CuentaNaturalezaModel> Aplicar(List<CuentaNaturalezaModel> src, int ex)
    {
        // Sin filtros activos no hay nada que recorrer, y ese es el caso normal: la
        // grilla arranca sin filtros. Cada encabezado llama a este método en CADA
        // redibujado, así que sin esta salida un solo clic recorría la lista entera
        // una vez por columna.
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtros) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<CuentaNaturalezaModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_CUENTA_NATURALEZA)),
                1 => q.Where(x => v.Contains(x.DES_CUENTA_NATURALEZA)),
                2 => q.Where(x => v.Contains(x.DES_CUENTA_NATURALEZA_ALTERNATIVA ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // El SP _SEARCH de esta tabla arranca con "WHERE 1 = 1 OR (...)", así que ignora el
    // texto y siempre devuelve todo — por eso se filtra en memoria y no se llama al SP.
    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("CONTABILIDAD", "CuentasNaturaleza");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("CONTABILIDAD.CUENTAS_NATURALEZA", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<CuentaNaturalezaModel>>>(
                ApiRoutes.Contabilidad.CuentasNaturaleza);
            var todos = r?.Data ?? new();
            _items = string.IsNullOrWhiteSpace(_search)
                ? todos
                : todos.Where(x => x.COD_CUENTA_NATURALEZA.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                || x.DES_CUENTA_NATURALEZA.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                || (x.DES_CUENTA_NATURALEZA_ALTERNATIVA ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(CuentasNaturaleza), nameof(Load));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(CuentasNaturaleza));
            _items = new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(CuentaNaturalezaModel item, BotonTreeviewItem b)
    {
        // Del más específico al más genérico. Un botón de Modificar suele traer
        // marcados GET y PUT a la vez (para editar primero hay que leer), y un
        // Eliminar suele traer GET y DELETE: preguntando por GET primero, esos dos
        // entraban por la rama de consulta y el lápiz y el tacho abrean en sólo
        // lectura. Con DELETE y PUT antes, cada botón hace lo que dice su nombre.
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(CuentaNaturalezaModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva naturaleza de cuenta",
            CrudModo.Delete => $"Eliminar · {item?.DES_CUENTA_NATURALEZA}",
            CrudModo.Read   => $"Consultar · {item?.DES_CUENTA_NATURALEZA}",
            _               => $"Editar · {item?.DES_CUENTA_NATURALEZA}"
        };
        var dlg = await DialogService.ShowAsync<CuentasNaturalezaDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["CodAplicacion"] = CodAplicacion, ["CodOpcionAplicacion"] = CodOpcionAplicacion },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("CONTABILIDAD.CUENTAS_NATURALEZA", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
