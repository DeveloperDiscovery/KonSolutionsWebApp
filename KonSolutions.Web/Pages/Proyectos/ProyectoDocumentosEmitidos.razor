@using System.Text.Json
@using KONSolutions.Shared.Models.Proyectos
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IJSRuntime JS

@* Documentos emitidos del proyecto (actas, contrato, cronograma a aprobar): nacen de una plantilla con su texto, que aquí se puede editar solo para este proyecto.
   Borrador → (enviar a aprobar: aparece en Compromisos con sus aprobadores) → Aprobado → Emitido (PDF congelado en los archivos del proyecto, ya no se modifica).
   Para cambiar uno emitido se crea una nueva versión; la emitida se conserva. *@
<div class="d-flex align-center gap-2 flex-wrap mb-2">
    @if (!ReadOnly)
    {
        <MudMenu Label="Nuevo desde plantilla" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.NoteAdd" EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true">
            @foreach (var p in _plantillas)
            {
                var cod = p.Id;
                <MudMenuItem OnClick="@(() => Nuevo(cod))">@p.Texto</MudMenuItem>
            }
            @if (_plantillas.Count == 0) { <MudMenuItem Disabled="true">No hay plantillas habilitadas</MudMenuItem> }
        </MudMenu>
    }
    <MudSpacer />
    <MudText Class="mono" Style="opacity:.6;font-size:.82rem;">@_items.Count documentos · @_items.Count(x => x.COD_ESTADO_DOCUMENTO == "EMI") emitidos</MudText>
    <GridRefreshButton OnRefresh="CargarAsync" />
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <MudDataGrid T="DocumentoEmitido" Items="_items" Dense="true" Hover="true" Striped="true" FixedHeader="true" SortMode="SortMode.Multiple" RowsPerPage="25">
        <Columns>
            <TemplateColumn Title="Estado" SortBy="x => x.COD_ESTADO_DOCUMENTO" HeaderStyle="width:130px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ColorEstado(context.Item.COD_ESTADO_DOCUMENTO)">@context.Item.DES_ESTADO_DOCUMENTO</MudChip>
                    @if (context.Item.COD_ESTADO_DOCUMENTO == "EMI" && !context.Item.FLG_VIGENTE) { <div class="mono" style="font-size:.7rem;opacity:.7;">reemplazado</div> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Documento" SortBy="x => x.DES_TITULO">
                <CellTemplate>
                    <div style="font-weight:600;">@context.Item.DES_TITULO <span class="mono" style="opacity:.6;font-size:.74rem;">v@(context.Item.NUM_VERSION)</span></div>
                    <div style="font-size:.76rem;opacity:.75;">@context.Item.DES_PLANTILLA_DOCUMENTO</div>
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_MOTIVO_ANULACION)) { <div style="font-size:.76rem;color:#c62828;">Anulado: @context.Item.DES_MOTIVO_ANULACION</div> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fase" SortBy="x => x.DES_FASE"><CellTemplate>@(context.Item.DES_FASE ?? "—")</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Aprobación" Sortable="false">
                <CellTemplate>
                    @if (context.Item.NUM_SECUENCIA_COMPROMISO is not null) { <span style="font-size:.8rem;">Compromiso #@context.Item.NUM_SECUENCIA_COMPROMISO · @TextoCompromiso(context.Item.COD_ESTADO_COMPROMISO)</span> }
                    else { <span style="opacity:.55;font-size:.8rem;">@(context.Item.FLG_REQUIERE_APROBACION ? "pide aprobación" : "sin aprobación")</span> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Emisión" SortBy="x => x.FEC_EMISION">
                <CellTemplate>@if (context.Item.FEC_EMISION is { } f) { <span class="mono" style="font-size:.78rem;">@f.ToString("dd/MM/yyyy")</span> @if (!string.IsNullOrWhiteSpace(context.Item.DES_EMISOR)) { <div style="font-size:.74rem;opacity:.75;">@context.Item.DES_EMISOR</div> } } else { <span style="opacity:.5;">—</span> }</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    @{ var d = context.Item; var edita = !ReadOnly && d.COD_ESTADO_DOCUMENTO is "BOR" or "OBS"; }
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Primary" OnClick="@(() => VerPdf(d))" title="@(d.COD_ESTADO_DOCUMENTO == "EMI" ? "Ver el PDF emitido" : "Vista previa del PDF")" />
                    @if (edita)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Editar(d))" title="Editar el texto" />
                        <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" OnClick="@(() => Enviar(d))" title="@(d.COD_ESTADO_DOCUMENTO == "OBS" ? "Volver a enviar a aprobar" : "Enviar a aprobar")" />
                    }
                    @if (!ReadOnly && (d.COD_ESTADO_DOCUMENTO == "APR" || (d.COD_ESTADO_DOCUMENTO == "BOR" && !d.FLG_REQUIERE_APROBACION)))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Success" OnClick="@(() => Emitir(d))" title="Emitir (congela el PDF)" />
                    }
                    @if (!ReadOnly && d.COD_ESTADO_DOCUMENTO == "EMI" && d.FLG_VIGENTE)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => NuevaVersion(d))" title="Nueva versión" />
                    }
                    @if (!ReadOnly && d.COD_ESTADO_DOCUMENTO is not "ANU")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" OnClick="@(() => Anular(d))" title="Anular" />
                    }
                    @if (!ReadOnly && d.COD_ESTADO_DOCUMENTO == "BOR" && d.NUM_SECUENCIA_COMPROMISO is null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" OnClick="@(() => Eliminar(d))" title="Eliminar el borrador" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Todavía no hay documentos. Usa «Nuevo desde plantilla».</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="DocumentoEmitido" /></PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    [Parameter] public int NumProyecto { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<DocumentoEmitido> _items = new();
    private List<ComboboxItem> _plantillas = new(), _entidades = new(), _tipos = new();
    private List<ExpedienteFase> _fases = new();

    protected override async Task OnInitializedAsync()
    {
        _plantillas = await Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Proyectos.Expediente + "/documentos-emitidos/plantillas") ?? new();
        _entidades = await Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Estandar.EntidadesCombobox) ?? new();
        _tipos = await Http.SafeGetAsync<List<ComboboxItem>>($"{ApiRoutes.Proyectos.Expediente}/compromisos-tipos") ?? new();
        await CargarAsync();
    }

    public async Task CargarAsync()
    {
        try
        {
            _items = await Http.SafeGetAsync<List<DocumentoEmitido>>(ApiRoutes.Proyectos.Exp(NumProyecto, "documentos-emitidos")) ?? new();
            var plan = await Http.SafeGetAsync<ExpedientePlanificacion>(ApiRoutes.Proyectos.Exp(NumProyecto, "planificacion")) ?? new();
            _fases = plan.Fases;
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(ProyectoDocumentosEmitidos), nameof(CargarAsync)); Snackbar.Add("No se pudo cargar los documentos. Ver detalle en el log de errores.", Severity.Error); }
    }

    private static Color ColorEstado(string? e) => e switch { "EMI" => Color.Success, "APR" => Color.Success, "OBS" => Color.Warning, "ENV" => Color.Info, "ANU" => Color.Error, _ => Color.Default };
    private static string TextoCompromiso(string? e) => e switch { "APR" => "aprobado", "REC" => "rechazado", "OBS" => "observado", _ => "pendiente" };

    private static readonly DialogOptions Opc = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };

    private async Task Refrescar() { await CargarAsync(); await OnCambio.InvokeAsync(); }

    private async Task Nuevo(string codPlantilla)
    {
        var (ok, msg, sec) = await PostConDatoAsync(ApiRoutes.Proyectos.Exp(NumProyecto, "documentos-emitidos"), new { CodPlantilla = codPlantilla });
        if (!ok) { Snackbar.Add(msg ?? "No se pudo crear el documento.", Severity.Warning); return; }
        await CargarAsync();
        var d = _items.FirstOrDefault(x => x.NUM_SECUENCIA == sec);
        if (d is not null) await Editar(d);
    }

    /// <summary>POST que devuelve un entero (la secuencia creada).</summary>
    private async Task<(bool Ok, string? Msg, int Dato)> PostConDatoAsync(string url, object? cuerpo)
    {
        using var resp = await Http.PostAsJsonAsync(url, cuerpo ?? new { });
        try
        {
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<int>>();
            if (resp.IsSuccessStatusCode) return (true, r?.Message, r?.Data ?? 0);
            return (false, string.IsNullOrWhiteSpace(r?.Message) ? $"La operación no se pudo completar (HTTP {(int)resp.StatusCode})." : r!.Message, 0);
        }
        catch { return (resp.IsSuccessStatusCode, resp.IsSuccessStatusCode ? null : $"La operación no se pudo completar (HTTP {(int)resp.StatusCode}).", 0); }
    }

    private async Task Editar(DocumentoEmitido d)
    {
        var dlg = await DialogService.ShowAsync<ProyectoDocumentoEmitidoDialog>($"Editar · {d.DES_TITULO}",
            new DialogParameters { ["NumProyecto"] = NumProyecto, ["Item"] = d, ["Fases"] = _fases }, Opc);
        if ((await dlg.Result) is { Canceled: false }) await Refrescar();
        else await CargarAsync();
    }

    private async Task Enviar(DocumentoEmitido d)
    {
        var dlg = await DialogService.ShowAsync<ProyectoDocumentoEnviarDialog>($"Enviar a aprobar · {d.DES_TITULO}",
            new DialogParameters { ["NumProyecto"] = NumProyecto, ["Item"] = d, ["Entidades"] = _entidades, ["Tipos"] = _tipos }, Opc);
        if ((await dlg.Result) is { Canceled: false }) { Snackbar.Add("Documento enviado a aprobar: los aprobadores lo ven en la pestaña Compromisos.", Severity.Success); await Refrescar(); }
    }

    private async Task Emitir(DocumentoEmitido d)
    {
        var ok = await DialogService.ShowMessageBox("Emitir documento", $"¿Emitir «{d.DES_TITULO}» v{d.NUM_VERSION}? Se genera el PDF con los datos de hoy y el documento ya no se podrá modificar (para cambiarlo se crea una nueva versión).", yesText: "Emitir", cancelText: "Cancelar");
        if (ok != true) return;
        var (exito, msg) = await ProyectoApi.PostAsync(Http, ApiRoutes.Proyectos.Exp(NumProyecto, $"documentos-emitidos/{d.NUM_SECUENCIA}/emitir"), new { });
        if (!exito) { Snackbar.Add(msg ?? "No se pudo emitir el documento.", Severity.Warning); return; }
        Snackbar.Add("Documento emitido.", Severity.Success);
        await Refrescar();
    }

    private async Task NuevaVersion(DocumentoEmitido d)
    {
        var (ok, msg, sec) = await PostConDatoAsync(ApiRoutes.Proyectos.Exp(NumProyecto, $"documentos-emitidos/{d.NUM_SECUENCIA}/nueva-version"), null);
        if (!ok) { Snackbar.Add(msg ?? "No se pudo crear la nueva versión.", Severity.Warning); return; }
        await Refrescar();
        var n = _items.FirstOrDefault(x => x.NUM_SECUENCIA == sec);
        if (n is not null) await Editar(n);
    }

    private async Task Anular(DocumentoEmitido d)
    {
        var dlg = await DialogService.ShowAsync<ProyectoMotivoDialog>($"Anular · {d.DES_TITULO}", new DialogParameters { ["Titulo"] = "Motivo de la anulación", ["Obligatorio"] = true });
        var r = await dlg.Result;
        if (r is null || r.Canceled || r.Data is not string motivo || string.IsNullOrWhiteSpace(motivo)) return;
        var (exito, msg) = await ProyectoApi.PostAsync(Http, ApiRoutes.Proyectos.Exp(NumProyecto, $"documentos-emitidos/{d.NUM_SECUENCIA}/anular"), new { Motivo = motivo });
        if (!exito) { Snackbar.Add(msg ?? "No se pudo anular el documento.", Severity.Warning); return; }
        await Refrescar();
    }

    private async Task Eliminar(DocumentoEmitido d)
    {
        var ok = await DialogService.ShowMessageBox("Eliminar borrador", $"¿Eliminar el borrador «{d.DES_TITULO}»?", yesText: "Eliminar", cancelText: "Cancelar");
        if (ok != true) return;
        var (exito, msg) = await ProyectoApi.DeleteAsync(Http, ApiRoutes.Proyectos.Exp(NumProyecto, $"documentos-emitidos/{d.NUM_SECUENCIA}"));
        if (!exito) { Snackbar.Add(msg ?? "No se pudo eliminar el borrador.", Severity.Warning); return; }
        await Refrescar();
    }

    private async Task VerPdf(DocumentoEmitido d)
    {
        try
        {
            using var resp = await Http.GetAsync(ApiRoutes.Proyectos.Exp(NumProyecto, $"documentos-emitidos/{d.NUM_SECUENCIA}/pdf"));
            if (!resp.IsSuccessStatusCode)
            {
                string? msg = null;
                try { msg = (await resp.Content.ReadFromJsonAsync<ApiResponse<JsonElement>>())?.Message; } catch { /* el cuerpo no era una respuesta de la API */ }
                Snackbar.Add(string.IsNullOrWhiteSpace(msg) ? "No se pudo generar el PDF." : msg, Severity.Warning);
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var url = await JS.InvokeAsync<string>("blobViewer.crear", bytes, "application/pdf");
            await DialogService.ShowAsync<ProyectoPdfDialog>($"{d.DES_TITULO} v{d.NUM_VERSION}" + (d.COD_ESTADO_DOCUMENTO == "EMI" ? "" : " · vista previa"),
                new DialogParameters { ["Url"] = url }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true });
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(ProyectoDocumentosEmitidos), nameof(VerPdf)); Snackbar.Add("No se pudo abrir el PDF. Ver detalle en el log de errores.", Severity.Error); }
    }
}
