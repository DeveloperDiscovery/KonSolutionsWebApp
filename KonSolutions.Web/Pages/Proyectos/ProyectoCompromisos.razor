@using KONSolutions.Shared.Models.Proyectos
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IJSRuntime JS
@inject ConfigService ConfigSvc

@* Documentos de compromiso y aceptación del proyecto: cada uno es de un tipo (catálogo), se asocia a una fase y a una etapa (tarea), lleva su archivo,
   uno o más responsables y uno o más aprobadores. Los aprobadores aprueban, observan o rechazan: el documento queda Aprobado cuando todos aprueban;
   cualquier rechazo lo deja Rechazado y, si no, cualquier observación lo deja Observado. *@
<div class="d-flex align-center gap-2 flex-wrap mb-2">
    @if (!ReadOnly) { <MudButton OnClick="@(() => Editar(null))" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Gavel">Nuevo documento</MudButton> }
    <MudSpacer />
    <MudText Class="mono" Style="opacity:.6;font-size:.82rem;">@_items.Count documentos · @_items.Count(x => x.COD_ESTADO_COMPROMISO == "APR") aprobados · @_items.Count(x => x.COD_ESTADO_COMPROMISO == "PEN") pendientes</MudText>
    <GridRefreshButton OnRefresh="CargarAsync" />
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <MudDataGrid T="ExpedienteCompromiso" Items="_items" Dense="true" Hover="true" Striped="true" FixedHeader="true" SortMode="SortMode.Multiple" Filterable="true" FilterMode="DataGridFilterMode.ColumnFilterMenu" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Estado" SortBy="x => x.COD_ESTADO_COMPROMISO" Filterable="false" HeaderStyle="width:120px;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ColorEstado(context.Item.COD_ESTADO_COMPROMISO)">@context.Item.DES_ESTADO_COMPROMISO</MudChip>
                    @if (context.Item.NUM_APROBADORES > 0) { <div class="mono" style="font-size:.7rem;opacity:.7;">@context.Item.NUM_APROBADOS de @context.Item.NUM_APROBADORES aprueban</div> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tipo" SortBy="x => x.DES_TIPO_DOCUMENTO_COMPROMISO">
                <CellTemplate>@context.Item.DES_TIPO_DOCUMENTO_COMPROMISO <span class="mono" style="opacity:.6;font-size:.72rem;">(@(context.Item.COD_CLASE_COMPROMISO == "A" ? "aceptación" : "compromiso"))</span>
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_DOCUMENTO)) { <div style="font-size:.78rem;opacity:.8;">@context.Item.DES_DOCUMENTO</div> }</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Fase / etapa" SortBy="x => x.DES_FASE"><CellTemplate>@(context.Item.DES_FASE ?? "—")@if (context.Item.DES_TAREA != null) { <div style="font-size:.78rem;opacity:.8;">@context.Item.DES_TAREA</div> }</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Archivo" Sortable="false" Filterable="false">
                <CellTemplate>@if (context.Item.NUM_SECUENCIA_ARCHIVO is not null) { <MudLink Typo="Typo.body2" OnClick="@(() => Descargar(context.Item))"><MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /> @NombreArchivo(context.Item)</MudLink> } else { <span style="opacity:.4;">sin archivo</span> }</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Responsables" Sortable="false" Filterable="false"><CellTemplate>@Lista(context.Item.RESPONSABLES)</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Aprobadores" Sortable="false" Filterable="false"><CellTemplate>@Lista(context.Item.APROBADORES)</CellTemplate></TemplateColumn>
            <TemplateColumn Title="Registró" SortBy="x => x.FEC_REGISTRO" Filterable="false"><CellTemplate><span class="mono" style="font-size:.76rem;">@context.Item.FEC_REGISTRO?.ToString("dd/MM/yyyy HH:mm")<br />@context.Item.COD_USUARIO_REGISTRO</span></CellTemplate></TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.HowToReg" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Decidir(context.Item))" title="Aprobar, observar o rechazar · historial" />
                    @if (!ReadOnly && context.Item.COD_ESTADO_COMPROMISO != "APR")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Editar(context.Item))" title="Editar" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" OnClick="@(() => Quitar(context.Item))" title="Quitar" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Todavía no hay documentos de compromiso o aceptación.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="ExpedienteCompromiso" /></PagerContent>
    </MudDataGrid>
</MudPaper>

@code {
    [Parameter] public int NumProyecto { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback OnCambio { get; set; }

    private List<ExpedienteCompromiso> _items = new();
    private ExpedientePlanificacion _plan = new();
    private List<ComboboxItem> _entidades = new(), _tipos = new();

    protected override async Task OnInitializedAsync()
    {
        _entidades = await Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Estandar.EntidadesCombobox) ?? new();
        _tipos = await Http.SafeGetAsync<List<ComboboxItem>>($"{ApiRoutes.Proyectos.Expediente}/compromisos-tipos") ?? new();
        await CargarAsync();
    }

    public async Task CargarAsync()
    {
        try
        {
            _items = await Http.SafeGetAsync<List<ExpedienteCompromiso>>(ApiRoutes.Proyectos.Exp(NumProyecto, "compromisos")) ?? new();
            _plan = await Http.SafeGetAsync<ExpedientePlanificacion>(ApiRoutes.Proyectos.Exp(NumProyecto, "planificacion")) ?? new();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(ProyectoCompromisos), nameof(CargarAsync)); Snackbar.Add("No se pudo cargar los documentos. Ver detalle en el log de errores.", Severity.Error); }
    }

    private static Color ColorEstado(string? e) => e switch { "APR" => Color.Success, "REC" => Color.Error, "OBS" => Color.Warning, _ => Color.Default };

    private static RenderFragment Lista(string? s) => b =>
    {
        foreach (var n in (s ?? "").Split('|', StringSplitOptions.RemoveEmptyEntries)) { b.OpenElement(0, "div"); b.AddAttribute(1, "style", "font-size:.78rem;"); b.AddContent(2, n); b.CloseElement(); }
    };

    private static string NombreArchivo(ExpedienteCompromiso c)
    {
        var n = System.IO.Path.GetFileName((c.DES_PATH_FILE ?? "").Replace('\\', '/'));
        return n.Length > 33 && n[32] == '_' ? n[33..] : n;
    }

    private static readonly DialogOptions Opc = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };

    private async Task Editar(ExpedienteCompromiso? c)
    {
        var dlg = await DialogService.ShowAsync<ProyectoCompromisoDialog>(c is null ? "Nuevo documento de compromiso / aceptación" : "Editar documento",
            new DialogParameters { ["NumProyecto"] = NumProyecto, ["Item"] = c, ["Fases"] = _plan.Fases, ["Tareas"] = _plan.Tareas, ["Entidades"] = _entidades, ["Tipos"] = _tipos }, Opc);
        if ((await dlg.Result) is { Canceled: false }) { await CargarAsync(); await OnCambio.InvokeAsync(); }
    }

    private async Task Decidir(ExpedienteCompromiso c)
    {
        var dlg = await DialogService.ShowAsync<ProyectoCompromisoDecisionDialog>($"{c.DES_TIPO_DOCUMENTO_COMPROMISO} · aprobación",
            new DialogParameters { ["NumProyecto"] = NumProyecto, ["Item"] = c, ["ReadOnly"] = ReadOnly }, Opc);
        if ((await dlg.Result) is { Canceled: false }) { await CargarAsync(); await OnCambio.InvokeAsync(); }
    }

    private async Task Quitar(ExpedienteCompromiso c)
    {
        var ok = await DialogService.ShowMessageBox("Quitar documento", $"¿Quitar «{c.DES_TIPO_DOCUMENTO_COMPROMISO}» del proyecto? El archivo queda en Documentos.", yesText: "Quitar", cancelText: "Cancelar");
        if (ok != true) return;
        var (exito, msg) = await ProyectoApi.DeleteAsync(Http, ApiRoutes.Proyectos.Exp(NumProyecto, $"compromisos/{c.NUM_SECUENCIA}"));
        if (!exito) { Snackbar.Add(msg ?? "No se pudo quitar el documento.", Severity.Warning); return; }
        await CargarAsync(); await OnCambio.InvokeAsync();
    }

    private async Task Descargar(ExpedienteCompromiso c)
    {
        if (c.NUM_SECUENCIA_ARCHIVO is not { } sec) return;
        try
        {
            var resp = await Http.GetAsync(ApiRoutes.Proyectos.Exp(NumProyecto, $"archivos/{sec}"));
            if (!resp.IsSuccessStatusCode) { Snackbar.Add("El archivo no está en el servidor.", Severity.Warning); return; }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("blobViewer.descargar", bytes, NombreArchivo(c), resp.Content.Headers.ContentType?.MediaType ?? "application/octet-stream");
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(ProyectoCompromisos), nameof(Descargar)); Snackbar.Add("No se pudo descargar. Ver detalle en el log de errores.", Severity.Error); }
    }
}
