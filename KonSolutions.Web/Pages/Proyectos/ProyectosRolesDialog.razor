@using Modelo = KONSolutions.Shared.Models.Proyectos.ProyectosRol
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_ROL_TAREA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit" OnInvalidSubmit="OnInvalidSubmit">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <CampoTexto Tabla="PROYECTOS.PROYECTOS_ROLES" Columna="COD_ROL_TAREA"
                                @bind-Value="_model.COD_ROL_TAREA" Disabled="@(!_esNuevo || _readonly)" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <CampoTexto Tabla="PROYECTOS.PROYECTOS_ROLES" Columna="DES_ROL_TAREA"
                                @bind-Value="_model.DES_ROL_TAREA" Disabled="_readonly" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <AriaCombo TItem="ComboboxItem" Items="_categorias" TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                               Value="@_model.COD_CATEGORIA_ROL" ValueChanged="@(v => _model.COD_CATEGORIA_ROL = string.IsNullOrWhiteSpace(v) ? null : v)"
                               Label="Categoría" Disabled="_readonly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <AriaCombo TItem="ComboboxItem" Items="_padres" TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                               Value="@_model.COD_ROL_PADRE" ValueChanged="@(v => _model.COD_ROL_PADRE = string.IsNullOrWhiteSpace(v) ? null : v)"
                               Label="Rol padre (jerarquía)" Disabled="_readonly" />
                </MudItem>
            </MudGrid>

            <CrudDialogActions Modo="Modo" Saving="_saving" OnCancel="@(() => MudDialog.Cancel())" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Modelo? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }

    private Modelo _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private List<ComboboxItem> _categorias = new(), _padres = new();

    protected override async Task OnInitializedAsync()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) _model = Item;
        try
        {
            _categorias = await Http.SafeGetAsync<List<ComboboxItem>>($"{ApiRoutes.Proyectos.Roles}/categorias/combobox") ?? new();
            // el rol padre puede ser cualquier otro rol (el SP rechaza ciclos)
            _padres = (await Http.SafeGetAsync<List<ComboboxItem>>($"{ApiRoutes.Proyectos.Roles}/combobox") ?? new()).Where(r => r.Id != _model.COD_ROL_TAREA).ToList();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(ProyectosRolesDialog), nameof(OnInitializedAsync)); }
    }

    private async Task OnInvalidSubmit(EditContext ctx)
    {
        var errores = string.Join(" · ", ctx.GetValidationMessages());
        await DialogService.ShowAsync<KONSolutions.Web.Pages.Shared.ErrorSqlDialog>("",
            new DialogParameters
            {
                ["Titulo"]  = "Faltan datos obligatorios",
                ["Mensaje"] = string.IsNullOrWhiteSpace(errores) ? "Hay campos obligatorios sin completar." : errores
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = ApiRoutes.Proyectos.Roles;

        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{Uri.EscapeDataString(_model.COD_ROL_TAREA)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(ProyectosRolesDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }

        var resp = await Http.GuardarAsync(ruta, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ProyectosRolesDialog), nameof(Submit));
    }
}
