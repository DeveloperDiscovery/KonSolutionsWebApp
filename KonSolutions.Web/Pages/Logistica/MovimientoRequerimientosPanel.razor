    protected override async Task OnParametersSetAsync()
    {
        if (NumMovimiento == _cargadoPara) return;
        _cargadoPara = NumMovimiento;

        // Primero se busca lo que este panel tenía en pantalla la última vez. Si está, se
        // restaura y NO se consulta: volver de otra pestaña no es motivo para pedir de nuevo
        // cuatro consultas, y además volver a consultar borraría lo que el usuario escribió.
        if (Restaurar()) { StateHasChanged(); return; }

        await CargarAsync();
    }

    /// <summary>Refresco EXPLÍCITO. Desde que las pestañas se mantienen vivas al cambiar de
    /// solapa, esto ya no se recarga solo: lo que el usuario marcó se queda como estaba, y
    /// volver a consultar es una decisión suya. Vuelve a traer las cuatro grillas y limpia
    /// las selecciones, porque una selección sobre datos viejos es peor que ninguna.</summary>
    public async Task RefrescarAsync()
    {
        // Olvida lo guardado ANTES de consultar. Si no, CargarAsync volvería a dejar el
        // estado viejo encima al terminar y el refresco no refrescaría nada.
        EstadoPaneles.Olvidar(ClavePanel, NumMovimiento);
        await CargarAsync();
    }

    // ── Estado que sobrevive a que el componente se destruya ─────────────────────────
    //
    // Blazor recrea este componente al cambiar de pestaña, porque no todas las MudTabs de la
    // cadena conservan sus paneles. Cuando eso pasa, el componente nuevo arranca vacío: se
    // perdían las órdenes marcadas, las líneas marcadas, las cantidades escritas a mano, el
    // lote y la ubicación elegidos. Todo eso vive ahora en EstadoPanelesMovimiento.

    private const string ClavePanel = "requerimientos";

    /// <summary>Trae de vuelta lo que había. Devuelve false si no había nada guardado, que es
    /// la señal de que hay que consultar.</summary>
    private bool Restaurar()
    {
        _dibujosDeGracia = 3;
        var e = EstadoPaneles.Leer<Cabecera, Linea>(ClavePanel, NumMovimiento);
        if (e is null) { _dibujosDeGracia = 0; return false; }

        // Un estado VACÍO no se restaura: se vuelve a consultar. El estado existe para no
        // perder el trabajo del usuario; si no hay nada cargado ni marcado, no hay trabajo
        // que preservar, y restaurarlo igual TAPA los datos que aparecieron después.
        var vacio = e.Disponibles.Count == 0
                 && e.Asignados.Count == 0
                 && e.DetalleDisponibles.Count == 0
                 && e.DetalleAsignados.Count == 0
                 && !e.HayCambiosSinGrabar;
        if (vacio) { _dibujosDeGracia = 0; return false; }

        // Se recuperan LAS MISMAS instancias, no copias: por eso lo que el usuario escribió
        // en una celda vuelve tal cual, sin guardarlo campo por campo.
        _disponibles           = e.Disponibles;
        _asignados             = e.Asignados;
        _detalleDisponibles    = e.DetalleDisponibles;
        _detalleAsignados      = e.DetalleAsignados;
        _selDisponibles        = e.SelDisponibles;
        _selDetalleDisponibles = e.SelDetalleDisponibles;
        _selDetalleAsignados   = e.SelDetalleAsignados;
        _hayCambiosSinGrabar   = e.HayCambiosSinGrabar;
        _motivoDetalleVacio    = e.MotivoDetalleVacio;
        return true;
    }

    /// <summary>Deja el estado afuera. Se llama después de CADA cosa que lo cambia: si se
    /// llamara sólo al destruirse el componente, un cierre abrupto se llevaría lo último.</summary>
    private void Recordar()
        => EstadoPaneles.Guardar(ClavePanel, NumMovimiento,
            new EstadoPanelesMovimiento.Estado<Cabecera, Linea>
            {
                Disponibles           = _disponibles,
                Asignados             = _asignados,
                DetalleDisponibles    = _detalleDisponibles,
                DetalleAsignados      = _detalleAsignados,
                SelDisponibles        = _selDisponibles,
                SelDetalleDisponibles = _selDetalleDisponibles,
                SelDetalleAsignados   = _selDetalleAsignados,
                HayCambiosSinGrabar   = _hayCambiosSinGrabar,
                MotivoDetalleVacio    = _motivoDetalleVacio
            });

    private async Task CargarAsync()
    {
        _hayCambiosSinGrabar = false;
        _selDisponibles = new();
        _selDetalleDisponibles = new();
        _selDetalleAsignados = new();
        _detalleDisponibles = new();

        // Los disponibles NO dependen del movimiento, así que se piden siempre —incluso con
        // la cabecera sin grabar—. Los asignados sí, y sin número no hay nada que pedir.
        var tDisp = Http.SafeGetAsync<List<Cabecera>>(ApiRoutes.Logistica.MovimientosAlmacenRequerimientosDisponibles);

        if (NumMovimiento is null or 0)
        {
            _disponibles = await tDisp ?? new();
            _asignados = new();
            _detalleAsignados = new();
            StateHasChanged();
            return;
        }

        var tAsig = Http.SafeGetAsync<List<Cabecera>>(ApiRoutes.Logistica.MovimientosAlmacenRequerimientosAsignados(NumMovimiento.Value));
        var tAsigDet = Http.SafeGetAsync<List<Linea>>(ApiRoutes.Logistica.MovimientosAlmacenRequerimientosAsignadosDetalle(NumMovimiento.Value));
        await Task.WhenAll(tDisp, tAsig, tAsigDet);

        _disponibles = (await tDisp) ?? new();
        _asignados = (await tAsig) ?? new();
        _detalleAsignados = (await tAsigDet) ?? new();
        Recordar();
        StateHasChanged();
    }

    /// <summary>Verdadero desde que se restaura el estado hasta que la pantalla terminó de
    /// dibujarse.
    ///
    /// MudDataGrid arranca con su selección vacía y AVISA de esa selección vacía apenas se
    /// dibuja. Como el aviso llega DESPUÉS de restaurar, pisaba lo restaurado con un conjunto
    /// vacío: el usuario veía volver las filas pero sin sus marcas.
    ///
    /// Mientras esta bandera está levantada, los tres manejadores ignoran lo que la grilla
    /// diga. El usuario todavía no tocó nada; cualquier aviso en ese momento es de la grilla
    /// acomodándose, no una decisión suya.</summary>
    private bool _restaurando => _dibujosDeGracia > 0;

    /// <summary>Cuántos dibujados más se ignora a la grilla. Tres y no uno: el aviso de la
    /// grilla no llega necesariamente en el primer dibujado —es asincrónico— y con uno solo
    /// la protección se caía justo a veces, que es la peor forma de fallar.
    ///
    /// Tres dibujados son milisegundos: nadie alcanza a hacer clic en ese lapso, así que no
    /// se está descartando ninguna decisión real del usuario.</summary>
    private int _dibujosDeGracia;

    /// <summary>Descuenta un dibujado de gracia y vuelve a pedir uno. Cuando se agotan, lo
    /// que la grilla avise ya es del usuario.</summary>
    protected override void OnAfterRender(bool primeraVez)
    {
        if (_dibujosDeGracia <= 0) return;
        _dibujosDeGracia--;
        // Se vuelve a dibujar para que las marcas restauradas se vean: la grilla acaba de
        // acomodar su estado interno y hay que devolverle el bueno.
        StateHasChanged();
    }

    private void OnSeleccionDetalleDisponiblesChanged(HashSet<Linea> sel)
    {
        if (_restaurando) return;
        _selDetalleDisponibles = sel ?? new();
        Recordar();
    }

    private void OnSeleccionDetalleAsignadosChanged(HashSet<Linea> sel)
    {
        if (_restaurando) return;
        _selDetalleAsignados = sel ?? new();
        Recordar();
    }

    private async Task OnSeleccionDisponiblesChanged(HashSet<Cabecera> sel)
    {
        if (_restaurando) return;
        _selDisponibles = sel ?? new();
        await CargarDetalleDisponiblesAsync();
        Recordar();
    }

    private async Task OnCriterioChanged(string valor)
    {
        _criterio = valor;
        await CargarDetalleDisponiblesAsync();
    }

    /// <summary>Una consulta por requerimiento marcado: el SP recibe uno solo, y desde que
    /// recibe también el MOVIMIENTO deja escrita en la base la selección de stock de ese par
    /// movimiento + requerimiento (por eso es un POST). Van en paralelo, así que marcar
    /// cinco cuesta lo que el más lento y no la suma; no se pisan porque cada llamada toca
    /// filas de un requerimiento distinto.
    ///
    /// Sin movimiento grabado no hay contra qué calcular: los disponibles de la grilla de
    /// arriba se ven igual, pero su detalle espera a que exista la cabecera.</summary>
    private async Task CargarDetalleDisponiblesAsync()
    {
        _selDetalleDisponibles = new();

        if (!_selDisponibles.Any())
        {
            _detalleDisponibles = new();
            _motivoDetalleVacio = "Marca uno o más requerimientos de arriba para ver sus líneas.";
            StateHasChanged();
            return;
        }

        if (NumMovimiento is null or 0)
        {
            _detalleDisponibles = new();
            _motivoDetalleVacio = "Graba la cabecera del movimiento para ver el detalle: " +
                                  "la cobertura se calcula contra el movimiento.";
            StateHasChanged();
            return;
        }

        var numMovimiento = (int)NumMovimiento.Value;
        var tareas = _selDisponibles.Select(r => PedirCoberturaAsync(numMovimiento, r.NUM_REQUERIMIENTO_STOCK));

        var resultados = await Task.WhenAll(tareas);

        // null es "falló la llamada", no "no hay datos": se separan, porque se arreglan en
        // lugares distintos.
        if (resultados.All(r => r is null))
        {
            _detalleDisponibles = new();
            _motivoDetalleVacio = "No se pudo leer el detalle de los requerimientos marcados. " +
                                  "Mira la consola del navegador: la llamada falló.";
            StateHasChanged();
            return;
        }

        _detalleDisponibles = resultados.Where(r => r is not null).SelectMany(r => r!).ToList();
        _motivoDetalleVacio = "Los requerimientos marcados no tienen líneas pendientes.";
        StateHasChanged();
    }

    /// <summary>Pide la cobertura de UN requerimiento y la deja con la forma de la grilla.
    /// Devuelve null si la llamada falló.</summary>
    private async Task<List<Linea>?> PedirCoberturaAsync(int numMovimiento, int numRequerimiento)
    {
        try
        {
            var resp = await Http.PostAsync(
                ApiRoutes.Logistica.MovimientosAlmacenRequerimientosCobertura(numMovimiento, numRequerimiento, _criterio), null);
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<Cobertura>>();
            if (!resp.IsSuccessStatusCode || r is not { Success: true, Data: not null }) return null;
            return LineasDeCobertura(r.Data);
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(MovimientoRequerimientosPanel), nameof(PedirCoberturaAsync),
                $"mov={numMovimiento}, req={numRequerimiento}, criterio={_criterio}");
            return null;
        }
    }

    /// <summary>Convierte los dos resultados del SP a UNA fila por línea del requerimiento, con
    /// su stock colgado: es lo que dibuja la grilla y su detalle incrustado.
    ///
    /// La cantidad requerida es la que el SP trata como pendiente; A atender es lo que logró
    /// cubrir y Pendiente lo que queda sin cubrir. Al asignar se envía A atender.</summary>
    private static List<Linea> LineasDeCobertura(Cobertura r)
    {
        var stock = r.Stock.ToLookup(s => s.NUM_SECUENCIA);
        return r.Lineas.OrderBy(l => l.NUM_SECUENCIA).Select(l => new Linea
        {
            NUM_REQUERIMIENTO_STOCK      = l.NUM_REQUERIMIENTO_STOCK,
            NUM_SECUENCIA                = l.NUM_SECUENCIA,
            COD_ALMACEN                  = l.COD_ALMACEN,
            DES_ALMACEN                  = l.DES_ALMACEN,
            COD_PRODUCTO                 = l.COD_PRODUCTO,
            DES_PRODUCTO                 = l.DES_PRODUCTO,
            COD_UNIDAD_MEDIDA            = l.COD_UNIDAD_MEDIDA,
            DES_UNIDAD_MEDIDA            = l.DES_UNIDAD_MEDIDA,
            CAN_PRODUCTO                 = l.CAN_PRODUCTO,
            COD_UNIDAD_MEDIDA_SECUNDARIA = l.COD_UNIDAD_MEDIDA_SECUNDARIA,
            DES_UNIDAD_MEDIDA_SECUNDARIA = l.DES_UNIDAD_MEDIDA_SECUNDARIA,
            CAN_PRODUCTO_SECUNDARIA      = l.CAN_PRODUCTO_SECUNDARIA,
            CAN_ATENDER                  = l.CAN_ATENDER,
            CAN_PENDIENTE_ATENDER        = l.CAN_PENDIENTE_ATENDER,
            DES_COBERTURA                = l.DES_COBERTURA,
            Stock                        = stock[l.NUM_SECUENCIA].OrderBy(x => x.NUM_ORDEN_SECUENCIA).ToList()
        }).ToList();
    }

    /// <summary>Color de la cobertura. Las palabras las decide el SP; acá sólo se traducen a un
    /// color: COMPLETO verde, ASIGNADA azul, PARCIAL ámbar, POR REVISAR gris.</summary>
    private static Color ColorCobertura(string? cobertura) => (cobertura ?? "").Trim().ToUpperInvariant() switch
    {
        "COMPLETO" => Color.Success,
        "ASIGNADA" => Color.Info,
        "PARCIAL"  => Color.Warning,
        _          => Color.Default
    };

    /// <summary>Las marcadas que ADEMÁS tienen algo que atender. La cantidad que se asigna es
    /// la que el SP dejó en CAN_ATENDER.</summary>
    private List<Linea> _asignables
        => _selDetalleDisponibles.Where(x => (x.CAN_ATENDER ?? 0) > 0).ToList();

    /// <summary>Marcadas sin nada que atender (sin stock), para el aviso al lado del botón.</summary>
    private int _marcadasSinCantidad
        => _selDetalleDisponibles.Count(x => (x.CAN_ATENDER ?? 0) <= 0);

    /// <summary>El motivo exacto por el que el botón está apagado. Las dos condiciones se
    /// arreglan en lugares distintos y merecen mensajes distintos.</summary>
    private string TituloAsignar
        => !_selDetalleDisponibles.Any()
               ? "Marca las líneas que vas a despachar"
         : !_asignables.Any()
               ? "Las líneas marcadas no tienen stock que atender"
         : $"Asignar {_asignables.Count} línea(s) al movimiento";

    /// <summary>Evita el doble clic. Los dos botones graban, y dos llamadas simultáneas
    /// dejarían la misma línea asignada dos veces sin que nada lo avise.</summary>
    private bool _trabajando;

    /// <summary>Asigna al movimiento las líneas marcadas. GRABA contra la base.
    ///
    /// Antes esto sólo movía filas de una grilla a la otra en memoria: se veía como si
    /// hubiera funcionado y no había escrito nada.
    ///
    /// La cadena se arma con ListaPedidoSecuencia, LA MISMA clase que usa Órdenes de
    /// Compra. Un solo formato en toda la aplicación: tener dos es exactamente lo que
    /// rompió el DESASIGNA de comerciales.
    ///
    /// El SP asigna EL STOCK YA SELECCIONADO (LOGISTICA.MOVIMIENTOS_ALMACEN_REQUERIMIENTO_STOCK_
    /// DETALLE_SELECCIONADO), que la consulta de cobertura dejó escrito al marcar el requerimiento:
    /// una fila de stock, un detalle del movimiento. La cadena de líneas dice CUÁLES de esas
    /// líneas se asignan y con qué cantidad (la de "A atender"); si esa cantidad no coincide con
    /// lo seleccionado en la base, el SP rechaza. COD_CRITERIO sigue viajando por compatibilidad
    /// con la firma del SP, pero ya no decide nada: la ubicación sale de la selección.</summary>
    private async Task AsignarSeleccionadas()
    {
        if (MotivoSoloLectura is { } motivo) { Snackbar.Add(motivo, Severity.Warning); return; }
        // Sólo las que cumplen las DOS condiciones. Las marcadas sin cantidad se quedan
        // donde están, CON SU MARCA: el usuario acaba de decir que le interesan.
        var mover = _asignables;
        if (mover.Count == 0 || NumMovimiento is null or 0 || _trabajando) return;

        _trabajando = true;
        try
        {
            var lineas = ListaPedidoSecuencia.Armar(
                mover.Select(l => (l.NUM_REQUERIMIENTO_STOCK, l.NUM_SECUENCIA,
                                   l.CAN_ATENDER ?? 0m)));

            var resp = await Http.PostAsJsonAsync(
                ApiRoutes.Logistica.MovimientosAlmacenRequerimientosAsignar(NumMovimiento.Value),
                new { lineas, COD_CRITERIO = _criterio });

            if (!resp.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService,
                    nameof(MovimientoRequerimientosPanel), nameof(AsignarSeleccionadas),
                    "No se pudieron asignar las líneas al movimiento.");
                return;
            }

            Snackbar.Add($"{mover.Count} línea(s) asignadas al movimiento.", Severity.Success);

            // Se vuelve a consultar en vez de mover las filas a mano: el SP decide la
            // ubicación y la secuencia del movimiento, así que lo que quedó en la base no
            // es exactamente lo que había en la pantalla.
            EstadoPaneles.Olvidar(ClavePanel, NumMovimiento);
            await RefrescarAsync();
            // El detalle del movimiento cambió: que el documento lo vuelva a traer.
            await OnDetalleCambiado.InvokeAsync();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(MovimientoRequerimientosPanel), nameof(AsignarSeleccionadas));
            await ErrorDialogHelper.MostrarAvisoAsync(ex.Message, DialogService, nameof(MovimientoRequerimientosPanel));
        }
        finally
        {
            _trabajando = false;
        }
    }

    /// <summary>Quita del movimiento las líneas marcadas a la derecha. También GRABA.
    ///
    /// La cadena lleva cantidad cero y una sola vez cada línea: DESASIGNA no la usa —revierte
    /// TODO lo que se despachó para esa línea en este movimiento (una fila de stock = un
    /// detalle), que lo lee del detalle del movimiento—, pero el formato se mantiene igual que
    /// en asignar a propósito.</summary>
    private async Task QuitarSeleccionadas()
    {
        if (MotivoSoloLectura is { } motivo) { Snackbar.Add(motivo, Severity.Warning); return; }
        var mover = _selDetalleAsignados.ToList();
        if (mover.Count == 0 || NumMovimiento is null or 0 || _trabajando) return;

        _trabajando = true;
        try
        {
            var lineas = ListaPedidoSecuencia.Armar(
                mover.Select(l => (l.NUM_REQUERIMIENTO_STOCK, l.NUM_SECUENCIA, 0m))
                     .Distinct());

            var resp = await Http.PostAsJsonAsync(
                ApiRoutes.Logistica.MovimientosAlmacenRequerimientosQuitar(NumMovimiento.Value),
                new { lineas });

            if (!resp.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService,
                    nameof(MovimientoRequerimientosPanel), nameof(QuitarSeleccionadas),
                    "No se pudieron quitar las líneas del movimiento.");
                return;
            }

            Snackbar.Add($"{mover.Count} línea(s) quitadas del movimiento.", Severity.Success);
            EstadoPaneles.Olvidar(ClavePanel, NumMovimiento);
            await RefrescarAsync();
            await OnDetalleCambiado.InvokeAsync();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(MovimientoRequerimientosPanel), nameof(QuitarSeleccionadas));
            await ErrorDialogHelper.MostrarAvisoAsync(ex.Message, DialogService, nameof(MovimientoRequerimientosPanel));
        }
        finally
        {
            _trabajando = false;
        }
    }
}
