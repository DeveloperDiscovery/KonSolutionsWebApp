@* Barra de lectura de etiquetas (código de barras / RFID) de un movimiento de almacén.

   Se escanea (o se digita) la etiqueta y Enter: cada lectura es un POST a movimientos-almacen-detalle/lecturas
   y el SP decide qué hace con ella. Mismo patrón que el conteo de Inventarios: el lector "teclea" la etiqueta
   y manda Enter.

   Dos modos, según la línea:
     Automática (sin elegir línea) — el SP ubica la línea por producto + lote + ubicación y, si no hay, la crea.
                    Solo cuando el tipo de movimiento admite cargar líneas a mano.
     Línea elegida — la etiqueta se ASIGNA a esa línea. Es el único modo en las líneas que vienen de otro
                    documento (orden de compra, requerimiento, reserva, ingreso de una transferencia): ahí la
                    lectura no cambia la cantidad ni el stock, solo deja registrado qué etiquetas llegaron,
                    y el aviso de pendientes compara lo leído con lo pedido.

   Qué pasa cuando el SP rechaza una lectura (lo dice el número de error de la respuesta):
     50708          — el producto se mide (un rollo): se pide el peso y se reenvía la MISMA etiqueta.
     50706 / 50707  — la etiqueta ya ingresó / ya salió en otro movimiento: se pregunta y, si se acepta, se
                      reenvía con FLG_FORZAR.
     cualquier otro — se avisa en un aviso corto y la caja queda lista para la siguiente etiqueta. No se abre
                      un diálogo por cada rechazo: leyendo cien etiquetas seguidas sería insoportable.

   El panel no sabe nada del documento: la página le pasa las líneas y el tipo de movimiento, y se entera de
   cada lectura con OnLectura para recargar el detalle y los pendientes. *@
@using DetalleModel = KONSolutions.Shared.Models.Logistica.MovimientosAlmacenDetalle
@using KONSolutions.Shared.Models.Logistica
@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ErrorLogService ErrorLog
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudPaper Elevation="0" Class="pa-3 mt-3" Style="border:1px solid var(--line);">
    <div class="d-flex align-center gap-2 mb-2" style="flex-wrap:wrap;">
        <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Small" />
        <MudText Typo="Typo.subtitle2">Lectura de etiquetas</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(Requisito == "R" ? Color.Warning : Color.Default)" Variant="Variant.Outlined">
            @(Requisito == "R" ? "Obligatoria" : "Optativa")
        </MudChip>
        @if (!PuedeAutomatico)
        {
            <MudText Typo="Typo.caption" Style="opacity:.7;">
                Las líneas de este movimiento vienen de otro documento: elige la línea y lee sus etiquetas.
            </MudText>
        }
        <MudButton Variant="Variant.Text" Size="Size.Small" Style="margin-left:auto;text-transform:none;"
                   StartIcon="@(_logOculto ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                   OnClick="AlternarLogAsync" data-lectura="log-alternar">
            @(_logOculto ? (_historial.Count > 0 ? $"Mostrar log ({_historial.Count})" : "Mostrar log") : "Ocultar log")
        </MudButton>
    </div>

    <MudGrid Class="align-end" Spacing="2">
        <MudItem xs="12" sm="@(EnModoAutomatico ? 4 : 12)">
            <AriaCombo TItem="ComboboxItem" Items="_itemsLinea"
                       TextFunc="@(l => l.Texto)" ValueFunc="@(l => l.Id)"
                       Value="@(_linea?.ToString())" ValueChanged="OnLineaCambiada"
                       Label="@(PuedeAutomatico ? "Línea (vacío = automática: por producto, lote y ubicación)" : "Línea donde asignar la etiqueta")"
                       Obligatorio="@(!PuedeAutomatico)" Disabled="Disabled" Class="mb-1" />
        </MudItem>

        @if (EnModoAutomatico)
        {
            @* En modo automático la lectura necesita saber en qué ubicación cae: se lee la etiqueta de la
               ubicación o se elige. Con una línea elegida no hace falta: la ubicación es la de la línea. *@
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="_stickerUbicacion" Label="Etiqueta de ubicación" Variant="Variant.Outlined"
                              Immediate="true" Disabled="Disabled" Class="mb-1"
                              OnKeyDown="OnUbicacionKey" />
            </MudItem>
            <MudItem xs="12" sm="@(ConDestino ? 2 : 5)">
                <AriaCombo TItem="ComboboxItem" Items="_combos.Ubicaciones"
                           TextFunc="@(u => u.Texto)" ValueFunc="@(u => u.Id)"
                           Value="@_ubicacion" ValueChanged="OnUbicacionElegida"
                           Label="Ubicación" Disabled="Disabled" Class="mb-1" />
            </MudItem>
            @if (ConDestino)
            {
                <MudItem xs="12" sm="3">
                    <AriaCombo TItem="ComboboxItem" Items="_combos.UbicacionesDestino"
                               TextFunc="@(u => u.Texto)" ValueFunc="@(u => u.Id)"
                               @bind-Value="_ubicacionDestino"
                               Label="Ubicación destino" Disabled="Disabled" Class="mb-1" />
                </MudItem>
            }
        }

        <MudItem xs="12" sm="@(_esperaPeso ? 8 : 12)">
            <MudTextField T="string" @ref="_campoEtiqueta" @bind-Value="_etiqueta" Label="RFID / código de barras"
                          Variant="Variant.Outlined" Immediate="true" Disabled="Disabled" Class="mb-1"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCode"
                          OnKeyDown="OnEtiquetaKey" />
        </MudItem>

        @if (_esperaPeso)
        {
            @* 50708: el producto se mide. La etiqueta ya se leyó; falta su peso. *@
            <MudItem xs="12" sm="4">
                <div class="d-flex align-end gap-2">
                    <MudNumericField T="decimal?" @ref="_campoPeso" @bind-Value="_peso" Label="Peso / cantidad" Variant="Variant.Outlined"
                                     Immediate="true" Min="0" Class="mb-1" HideSpinButtons="true"
                                     OnKeyDown="OnPesoKey" />
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Medium" title="Leer con este peso"
                                   OnClick="ConfirmarPesoAsync" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Medium" title="Descartar esta etiqueta"
                                   OnClick="DescartarPesoAsync" />
                </div>
            </MudItem>
        }
    </MudGrid>

    @if (_esperaPeso)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1 mb-0">@_mensajePeso</MudAlert>
    }
    @if (_cola.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="mt-1" Style="opacity:.7;">@_cola.Count etiqueta(s) en cola…</MudText>
    }

    @if (_ultimo is { } u)
    {
        <div class="mt-2" style="display:flex;flex-direction:column;line-height:1.3;">
            <div>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="vertical-align:middle;" />
                <strong>@u.DES_PRODUCTO</strong>
                <span class="mono" style="font-size:.78rem;opacity:.65;"> @u.COD_PRODUCTO</span>
                <span style="opacity:.8;"> · @u.COD_TIPO_ETIQUETA · +@(u.CAN_LEIDA?.ToString("0.######")) @u.COD_UNIDAD_MEDIDA</span>
            </div>
            <div style="font-size:.82rem;opacity:.75;">
                Línea @u.NUM_SECUENCIA@(u.FLG_LINEA_NUEVA == true ? " (nueva)" : "")
                · @(string.IsNullOrWhiteSpace(u.NUM_LOTE_CONTROL) ? "sin lote" : $"lote {u.NUM_LOTE_CONTROL}")
                · ubicación @u.COD_UBICACION_ALMACEN
                @if (u.FLG_LINEA_CON_ORIGEN == true)
                {
                    <span> · etiquetado @(u.CAN_ETIQUETADA?.ToString("0.######")) de @(u.CAN_PRODUCTO_LINEA?.ToString("0.######")) @u.COD_UNIDAD_MEDIDA</span>
                }
                else
                {
                    <span> · la línea lleva @(u.CAN_PRODUCTO_LINEA?.ToString("0.######")) @u.COD_UNIDAD_MEDIDA</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(u.DES_ADVERTENCIA))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1 mb-0">@u.DES_ADVERTENCIA</MudAlert>
            }
        </div>
    }

    @if (_historial.Count > 0 && !_logOculto)
    {
        <div class="mt-2" style="font-size:.78rem;max-height:120px;overflow:auto;" data-lectura="log">
            @foreach (var h in _historial)
            {
                <div style="display:flex;gap:6px;align-items:baseline;">
                    <MudIcon Icon="@(h.Ok ? Icons.Material.Filled.Check : Icons.Material.Filled.ErrorOutline)"
                             Color="@(h.Ok ? Color.Success : Color.Error)" Size="Size.Small" Style="flex-shrink:0;position:relative;top:3px;" />
                    <span class="mono" style="opacity:.55;flex-shrink:0;">@h.Hora.ToString("HH:mm:ss")</span>
                    <span style="@(h.Ok ? "" : "color:var(--mud-palette-error);")">@h.Texto</span>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter] public decimal NumMovimiento { get; set; }
    /// <summary>O = optativa · R = obligatoria. Solo cambia el rótulo: lo que se exige al aceptar lo controla el SP.</summary>
    [Parameter] public string Requisito { get; set; } = "O";
    /// <summary>Las líneas del movimiento (las que se pueden elegir).</summary>
    [Parameter] public List<DetalleModel> Lineas { get; set; } = new();
    /// <summary>El tipo admite cargar líneas a mano, así que la lectura puede ubicar o crear la línea sola.</summary>
    [Parameter] public bool PuedeAutomatico { get; set; }
    /// <summary>Salida por transferencia que se replica en el ingreso destino: en modo automático hay que elegir la ubicación destino.</summary>
    [Parameter] public bool ConDestino { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Se dispara tras cada lectura registrada: la página recarga el detalle, las etiquetas y los pendientes.</summary>
    [Parameter] public EventCallback OnLectura { get; set; }

    private sealed record Registro(bool Ok, string Texto, DateTime Hora);

    /// <summary>Sin línea elegida y con tipo que admite líneas a mano: el SP ubica o crea la línea, y necesita la ubicación.</summary>
    private bool EnModoAutomatico => _linea is null && PuedeAutomatico;

    private MudTextField<string>? _campoEtiqueta;
    private MudNumericField<decimal?>? _campoPeso;
    private MovimientosAlmacenDetalleCombosLinea _combos = new();
    private List<ComboboxItem> _itemsLinea = new();
    private readonly List<Registro> _historial = new();
    private MovimientosAlmacenLecturaResultado? _ultimo;

    private int? _linea;
    private string? _etiqueta, _stickerUbicacion, _ubicacion, _ubicacionDestino;
    private decimal? _peso;
    private bool _procesando, _esperaPeso, _enfocarPeso, _enfocarEtiqueta;
    private string? _etiquetaPendiente, _mensajePeso;
    private bool _forzarPendiente;
    // Las etiquetas que llegan mientras otra se está enviando (o espera su peso) no se descartan: un lector RFID
    // puede leer varias por segundo y la recarga del detalle tarda. Se atienden en orden, de a una.
    private readonly Queue<string> _cola = new();

    // El log (el historial de lecturas con su hora) se puede ocultar. La elección es de este navegador y vale para todos los
    // paneles de lectura: si no se puede leer (modo privado, almacenamiento bloqueado), el log se muestra.
    private const string ClaveLogOculto = "lecturaLogOculto";
    private bool _logOculto;

    private async Task AlternarLogAsync()
    {
        _logOculto = !_logOculto;
        try { await LocalStorage.SetItemAsync(ClaveLogOculto, _logOculto); }
        catch { /* solo se pierde recordar la elección */ }
        _enfocarEtiqueta = true;   // el clic no le quita el foco al lector
    }

    protected override async Task OnInitializedAsync()
    {
        try { _logOculto = await LocalStorage.GetItemAsync<bool>(ClaveLogOculto); }
        catch { _logOculto = false; }
        _combos = await Http.SafeGetAsync<MovimientosAlmacenDetalleCombosLinea>(
                      ApiRoutes.Logistica.MovimientosAlmacenDetalleCombosLinea(NumMovimiento)) ?? new();
        // Una sola ubicación: no hay nada que elegir.
        if (_combos.Ubicaciones.Count == 1) _ubicacion = _combos.Ubicaciones[0].Id;
        if (_combos.UbicacionesDestino.Count == 1) _ubicacionDestino = _combos.UbicacionesDestino[0].Id;
    }

    protected override void OnParametersSet()
    {
        _itemsLinea = Lineas
            .Where(l => l.NUM_SECUENCIA is not null)
            .OrderBy(l => l.NUM_SECUENCIA)
            .Select(l => new ComboboxItem
            {
                Id = l.NUM_SECUENCIA!.Value.ToString(),
                Texto = $"{l.NUM_SECUENCIA} · {l.COD_PRODUCTO} {l.DES_PRODUCTO} · {l.CAN_PRODUCTO?.ToString("0.######")} {l.COD_UNIDAD_MEDIDA}"
            }).ToList();
        // La línea elegida se quitó del documento: se vuelve al modo automático (o a no tener línea).
        if (_linea is { } sec && !Lineas.Any(l => l.NUM_SECUENCIA == sec)) _linea = null;
        // Sin modo automático y con una sola línea, no hay nada que elegir.
        if (!PuedeAutomatico && _linea is null && _itemsLinea.Count == 1 && int.TryParse(_itemsLinea[0].Id, out var unica)) _linea = unica;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _enfocarEtiqueta)
        {
            _enfocarEtiqueta = false;
            if (_campoEtiqueta is not null && !Disabled) await _campoEtiqueta.FocusAsync();
        }
        if (_enfocarPeso)
        {
            _enfocarPeso = false;
            if (_campoPeso is not null) await _campoPeso.FocusAsync();
        }
    }

    /// <summary>Lo llama la página desde la acción «Leer en esta línea» de la grilla.</summary>
    public void SeleccionarLinea(int numSecuencia)
    {
        if (!Lineas.Any(l => l.NUM_SECUENCIA == numSecuencia)) return;
        _linea = numSecuencia;
        _enfocarEtiqueta = true;
        StateHasChanged();
    }

    private void OnLineaCambiada(string? v)
    {
        _linea = int.TryParse(v, out var n) ? n : null;
        DescartarPendiente();
        _enfocarEtiqueta = true;
    }

    // Etiqueta de la ubicación o ubicación elegida: una u otra. Si llegaran las dos y no coinciden, el SP
    // rechaza la lectura (50709), así que al usar una se borra la otra.
    private void OnUbicacionElegida(string? v)
    {
        _ubicacion = string.IsNullOrWhiteSpace(v) ? null : v;
        if (_ubicacion is not null) _stickerUbicacion = null;
        _enfocarEtiqueta = true;
    }

    private void OnUbicacionKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_stickerUbicacion)) return;
        _ubicacion = null;
        _enfocarEtiqueta = true;
    }

    private async Task OnEtiquetaKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await LeerAsync();
    }

    private async Task OnPesoKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmarPesoAsync();
    }

    private async Task ConfirmarPesoAsync()
    {
        if (_etiquetaPendiente is null) return;
        if (_peso is not > 0) { Snackbar.Add("Indica el peso o la cantidad de la etiqueta, mayor que cero.", Severity.Warning); return; }
        await EnviarAsync(_etiquetaPendiente, _peso, _forzarPendiente);
        await ProcesarColaAsync();
    }

    private void DescartarPendiente()
    {
        _esperaPeso = false;
        _etiquetaPendiente = _mensajePeso = null;
        _peso = null;
        _forzarPendiente = false;
        _enfocarEtiqueta = true;
    }

    /// <summary>El usuario descarta la etiqueta que esperaba su peso: lo que quedó en cola sigue su curso.</summary>
    private async Task DescartarPesoAsync()
    {
        DescartarPendiente();
        await ProcesarColaAsync();
    }

    private async Task LeerAsync()
    {
        var etiqueta = _etiqueta?.Trim();
        if (string.IsNullOrEmpty(etiqueta) || Disabled) return;
        if (_linea is null && !PuedeAutomatico)
        {
            Snackbar.Add("Elige primero la línea donde se asignan las etiquetas.", Severity.Warning);
            return;
        }
        if (EnModoAutomatico && string.IsNullOrWhiteSpace(_stickerUbicacion) && string.IsNullOrWhiteSpace(_ubicacion))
        {
            Snackbar.Add("Indica la ubicación: lee su etiqueta o elígela.", Severity.Warning);
            return;
        }
        // La caja queda lista para la siguiente etiqueta desde ya; esta se atiende cuando le toque.
        _etiqueta = null;
        _cola.Enqueue(etiqueta);
        if (_esperaPeso) Snackbar.Add("Falta el peso de la etiqueta anterior: la nueva quedó en cola.", Severity.Warning);
        await ProcesarColaAsync();
    }

    /// <summary>Atiende la cola de a una, en orden. Se detiene si una etiqueta pide su peso (sigue cuando se resuelve).</summary>
    private async Task ProcesarColaAsync()
    {
        if (_procesando) return;   // el que ya está procesando atenderá lo que llegue
        _procesando = true;
        try
        {
            while (!_esperaPeso && _cola.TryDequeue(out var etiqueta))
                await EnviarAsync(etiqueta, null, false);
        }
        finally
        {
            _procesando = false;
            StateHasChanged();
        }
    }

    private async Task EnviarAsync(string etiqueta, decimal? peso, bool forzar)
    {
        // Aquí NO se toca la caja (_etiqueta): LeerAsync ya la vació al encolar, y lo que haya en ella ahora es la etiqueta SIGUIENTE
        // que el lector todavía está escribiendo. Borrarla al terminar esta lectura cortaba la etiqueta que venía en camino.
        try
        {
            var dto = new MovimientosAlmacenLecturaDto
            {
                NUM_MOVIMIENTO_ALMACEN = NumMovimiento,
                COD_STICKER_RFID = etiqueta,
                CAN_PRODUCTO = peso,
                FLG_FORZAR = forzar,
                NUM_SECUENCIA_LINEA = _linea,
                COD_STICKER_UBICACION = EnModoAutomatico && !string.IsNullOrWhiteSpace(_stickerUbicacion) ? _stickerUbicacion!.Trim() : null,
                COD_UBICACION_ALMACEN = EnModoAutomatico && string.IsNullOrWhiteSpace(_stickerUbicacion) ? NullSiVacio(_ubicacion) : null,
                COD_UBICACION_ALMACEN_SINCRONIZADO = EnModoAutomatico && ConDestino ? NullSiVacio(_ubicacionDestino) : null,
            };
            var resp = await Http.PostAsJsonAsync(ApiRoutes.Logistica.MovimientosAlmacenLecturas, dto);
            var cuerpo = await resp.Content.ReadAsStringAsync();
            var r = Leer(cuerpo);

            if (resp.IsSuccessStatusCode && r?.Data is { } ok)
            {
                _ultimo = ok;
                Registrar(true, $"{ok.COD_PRODUCTO} · {ok.COD_TIPO_ETIQUETA} · línea {ok.NUM_SECUENCIA} · +{ok.CAN_LEIDA?.ToString("0.######")} {ok.COD_UNIDAD_MEDIDA}");
                if (!string.IsNullOrWhiteSpace(ok.DES_ADVERTENCIA)) Snackbar.Add(ok.DES_ADVERTENCIA, Severity.Warning);
                DescartarPendiente();
                await OnLectura.InvokeAsync();
                return;
            }

            var numero = r?.Data?.ErrorNumber;
            var mensaje = string.IsNullOrWhiteSpace(r?.Message) ? "No se pudo registrar la lectura." : r!.Message;
            switch (numero)
            {
                case 50708:   // el producto se mide: falta el peso
                    _etiquetaPendiente = etiqueta;
                    _forzarPendiente = forzar;
                    _mensajePeso = mensaje;
                    _esperaPeso = true;
                    _enfocarPeso = true;
                    return;

                case 50706:   // ya ingresó en otro movimiento
                case 50707:   // ya salió en otro movimiento
                    if (await ConfirmarForzadoAsync(numero.Value, mensaje))
                    {
                        await EnviarAsync(etiqueta, peso, true);
                        return;
                    }
                    Registrar(false, $"{Corta(etiqueta)}: no se leyó ({mensaje})");
                    DescartarPendiente();
                    return;

                case not null:
                    Registrar(false, $"{Corta(etiqueta)}: {mensaje}");
                    Snackbar.Add(mensaje, Severity.Error);
                    DescartarPendiente();
                    return;

                default:
                    // Sin número de error del SP: validación del modelo, sesión vencida, error del servidor...
                    await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(MovimientoLecturaPanel), nameof(EnviarAsync));
                    return;
            }
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(MovimientoLecturaPanel), nameof(EnviarAsync));
            Snackbar.Add("No se pudo registrar la lectura. Ver detalle en el log de errores.", Severity.Error);
        }
        finally
        {
            _enfocarEtiqueta = !_esperaPeso;
            StateHasChanged();
        }
    }

    private async Task<bool> ConfirmarForzadoAsync(int numero, string mensaje)
    {
        var titulo = numero == 50706 ? "La etiqueta ya ingresó" : "La etiqueta ya salió";
        var si = await DialogService.ShowMessageBox(titulo, mensaje + " ¿La lees de todos modos?",
                                                    yesText: "Leer de todos modos", cancelText: "No leerla");
        return si == true;
    }

    private void Registrar(bool ok, string texto)
    {
        _historial.Insert(0, new Registro(ok, texto, DateTime.Now));
        if (_historial.Count > 8) _historial.RemoveRange(8, _historial.Count - 8);
    }

    private static ApiResponse<MovimientosAlmacenLecturaResultado>? Leer(string cuerpo)
    {
        if (string.IsNullOrWhiteSpace(cuerpo)) return null;
        try { return JsonSerializer.Deserialize<ApiResponse<MovimientosAlmacenLecturaResultado>>(cuerpo, new JsonSerializerOptions(JsonSerializerDefaults.Web)); }
        catch (JsonException) { return null; }   // la respuesta de una validación de modelo (400) no es un ApiResponse
    }

    // Las etiquetas RFID miden 100 caracteres o más: en el historial se muestra el final, que es lo que las distingue.
    private static string Corta(string etiqueta) => etiqueta.Length <= 24 ? etiqueta : "…" + etiqueta[^22..];
    private static string? NullSiVacio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v!.Trim();
}
