@page "/logistica/gre-recibidas"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Finanzas
@using KONSolutions.Shared.Models.Logistica
@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog

@*
    Bandeja de guías recibidas (LOGISTICA.GRE_RECIBIDAS): las guías de remisión de los proveedores (remitente 09) y de los transportistas (31) que cargó el servicio de XML, ya sea que llegaron por el correo o que alguien
    dejó los archivos en la carpeta de Compras. Es de CONSULTA: qué guía entró, de quién, el motivo del traslado, el estado (pendiente, ya usada en un ingreso a almacén, o descartada), sus líneas, el XML original y el PDF.
    Se puede descartar una guía pendiente (o devolverla a pendiente). Generar el ingreso a almacén se sigue haciendo desde Movimientos de Almacén («Traer guía recibida»). Permiso propio: LOGISTICA.GUIAS_RECIBIDAS
    (API api/v1/logistica/guias-recibidas).
*@

<PageTitle>Bandeja de guías recibidas · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-3 grid-header-compacto" style="flex-wrap:wrap;">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Bandeja de guías recibidas" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);" data-resumen="cabecera">Schema LOGISTICA · @_items.Count guía@(_items.Count == 1 ? "" : "s")</MudText>
    </div>
    <BarraBusqueda @bind-Value="_texto" OnSearch="CargarAsync" MaxWidth="460px" Class="grid-header-search" />
    <MudSelect T="string" Variant="Variant.Outlined" Label="Estado" Style="min-width:170px;max-width:200px;" Value="_estado"
               ValueChanged="@(v => { _estado = v ?? ""; return CargarAsync(); })" data-campo="estado">
        <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
        <MudSelectItem T="string" Value="@("PEN")">Pendientes</MudSelectItem>
        <MudSelectItem T="string" Value="@("USA")">Ya usadas</MudSelectItem>
        <MudSelectItem T="string" Value="@("DES")">Descartadas</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Variant="Variant.Outlined" Label="Tipo de guía" Style="min-width:170px;max-width:210px;" Value="_tipo"
               ValueChanged="@(v => { _tipo = v ?? ""; return CargarAsync(); })" data-campo="tipo">
        <MudSelectItem T="string" Value="@("")">Todas</MudSelectItem>
        <MudSelectItem T="string" Value="@("09")">Remitente</MudSelectItem>
        <MudSelectItem T="string" Value="@("31")">Transportista</MudSelectItem>
    </MudSelect>
    <MudDatePicker Label="Emitidas desde" Variant="Variant.Outlined" Style="max-width:170px;" Date="_desde" DateChanged="@(d => { _desde = d; return CargarAsync(); })" Clearable="true" data-campo="desde" />
    <MudDatePicker Label="hasta" Variant="Variant.Outlined" Style="max-width:170px;" Date="_hasta" DateChanged="@(d => { _hasta = d; return CargarAsync(); })" Clearable="true" data-campo="hasta" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@HayFiltros" />
    <GridRefreshButton OnRefresh="CargarAsync" />
    @* Los botones de la cabecera salen de la configuración de la opción en Seguridad (por rol): Imprimir, Exportar, Completar datos *@
    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
</div>

@if (_cargando || _completando) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" data-estado="cargando" /> }
@if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2" data-aviso="error">@_error</MudAlert> }

<MudStack Row="true" Spacing="2" Class="mb-2" Style="flex-wrap:wrap;" data-resumen="estados">
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-chip="pendientes">Pendientes: @_items.Count(x => x.COD_ESTADO_USO == "PEN")</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" data-chip="usados">Ya usadas: @_items.Count(x => x.COD_ESTADO_USO == "USA")</MudChip>
    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" data-chip="descartados">Descartadas: @_items.Count(x => x.COD_ESTADO_USO == "DES")</MudChip>
    @if (_items.Any(x => x.NUM_LINEAS_SIN_PRODUCTO > 0 && x.COD_ESTADO_USO == "PEN"))
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" data-chip="sin-producto">Con líneas sin producto: @_items.Count(x => x.NUM_LINEAS_SIN_PRODUCTO > 0 && x.COD_ESTADO_USO == "PEN")</MudChip>
    }
</MudStack>

    <MudPaper Elevation="0" Style="border:1px solid var(--line);">
        <div data-resizable-grid="bandeja-guias-recibidas" style="position:relative;">
        <MudDataGrid T="GreRecibida" Items="_visibles" Dense="true" Hover="true" Striped="true" Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica" data-grid="bandeja-xml">
            <Columns>
                @foreach (var (c, idx) in _cols.Select((c, i) => (c, i)))
                {
                    <TemplateColumn Sortable="false" Title="@c.Titulo" CellStyle="@c.Estilo">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1">
                                <EncabezadoOrdenable Texto="@c.Titulo" Activo="@(_ordenColumna == idx)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(idx))" />
                                <FiltroExcelColumna T="GreRecibida" ItemsBase="@Base(idx)" ValorDe="@c.Valor"
                                                    ValoresActivos="_filtros.GetValueOrDefault(idx)" ValoresActivosChanged="@(v => Filtro(idx, v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (idx == 2) { <span class="mono">@c.Valor(context.Item)</span> }
                            else if (idx == 3)
                            {
                                @(string.IsNullOrWhiteSpace(context.Item.DES_ENTIDAD) ? context.Item.DES_REMITENTE : context.Item.DES_ENTIDAD)
                                <span class="mono" style="opacity:.6;"> @(context.Item.NUM_RUC_REMITENTE ?? context.Item.NUM_RUC_EMISOR)</span>
                                @if (context.Item.COD_ENTIDAD is null) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-1" title="El RUC no está en el maestro de entidades.">sin registrar</MudChip> }
                            }
                            else if (idx == 5) { <span class="mono" style="display:block;text-align:right;">@c.Valor(context.Item)</span> }
                            else if (idx == 6) { <span class="mono">@context.Item.NUM_LINEAS</span>@if (context.Item.NUM_LINEAS_SIN_PRODUCTO > 0) { <span class="mono" style="opacity:.65;"> (@context.Item.NUM_LINEAS_SIN_PRODUCTO sin producto)</span> } }
                            else if (idx == 7) { <EstadoChip Estado="@c.Valor(context.Item)" BackColor="@context.Item.DES_BACKCOLOR_ESTADO" ForeColor="@context.Item.DES_FORECOLOR_ESTADO" /> }
                            else if (idx == 8) { <span class="mono">@c.Valor(context.Item)</span> }
                            else if (idx == 9) { <MudTooltip Text="@TooltipSunat(context.Item)"><EstadoChip Estado="@c.Valor(context.Item)" BackColor="@ColorSunat(context.Item, true)" ForeColor="@ColorSunat(context.Item, false)" /></MudTooltip> }
                            else { @c.Valor(context.Item) }
                        </CellTemplate>
                    </TemplateColumn>
                }
                <TemplateColumn Title="" Sortable="false" Filterable="false" CellStyle="white-space:nowrap;">
                    <CellTemplate>
                        <MudTooltip Text="Ver el detalle, el XML y el PDF"><MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => VerAsync(context.Item))" data-accion="ver" /></MudTooltip>
                        @if (!string.IsNullOrWhiteSpace(context.Item.DES_NOMBRE_ARCHIVO_PDF))
                        {
                            <MudTooltip Text="Ver el PDF"><MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" OnClick="@(() => VerPdfAsync(context.Item))" data-accion="pdf" /></MudTooltip>
                        }
                        @{ var item = context.Item; }
                        @* @key: los botones de la fila dependen del estado del documento (descartar o devolver a pendiente, completar solo si está pendiente) y el componente guarda sus botones. *@
                        <AccionesBotones @key="@($"{item.NUM_GRE}|{item.COD_ESTADO_USO}")" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                         Zona="@AccionesBotones.ZonaBotones.Grilla" TodasLasZonas="true" Filtro="@(b => BotonAplica(item, b))" OnAccion="@(b => OnAccionGrilla(item, b))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;" data-vacio="bandeja">@(_cargando ? "Buscando..." : "No hay guías recibidas con ese filtro. El servicio de XML las carga desde el correo o desde la carpeta de Compras.")</MudText></NoRecordsContent>
            <PagerContent><MudDataGridPager T="GreRecibida" /></PagerContent>
        </MudDataGrid>
        <div class="grid-resize-handle"></div>
        </div>
    </MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    // ── Grilla estándar: filtros tipo Excel por columna, orden, ancho ajustable (en el navegador) y alto hasta el tope ──
    private sealed record Col(string Titulo, Func<GreRecibida, string?> Valor, Func<GreRecibida, IComparable?>? Clave = null, string? Estilo = null);

    private readonly Col[] _cols =
    {
        new("Emisión",   x => x.FEC_EMISION.ToString("dd/MM/yyyy"), x => x.FEC_EMISION),
        new("Tipo",      x => x.DES_TIPO_GUIA),
        new("Número",    x => x.NUM_GUIA),
        new("Remitente", x => $"{(string.IsNullOrWhiteSpace(x.DES_ENTIDAD) ? x.DES_REMITENTE : x.DES_ENTIDAD)} {x.NUM_RUC_REMITENTE ?? x.NUM_RUC_EMISOR}".Trim()),
        new("Motivo del traslado", x => x.DES_MOTIVO_TRASLADO),
        new("Peso",      x => x.CAN_PESO_BRUTO_TOTAL is { } kg ? $"{kg:N2} {x.COD_UNIDAD_PESO}" : null, x => x.CAN_PESO_BRUTO_TOTAL, "text-align:right;"),
        new("Líneas",    x => x.NUM_LINEAS.ToString(), x => x.NUM_LINEAS),
        new("Estado",    x => $"{x.DES_ESTADO_USO}{(x.NUM_MOVIMIENTO_ALMACEN is { } n ? $" · movimiento {n:0}" : "")}", x => x.COD_ESTADO_USO),
        new("Recibida",  x => x.FEC_REGISTRO?.ToString("dd/MM/yyyy HH:mm"), x => x.FEC_REGISTRO),
        new("Validación", x => TextoSunat(x), x => x.COD_ESTADO_VALIDACION),
    };

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private bool HayFiltros => _filtros.Any(f => f.Value is not null) || !string.IsNullOrWhiteSpace(_texto) || _estado != "" || _tipo != "" || _desde is not null || _hasta is not null;

    private List<GreRecibida> Aplicar(int ex)
    {
        IEnumerable<GreRecibida> q = _items;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = q.Where(x => v.Contains(_cols[c].Valor(x) ?? ""));
        }
        return q.ToList();
    }
    private List<GreRecibida> Base(int col) => Aplicar(col);
    private List<GreRecibida> _visibles => Ordenar(Aplicar(-1));

    private List<GreRecibida> Ordenar(List<GreRecibida> items)
    {
        if (_ordenColumna is not { } col) return items;
        var c = _cols[col];
        Func<GreRecibida, object?> clave = x => c.Clave is not null ? c.Clave(x) : c.Valor(x);
        return _ordenAscendente ? items.OrderBy(clave).ToList() : items.OrderByDescending(clave).ToList();
    }
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente; else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private async Task LimpiarFiltros()
    {
        foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null;
        _texto = ""; _estado = ""; _tipo = ""; _desde = null; _hasta = null;
        await CargarAsync();
    }

    private List<GreRecibida> _items = new();
    private string _texto = "", _estado = "", _tipo = "";
    private DateTime? _desde, _hasta;
    private bool _cargando, _completando;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("LOGISTICA", "GRE_Recibidas");
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true; _error = null; StateHasChanged();
        try
        {
            var url = BandejaRutas.Consulta(BandejaRutas.GuiasRecibidas, _texto, _estado, _desde, _hasta, _tipo, "COD_TIPO_GUIA");
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode && resp.Content.Headers.ContentLength is null or 0)
            {
                _items = new();
                _error = resp.StatusCode is System.Net.HttpStatusCode.Unauthorized ? "La sesión venció o no se reconoció: vuelve a iniciar sesión."
                       : resp.StatusCode is System.Net.HttpStatusCode.Forbidden ? "No tienes permiso para ver esta bandeja (pídelo en Seguridad > Roles)."
                       : $"No se pudo leer la bandeja (HTTP {(int)resp.StatusCode}).";
                return;
            }
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<List<GreRecibida>>>();
            if (r is { Success: true }) _items = r.Data ?? new();
            else { _items = new(); _error = string.IsNullOrWhiteSpace(r?.Message) ? "No se pudo leer la bandeja." : r!.Message; }
        }
        catch (Exception ex)
        {
            _items = new(); _error = "No se pudo leer la bandeja. Ver detalle en el log de errores.";
            await ErrorLog.LogAsync(ex, nameof(GRE_Recibidas), nameof(CargarAsync));
        }
        finally { _cargando = false; }
    }

    /// <summary>«Completar datos»: sin número, con todos los pendientes; con número, solo ese documento.</summary>
    private async Task CompletarAsync(decimal? num)
    {
        _completando = true; StateHasChanged();
        try
        {
            var resp = await Http.PostAsync(BandejaRutas.CompletarDatos(BandejaRutas.GuiasRecibidas, num), null);
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<RecibidoCompletarResult>>();
            if (r is { Success: true }) { Snackbar.Add(string.IsNullOrWhiteSpace(r.Message) ? "Datos completados." : r.Message, Severity.Success); await CargarAsync(); }
            else Snackbar.Add(string.IsNullOrWhiteSpace(r?.Message) ? $"No se pudo completar (HTTP {(int)resp.StatusCode})." : r!.Message, Severity.Warning);
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(GRE_Recibidas), nameof(CompletarAsync)); Snackbar.Add("No se pudo completar los datos. Ver detalle en el log de errores.", Severity.Error); }
        finally { _completando = false; }
    }

    /// <summary>«Validar con SUNAT»: sin número, las guías sin resultado; con número, solo esa. SUNAT no consulta guías de terceros: la revisión es propia (RUC, serie, correlativo, fecha, firma y líneas).</summary>
    private async Task ValidarSunatAsync(decimal? num)
    {
        _completando = true; StateHasChanged();
        try
        {
            var resp = await Http.PostAsync(BandejaRutas.ValidarSunat(num, BandejaRutas.GuiasRecibidas), null);
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<RecibidoSunatResult>>();
            if (r is { Success: true }) { Snackbar.Add(r.Message ?? "Listo.", r.Data is { NUM_OBSERVADOS: > 0 } ? Severity.Warning : Severity.Success); await CargarAsync(); }
            else Snackbar.Add(string.IsNullOrWhiteSpace(r?.Message) ? $"No se pudo validar (HTTP {(int)resp.StatusCode})." : r!.Message, Severity.Warning);
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(GRE_Recibidas), nameof(ValidarSunatAsync)); Snackbar.Add("No se pudo validar. Ver detalle en el log de errores.", Severity.Error); }
        finally { _completando = false; }
    }

    // El estado sale del estándar (ESTANDAR.ESTADOS, tipo «Validación de guías»): descripción y colores vienen de la base; el motivo de la observación va en el tooltip.
    private static string TextoSunat(GreRecibida x) => string.IsNullOrWhiteSpace(x.DES_ESTADO_VALIDACION) ? "Sin validar" : x.DES_ESTADO_VALIDACION;
    private static string TooltipSunat(GreRecibida x) => string.IsNullOrWhiteSpace(x.COD_ESTADO_SUNAT) ? "Todavía no se validó: usa el botón «Validar con SUNAT». SUNAT no consulta guías de terceros; la revisión es propia."
        : $"{x.DES_ESTADO_SUNAT}{(x.FEC_VALIDACION_SUNAT is { } f ? $" ({f:dd/MM/yyyy HH:mm})" : "")}";
    private static string ColorSunat(GreRecibida x, bool fondo) => (fondo ? x.DES_BACKCOLOR_VALIDACION : x.DES_FORECOLOR_VALIDACION) ?? (fondo ? "#e0e0e0" : "#616161");

    // ── Botones configurados en Seguridad (Opciones de Aplicaciones > Botones) ──
    /// <summary>El método del botón; si el botón se creó a mano sin método, se toma de su nombre («Validar con SUNAT» = VALIDARSUNAT, «Completar datos» = COMPLETARDATOS).</summary>
    private static string Metodo(BotonTreeviewItem b)
    {
        var m = (b.DES_METODO ?? "").Trim().ToUpperInvariant();
        if (m != "") return m;
        var n = new string(((b.DES_BOTON_OPCION ?? "").Trim().ToUpperInvariant()).Normalize(System.Text.NormalizationForm.FormD).Where(char.IsLetter).ToArray());
        return n switch { "VALIDARCONSUNAT" or "VALIDARSUNAT" => "VALIDARSUNAT", "COMPLETARDATOS" => "COMPLETARDATOS", "DESCARTAR" => "DESCARTAR", _ => n };
    }

    /// <summary>Los botones de la fila: Descartar sirve para pendientes (descartar) y descartados (devolver a pendiente); Completar datos, solo para pendientes. Los de consulta sin método propio ya los cubren el ojo y el PDF.</summary>
    private static bool BotonAplica(GreRecibida item, BotonTreeviewItem b) => Metodo(b) switch
    {
        "DESCARTAR" => item.COD_ESTADO_USO is "PEN" or "DES",
        "COMPLETARDATOS" => item.COD_ESTADO_USO == "PEN",
        "VALIDARSUNAT" => true,
        _ => false
    };

    private Task OnAccionHeader(BotonTreeviewItem b) => Despacha(b, null);
    private Task OnAccionGrilla(GreRecibida item, BotonTreeviewItem b) => Despacha(b, item);

    private async Task Despacha(BotonTreeviewItem b, GreRecibida? item)
    {
        switch (Metodo(b))
        {
            case "COMPLETARDATOS": await CompletarAsync(item?.NUM_GRE); break;
            case "VALIDARSUNAT": await ValidarSunatAsync(item?.NUM_GRE); break;
            case "DESCARTAR": if (item is not null) await DescartarAsync(item, item.COD_ESTADO_USO == "PEN"); break;
            default:
                // Imprimir y Exportar: los atiende el reporteador cuando el botón tiene un diseño asignado (Reportes > Asignación a botones); sin diseño, no hay nada que ejecutar
                Snackbar.Add($"El botón «{b.DES_BOTON_OPCION}» no tiene una acción ni un reporte asignado en esta pantalla. Asígnale un diseño en Reportes > Asignación a botones.", Severity.Info);
                break;
        }
    }

    private Task VerAsync(GreRecibida x)
        => DialogService.ShowAsync<GRE_RecibidaDetalleDialog>("", new DialogParameters { ["Resumen"] = x }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = false });

    private Task VerPdfAsync(GreRecibida x)
        => DialogService.ShowAsync<KONSolutions.Web.Pages.Comercial.RecibidoPdfDialog>("", new DialogParameters { ["Url"] = BandejaRutas.GuiaRecibida(x.NUM_GRE, "pdf"), ["Titulo"] = $"PDF de {x.NUM_GUIA}" },
                                                      new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = false });

    private async Task DescartarAsync(GreRecibida x, bool descartar)
    {
        var pregunta = descartar ? $"¿Descartar la guía {x.NUM_GUIA}? Dejará de ofrecerse en «Traer guía recibida»; se puede devolver a pendiente." : $"¿Devolver la guía {x.NUM_GUIA} a pendiente?";
        var ok = await DialogService.ShowMessageBox(descartar ? "Descartar guía" : "Devolver a pendiente", pregunta, yesText: descartar ? "Descartar" : "Devolver", cancelText: "Cancelar");
        if (ok != true) return;
        try
        {
            var resp = await Http.PutAsJsonAsync(BandejaRutas.GuiaRecibida(x.NUM_GRE, "descartar"), new RecibidoDescartarDto { FLG_DESCARTAR = descartar });
            var r = await resp.Content.ReadFromJsonAsync<ApiResponse<bool>>();
            if (r is { Success: true }) { Snackbar.Add(descartar ? "Guía descartada." : "Guía devuelta a pendiente.", Severity.Success); await CargarAsync(); }
            else Snackbar.Add(string.IsNullOrWhiteSpace(r?.Message) ? "No se pudo cambiar el estado." : r!.Message, Severity.Warning);
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(GRE_Recibidas), nameof(DescartarAsync)); Snackbar.Add("No se pudo cambiar el estado. Ver detalle en el log de errores.", Severity.Error); }
    }

    private static Color ColorEstado(string? e) => e switch { "PEN" => Color.Warning, "USA" => Color.Success, _ => Color.Default };
}
