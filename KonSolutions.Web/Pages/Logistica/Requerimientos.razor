@page "/logistica/requerimientos-stock"
@attribute [Authorize]
@using Modelo = KONSolutions.Shared.Models.Logistica.RequerimientosStock
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Requerimientos de Almacén · @ConfigSvc.Current.NombreApp</PageTitle>

@* Dos solapas que nunca están habilitadas a la vez: o se está mirando la lista, o se
   está trabajando sobre un documento. Es lo que evita que uno navegue el listado con una
   edición a medio hacer detrás. *@
<MudTabs Elevation="0" ActivePanelIndex="@_tab" ActivePanelIndexChanged="@(i => _tab = i)"
         Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">

    <MudTabPanel Text="Requerimientos" Icon="@Icons.Material.Filled.List" Disabled="@_enDocumento">
        <div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
            <div class="grid-header-titulo">
                <TituloPagina Fallback="Requerimientos de Almacén" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
                <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema LOGISTICA · @_visibles.Count de @_items.Count documentos</MudText>
            </div>
            <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar por número, descripción o requiriente..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />

            @* Filtra EN LA BASE, no en memoria: el SHOWALL recibe el código del tipo. Es lo
               correcto para un listado que crece con cada documento —traerlos todos para
               descartarlos en el navegador no escala— y es lo que ya hace la pantalla de
               Productos con sus tres combos de clasificación. *@
            @* Class="" saca el mb-3 que AriaCombo trae por defecto, y el margin-top:0 saca los
               16px que la clase reserva para la etiqueta flotante: en una fila con
               align-center esos 16px dejaban el combo 8px más abajo que el buscador. El aire
               que la etiqueta necesita se devuelve como padding-top del contenedor. *@
            <div style="min-width:520px;padding-top:8px;">
                <AriaCombo TItem="ComboboxItem" Items="_tiposFiltro"
                           TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                           Value="@_codTipoFiltro" ValueChanged="OnTipoFiltroChanged"
                           Label="Tipo de Requerimiento" Class="" Style="margin-top:0;" />
            </div>

            @* El botón de limpiar también cuenta el combo: si no, se podía dejar un filtro
               activo y el ícono no se enteraba. *@
            <GridClearFiltersButton OnClear="LimpiarFiltros"
                                    HasFilters="@(_filtros.Any(f=>f.Value is not null) || !string.IsNullOrWhiteSpace(_codTipoFiltro))" />
            <div class="grid-header-divider"></div>
            <div class="d-flex gap-2">
                <GridRefreshButton OnRefresh="Load" />
                <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                 Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
            </div>
        </div>

        <MudPaper Elevation="0" Style="border:1px solid var(--line);">
            <div data-resizable-grid="requerimientos-stock" style="position:relative;">
            <MudDataGrid T="Modelo" Items="_visibles" Dense="true" Hover="true" Striped="true"
                         Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
                <Columns>
                    <TemplateColumn Sortable="false" Title="N°" Width="90px" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                        <HeaderTemplate><EncabezadoOrdenable Campo="N°" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" /></HeaderTemplate>
                        <CellTemplate><span class="mono">@context.Item.NUM_REQUERIMIENTO_STOCK</span></CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Descripción"
                                    Width="@Limites.ColWidth("LOGISTICA.REQUERIMIENTOS_STOCK","DES_REQUERIMIENTO_STOCK",180,340)">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_REQUERIMIENTO_STOCK" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                                <FiltroExcelColumna T="Modelo" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_REQUERIMIENTO_STOCK)"
                                                    ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.DES_REQUERIMIENTO_STOCK</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Fecha" Width="110px" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                        <HeaderTemplate><EncabezadoOrdenable Campo="Fecha" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" /></HeaderTemplate>
                        <CellTemplate><span class="mono">@context.Item.FEC_REQUERIMIENTO_STOCK?.ToString("dd/MM/yyyy")</span></CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Tipo" Width="160px">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo" />
                                <FiltroExcelColumna T="Modelo" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_TIPO_REQUERIMIENTO)"
                                                    ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.DES_TIPO_REQUERIMIENTO</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Proyecto" Width="200px">
                        <HeaderTemplate><EncabezadoOrdenable Texto="Proyecto" /></HeaderTemplate>
                        <CellTemplate>@if (context.Item.NUM_PROYECTO is null) { <span style="opacity:.4;">—</span> } else { <span class="mono" style="opacity:.7;">@context.Item.NUM_PROYECTO</span> <span class="ml-1">@context.Item.DES_PROYECTO</span> }</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Centro de costo" Width="180px">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Centro de costo" />
                                <FiltroExcelColumna T="Modelo" ItemsBase="@Base(4)" ValorDe="@(x=>x.DES_CENTRO_COSTO)"
                                                    ValoresActivos="_filtros.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>Filtro(4,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.DES_CENTRO_COSTO</CellTemplate>
                    </TemplateColumn>

                    @* La entidad llega desglosada en siete campos. Se arma uno solo aquí y no en el SP
                       para no tocar un procedimiento que ya usan otras consultas. *@
                    <TemplateColumn Sortable="false" Title="Requiriente" Width="220px">
                        <HeaderTemplate><EncabezadoOrdenable Texto="Requiriente" /></HeaderTemplate>
                        <CellTemplate>@NombreEntidad(context.Item)</CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Atención" Width="110px" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                        <HeaderTemplate><EncabezadoOrdenable Texto="Atención" /></HeaderTemplate>
                        <CellTemplate>
                            <span class="mono">@(context.Item.FEC_ATENCION?.ToString("dd/MM/yyyy") ?? "—")</span>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Sortable="false" Title="Estado" Width="130px" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Estado" />
                                <FiltroExcelColumna T="Modelo" ItemsBase="@Base(7)" ValorDe="@(x=>x.DES_ESTADO)"
                                                    ValoresActivos="_filtros.GetValueOrDefault(7)" ValoresActivosChanged="@(v=>Filtro(7,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            <EstadoChip Estado="@context.Item.DES_ESTADO"
                                        BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Acciones" Sortable="false">
                        <CellTemplate>
                            @{ var item = context.Item; }
                            <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                             Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))"
                                             CodTipoEstado="@item.COD_TIPO_ESTADO" CodEstadoActual="@item.COD_ESTADO" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin documentos.</MudText></NoRecordsContent>
                <PagerContent><MudDataGridPager T="Modelo" /></PagerContent>
            </MudDataGrid>
            <div class="grid-resize-handle"></div>
            </div>
        </MudPaper>
    </MudTabPanel>

    @* Arranca deshabilitada: se enciende sólo cuando hay un documento abierto, y se apaga
       de nuevo al volver. *@
    <MudTabPanel Text="@_tituloDocumento" Icon="@Icons.Material.Filled.Description" Disabled="@(!_enDocumento)">
        @if (_enDocumento)
        {
            <RequerimientoDocumento Item="_docItem" Modo="_docModo" OnCerrar="CerrarDocumento"
                                     CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        }
    </MudTabPanel>
</MudTabs>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Modelo> _items = new();
    private string _search = "";

    /// <summary>Tipos para el combo de filtro del encabezado, y el tipo elegido. Vacío = todos.
    /// El valor viaja al SHOWALL: el filtro se resuelve en la base.</summary>
    private List<ComboboxItem> _tiposFiltro = new();
    private string? _codTipoFiltro;
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna = 0;
    private bool _ordenAscendente = false;   // el documento más reciente primero

    /// <summary>El SP trae los siete campos del nombre de la entidad. Se prefiere el nombre
    /// completo y se cae al comercial, que es lo que muestra el resto del sistema.</summary>
    private static string NombreEntidad(Modelo x)
        => !string.IsNullOrWhiteSpace(x.DES_NOMBRE_COMPLETO) ? x.DES_NOMBRE_COMPLETO
         : !string.IsNullOrWhiteSpace(x.DES_COMERCIAL)       ? x.DES_COMERCIAL
         : string.Empty;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<Modelo> Ordenar(List<Modelo> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.NUM_REQUERIMIENTO_STOCK).ToList() : items.OrderByDescending(x => x.NUM_REQUERIMIENTO_STOCK).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_REQUERIMIENTO_STOCK).ToList() : items.OrderByDescending(x => x.DES_REQUERIMIENTO_STOCK).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.FEC_REQUERIMIENTO_STOCK).ToList() : items.OrderByDescending(x => x.FEC_REQUERIMIENTO_STOCK).ToList(),
        _ => items
    };

    private List<Modelo> _visibles => Ordenar(Aplicar(_items, -1));
    private List<Modelo> Base(int col) => Aplicar(_items, col);

    private List<Modelo> Aplicar(List<Modelo> src, int ex)
    {
        // Sin filtros activos no hay nada que recorrer, y ese es el caso normal: la
        // grilla arranca sin filtros. Cada encabezado llama a este método en CADA
        // redibujado, así que sin esta salida un solo clic recorría la lista entera
        // una vez por columna.
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtros) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<Modelo> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                1 => q.Where(x => v.Contains(x.DES_REQUERIMIENTO_STOCK)),
                3 => q.Where(x => v.Contains(x.DES_TIPO_REQUERIMIENTO)),
                4 => q.Where(x => v.Contains(x.DES_CENTRO_COSTO)),
                7 => q.Where(x => v.Contains(x.DES_ESTADO)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private async Task LimpiarFiltros()
    {
        foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null;

        // El combo de tipo filtra en la base, así que limpiarlo obliga a volver a pedir el
        // listado: no alcanza con redibujar lo que ya está en memoria.
        var habiaTipo  = !string.IsNullOrWhiteSpace(_codTipoFiltro);
        _codTipoFiltro = null;
        if (habiaTipo) await Load();

        StateHasChanged();
    }

    private async Task OnTipoFiltroChanged(string? cod)
    {
        _codTipoFiltro = cod;
        await Load();
        StateHasChanged();
    }

    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("LOGISTICA", "Requerimientos");
        await CargarTiposFiltro();
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("LOGISTICA.REQUERIMIENTOS_STOCK", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    /// <summary>El mismo combobox que usa el documento. Si falla, la lista queda vacía y el
    /// filtro simplemente no se ofrece: no es motivo para tumbar la pantalla.</summary>
    private async Task CargarTiposFiltro()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(
                ApiRoutes.Logistica.TiposRequerimientoCombobox);
            _tiposFiltro = r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Requerimientos), nameof(CargarTiposFiltro));
            _tiposFiltro = new();
        }
    }

    private async Task Load()
    {
        try
        {
            // Siempre el mismo endpoint, haya o no tipo elegido: sin filtro el SP se comporta
            // igual que el SHOWALL de siempre. Tener dos caminos según el estado del combo es
            // como se terminan comportando distinto sin que nadie se dé cuenta.
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<Modelo>>>(
                ApiRoutes.Logistica.RequerimientosStockPorTipo(_codTipoFiltro));
            var todos = r?.Data ?? new();
            _items = string.IsNullOrWhiteSpace(_search)
                ? todos
                : todos.Where(x =>
                       (x.NUM_REQUERIMIENTO_STOCK?.ToString() ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || x.DES_REQUERIMIENTO_STOCK.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || NombreEntidad(x).Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Requerimientos), nameof(Load));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(Requerimientos));
            _items = new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    // Mismos códigos que usa el documento (ver RequerimientoDocumento.razor): son los de
    // esta opción en SEGURIDAD.APLICACIONES_OPCIONES_BOTONES.
    private const string CodBotonGenerarReservas  = "04";
    private const string CodBotonRevertirReservas = "05";

    private Task OnAccionGrilla(Modelo item, BotonTreeviewItem b)
    {
        // PRIMERO los botones propios del módulo, por su código. Si se preguntara antes por
        // los verbos, un botón de acción que además traiga marcado GET (para leer el registro
        // sobre el que actúa) se lo llevaría la rama de Consultar y abriría el documento en
        // vez de ejecutar su acción.
        switch (b.COD_BOTON_OPCION)
        {
            case CodBotonGenerarReservas:  return EjecutarAccionAsync(item, ApiRoutes.Logistica.RequerimientosStockGeneraReservas, "Reservas y requerimiento de compra generados.");
            case CodBotonRevertirReservas: return EjecutarAccionAsync(item, ApiRoutes.Logistica.RequerimientosStockRevierteReservas, "Reservas revertidas.");
        }

        // Del más específico al más genérico. Un botón de Modificar suele traer
        // marcados GET y PUT a la vez (para editar primero hay que leer), y un
        // Eliminar suele traer GET y DELETE: preguntando por GET primero, esos dos
        // entraban por la rama de consulta y el lápiz y el tacho abrean en sólo
        // lectura. Con DELETE y PUT antes, cada botón hace lo que dice su nombre.
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);

        // Un botón configurado que todavía no tiene acción conectada (Cerrar/Abrir
        // Requerimiento, hoy). Antes no pasaba NADA al hacer clic —ni una señal—, que es lo
        // que hacía parecer que la grilla estaba rota.
        return AvisarBotonSinConectar(b);
    }

    /// <summary>Ejecuta desde la GRILLA una acción del módulo sobre un requerimiento, sin
    /// abrir el documento. Llama al mismo endpoint que el botón del pie del documento y
    /// recarga la lista, porque estas acciones cambian el Estado.</summary>
    private async Task EjecutarAccionAsync(Modelo item, Func<int, string> ruta, string mensajeOk)
    {
        if (item.NUM_REQUERIMIENTO_STOCK is not { } num) return;
        try
        {
            var resp = await Http.PostAsync(ruta(num), null);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(mensajeOk, Severity.Success);
                await Load();
            }
            else
            {
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(Requerimientos), nameof(EjecutarAccionAsync));
            }
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Requerimientos), nameof(EjecutarAccionAsync));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo ejecutar la acción. Ver detalle en el log de errores.", DialogService, nameof(Requerimientos));
        }
    }

    private async Task AvisarBotonSinConectar(BotonTreeviewItem b)
    {
        await ErrorLog.TraceAsync(
            $"BOTÓN DE GRILLA — {b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION} " +
            $"(método configurado: {b.DES_METODO ?? "sin método"}) sin acción conectada");
        await ErrorDialogHelper.MostrarAvisoAsync(
            $"El botón \"{b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION}\" todavía no tiene una acción conectada en esta pantalla.",
            DialogService, nameof(Requerimientos), "Acción pendiente");
    }

    private int _tab;
    private bool _enDocumento;
    private Modelo? _docItem;
    private CrudModo _docModo = CrudModo.Create;

    private string _tituloDocumento => !_enDocumento ? "Documento" : _docModo switch
    {
        CrudModo.Create => "Nuevo",
        CrudModo.Delete => $"Eliminar N° {_docItem?.NUM_REQUERIMIENTO_STOCK}",
        CrudModo.Read   => $"Consultar N° {_docItem?.NUM_REQUERIMIENTO_STOCK}",
        _               => $"Editar N° {_docItem?.NUM_REQUERIMIENTO_STOCK}"
    };

    /// <summary>Pasa a la solapa del documento. La lista queda deshabilitada mientras tanto.</summary>
    private Task Abrir(Modelo? item, CrudModo modo)
    {
        _docItem = item;
        _docModo = modo;
        _enDocumento = true;
        _tab = 1;
        return Task.CompletedTask;
    }

    /// <summary>Vuelve a la lista y apaga la solapa del documento. Recarga sólo si se grabó
    /// algo, que es lo que informa el componente al cerrarse.</summary>
    private async Task CerrarDocumento(bool huboCambios)
    {
        _enDocumento = false;
        _docItem = null;
        _tab = 0;
        if (huboCambios) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("LOGISTICA.REQUERIMIENTOS_STOCK", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
