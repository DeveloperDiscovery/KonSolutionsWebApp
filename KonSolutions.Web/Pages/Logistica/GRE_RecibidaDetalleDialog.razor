@using KONSolutions.Shared.Models.Logistica
@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@inject HttpClient Http
@inject IDialogService DialogService
@inject ErrorLogService ErrorLog

@* El detalle de una guía de remisión recibida (solo lectura): la cabecera, el traslado, sus líneas con el producto de la empresa que se les asignó, el XML original y el PDF. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6" data-titulo="detalle">Guía @Resumen.NUM_GUIA</MudText></TitleContent>
    <DialogContent>
        @if (_cargando) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" data-estado="cargando" /> }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_error</MudAlert> }
        @{ var f = _ficha ?? Resumen; }
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">@f.DES_TIPO_GUIA</MudText>
                <MudText>@(string.IsNullOrWhiteSpace(f.DES_ENTIDAD) ? f.DES_REMITENTE : f.DES_ENTIDAD) <span class="mono" style="opacity:.6;">@(f.NUM_RUC_REMITENTE ?? f.NUM_RUC_EMISOR)</span></MudText>
                @if (f.COD_ENTIDAD is null) { <MudText Typo="Typo.caption" Color="Color.Warning">El RUC no está en el maestro de entidades.</MudText> }
                <MudText Typo="Typo.caption" Style="opacity:.7;">Emisión @f.FEC_EMISION.ToString("dd/MM/yyyy")@(f.FEC_INICIO_TRASLADO is { } t ? $" · inicio del traslado {t:dd/MM/yyyy}" : "")</MudText>
                @if (!string.IsNullOrWhiteSpace(f.DES_MOTIVO_TRASLADO)) { <MudText Typo="Typo.caption" Style="opacity:.7;">Motivo: @f.DES_MOTIVO_TRASLADO</MudText> }
                @if (!string.IsNullOrWhiteSpace(f.DES_TRANSPORTISTA)) { <MudText Typo="Typo.caption" Style="opacity:.7;">Transportista: @f.DES_TRANSPORTISTA <span class="mono">@f.NUM_RUC_TRANSPORTISTA</span></MudText> }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Estado</MudText>
                <EstadoChip Estado="@($"{f.DES_ESTADO_USO}{(f.NUM_MOVIMIENTO_ALMACEN is { } n ? $" · movimiento de almacén {n:0}" : "")}")" BackColor="@f.DES_BACKCOLOR_ESTADO" ForeColor="@f.DES_FORECOLOR_ESTADO" />
                <MudText Typo="Typo.caption" Style="opacity:.7;">Archivo: @f.DES_NOMBRE_ARCHIVO@(f.FEC_REGISTRO is { } fr ? $" · recibida {fr:dd/MM/yyyy HH:mm}" : "")</MudText>
                @if (f.CAN_PESO_BRUTO_TOTAL is { } kg) { <MudText Typo="Typo.caption" Style="opacity:.7;">Peso bruto: @kg.ToString("N2") @f.COD_UNIDAD_PESO@(_ficha?.NUM_BULTOS is { } b ? $" · {b:N0} bultos" : "")</MudText> }
            </MudItem>
        </MudGrid>
        @if (_ficha is not null)
        {
            <MudSimpleTable Dense="true" Bordered="true" Class="mb-3" data-tabla="traslado">
                <tbody>
                    <tr><td>Partida</td><td>@_ficha.DES_DIRECCION_PARTIDA</td></tr>
                    <tr><td>Llegada</td><td>@_ficha.DES_DIRECCION_LLEGADA</td></tr>
                    @if (!string.IsNullOrWhiteSpace(_ficha.DES_DESTINATARIO)) { <tr><td>Destinatario</td><td>@_ficha.DES_DESTINATARIO <span class="mono" style="opacity:.6;">@_ficha.NUM_DOC_DESTINATARIO</span></td></tr> }
                    @if (!string.IsNullOrWhiteSpace(_ficha.DES_VEHICULOS)) { <tr><td>Vehículos</td><td class="mono">@_ficha.DES_VEHICULOS</td></tr> }
                    @if (!string.IsNullOrWhiteSpace(_ficha.DES_CONDUCTORES)) { <tr><td>Conductores</td><td class="mono">@_ficha.DES_CONDUCTORES</td></tr> }
                    @if (!string.IsNullOrWhiteSpace(_ficha.DES_DOCUMENTOS_RELACIONADOS)) { <tr><td>Documentos que cita</td><td class="mono">@_ficha.DES_DOCUMENTOS_RELACIONADOS</td></tr> }
                </tbody>
            </MudSimpleTable>
        }
        <MudText Typo="Typo.subtitle2" Class="mt-2">Líneas (@_lineas.Count)</MudText>
        <MudPaper Elevation="0" Style="border:1px solid var(--line);">
            <div data-resizable-grid="gre-recibida-lineas" style="position:relative;">
            <MudDataGrid T="GreRecibidaLinea" Items="_visibles" Dense="true" Hover="true" Striped="true" Height="280px" FixedHeader="true" Hideable="false" data-tabla="lineas">
                <Columns>
                    @foreach (var (c, idx) in _cols.Select((c, i) => (c, i)))
                    {
                        <TemplateColumn Sortable="false" Title="@c.Titulo" CellStyle="@c.Estilo">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="@c.Titulo" Activo="@(_ordenColumna == idx)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(idx))" />
                                    <FiltroExcelColumna T="GreRecibidaLinea" ItemsBase="@Base(idx)" ValorDe="@c.Valor"
                                                        ValoresActivos="_filtros.GetValueOrDefault(idx)" ValoresActivosChanged="@(v => Filtro(idx, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>
                                @if (idx == ColProducto)
                                {
                                    @if (string.IsNullOrWhiteSpace(context.Item.COD_PRODUCTO)) { <span style="opacity:.55;">sin asignar</span> } else { <span>@context.Item.DES_PRODUCTO_EMPRESA</span> <span class="mono" style="opacity:.6;margin-left:6px;">@context.Item.COD_PRODUCTO</span> }
                                }
                                else if (c.Estilo is not null) { <span class="mono">@c.Valor(context.Item)</span> }
                                else { @c.Valor(context.Item) }
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
                <NoRecordsContent><MudText Class="pa-4 mono" Style="opacity:.5;">Sin líneas.</MudText></NoRecordsContent>
            </MudDataGrid>
            </div>
        </MudPaper>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Code" OnClick="AlternarXmlAsync" data-accion="xml">@(_verXml ? "Ocultar el XML" : "Ver el XML original")</MudButton>
            @if (!string.IsNullOrWhiteSpace(Resumen.DES_NOMBRE_ARCHIVO_PDF))
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="VerPdfAsync" data-accion="pdf">Ver el PDF</MudButton>
            }
        </MudStack>
        @if (_verXml)
        {
            <pre style="max-height:300px;overflow:auto;font-size:.75rem;background:var(--mud-palette-background-gray,#f5f5f5);padding:8px;margin-top:8px;" data-xml="texto">@(_xml ?? "Cargando...")</pre>
        }
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Filled" OnClick="@(() => MudDialog.Close())" Style="@EstilosBoton.Cancelar" data-accion="cerrar">Cerrar</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public GreRecibida Resumen { get; set; } = new();

    private GreRecibidaFicha? _ficha;

    // ── Grilla estándar de las líneas: filtro tipo Excel por columna, orden y ancho ajustable ──
    private sealed record Col(string Titulo, Func<GreRecibidaLinea, string?> Valor, Func<GreRecibidaLinea, IComparable?>? Clave = null, string? Estilo = null);
    private const int ColProducto = 6;
    private readonly Col[] _cols =
    {
        new("#",           x => x.NUM_ITEM.ToString(), x => x.NUM_ITEM, "text-align:right;"),
        new("Descripción", x => x.DES_PRODUCTO),
        new("Und.",        x => x.COD_UNIDAD_SUNAT, null, "white-space:nowrap;"),
        new("Cantidad",    x => x.CAN_PRODUCTO?.ToString("N2"), x => x.CAN_PRODUCTO, "text-align:right;"),
        new("Lote",        x => x.NUM_LOTE, null, "white-space:nowrap;"),
        new("Orden de compra", x => x.NUM_ORDEN_COMPRA_ITEM, null, "white-space:nowrap;"),
        new("Producto de la empresa", x => string.IsNullOrWhiteSpace(x.COD_PRODUCTO) ? "sin asignar" : $"{x.DES_PRODUCTO_EMPRESA} {x.COD_PRODUCTO}"),
        new("Lote interno",  x => x.NUM_LOTE_CONTROL, null, "white-space:nowrap;"),
    };
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private List<GreRecibidaLinea> Aplicar(int ex)
    {
        IEnumerable<GreRecibidaLinea> q = _lineas;
        foreach (var (c, v) in _filtros) { if (c == ex || v is null) continue; q = q.Where(x => v.Contains(_cols[c].Valor(x) ?? "")); }
        return q.ToList();
    }
    private List<GreRecibidaLinea> Base(int col) => Aplicar(col);
    private List<GreRecibidaLinea> _visibles
    {
        get
        {
            var l = Aplicar(-1);
            if (_ordenColumna is not { } col) return l;
            var c = _cols[col];
            Func<GreRecibidaLinea, object?> clave = x => c.Clave is not null ? c.Clave(x) : c.Valor(x);
            return _ordenAscendente ? l.OrderBy(clave).ToList() : l.OrderByDescending(clave).ToList();
        }
    }
    private void ToggleOrden(int columna) { if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente; else { _ordenColumna = columna; _ordenAscendente = true; } StateHasChanged(); }
    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }

    private List<GreRecibidaLinea> _lineas = new();
    private bool _cargando, _verXml;
    private string? _error, _xml;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        try
        {
            var fichaT = Http.GetFromJsonAsync<ApiResponse<GreRecibidaFicha>>(BandejaRutas.GuiaRecibida(Resumen.NUM_GRE));
            var lineasT = Http.GetFromJsonAsync<ApiResponse<List<GreRecibidaLinea>>>(BandejaRutas.GuiaRecibida(Resumen.NUM_GRE, "lineas"));
            var ficha = await fichaT; var lineas = await lineasT;
            _ficha = ficha?.Data; _lineas = lineas?.Data ?? new();
            if (ficha is { Success: false }) _error = ficha.Message;
        }
        catch (Exception ex) { _error = "No se pudo leer la guía. Ver detalle en el log de errores."; await ErrorLog.LogAsync(ex, nameof(GRE_RecibidaDetalleDialog), nameof(OnInitializedAsync)); }
        finally { _cargando = false; }
    }

    private async Task AlternarXmlAsync()
    {
        _verXml = !_verXml;
        if (!_verXml || _xml is not null) return;
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<GreRecibidaXml>>(BandejaRutas.GuiaRecibida(Resumen.NUM_GRE, "xml"));
            _xml = r?.Data?.DES_XML ?? (r?.Message ?? "No se pudo leer el XML.");
        }
        catch (Exception ex) { _xml = "No se pudo leer el XML."; await ErrorLog.LogAsync(ex, nameof(GRE_RecibidaDetalleDialog), nameof(AlternarXmlAsync)); }
    }

    private Task VerPdfAsync()
        => DialogService.ShowAsync<KONSolutions.Web.Pages.Comercial.RecibidoPdfDialog>("", new DialogParameters { ["Url"] = BandejaRutas.GuiaRecibida(Resumen.NUM_GRE, "pdf"), ["Titulo"] = $"PDF de la guía {Resumen.NUM_GUIA}" },
                                                      new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = false });
}
