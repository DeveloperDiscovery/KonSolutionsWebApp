    private async Task<bool> PostAsync(MovimientosAlmacenDetalleInsertDto dto)
        => await EnviarAsync(() => Http.PostAsJsonAsync(ApiRoutes.Logistica.MovimientosAlmacenDetalle, dto), nameof(PostAsync));

    private async Task<bool> PutAsync(MovimientosAlmacenDetalleUpdateDto dto)
        => await EnviarAsync(() => Http.PutAsJsonAsync(ApiRoutes.Logistica.MovimientosAlmacenDetalle, dto), nameof(PutAsync));

    private async Task<bool> EnviarAsync(Func<Task<HttpResponseMessage>> llamada, string metodo)
    {
        try
        {
            var resp = await llamada();
            if (resp.IsSuccessStatusCode) return true;
            await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(MovimientoDetalleLineaDialog), metodo);
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(MovimientoDetalleLineaDialog), metodo);
            Snackbar.Add("No se pudo grabar la línea. Ver detalle en el log de errores.", Severity.Error);
        }
        return false;
    }

    // ── Presentación ────────────────────────────────────────────────────────────
    private static string Num(decimal? v) => (v ?? 0).ToString(Decimales.FormatoCantidad);

    /// <summary>"Lote L-001 · OP 12-1-1 (TEJ)"; sin orden de producción, sólo el lote.</summary>
    private static string LoteOrden(string? lote, string? proceso, int? orden, short? item, byte? unidad)
    {
        var partes = new List<string>();
        if (!string.IsNullOrWhiteSpace(lote)) partes.Add($"Lote {lote}");
        if (orden is > 0) partes.Add($"OP {orden}-{item}-{unidad}{(string.IsNullOrWhiteSpace(proceso) ? "" : $" ({proceso})")}");
        return partes.Count == 0 ? "—" : string.Join(" · ", partes);
    }
