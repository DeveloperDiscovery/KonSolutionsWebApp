        {
            NUM_MOVIMIENTO_ALMACEN             = l.NUM_MOVIMIENTO_ALMACEN,
            NUM_SECUENCIA                      = l.NUM_SECUENCIA,
            COD_PRODUCTO                       = l.COD_PRODUCTO,
            COD_CLASE_MOVIMIENTO               = l.COD_CLASE_MOVIMIENTO,
            COD_TIPO_MOVIMIENTO                = l.COD_TIPO_MOVIMIENTO,
            CAN_PRODUCTO                       = _cantidad,
            COD_UNIDAD_MEDIDA                  = l.COD_UNIDAD_MEDIDA,
            CAN_PRODUCTO_SECUNDARIO            = _cantidadSecundaria ?? 0,
            COD_UNIDAD_MEDIDA_SECUNDARIO       = l.COD_UNIDAD_MEDIDA_SECUNDARIO,
            COD_ALMACEN                        = l.COD_ALMACEN,
            COD_UBICACION_ALMACEN              = l.COD_UBICACION_ALMACEN,
            NUM_LOTE_CONTROL                   = l.NUM_LOTE_CONTROL,
            COD_PROCESO                        = l.COD_PROCESO,
            NUM_ORDEN_PRODUCCION               = l.NUM_ORDEN_PRODUCCION,
            NUM_ORDEN_PRODUCCION_ITEM          = l.NUM_ORDEN_PRODUCCION_ITEM,
            NUM_ORDEN_PRODUCCION_UNIDAD        = l.NUM_ORDEN_PRODUCCION_UNIDAD,
