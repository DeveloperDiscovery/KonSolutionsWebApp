@using Modelo = KONSolutions.Shared.Models.Logistica.MovimientosAlmacen
@using DetalleModel = KONSolutions.Shared.Models.Logistica.MovimientosAlmacenDetalle
@using KONSolutions.Shared.Models.Logistica
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ErrorLogService ErrorLog
@inject MenuService MenuService
@inject ConfiguracionGeneralService ConfigGeneral
@inject IJSRuntime JS
@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@using TipoComprobanteModel = KONSolutions.Shared.Models.Estandar.TiposComprobantesPago
@using TransporteModel = KONSolutions.Shared.Models.Logistica.MovimientosAlmacenTransporte
@using EspecificacionModel = KONSolutions.Shared.Models.Estandar.ProductosEspecificacionesTecnicas
@using TransporteFichaModel = KONSolutions.Shared.Models.Logistica.Transportes
@using ItemTecnicoModel = KONSolutions.Shared.Models.Comercial.EspecificacionesItemsTecnicosComboDependiente
@using DocumentoIdentidadModel = KONSolutions.Shared.Models.Estandar.EntidadesDocumentosIdentidad
@using DireccionEntidadModel = KONSolutions.Shared.Models.Comercial.EntidadesDirecciones

@* ─────────────────────────────────────────────────────────────────────────────
   EL DOCUMENTO DE UN MOVIMIENTO DE ALMACEN

   Componente, no página: no lleva @page ni entrada en WorkspaceRegistry. Lo
   renderiza MovimientosAlmacen.razor dentro de su segunda solapa, igual que hacen
   Reserva y Requerimiento con los suyos.

   DOS REGLAS GOBIERNAN LA CABECERA, Y SE APLICAN UNA SOBRE OTRA:

     1. LA MATRIZ POR MODO — cada campo está habilitado, deshabilitado u oculto
        según se esté creando, modificando, consultando o eliminando. Vive en
        Estado(), abajo, escrita tal cual la pasaste.

     2. LAS DIECISIETE BANDERAS del tipo de movimiento — un campo que la matriz da
        por habilitado igual se oculta si su bandera está en false. Vive en Visible().

   El orden importa: primero la matriz dice qué se puede tocar, después las banderas
   dicen qué tiene sentido mostrar para ESTE tipo de movimiento.
   ───────────────────────────────────────────────────────────────────────────── *@

<EditForm Context="formulario" Model="_m" OnValidSubmit="Guardar" OnInvalidSubmit="MostrarCabeceraPorError">
    <DataAnnotationsValidator />

    @* ── LAS CUATRO PESTAÑAS ───────────────────────────────────────────────────
       Todo lo que se escribe vive acá arriba; la grilla del detalle va abajo, fuera
       de las pestañas, porque es la misma para todas.

       Documento reúne los campos del movimiento. Transportista, lo del transporte.
       Requerimientos y Órdenes de Compra quedan preparadas pero vacías: cuando se
       llenen, van a ser el lugar desde donde se traen líneas al detalle. *@
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">

        @* ═══════════════════════════ DOCUMENTO ═══════════════════════════ *@
        <MudTabPanel Text="Documento" Icon="@Icons.Material.Filled.Description">

            @* LA DISTRIBUCION, Y POR QUE ES UNA SOLA REJILLA

                 fila 1   Tipo de Movimiento · N.° de Movimiento · Almacén ·
                          Fecha de Movimiento · Fecha de Recepción (en salidas, de Inicio de Traslado)
                 fila 2   Entidad · Tipo de Documento · N.° de Documento · Lote de Control
                 fila 3   Almacén Destino/Origen · N.° Mov. Origen/Destino ·
                          Centro de Costo · Observación (ocupa las filas 3 y 4)
                 fila 4   Motivo · Estado

               TODOS los campos son celdas de UNA MISMA rejilla de 24 columnas, y cada uno
               declara cuántas ocupa. No hay bloques anidados ni contenedores hermanos que
               haya que emparejar: dentro de una fila de una rejilla, los bordes de arriba
               coinciden por construcción. Es la respuesta a los tops descuadrados —el
               problema no era cuánto bajaba cada campo, era que los estaba midiendo contra
               contenedores distintos.

               24 y no 12 porque las dos fechas necesitan 2 columnas cada una: con 12, lo más
               angosto posible era 1/12 y quedaban desproporcionadas.

               LA SEPARACIÓN HORIZONTAL NO PUEDE SER column-gap ACÁ. Un gap se aplica entre
               cada par de pistas, y con 24 pistas hay 23 huecos repartidos por dentro de la
               fila: un campo de 8 columnas se come 7 de ellos y queda más angosto de lo que
               su span dice, y la separación visible deja de coincidir con la configurada.

               Por eso la clase es rejilla-campos y no campos-config: hace lo mismo que
               MudGrid —medio espacio de padding a cada lado de la celda y un margen negativo
               en el contenedor—, así entre dos campos vecinos quedan sus dos medios, que es
               exactamente la Separación horizontal de Configuración General, tenga la rejilla
               las columnas que tenga. La vertical sigue siendo row-gap, que ahí sí es una
               sola por fila. *@

            @* ── ACCESOS DIRECTOS ─────────────────────────────────────────────────
               Fila de botones, uno por cada tipo de movimiento que ESTE usuario marcó
               como atajo (LOGISTICA.USUARIOS_TIPOS_MOVIMIENTO_DIRECT_ACCESS). Va ENTRE
               las pestañas y la primera fila de inputs: es lo primero que se toca al
               abrir un movimiento nuevo, antes de tocar el combo de Tipo de Movimiento.

               Cada botón lleva el IMG_ICONO del tipo (el mismo que se sube en Tipos de
               Movimiento) y el nombre completo como tooltip. Un clic llena el combo de
               Tipo de Movimiento y dispara la misma carga de banderas/dependientes que
               elegirlo a mano (OnTipoMovimientoChanged): así los inputs quedan
               habilitados o deshabilitados según la configuración de ESE tipo, igual
               que si se hubiera elegido del combo.

               La "x" en la esquina quita el atajo sin abrir nada más: es el mismo
               DELETE que usa el botón de estrella de al lado del combo.

               FILTRADOS POR ALMACÉN, igual que el combo de Tipo de Movimiento.
               La tabla de accesos directos no guarda almacén —es sólo usuario + clase +
               tipo—, así que el filtro no sale de una columna propia: sale de comparar
               contra _tiposDelRol, que ya es "los tipos de movimiento que el rol tiene
               habilitados EN ESE ALMACÉN" (CargarTiposDelRol). Un acceso directo a un tipo
               que ese almacén no ofrece no tiene nada que hacer en la fila: clickearlo
               dejaría el combo con un valor que _tiposDelRol de inmediato invalida. *@
            @* LA CABECERA SE PUEDE OCULTAR para darle todo el alto al detalle (botón de la barra del detalle). Se oculta con
               display:none y no con @if: así los combos conservan lo escrito y no se vuelven a crear al mostrarla. Nada de lo
               que se oculta se pierde: sigue en _m y se graba igual. La barra de botones (Cerrar, Guardar, Transferir…) queda. *@
            <div style="@(CabeceraOculta ? "display:none;" : null)">
            @if (AccesosDirectosVisibles.Count > 0)
            {
                <div class="d-flex align-center gap-2 flex-wrap mb-3">
                    @foreach (var acceso in AccesosDirectosVisibles)
                    {
                        <div style="position:relative;display:inline-block;">
                            <MudTooltip Text="@(acceso.DES_TIPO_MOVIMIENTO ?? acceso.COD_TIPO_MOVIMIENTO)">
                                <MudButton Variant="Variant.Filled"
                                           Style="background:#fff;color:var(--ink);box-shadow:0 2px 6px rgba(0,0,0,.25);min-width:48px;width:48px;height:48px;padding:4px;border-radius:8px;"
                                           OnClick="@(() => AplicarAccesoDirecto(acceso))">
                                    @if (acceso.IMG_ICONO is { Length: > 0 })
                                    {
                                        <img src="@($"data:image/png;base64,{Convert.ToBase64String(acceso.IMG_ICONO)}")"
                                             style="width:26px;height:26px;object-fit:contain;" alt="" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Bolt" />
                                    }
                                </MudButton>
                            </MudTooltip>
                            @if (!_readonly)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               Style="position:absolute;top:-8px;right:-8px;background:#c62828;color:#fff;width:18px;height:18px;padding:0;min-width:18px;"
                                               title="Quitar de accesos directos"
                                               OnClick="@(() => QuitarAccesoDirecto(acceso.COD_TIPO_MOVIMIENTO))" />
                            }
                        </div>
                    }
                </div>
            }

            <div class="rejilla-campos" style="grid-template-columns:repeat(24,minmax(0,1fr));">

                @* ── Fila 1 ─────────────────────────────────────────────────── *@
                @if (Ver("COD_ALMACEN"))
                {
                    <div style="grid-column:span 7;">
                        @* Los almacenes DEL ROL (PROC_SEGURIDAD_ROLES_USUARIO_ALMACENES_SHOWCOMBOX),
                           no todos los de la base. Cambiar de almacén recarga los tipos de
                           movimiento, que también dependen del rol Y del almacén. *@
                        <AriaCombo TItem="ComboboxItem" Items="_almacenesDelRol"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_m.COD_ALMACEN" ValueChanged="OnAlmacenChanged"
                                   Label="Almacén" Obligatorio="true"
                                   Disabled="@(!Editable("COD_ALMACEN"))" Class="" />
                    </div>
                }
                @if (Ver("COD_TIPO_MOVIMIENTO"))
                {
                    <div style="grid-column:span 8;">
                        <div class="d-flex align-end gap-1">
                            <div style="flex:1;min-width:0;">
                                @* Los tipos habilitados para el rol EN ESE ALMACÉN
                                   (PROC_SEGURIDAD_ROLES_USUARIO_ALMACENES_TIPOS_MOVIMIENTO_SHOWCOMBOX). *@
                                <AriaCombo TItem="ComboboxItem" Items="_tiposDelRol"
                                           TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                           Value="@_m.COD_TIPO_MOVIMIENTO" ValueChanged="OnTipoMovimientoChanged"
                                           Label="Tipo de Movimiento" Obligatorio="true"
                                           Disabled="@(!Editable("COD_TIPO_MOVIMIENTO"))" Class="" />
                            </div>
                            @* Marca o quita el tipo elegido como acceso directo. Sólo tiene sentido
                               con un tipo puesto: sin eso no hay nada que fijar. *@
                            @if (!string.IsNullOrWhiteSpace(_m.COD_TIPO_MOVIMIENTO) && Editable("COD_TIPO_MOVIMIENTO"))
                            {
                                <MudTooltip Text="@(EsAccesoDirecto(_m.COD_TIPO_MOVIMIENTO) ? "Quitar de accesos directos" : "Agregar a accesos directos")">
                                    <MudIconButton Icon="@(EsAccesoDirecto(_m.COD_TIPO_MOVIMIENTO) ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                                   Style="color:var(--boton-backcolor,var(--ink));margin-bottom:4px;"
                                                   OnClick="ToggleAccesoDirectoActual" />
                                </MudTooltip>
                            }
                        </div>
                    </div>
                }
                @if (Ver("NUM_MOVIMIENTO_ALMACEN"))
                {
                    <div style="grid-column:span 5;">
                        <CampoTexto Label="N.° de Movimiento" Value="@(_m.NUM_MOVIMIENTO_ALMACEN?.ToString() ?? "")"
                                    ValueChanged="@(_ => { })" Disabled="true" />
                    </div>
                }
                @if (Ver("FEC_MOVIMENTO_ALMACEN"))
                {
                    <div style="grid-column:span 2;">
                        <MudDatePicker Label="Fecha de Movimiento" @bind-Date="_m.FEC_MOVIMENTO_ALMACEN"
                                       DateFormat="dd/MM/yyyy" Variant="Variant.Outlined"
                                       Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))"
                                       Disabled="@(!Editable("FEC_MOVIMENTO_ALMACEN"))" />
                    </div>
                }
                @if (Ver("FEC_RECEPCION"))
                {
                    <div style="grid-column:span 2;">
                        <MudDatePicker Label="@RotuloFechaRecepcion" @bind-Date="_m.FEC_RECEPCION"
                                       DateFormat="dd/MM/yyyy" Variant="Variant.Outlined"
                                       Editable="true" Mask="@(new DateMask("dd/MM/yyyy"))"
                                       Disabled="@(!Editable("FEC_RECEPCION"))" />
                    </div>
                }

                @* ── Fila 2 ─────────────────────────────────────────────────── *@
                @if (Ver("COD_ENTIDAD"))
                {
                    <div style="grid-column:span 10;">
                        @* Entidades del tipo que declara el tipo de movimiento, no el catálogo
                           entero: un movimiento de compra ofrece proveedores, uno de venta
                           clientes. *@
                        <AriaCombo TItem="ComboboxItem" Items="_entidades"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_m.COD_ENTIDAD?.ToString())"
                                   ValueChanged="OnEntidadChanged"
                                   Label="@RotuloEntidad" Disabled="@(!Editable("COD_ENTIDAD"))" Class="" />
                        @* El campo en gris puede querer decir dos cosas muy distintas: que el
                           tipo no usa entidad, o que la usa y no hay ninguna cargada de ese
                           tipo. La segunda merece decirse: si no, se busca el error en la
                           pantalla cuando está en el maestro de entidades. *@
                        @if (!string.IsNullOrWhiteSpace(_flags.COD_TIPO_ENTIDAD_ASOCIADA) && _entidades.Count == 0)
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.7;">
                                Sin entidades del tipo @_flags.COD_TIPO_ENTIDAD_ASOCIADA.
                            </MudText>
                        }
                    </div>
                }
                @if (Ver("COD_TIPO_COMPROBANTE_PAGO"))
                {
                    <div style="grid-column:span 5;">
                        @* Sólo los comprobantes que el tipo de movimiento acepta
                           (LOGISTICA.TIPOS_MOVIMIENTO_TIPOS_COMPROBATE_PAGO), no el catálogo
                           general de comprobantes. *@
                        <AriaCombo TItem="ComboboxItem" Items="_comprobantesCombo"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   @bind-Value="_m.COD_TIPO_COMPROBANTE_PAGO" Label="Tipo de Documento"
                                   Disabled="@(!Editable("COD_TIPO_COMPROBANTE_PAGO"))" Class="" />
                    </div>
                }
                @if (Ver("NUM_COMPROBANTE_PAGO"))
                {
                    <div style="grid-column:span 5;">
                        @* Se normaliza al SALIR del campo (OnBlur), no en cada tecla: mientras
                           escribes "T1-453" el texto pasa por "T", "T1", "T1-"… y normalizar
                           cada uno de esos estados intermedios no tiene sentido. Tampoco se
                           normaliza al grabar: ahí el cambio quedaría escondido hasta que ya
                           no se puede revisar. *@
                        <CampoTexto Label="Número de Documento" @bind-Value="_m.NUM_COMPROBANTE_PAGO"
                                    OnBlur="NormalizarNumeroComprobante"
                                    Disabled="@(!Editable("NUM_COMPROBANTE_PAGO"))" />
                    </div>
                }
                @if (Ver("NUM_LOTE_CONTROL"))
                {
                    <div style="grid-column:span 4;">
                        @* Los lotes de la ENTIDAD elegida. El SP de combo recibe @COD_ENTIDAD
                           —opcional— y filtra; sin entidad devuelve todos, que es lo correcto
                           para un movimiento que no la usa. *@
                        <AriaCombo TItem="ComboboxItem" Items="_lotesControl"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   @bind-Value="_m.NUM_LOTE_CONTROL" Label="Lote de Control"
                                   Disabled="@(!Editable("NUM_LOTE_CONTROL"))" Class="" />
                    </div>
                }

                @* ── Fila 3 ─────────────────────────────────────────────────── *@
                @if (Ver("COD_ALMACEN_SINCRONIZADO"))
                {
                    <div style="grid-column:span 5;">
                        @* Qué almacenes se ofrecen lo dice el ALCANCE del tipo (ver AlmacenesContrarios):
                           entre sucursales de la empresa, los de OTRA sucursal; entre almacenes de la
                           sucursal, los de la MISMA sucursal sin el propio; entre ubicaciones, solo el
                           almacén del movimiento. Nunca el propio, salvo en esta última: transferir a sí
                           mismo no mueve nada. Obligatorio cuando el tipo es de transferencia (también
                           lo valida el SP). En el traslado entre ubicaciones el destino se completa
                           solo y no se elige. *@
                        <AriaCombo TItem="ComboboxItem" Items="@AlmacenesContrarios()"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   @bind-Value="_m.COD_ALMACEN_SINCRONIZADO" Label="@RotuloAlmacenSincronizado"
                                   Obligatorio="@(_flags.FLG_TRANSFERENCIA == true)"
                                   Disabled="@(!Editable("COD_ALMACEN_SINCRONIZADO"))" Class="" />
                    </div>
                }
                @if (Ver("NUM_MOVIMIENTO_ALMACEN_SINCRONIZADO"))
                {
                    <div style="grid-column:span 5;">
                        <CampoTexto Label="@RotuloMovimientoSincronizado"
                                    Value="@(_m.NUM_MOVIMIENTO_ALMACEN_SINCRONIZADO?.ToString() ?? "")"
                                    ValueChanged="@(v => _m.NUM_MOVIMIENTO_ALMACEN_SINCRONIZADO = decimal.TryParse(v, out var d) ? d : null)"
                                    Disabled="@(!Editable("NUM_MOVIMIENTO_ALMACEN_SINCRONIZADO"))" />
                    </div>
                }
                @if (Ver("COD_CENTRO_COSTO"))
                {
                    <div style="grid-column:span 5;">
                        <AriaCombo TItem="ComboboxItem" Items="_combos.CentrosCosto"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   @bind-Value="_m.COD_CENTRO_COSTO" Label="Centro de Costo Solicitante"
                                   Disabled="@(!Editable("COD_CENTRO_COSTO"))" Class="" />
                    </div>
                }

                @* La observación: última columna, y ocupa las filas 3 y 4. Su borde de arriba
                   coincide con el de Almacén Destino/Origen porque son celdas de la MISMA
                   fila de la MISMA rejilla — no porque se haya ajustado a ojo. *@
                @if (Ver("DES_OBSERVACION"))
                {
                    <div style="grid-column:span 9;grid-row:span 2;">
                        @* campo-abarca-separacion: el alto crece exactamente lo que mide la
                           separación vertical entre inputs, para cubrir la franja que queda
                           entre las dos filas que ocupa. Top y ancho, sin tocar. *@
                        <MudTextField @bind-Value="_m.DES_OBSERVACION" Label="Descripción de observación"
                                      Lines="5" Variant="Variant.Outlined" Class="campo-abarca-separacion"
                                      Disabled="@(!Editable("DES_OBSERVACION"))" />
                    </div>
                }

                @* ── Fila 4 ─────────────────────────────────────────────────── *@
                @* Proyecto abre la fila 4. Va en esta fila y no en la de arriba porque la 3 ya
                   suma sus 24 columnas: meterlo ahí obligaba a angostar Centro de Costo hasta
                   cortarle el rótulo, que es lo que se veía en tu captura. *@
                @if (Ver("NUM_PROYECTO"))
                {
                    <div style="grid-column:span 5;">
                        <AriaCombo TItem="ComboboxItem" Items="_proyectos"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_m.NUM_PROYECTO?.ToString())"
                                   ValueChanged="@(v => _m.NUM_PROYECTO = int.TryParse(v, out var n) ? n : null)"
                                   Label="Proyecto" Disabled="@(!Editable("NUM_PROYECTO"))" Class="" />
                    </div>
                }
                @if (Ver("COD_MOTIVO"))
                {
                    @* Combo, no caja de texto: acá se ELIGE el motivo. La lista sale del tipo
                       de motivo que declara el tipo de movimiento. *@
                    <div style="grid-column:span 5;">
                        <AriaCombo TItem="ComboboxItem" Items="_motivos"
                                   TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                   Value="@(_m.COD_MOTIVO?.ToString())"
                                   ValueChanged="@(v => _m.COD_MOTIVO = int.TryParse(v, out var n) ? n : null)"
                                   Label="Motivo" Disabled="@(!Editable("COD_MOTIVO") || _motivos.Count == 0)" Class="" />
                    </div>
                }
                @if (Ver("COD_ESTADO"))
                {
                    <div style="grid-column:span 5;">
                        @* EL TIPO DE ESTADO LO DEFINE EL TIPO DE MOVIMIENTO, en su
                           COD_TIPO_ESTADO_RELACIONADO. Sin tipo elegido no se pregunta nada:
                           el campo va vacío y bloqueado, que es la verdad de ese momento.
                           Preguntarle a la tabla —DesTabla— era lo que sacaba el cartel
                           "Sin estados disponibles". *@
                        @if (_flags.COD_TIPO_ESTADO_RELACIONADO is { } codTipoEstado)
                        {
                            <EstadoCombo CodTipoEstado="@codTipoEstado"
                                         @bind-Value="_m.COD_ESTADO"
                                         CodTipoEstadoChanged="@(v => _m.COD_TIPO_ESTADO = v)"
                                         Disabled="@(!Editable("COD_ESTADO"))" Class="" />
                        }
                        else
                        {
                            <CampoTexto Label="Estado" Value="" ValueChanged="@(_ => { })" Disabled="true" />
                        }
                    </div>
                }
            </div>
            </div>@* fin de la cabecera ocultable *@

            @* Los botones, DEBAJO DEL ESTADO y dentro de la pestaña Documento: son los que
               graban la CABECERA, no algo del detalle de más abajo. Mismo lugar que en
               Requerimientos.

               Grabar no cierra: deja la cabecera grabada y el foco en el detalle. Del
               documento se sale con Cerrar. *@
            <div class="d-flex align-center gap-2 mt-4">
                @if (CabeceraOculta)
                {
                    @* Con la cabecera oculta, qué movimiento es. *@
                    <MudText Typo="Typo.body2" Style="font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@ResumenCabecera">
                        @ResumenCabecera
                    </MudText>
                }
                <MudSpacer />
                @* Botones configurados con FLG_DIALOG (por ejemplo, TRANSFERIR). Mismo lugar que en
                   RequerimientoDocumento: a la izquierda de Cerrar y Grabar, separados por una
                   línea, y sólo con la cabecera grabada, porque actúan sobre un movimiento que
                   existe. El estado del movimiento decide si cada uno está habilitado. *@
                @if (_cabeceraGrabada && !string.IsNullOrWhiteSpace(CodAplicacion))
                {
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" Fila="@_m"
                                     Zona="@AccionesBotones.ZonaBotones.Dialog" OnAccion="OnAccionDialog"
                                     CodTipoEstado="@_m.COD_TIPO_ESTADO" CodEstadoActual="@_m.COD_ESTADO" />
                    <div style="width:1px;align-self:stretch;background:var(--line);margin:0 4px;"></div>
                }
                <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cerrar" Disabled="_saving"
                           Variant="Variant.Filled" Style="@EstilosBoton.Cancelar">Cerrar</MudButton>
                @if (!_readonly)
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Save" Disabled="_saving">
                        @(Modo == CrudModo.Delete ? "Eliminar" : _cabeceraGrabada ? "Guardar cambios" : "Grabar cabecera")
                    </MudButton>
                }
            </div>

            @* ── DETALLE ───────────────────────────────────────────────────────────────
               DENTRO de la pestaña Documento, no debajo de las pestañas.

               Estaba afuera para decir "es del movimiento, no de una pestaña", pero el
               efecto era el contrario: se veía también bajo Transportista, Requerimientos y
               Órdenes de Compra, donde no tiene nada que ver y compite con lo que sí importa
               en esas pestañas.

               Alto FIJO y cabecera fija, como en Requerimientos y Reservas: la grilla no crece
               con las líneas, así que los botones de arriba no se van moviendo de lugar a
               medida que se carga. El borde de abajo se arrastra para cambiar el alto; doble
               clic vuelve al original. *@
            @* Alta, modificación y eliminación A MANO del detalle. Las reglas viven en
               TipoBloqueaDetalleManual y PuedeAgregarDetalleManual (abajo):
                 - tipos comerciales y de requerimiento: no; las líneas entran desde sus pestañas.
                 - ingreso de una transferencia: no; sus líneas las genera la salida.
                 - los demás (la salida de una transferencia incluida): sí.
               Cuando no se puede, el aviso dice por qué en vez de esconder el botón sin más. *@
            @if (_bloqueadoPorEstado)
            {
                @* Va aparte porque en solo lectura el aviso de abajo no se muestra. *@
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3 mb-0">
                    @_motivoEstado
                </MudAlert>
            }
            else if (!PuedeAgregarDetalleManual && !_readonly && MotivoSinAltaManual is { } motivoSinAlta)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3 mb-0">
                    @motivoSinAlta
                </MudAlert>
            }

            @* Lectura de etiquetas (código de barras / RFID). El panel y el aviso dependen del requisito del
               TIPO de movimiento: N no los muestra, O deja leer, R además avisa lo que falta leer. *@
            @if (RequisitoLectura == "R" && !_readonly && _pendientes.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 mb-0">
                    <strong>Faltan lecturas.</strong> Este tipo de movimiento exige leer las etiquetas y el movimiento no se podrá aceptar así:
                    <ul style="margin:4px 0 0;padding-left:18px;">
                        @foreach (var p in _pendientes.Take(5))
                        {
                            <li>Línea @p.NUM_SECUENCIA · <span class="mono">@p.COD_PRODUCTO</span> — @p.DES_PROBLEMA</li>
                        }
                    </ul>
                    @if (_pendientes.Count > 5) { <span>… y @(_pendientes.Count - 5) línea(s) más.</span> }
                </MudAlert>
            }
            @if (MostrarPanelLectura)
            {
                <MovimientoLecturaPanel @ref="_panelLectura" NumMovimiento="@_m.NUM_MOVIMIENTO_ALMACEN!.Value"
                                        Requisito="@RequisitoLectura" Lineas="_detalle"
                                        PuedeAutomatico="PuedeAgregarDetalleManual" ConDestino="SalidaConDestino"
                                        OnLectura="AlLeerAsync" />
            }

            <MudPaper Elevation="0" Style="border:1px solid var(--line);" Class="mt-3">
                <div class="d-flex align-center gap-2 mb-1">
                    @if (PuedeAgregarDetalleManual)
                    {
                        @* En una salida las líneas salen del stock con disponible del almacén; en
                           un ingreso se cargan con producto, ubicación y lote. *@
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Style="@EstilosBoton.Confirmar" Class="ma-1"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd" OnClick="AgregarLineas">
                            @(_flags.FLG_POSITIVO == false ? "Agregar desde el stock" : "Agregar línea")
                        </MudButton>
                    }
                    <MudSpacer />
                    @if (_cabeceraGrabada)
                    {
                        <MudIconButton Icon="@(_detalleExpandido ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                                       Size="Size.Small" Class="ma-1" OnClick="AlternarDetalleExpandido"
                                       title="@(_detalleExpandido ? "Mostrar la cabecera" : "Expandir el detalle (oculta la cabecera)")" />
                    }
                    <GridClearFiltersButton OnClear="LimpiarFiltrosDetalle" HasFilters="@(_filtrosDetalle.Any(f => f.Value is not null))" />
                </div>
                <div data-resizable-grid="movimiento-detalle" style="position:relative;">
                <MudDataGrid T="DetalleModel" Items="@BaseDetalle(-1)" Dense="true" Hover="true" Striped="true"
                             Height="460px" FixedHeader="true">
                    <Columns>
                        <PropertyColumn Property="x => x.NUM_SECUENCIA" Sortable="false" CellStyle="text-align:right;">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Sec." Activo="@(_ordenColDetalle == 0)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(0))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(0)" ValorDe="@(x => x.NUM_SECUENCIA?.ToString() ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(0)" ValoresActivosChanged="@(v => FiltroDetalle(0, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>

                        @* Código y descripción en UNA columna, igual que en los paneles de
                           órdenes de compra y requerimientos. Eran dos, y entre las dos se
                           llevaban el ancho que necesitan las cantidades: el código es largo
                           y fijo, la descripción se parte en varios renglones, y la fila
                           terminaba midiendo el triple de alto. *@
                        <TemplateColumn Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Producto" Activo="@(_ordenColDetalle == 1)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(1))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(1)" ValorDe="@(x => x.COD_PRODUCTO ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(1)" ValoresActivosChanged="@(v => FiltroDetalle(1, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="pr">
                                <div style="display:flex;flex-direction:column;line-height:1.25;">
                                    <span class="mono" style="font-size:.72rem;opacity:.6;">@pr.Item.COD_PRODUCTO</span>
                                    <span>@pr.Item.DES_PRODUCTO</span>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        @* Lote, proceso y orden de producción en una sola celda que abre el
                           mismo diálogo que los paneles. Acá va en SOLO LECTURA: esta grilla
                           es el resultado de lo ya asignado, y el lote se elige del lado de
                           disponibles, antes de asignar. *@
                        <TemplateColumn Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Lote / Orden" Activo="@(_ordenColDetalle == 2)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(2))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(2)" ValorDe="@(x => ResumenLoteOrden(x))"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(2)" ValoresActivosChanged="@(v => FiltroDetalle(2, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="ln">
                                <div @onclick="@(() => VerLoteOrdenAsync(ln.Item))"
                                     title="Clic para ver el lote y la orden de producción"
                                     style="cursor:pointer;min-height:24px;display:flex;align-items:center;gap:6px;">
                                    <span class="mono" style="font-size:.78rem;">@ResumenLoteOrden(ln.Item)</span>
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Style="opacity:.35;" />
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        @* La DESCRIPCIÓN de la unidad, no el código: "Kilogramo" se lee,
                           "KG " hay que saberlo. Si el SP no la trajo, cae al código antes
                           que dejar la celda en blanco. *@
                        <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA) ? x.COD_UNIDAD_MEDIDA : x.DES_UNIDAD_MEDIDA)"
                                        Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="UM" Activo="@(_ordenColDetalle == 3)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(3))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(3)"
                                                        ValorDe="@(x => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA) ? (x.COD_UNIDAD_MEDIDA ?? "") : x.DES_UNIDAD_MEDIDA)"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(3)" ValoresActivosChanged="@(v => FiltroDetalle(3, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        @* Seis decimales: es lo que tiene la columna en la tabla
                           (VAL_DECIMAL = decimal(10,6)). Ver "1,00" cuando lo guardado es
                           1,000125 es peor que ver un número largo. *@
                        <PropertyColumn Property="x => x.CAN_PRODUCTO"
                                        Format="@Decimales.FormatoCantidad" CellStyle="text-align:right;" Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Cantidad" Activo="@(_ordenColDetalle == 4)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(4))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(4)" ValorDe="@(x => x.CAN_PRODUCTO?.ToString(Decimales.FormatoCantidad) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(4)" ValoresActivosChanged="@(v => FiltroDetalle(4, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.CAN_PRODUCTO_SECUNDARIO"
                                        Format="@Decimales.FormatoCantidad" CellStyle="text-align:right;" Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Cant. sec." Activo="@(_ordenColDetalle == 5)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(5))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(5)" ValorDe="@(x => x.CAN_PRODUCTO_SECUNDARIO?.ToString(Decimales.FormatoCantidad) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(5)" ValoresActivosChanged="@(v => FiltroDetalle(5, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="@(x => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA_SECUNDARIO) ? x.COD_UNIDAD_MEDIDA_SECUNDARIO : x.DES_UNIDAD_MEDIDA_SECUNDARIO)"
                                        Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="UM sec." Activo="@(_ordenColDetalle == 6)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(6))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(6)"
                                                        ValorDe="@(x => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA_SECUNDARIO) ? (x.COD_UNIDAD_MEDIDA_SECUNDARIO ?? "") : x.DES_UNIDAD_MEDIDA_SECUNDARIO)"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(6)" ValoresActivosChanged="@(v => FiltroDetalle(6, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>

                        @* Acá SÍ van código y descripción de la ubicación, a diferencia de
                           los paneles: esta grilla es el documento que queda, y el código es
                           lo que se busca cuando hay que ir físicamente a ver. *@
                        <TemplateColumn Sortable="false">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Ubicación" Activo="@(_ordenColDetalle == 7)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(7))" />
                                    <FiltroExcelColumna T="DetalleModel" ItemsBase="@BaseDetalle(7)" ValorDe="@(x => x.COD_UBICACION_ALMACEN ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(7)" ValoresActivosChanged="@(v => FiltroDetalle(7, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="ub">
                                <div style="display:flex;flex-direction:column;line-height:1.25;">
                                    <span class="mono" style="font-size:.72rem;opacity:.6;">@ub.Item.COD_UBICACION_ALMACEN</span>
                                    <span>@ub.Item.DES_UBICACION_ALMACEN</span>
                                    @* En la salida de una transferencia, a qué ubicación del almacén destino entra. *@
                                    @if (SalidaConDestino && !string.IsNullOrWhiteSpace(ub.Item.COD_UBICACION_ALMACEN_SINCRONIZADO))
                                    {
                                        <span class="mono" style="font-size:.7rem;opacity:.7;" title="Ubicación en el almacén destino">→ @ub.Item.COD_UBICACION_ALMACEN_SINCRONIZADO</span>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        @* Lecturas: cuántas etiquetas tiene la línea (abre la lista para cambiar un peso o quitar una
                           mal leída), la advertencia si el tipo exige leer y la línea no está completa, y el atajo para
                           leer en ESA línea. Sin orden ni filtro: es información de apoyo, no una columna del documento. *@
                        <TemplateColumn Title="Lecturas" Sortable="false" Hidden="@(!UsaLectura)">
                            <CellTemplate>
                                <div class="d-flex align-center gap-1" style="min-height:24px;">
                                    @* Con lecturas, TODA la zona de la celda abre la grilla de lecturas de la línea (no solo el chip). *@
                                    @if (EtiquetasDe(context.Item) is { N: > 0 } et)
                                    {
                                        <div role="button" data-lecturas="@context.Item.NUM_SECUENCIA"
                                             style="flex:1;min-height:32px;cursor:pointer;display:flex;align-items:center;gap:4px;"
                                             title="@($"{et.N} lectura(s) · {et.Total.ToString(Decimales.FormatoCantidad)} {context.Item.COD_UNIDAD_MEDIDA}. Clic para ver las lecturas.")"
                                             @onclick="@(() => VerEtiquetasAsync(context.Item))">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="pointer-events:none;"
                                                     Color="@(PendienteDe(context.Item) is null ? Color.Success : Color.Warning)">@et.N</MudChip>
                                            @* De qué tipo son las lecturas: RFID, código de barras, o los dos si la línea mezcla. *@
                                            @if (et.Rfid > 0)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Sensors" Size="Size.Small" Style="opacity:.8;" data-tipo-lectura="RFID"
                                                         title="@($"RFID ({et.Rfid})")" />
                                            }
                                            @if (et.Codebar > 0)
                                            {
                                                <MudIcon Icon="@IconoCodigoBarras" Size="Size.Small" Style="opacity:.8;" data-tipo-lectura="CODEBAR"
                                                         title="@($"Código de barras ({et.Codebar})")" />
                                            }
                                            @if (RequisitoLectura == "R" && !_readonly && PendienteDe(context.Item) is { } pendiente)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" title="@pendiente.DES_PROBLEMA" />
                                            }
                                        </div>
                                    }
                                    else if (RequisitoLectura == "R" && !_readonly && PendienteDe(context.Item) is { } pend)
                                    {
                                        <MudTooltip Text="@pend.DES_PROBLEMA">
                                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                    @if (MostrarLeerEnLinea(context.Item))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.QrCodeScanner" Size="Size.Small"
                                                       title="Leer etiquetas en esta línea"
                                                       OnClick="@(() => _panelLectura?.SeleccionarLinea(context.Item.NUM_SECUENCIA ?? 0))" />
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        @* Las acciones NO están para todas las líneas.

                           Una línea que vino de un requerimiento o de una orden de compra se
                           quita desde el panel que la asignó, nunca desde acá: ese panel
                           además le devuelve lo atendido a su documento de origen. Borrarla
                           de este lado dejaría al requerimiento o a la orden creyendo que
                           sigue atendida, y nada lo avisaría.

                           Cuando no hay acción, se muestra el motivo en vez de dejar la celda
                           vacía: una celda en blanco se lee como una pantalla a medio hacer. *@
                        <TemplateColumn Title="Acciones" Sortable="false">
                            <CellTemplate>
                                @if (_readonly && !_bloqueadoPorEstado)
                                {
                                }
                                else if (!PuedeTocarLinea(context.Item))
                                {
                                    <MudTooltip Text="@MotivoLineaBloqueada(context.Item)">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="opacity:.3;" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                   title="@(TieneEtiquetas(context.Item) ? MotivoLineaConEtiquetas : "Modificar la línea")"
                                                   Disabled="@TieneEtiquetas(context.Item)"
                                                   OnClick="@(() => ModificarLinea(context.Item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                   title="Quitar la línea"
                                                   OnClick="@(() => QuitarLinea(context.Item))" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="pa-4" Style="opacity:.6;">
                            Sin líneas.
                        </MudText>
                    </NoRecordsContent>
                </MudDataGrid>
                @* Arrastrar el borde inferior cambia el alto; doble clic vuelve al original. *@
                <div class="grid-resize-handle"></div>
                </div>
            </MudPaper>
        </MudTabPanel>

        @* ═════════════════════════ TRANSPORTISTA ═════════════════════════
           SÓLO EXISTE si el movimiento mueve mercadería fuera de la empresa o entre
           sucursales: comercial, o transferencia entre sucursales. En los demás no hay
           transporte que declarar, y una pestaña vacía invita a buscar qué falta.

           Ojo con la diferencia: los campos de adentro se DESHABILITAN según la matriz; la
           pestaña entera se OCULTA. Es una decisión distinta — acá no hay nada que mostrar
           en gris, directamente no aplica. *@
        @if (VerPestanaTransportista)
        {
        <MudTabPanel Text="Transportista" Icon="@Icons.Material.Filled.LocalShipping">
            @* Los seis en UNA fila, como pediste.

               rejilla-campos y no campos-config: con 24 columnas el column-gap se aplica
               entre cada par de pistas y un campo que ocupa 6 se come 5 de esos huecos, así
               que ni los anchos ni la separación salen como se declaran. rejilla-campos
               reparte medio espacio por celda, como hace MudGrid.

                   Transportista 6 · Brevete 3 · Dir. Origen 5 · Ubigeo 2 · Dir. Destino 5 · Ubigeo 3  = 24 *@
            <div class="rejilla-campos" style="grid-template-columns:repeat(24,minmax(0,1fr));">
                @if (Ver("COD_ENTIDAD_TRANSPORTISTA"))
                {
                    <div style="grid-column:span 6;">
                        @* Entidades del tipo TRN, no el catálogo entero. *@
                        <AriaCombo TItem="ComboboxItem" Items="_transportistas"
                                   TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_m.COD_ENTIDAD_TRANSPORTISTA?.ToString())"
                                   ValueChanged="OnTransportistaChanged"
                                   Label="Transportista" Disabled="@(!Editable("COD_ENTIDAD_TRANSPORTISTA"))" Class="" />
                    </div>
                    @* El brevete, al lado: es lo que se controla en la ruta. Sale del documento
                       de identidad tipo 6 de ESA entidad, y es de sólo lectura — se mantiene
                       en el maestro de entidades, no acá. *@
                    <div style="grid-column:span 3;">
                        <CampoTexto Label="Brevete" Value="@(_brevete ?? "")"
                                    ValueChanged="@(_ => { })" Disabled="true" Class="" />
                    </div>
                }

                @* Los dos PUNTOS del traslado —partida y llegada— los RESUELVE el SHOWBYID, no
                   la pantalla:

                     · una SALIDA parte de la sucursal del almacén del movimiento y llega al
                       OTRO punto;
                     · un INGRESO es al revés: parte del OTRO punto y llega a la sucursal.

                   El OTRO punto es la sucursal del almacén contrario en una transferencia, y
                   en el resto la dirección de la entidad que se ELIGE acá. Esa elección es lo
                   único que se graba (NUM_SECUENCIA_DIRECCION): el texto de las direcciones se
                   lee de las sucursales y de la entidad cada vez, así que si cambian, el
                   movimiento lo refleja.

                   Esa decisión vive en el SP porque depende de las banderas del tipo y de dos
                   caminos distintos de JOIN. Repetirla acá sería tener la misma regla escrita
                   en dos lugares, condenados a separarse. Por eso, donde el otro punto se
                   elige, el combo ocupa el lugar del texto de ESE punto y el otro punto sigue
                   siendo de sólo lectura. *@
                <div style="grid-column:span 5;">
                    @if (UsaDireccionDeLaEntidad && EsIngreso && Ver("NUM_SECUENCIA_DIRECCION"))
                    {
                        @DireccionDeLaEntidad()
                    }
                    else
                    {
                        <CampoTexto Label="Dirección de Origen" Value="@(_m.DES_DIRECCION_ORIGEN ?? "")"
                                    ValueChanged="@(_ => { })" Disabled="true" Class="" />
                    }
                </div>
                <div style="grid-column:span 2;">
                    <CampoTexto Label="Ubigeo de Origen" Value="@(_m.DES_UBIGEO_ORIGEN ?? "")"
                                ValueChanged="@(_ => { })" Disabled="true" Class="" />
                </div>
                @if (Ver("DES_DIRECCION_DESTINO"))
                {
                    <div style="grid-column:span 5;">
                        @if (UsaDireccionDeLaEntidad && !EsIngreso && Ver("NUM_SECUENCIA_DIRECCION"))
                        {
                            @DireccionDeLaEntidad()
                        }
                        else
                        {
                            <CampoTexto Label="Dirección de Destino" Value="@(_m.DES_DIRECCION_DESTINO ?? "")"
                                        ValueChanged="@(_ => { })" Disabled="true" Class="" />
                        }
                    </div>
                }
                @if (Ver("COD_UBIGEO_DESTINO"))
                {
                    <div style="grid-column:span 3;">
                        <CampoTexto Label="Ubigeo de Destino" Value="@(_m.DES_UBIGEO ?? _m.COD_UBIGEO_DESTINO ?? "")"
                                    ValueChanged="@(_ => { })" Disabled="true" Class="" />
                    </div>
                }
            </div>

            @* ── TRANSPORTES ───────────────────────────────────────────────────────────
               El CRUD vive EN LA GRILLA, sin diálogo: son tres datos —el transporte, si es
               acarreo y una observación— y abrir una ventana para eso es más ceremonia que
               trabajo.

               Las especificaciones técnicas van en UNA celda, juntas. Son las del maestro del
               transporte (placa, inscripción, certificado): acá no se editan, se muestran
               para saber qué unidad se está declarando. *@
            <div class="d-flex align-center justify-space-between mt-4 mb-2">
                <div>
                    <MudText Typo="Typo.subtitle2">Transportes</MudText>
                    <MudText Class="mono" Style="opacity:.5;font-size:.74rem;">
                        @if (_cabeceraGrabada) { <text>@_transportes.Count asignados</text> }
                        else { <text>Graba la cabecera para asignar transportes</text> }
                    </MudText>
                    @* Un movimiento lleva UN vehículo principal y, como opción, UNO de acarreo. Se dice
                       acá qué rol tendrá el próximo que se agregue, para no hacer adivinar. *@
                    @if (_cabeceraGrabada && !_readonly)
                    {
                        <MudText Class="mono" Style="opacity:.6;font-size:.74rem;">@ReglaVehiculosMovimiento.TextoRolDelNuevo(_numPrincipales, _numAcarreos)</MudText>
                    }
                </div>
                @if (_cabeceraGrabada && !_readonly)
                {
                    <div class="d-flex align-center gap-2">
                        @* Al triple del ancho que toma por sí solo: la descripción de un
                           transporte es larga —unidad, marca, placa— y en el ancho natural se
                           cortaba justo en lo que sirve para distinguir uno de otro.

                           Con min() para que en una pantalla angosta no se pase del contenedor
                           y empuje al botón fuera de la vista. *@
                        <div style="flex:0 0 auto;width:min(720px,55vw);">
                            <AriaCombo TItem="ComboboxItem" Items="_transportesDisponibles"
                                       TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                       @bind-Value="_transporteNuevo" Label="Transporte" Class="" />
                        </div>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(string.IsNullOrWhiteSpace(_transporteNuevo) || _rolNuevo == ReglaVehiculosMovimiento.Rol.Ninguno)"
                                   OnClick="AgregarTransporte">Agregar</MudButton>
                    </div>
                }
            </div>

            @if (_cabeceraGrabada)
            {
                @if (_problemaVehiculos is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_problemaVehiculos</MudAlert>
                }
                <div class="d-flex align-center gap-2 mb-1">
                    <MudSpacer />
                    <GridClearFiltersButton OnClear="LimpiarFiltrosTransporte" HasFilters="@(_filtrosTransporte.Any(f => f.Value is not null))" />
                </div>
                <div data-resizable-grid="movimiento-transportes" data-default-height="220" style="position:relative;">
                <MudDataGrid T="TransporteModel" Items="@BaseTransporte(-1)" Dense="true" Hover="true" Striped="true"
                             Height="100%" FixedHeader="true">
                    <Columns>
                        <TemplateColumn Sortable="false" Width="220">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Transporte" Activo="@(_ordenColTransporte == 0)" Ascendente="_ordenAscTransporte" OnClick="@(() => ToggleOrdenTransporte(0))" />
                                    <FiltroExcelColumna T="TransporteModel" ItemsBase="@BaseTransporte(0)" ValorDe="@(x => x.COD_TRANSPORTE ?? "")"
                                                        ValoresActivos="_filtrosTransporte.GetValueOrDefault(0)" ValoresActivosChanged="@(v => FiltroTransporte(0, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="tr">
                                <div class="mono">@tr.Item.COD_TRANSPORTE</div>
                                <div style="font-size:.78rem;opacity:.75;">@tr.Item.DES_TRANSPORTE</div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false">
                            @* Todas en una celda, como pediste: una debajo de otra, cada una
                               con su nombre. Es información de contexto, no una grilla más. *@
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Datos del vehículo" Activo="@(_ordenColTransporte == 1)" Ascendente="_ordenAscTransporte" OnClick="@(() => ToggleOrdenTransporte(1))" />
                                    @* Filtra por el mismo texto de la celda, todo junto: es un dato
                                       compuesto y no tiene sentido partirlo en columnas propias. *@
                                    <FiltroExcelColumna T="TransporteModel" ItemsBase="@BaseTransporte(1)" ValorDe="@(x => TextoEspecificaciones(x))"
                                                        ValoresActivos="_filtrosTransporte.GetValueOrDefault(1)" ValoresActivosChanged="@(v => FiltroTransporte(1, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="tr">
                                @if (_especificaciones.TryGetValue(tr.Item.COD_TRANSPORTE ?? "", out var lista) && lista.Count > 0)
                                {
                                    <div style="font-size:.78rem;line-height:1.35;">
                                        @foreach (var e in lista)
                                        {
                                            <div><span style="opacity:.6;">@(e.DES_ESPECIFICACION_TECNICA_SINGULAR ?? e.DES_ESPECIFICACION_TECNICA):</span> <span class="mono">@ValorEspecificacion(e)</span></div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="opacity:.45;">Sin especificaciones cargadas</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        @* FLG_ACARREO queda fuera del filtro a propósito: es lo que pediste
                           excluir. *@
                        <TemplateColumn Title="Acarreo" Sortable="false" Width="110" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                            <CellTemplate Context="tr">
                                @{ var fila = tr.Item; }
                                @* El rol se elige al agregar. El interruptor solo se habilita si el cambio deja al
                                   movimiento válido (un principal y, como máximo, un acarreo): sirve para arreglar uno que
                                   venía mal. Para cambiar el rol de uno que está bien, se quita y se agrega de nuevo. *@
                                <span title="@TituloAcarreo(fila)">
                                    <MudSwitch T="bool" Value="@(fila.FLG_ACARREO == true)"
                                               ValueChanged="@(v => CambiarAcarreo(fila, v))"
                                               Color="Color.Primary" Disabled="@(_readonly || !PuedeCambiarAcarreo(fila))" />
                                </span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Width="300">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Observación" Activo="@(_ordenColTransporte == 2)" Ascendente="_ordenAscTransporte" OnClick="@(() => ToggleOrdenTransporte(2))" />
                                    <FiltroExcelColumna T="TransporteModel" ItemsBase="@BaseTransporte(2)" ValorDe="@(x => x.DES_OBSERVACION ?? "")"
                                                        ValoresActivos="_filtrosTransporte.GetValueOrDefault(2)" ValoresActivosChanged="@(v => FiltroTransporte(2, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate Context="tr">
                                @{ var fila = tr.Item; }
                                <CampoTexto Label="" MostrarLabel="false" Value="@(fila.DES_OBSERVACION ?? "")"
                                            ValueChanged="@(v => fila.DES_OBSERVACION = v)"
                                            OnBlur="@(() => GuardarTransporte(fila))"
                                            Disabled="_readonly" Class="" Margin="Margin.Dense" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="" Sortable="false" Width="60" CellStyle="text-align:center;">
                            <CellTemplate Context="tr">
                                @{ var fila = tr.Item; }
                                @if (!_readonly)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   title="Quitar el transporte" OnClick="@(() => QuitarTransporte(fila))" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Class="pa-4" Style="opacity:.6;">Sin transportes asignados.</MudText>
                    </NoRecordsContent>
                </MudDataGrid>
                <div class="grid-resize-handle"></div>
                </div>
            }
        </MudTabPanel>
        }

        @* ══════════ GUÍA DE REMISIÓN ══════════
           Una salida con la cabecera ya grabada: antes de grabar no hay número de movimiento y la
           guía se arma con lo grabado. La pestaña revisa si el movimiento está en condiciones de
           emitir su guía y, si ya la tiene, muestra su estado (ver GuiaRemisionPanel). *@
        @if (MuestraGuiaRemision)
        {
            <MudTabPanel Text="Guía de remisión" Icon="@Icons.Material.Filled.FactCheck">
                <GuiaRemisionPanel NumMovimiento="@_m.NUM_MOVIMIENTO_ALMACEN" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" OnGuiaCambiada="GuiaCambiadaAsync" />
            </MudTabPanel>
        }

        @* ══════════ REQUERIMIENTOS Y ÓRDENES DE COMPRA ══════════
           Cada una aparece SÓLO en el tipo de movimiento que la usa. Una pestaña que no
           corresponde no es neutra: invita a entrar, y adentro no hay nada que hacer.

           Las dos condiciones son excluyentes por construcción, así que nunca se ven
           juntas. Y mientras no haya un tipo elegido, _flags viene vacío y no se ve
           ninguna de las dos, que es lo correcto: todavía no se sabe qué clase de
           movimiento es. *@
        @if (MuestraRequerimientos)
        {
            <MudTabPanel Text="Requerimientos" Icon="@Icons.Material.Filled.Assignment">
                @* Mismo esquema que Órdenes de Compra, en su propio componente por el mismo
                   motivo: este archivo ya es largo. *@
                <MovimientoRequerimientosPanel NumMovimiento="@_m.NUM_MOVIMIENTO_ALMACEN"
                                           OnDetalleCambiado="RecargarDetalleDesdePanel"
                                           MotivoSoloLectura="@_motivoEstado" />
            </MudTabPanel>
        }

        @* Devolución de compra: asociar guías de compra del mismo proveedor y elegir items/cantidades a devolver. *@
        @if (MuestraDevolucionCompra)
        {
            <MudTabPanel Text="Devolución de compra" Icon="@Icons.Material.Filled.AssignmentReturn">
                <MovimientoDevolucionCompraPanel NumMovimiento="@_m.NUM_MOVIMIENTO_ALMACEN"
                                           OnDetalleCambiado="RecargarDetalleDesdePanel"
                                           MotivoSoloLectura="@_motivoEstado"
                                           CodEntidad="@_m.COD_ENTIDAD?.ToString()"
                                           DesEntidad="@(_entidades.FirstOrDefault(e => e.Id == _m.COD_ENTIDAD?.ToString())?.Texto)" />
            </MudTabPanel>
        }

        @if (MuestraCompras)
        {
            <MudTabPanel Text="Órdenes de Compra" Icon="@Icons.Material.Filled.ShoppingCart">
                @* Las cuatro grillas viven en su propio componente: este archivo ya es largo y
                   ahí adentro el bloque se entiende solo. Recibe el número del movimiento, que
                   es lo único que necesitan tres de las cuatro consultas. *@
                <MovimientoOrdenesCompraPanel NumMovimiento="@_m.NUM_MOVIMIENTO_ALMACEN"
                                           OnDetalleCambiado="RecargarDetalleDesdePanel"
                                           MotivoSoloLectura="@_motivoEstado"
                                           CodEntidad="@_m.COD_ENTIDAD"
                                           DesEntidad="@(_entidades.FirstOrDefault(e => e.Id == _m.COD_ENTIDAD?.ToString())?.Texto)" />
            </MudTabPanel>
        }
    </MudTabs>

</EditForm>

@code {
    [Parameter] public EventCallback<bool> OnCerrar { get; set; }
    [Parameter] public Modelo? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    // Opción de menú de la pantalla (Movimientos de Almacén): de ella salen los botones
    // marcados como Diálogo que van en el pie.
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    // Los botones de diálogo se conectan acá. Mientras uno no tenga su acción, tocarlo avisa
    // en vez de no hacer nada (mismo criterio que RequerimientoDocumento).
    private Task OnAccionDialog(BotonTreeviewItem b)
        => EsBotonTransferir(b) ? TransferirAsync() : AvisarBotonSinConectar(b);

    /// <summary>Reconoce el botón TRANSFERIR: primero por DES_METODO ("Transferir") y, como
    /// respaldo, por el nombre, alias o tooltip visible — mismo criterio que "Versiones" en
    /// Diseños. No por COD_BOTON_OPCION: ese código cambia de una opción a otra. Lo usa también
    /// la grilla de Movimientos de Almacén.</summary>
    public static bool EsBotonTransferir(BotonTreeviewItem b)
    {
        if (string.Equals(b.DES_METODO?.Trim(), "Transferir", StringComparison.OrdinalIgnoreCase)) return true;
        var n = ((b.DES_BOTON_OPCION ?? b.DES_ALIAS ?? "") + " " + (b.DES_TOOLTIPTEXT ?? "")).ToUpperInvariant();
        return n.Contains("TRANSFER");
    }

    /// <summary>La confirmación de TRANSFERIR, la misma desde el documento y desde la grilla.</summary>
    public static async Task<bool> ConfirmarTransferenciaAsync(IDialogService dialogService, decimal num)
    {
        var dlg = await dialogService.ShowAsync<ConfirmarAccionDialog>("Transferir",
            new DialogParameters
            {
                ["Titulo"] = "Transferir",
                ["IconoTitulo"] = Icons.Material.Filled.LocalShipping,
                ["Mensaje"] = $"¿Transferir el movimiento N° {num}? Pasa a su estado de enviado.",
                ["TextoConfirmar"] = "Transferir",
                ["IconoConfirmar"] = Icons.Material.Filled.LocalShipping
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        return (await dlg.Result) is { Canceled: false };
    }

    /// <summary>PROC_LOGISTICA_MOVIMIENTOS_ALMACEN_TRANSFERIR: pasa el movimiento a su estado
    /// "enviado" (alias ENV). Si el estado actual lo permite ya lo decidió el botón, con su flujo.
    /// Después se relee la cabecera: con el estado nuevo cambian los botones del pie y si el
    /// detalle se puede tocar.</summary>
    private async Task TransferirAsync()
    {
        if (_m.NUM_MOVIMIENTO_ALMACEN is not { } num) return;
        if (!await ConfirmarTransferenciaAsync(DialogService, num)) return;
        _saving = true;
        try
        {
            var resp = await Http.PostAsync(ApiRoutes.Logistica.MovimientosAlmacenTransferir(num), null);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Movimiento N° {num} transferido.", Severity.Success);
                _huboCambios = true;
                await RecargarCabeceraAsync();
            }
            else
            {
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(MovimientoAlmacenDocumento), nameof(TransferirAsync), "No se pudo transferir");
            }
        }
        finally { _saving = false; }
    }

    // ── El detalle, sujeto al estado de la cabecera ─────────────────────────────────
    /// <summary>Por qué el estado actual de la cabecera no deja tocar el detalle (null: lo deja).
    ///
    /// Lo decide el flujo de estados del botón de MODIFICAR de esta opción (el que tiene
    /// FLG_ACCION_PUT), con el mismo SP que habilita los botones del pie
    /// (PROC_ESTANDAR_OPCIONES_PROCESOS_ESTADOS_FLUJOS_DEPENDENCIA_VALIDA): si en este estado no se
    /// puede modificar el movimiento, tampoco agregar, cambiar o quitar sus líneas, ni desde la
    /// grilla ni desde las pestañas Requerimientos / Órdenes de Compra.
    ///
    /// Sin tipo de estado, sin botón de modificar o si la validación no responde, no se bloquea
    /// nada: es lo que pasaba antes.</summary>
    private string? _motivoFlujo;
    /// <summary>Por qué el documento no se puede modificar: el flujo de estados del botón MODIFICAR (_motivoFlujo) o la guía de remisión ya
    /// enviada a SUNAT (_motivoGuia). La guía manda: es lo que no se puede deshacer.</summary>
    private string? _motivoEstado => _motivoGuia ?? _motivoFlujo;
    private string? _motivoGuia;
    private (int? Tipo, int? Estado) _estadoValidado = (-1, -1);

    /// <summary>El botón MODIFICAR de la opción: por su nombre primero (es el que se ve y se
    /// configura en Configuración de Flujos de los Estados), así no depende de cómo estén
    /// marcadas las acciones HTTP de los demás botones —NUEVO o ANULAR también pueden traer
    /// PUT—. Si ninguno se llama así, el que tenga sólo la acción PUT, sin POST ni DELETE.</summary>
    private static BotonTreeviewItem? BotonModificar(IEnumerable<BotonTreeviewItem> botones)
    {
        var conCodigo = botones.Where(b => !string.IsNullOrWhiteSpace(b.COD_BOTON_OPCION))
                               .OrderBy(b => b.NUM_ORDEN_PRESENTACION ?? int.MaxValue).ToList();
        static string Nombre(BotonTreeviewItem b)
            => ((b.DES_BOTON_OPCION ?? "") + " " + (b.DES_ALIAS ?? "") + " " + (b.DES_METODO ?? "")).ToUpperInvariant();
        return conCodigo.FirstOrDefault(b => Nombre(b).Contains("MODIFIC"))
            ?? conCodigo.FirstOrDefault(b => b.FLG_ACCION_PUT == true && b.FLG_ACCION_POST != true && b.FLG_ACCION_DELETE != true);
    }

    private async Task ValidarEstadoDetalleAsync()
    {
        if (_estadoValidado == (_m.COD_TIPO_ESTADO, _m.COD_ESTADO)) return;
        _estadoValidado = (_m.COD_TIPO_ESTADO, _m.COD_ESTADO);
        _motivoFlujo = null;
        if (!_cabeceraGrabada || _m.COD_TIPO_ESTADO is not { } tipo || _m.COD_ESTADO is not { } estado
            || string.IsNullOrWhiteSpace(CodAplicacion) || string.IsNullOrWhiteSpace(CodOpcionAplicacion)) return;

        // Los botones de la opción, frescos: el documento puede validar antes de que el pie
        // (AccionesBotones) los refresque. Mismo llamado que hace AccionesBotones al iniciar.
        await MenuService.AsegurarBotonesFrescosAsync(CodAplicacion, CodOpcionAplicacion);
        var modificar = BotonModificar(MenuService.GetBotonesPorOpcion(CodAplicacion, CodOpcionAplicacion));
        if (modificar is null)
        {
            await ErrorLog.TraceAsync($"DETALLE SUJETO AL ESTADO — la opción {CodAplicacion}/{CodOpcionAplicacion} no tiene botón MODIFICAR habilitado para el rol: el detalle no se bloquea.");
            return;
        }

        var r = await Http.SafeGetAsync<KONSolutions.Shared.Models.Estandar.OpcionesProcesosEstadosFlujosDependenciaValidaResult>(
            $"{ApiRoutes.Estandar.OpcionesProcesosEstadosFlujosDependenciaValidar}" +
            $"?codAplicacion={Uri.EscapeDataString(CodAplicacion)}&codOpcionAplicacion={Uri.EscapeDataString(CodOpcionAplicacion)}" +
            $"&codBotonOpcion={Uri.EscapeDataString(modificar.COD_BOTON_OPCION!)}&codTipoEstado={tipo}&codEstadoActual={estado}");
        // La evidencia, igual que "VALIDAR FLUJO" en AccionesBotones: qué botón se validó, con qué
        // estado y qué respondió el SP.
        await ErrorLog.TraceAsync(
            $"DETALLE SUJETO AL ESTADO — movimiento {_m.NUM_MOVIMIENTO_ALMACEN}: botón {modificar.DES_BOTON_OPCION ?? modificar.DES_ALIAS} " +
            $"(@COD_BOTON_OPCION={modificar.COD_BOTON_OPCION}) @COD_TIPO_ESTADO={tipo} @COD_ESTADO_ACTUAL={estado} " +
            $"→ FLG_VALIDO={(r?.FLG_VALIDO.ToString() ?? "null (sin respuesta)")} {r?.DES_MENSAJE}");
        if (r is { FLG_VALIDO: false })
            _motivoFlujo = "En el estado actual el movimiento no se puede modificar, ni la cabecera ni el detalle (flujo de estados del botón "
                          + $"{modificar.DES_BOTON_OPCION ?? modificar.COD_BOTON_OPCION}). {r.DES_MENSAJE}";
    }

    /// <summary>Una guía de remisión ENVIADA o ACEPTADA congela el movimiento: lo que se envió a SUNAT tiene que seguir siendo lo que dice el
    /// movimiento. La base ya lo impide (script 08_GUIAS_REMISION_BLOQUEO_MOVIMIENTO.sql); esto lo deja de solo lectura con el motivo a la vista,
    /// en vez de dejar escribir y avisar recién al grabar. Solo se pregunta en un movimiento que puede tener guía (una salida ya grabada).</summary>
    private async Task ValidarGuiaAsync()
    {
        var antes = _motivoGuia;
        _motivoGuia = null;
        if (MuestraGuiaRemision && _m.NUM_MOVIMIENTO_ALMACEN is { } num)
        {
            var b = await Http.SafeGetAsync<GuiaRemisionBloqueo>(ApiRoutes.Logistica.GuiaRemisionBloqueoPorMovimiento(num));
            if (b is { FLG_BLOQUEADO: true }) _motivoGuia = b.DES_MENSAJE;
        }
        if (antes != _motivoGuia) StateHasChanged();
    }

    /// <summary>La pestaña de la guía emitió, consultó o reintentó: la guía pudo pasar a ENVIADA o ACEPTADA (o volver a editable).</summary>
    private Task GuiaCambiadaAsync() => ValidarGuiaAsync();

    private async Task AvisarBotonSinConectar(BotonTreeviewItem b)
    {
        await ErrorLog.TraceAsync(
            $"BOTÓN DE DIÁLOGO — {b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION} " +
            $"(método configurado: {b.DES_METODO ?? "sin método"}) sobre el movimiento {_m.NUM_MOVIMIENTO_ALMACEN}");
        await ErrorDialogHelper.MostrarAvisoAsync(
            $"El botón \"{b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION}\" todavía no tiene una acción conectada en esta pantalla.",
            DialogService, nameof(MovimientoAlmacenDocumento), "Acción pendiente");
    }

    private Modelo _m = new();

    private List<DetalleModel> _detalle = new();

    // ── Filtro de columna, estilo Excel, para la grilla de detalle ────────────────────────
    private readonly Dictionary<int, HashSet<string>?> _filtrosDetalle = new();

    private List<DetalleModel> BaseDetalle(int col) => AplicarFiltrosDetalle(OrdenarDetalle(_detalle), col);

    private string ValorDetalle(DetalleModel x, int col) => col switch
    {
        0 => x.NUM_SECUENCIA?.ToString() ?? "",
        1 => x.COD_PRODUCTO ?? "",
        2 => ResumenLoteOrden(x),
        3 => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA) ? (x.COD_UNIDAD_MEDIDA ?? "") : x.DES_UNIDAD_MEDIDA,
        4 => x.CAN_PRODUCTO?.ToString(Decimales.FormatoCantidad) ?? "",
        5 => x.CAN_PRODUCTO_SECUNDARIO?.ToString(Decimales.FormatoCantidad) ?? "",
        6 => string.IsNullOrWhiteSpace(x.DES_UNIDAD_MEDIDA_SECUNDARIO) ? (x.COD_UNIDAD_MEDIDA_SECUNDARIO ?? "") : x.DES_UNIDAD_MEDIDA_SECUNDARIO,
        7 => x.COD_UBICACION_ALMACEN ?? "",
        _ => ""
    };

    private int? _ordenColDetalle;
    private bool _ordenAscDetalle = true;
    private void ToggleOrdenDetalle(int col) { if (_ordenColDetalle == col) _ordenAscDetalle = !_ordenAscDetalle; else { _ordenColDetalle = col; _ordenAscDetalle = true; } }
    private List<DetalleModel> OrdenarDetalle(List<DetalleModel> items) => _ordenColDetalle is not { } col ? items : _ordenAscDetalle ? items.OrderBy(x => ValorDetalle(x, col)).ToList() : items.OrderByDescending(x => ValorDetalle(x, col)).ToList();

    private List<DetalleModel> AplicarFiltrosDetalle(List<DetalleModel> src, int ex)
    {
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtrosDetalle) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<DetalleModel> q = src;
        foreach (var (c, v) in _filtrosDetalle)
        {
            if (c == ex || v is null) continue;
            q = q.Where(x => v.Contains(ValorDetalle(x, c)));
        }
        return q.ToList();
    }

    private void FiltroDetalle(int c, HashSet<string>? v) { _filtrosDetalle[c] = v; StateHasChanged(); }
    private void LimpiarFiltrosDetalle() { foreach (var k in _filtrosDetalle.Keys.ToList()) _filtrosDetalle[k] = null; StateHasChanged(); }
    private MovimientosAlmacenLoadCombosResult _combos = new();
    private TiposMovimiento _flags = new();

    // ── Qué pestañas corresponden a este tipo de movimiento ──────────────────────────
    //
    // Las dos salen del TIPO, no del documento: es el tipo el que dice si este movimiento
    // atiende compras o requerimientos.

    /// <summary>Órdenes de Compra: comercial y que SUMA stock.
    ///
    /// Los dos flags, no sólo el comercial: una salida comercial también es comercial, y
    /// ahí no se reciben órdenes de compra — se despacha. Lo que trae mercadería contra
    /// una orden es el movimiento positivo.</summary>
    private bool MuestraCompras
        => _flags.FLG_COMERCIAL == true && _flags.FLG_POSITIVO == true;

    /// <summary>Devolución de compra: comercial, devolución y que RESTA stock (FLG_POSITIVO = false; NULL no es una salida).</summary>
    private bool MuestraDevolucionCompra
        => _flags.FLG_COMERCIAL == true && _flags.FLG_DEVOLUCION == true && _flags.FLG_POSITIVO == false;

    /// <summary>Requerimientos: de requerimiento y que RESTA stock.
    ///
    /// El requerimiento se atiende sacando del almacén, así que el movimiento es negativo.
    ///
    /// Comparo contra false y no uso "distinto de true" a propósito: la columna es
    /// NULLABLE en TIPOS_MOVIMIENTO, y un tipo con el flag sin definir no es un tipo
    /// negativo, es un tipo sin clasificar. Con NULL la pestaña no aparece, que es la misma
    /// respuesta que daría SQL para FLG_POSITIVO = 0.</summary>
    private bool MuestraRequerimientos
        => _flags.FLG_REQUERIMIENTO == true && _flags.FLG_POSITIVO == false;

    /// <summary>Guía de remisión: una SALIDA con la cabecera grabada. Se compara contra false por la misma razón
    /// que Requerimientos: FLG_POSITIVO es NULLABLE y un tipo sin clasificar no es una salida.
    /// Se muestra en toda salida y no solo en las comerciales o las transferencias: qué motivos exigen guía
    /// lo decidirán las reglas por motivo, y esconder la pestaña antes de eso sería decidirlo a ciegas.</summary>
    private bool MuestraGuiaRemision
        => _cabeceraGrabada && _flags.FLG_POSITIVO == false;


