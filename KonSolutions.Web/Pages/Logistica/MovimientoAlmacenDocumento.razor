    private List<TransporteModel> _transportes = new();

    // ── Filtro de columna, estilo Excel, para la grilla de transportes ────────────────────
    private readonly Dictionary<int, HashSet<string>?> _filtrosTransporte = new();

    private List<TransporteModel> BaseTransporte(int col) => AplicarFiltrosTransporte(OrdenarTransporte(_transportes), col);

    private string ValorTransporte(TransporteModel x, int col) => col switch
    {
        0 => x.COD_TRANSPORTE ?? "",
        1 => TextoEspecificaciones(x),
        2 => x.DES_OBSERVACION ?? "",
        _ => ""
    };

    private int? _ordenColTransporte;
    private bool _ordenAscTransporte = true;
    private void ToggleOrdenTransporte(int col) { if (_ordenColTransporte == col) _ordenAscTransporte = !_ordenAscTransporte; else { _ordenColTransporte = col; _ordenAscTransporte = true; } }
    private List<TransporteModel> OrdenarTransporte(List<TransporteModel> items) => _ordenColTransporte is not { } col ? items : _ordenAscTransporte ? items.OrderBy(x => ValorTransporte(x, col)).ToList() : items.OrderByDescending(x => ValorTransporte(x, col)).ToList();

    private List<TransporteModel> AplicarFiltrosTransporte(List<TransporteModel> src, int ex)
    {
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtrosTransporte) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<TransporteModel> q = src;
        foreach (var (c, v) in _filtrosTransporte)
        {
            if (c == ex || v is null) continue;
            q = q.Where(x => v.Contains(ValorTransporte(x, c)));
        }
        return q.ToList();
    }

    private void FiltroTransporte(int c, HashSet<string>? v) { _filtrosTransporte[c] = v; StateHasChanged(); }
    private void LimpiarFiltrosTransporte() { foreach (var k in _filtrosTransporte.Keys.ToList()) _filtrosTransporte[k] = null; StateHasChanged(); }

    /// <summary>El texto de "Datos del vehículo" tal como se ve en la celda, todo junto en una
    /// sola línea: es lo que compara el filtro Excel de esa columna.</summary>
    private string TextoEspecificaciones(TransporteModel tr)
    {
        if (!_especificaciones.TryGetValue(tr.COD_TRANSPORTE ?? "", out var lista) || lista.Count == 0)
            return "";
        return string.Join(" · ", lista.Select(e =>
            $"{e.DES_ESPECIFICACION_TECNICA_SINGULAR ?? e.DES_ESPECIFICACION_TECNICA}: {ValorEspecificacion(e)}"));
    }
    private List<ComboboxItem> _transportesTodos = new();
    private string? _transporteNuevo;

