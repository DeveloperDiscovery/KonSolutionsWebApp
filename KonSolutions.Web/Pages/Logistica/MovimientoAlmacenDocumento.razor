    /// <summary>El brevete del transportista elegido. Sólo lectura: se mantiene en el maestro
    /// de entidades. Si no lo tiene cargado, el campo queda vacío — y eso es un dato, no un
    /// error: quiere decir que a esa entidad le falta el documento.</summary>
    private async Task CargarBrevete()
    {
        _brevete = null;
