@page "/logistica/tipos-transporte"
@attribute [Authorize]
@using Modelo = KONSolutions.Shared.Models.Logistica.LogisticaTiposTransporte
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Transporte · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Transporte" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema LOGISTICA · @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipostransporte" style="position:relative;">
    <MudDataGrid T="Modelo" Items="_items" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("LOGISTICA.TIPOS_TRANSPORTE","COD_TIPO_TRANSPORTE",80,120)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <CellTemplate><span class="mono">@context.Item.COD_TIPO_TRANSPORTE</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("LOGISTICA.TIPOS_TRANSPORTE","DES_TIPO_TRANSPORTE",180,340)">
                <CellTemplate>@context.Item.DES_TIPO_TRANSPORTE</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Grupo" Width="160">
                <CellTemplate>@context.Item.DES_GRUPO_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Familia" Width="160">
                <CellTemplate>@context.Item.DES_FAMILIA_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Sub Familia" Width="160">
                <CellTemplate>@context.Item.DES_SUB_FAMILIA_PRODUCTO</CellTemplate>
            </TemplateColumn>
            @* Las cuatro marcas de vía van juntas: cada una es un sí/no independiente. *@
            <TemplateColumn Sortable="false" Title="Vía" Width="180px">
                <CellTemplate>
                    <div class="d-flex align-center gap-2">
                        @if (context.Item.FLG_TERRESTRE == true)
                        {
                            <span title="Terrestre" style="display:inline-flex;align-items:center;"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Color="Color.Primary" /></span>
                        }
                        @if (context.Item.FLG_MARITIMO == true)
                        {
                            <span title="Marítimo" style="display:inline-flex;align-items:center;"><MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" Color="Color.Primary" /></span>
                        }
                        @if (context.Item.FLG_FLUVIAL == true)
                        {
                            <span title="Fluvial" style="display:inline-flex;align-items:center;"><MudIcon Icon="@Icons.Material.Filled.Water" Size="Size.Small" Color="Color.Primary" /></span>
                        }
                        @if (context.Item.FLG_AEREO == true)
                        {
                            <span title="Aéreo" style="display:inline-flex;align-items:center;"><MudIcon Icon="@Icons.Material.Filled.Flight" Size="Size.Small" Color="Color.Primary" /></span>
                        }
                        @if (!(context.Item.FLG_TERRESTRE == true || context.Item.FLG_MARITIMO == true || context.Item.FLG_FLUVIAL == true || context.Item.FLG_AEREO == true))
                        {
                            <span style="opacity:.35;">—</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Modelo" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Modelo> _items = new();
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("LOGISTICA", "TiposTransporte");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("LOGISTICA.TIPOS_TRANSPORTE", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    /// <summary>Con texto de búsqueda usa el SP _SEARCH (esta tabla sí lo tiene funcionando);
    /// sin texto trae el listado completo por SHOWALL.</summary>
    private async Task Load()
    {
        try
        {
            var ruta = string.IsNullOrWhiteSpace(_search)
                ? ApiRoutes.Logistica.TiposTransporte
                : $"{ApiRoutes.Logistica.TiposTransporteSearch}?search={Uri.EscapeDataString(_search)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<Modelo>>>(ruta);
            _items = r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposTransporte), nameof(Load));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(TiposTransporte));
            _items = new();
        }
    }

    private Task Buscar() => Load();

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(Modelo item, BotonTreeviewItem b)
    {
        // Del más específico al más genérico. Un botón de Modificar suele traer
        // marcados GET y PUT a la vez (para editar primero hay que leer), y un
        // Eliminar suele traer GET y DELETE: preguntando por GET primero, esos dos
        // entraban por la rama de consulta y el lápiz y el tacho abrean en sólo
        // lectura. Con DELETE y PUT antes, cada botón hace lo que dice su nombre.
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(Modelo? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo registro",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_TRANSPORTE}",
            CrudModo.Read   => $"Consultar · {item?.DES_TIPO_TRANSPORTE}",
            _               => $"Editar · {item?.DES_TIPO_TRANSPORTE}"
        };
        var dlg = await DialogService.ShowAsync<TiposTransporteDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["CodAplicacion"] = CodAplicacion, ["CodOpcionAplicacion"] = CodOpcionAplicacion },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("LOGISTICA.TIPOS_TRANSPORTE", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
