    private static string NombreTotal(string? funcion) => funcion switch { "MAX" => "Máximo", "MIN" => "Mínimo", "AVG" => "Promedio", _ => "Total" };

    private static string SinArroba(string? nombre) => (nombre ?? "").Trim().TrimStart('@');

    /// <summary>Las líneas de los enlaces («NOMBRE=expresión», con o sin @). Una línea con solo un nombre es NOMBRE={NOMBRE}
    /// (como la lee el motor).</summary>
    private static List<(string Nombre, string Expresion)> EnlacesDe(ReporteLienzoObjeto o)
    {
        var res = new List<(string, string)>();
        foreach (var linea in (o.DES_ENLACES ?? "").Replace("\r\n", "\n").Split('\n'))
        {
            var i = linea.IndexOf('=');
            var nombre = SinArroba(i < 0 ? linea : linea[..i]);
            if (nombre.Length == 0) continue;
            res.Add((nombre, i < 0 ? "{" + nombre + "}" : linea[(i + 1)..].Trim()));
        }
        return res;
    }

    /// <summary>Guarda los enlaces, una línea por cada uno (los de un subinforme con @, como sus parámetros).</summary>
    private static void GuardarEnlaces(ReporteLienzoObjeto o, IEnumerable<(string Nombre, string Expresion)> lista)
    {
        var arroba = o.COD_TIPO_OBJETO == "SUB" ? "@" : "";
        o.DES_ENLACES = Vacio(string.Join("\n", lista.Where(x => x.Nombre.Length > 0 && x.Expresion.Length > 0).Select(x => $"{arroba}{x.Nombre}={x.Expresion}")));
    }

    private void CambiarEnlace(ReporteLienzoObjeto o, int i, string? nombre, string? expresion)
    {
        var lista = EnlacesDe(o);
        if (i < 0 || i >= lista.Count) return;
        Antes();
        lista[i] = (SinArroba(nombre ?? lista[i].Nombre), (expresion ?? lista[i].Expresion).Trim());
        GuardarEnlaces(o, lista);
    }

    private void QuitarEnlace(ReporteLienzoObjeto o, int i)
    {
        var lista = EnlacesDe(o);
        if (i < 0 || i >= lista.Count) return;
        Antes();
        lista.RemoveAt(i);
        GuardarEnlaces(o, lista);
    }

    /// <summary>Un enlace nuevo de una tabla: la primera columna del resultado que también trae el resultado 1 (las dos
    /// del mismo nombre, como el número de la orden); si no hay, la primera de cada uno.</summary>
    private void AgregarEnlace(ReporteLienzoObjeto o)
    {
        var propias = Columnas(o.NUM_RESULTADO ?? 1);
        var comun = propias.FirstOrDefault(c => Columnas(1).Any(x => Igual(x.DES_COLUMNA, c.DES_COLUMNA)) && !EnlacesDe(o).Any(e => Igual(e.Nombre, c.DES_COLUMNA)));
        var izq = comun?.DES_COLUMNA ?? propias.FirstOrDefault()?.DES_COLUMNA;
        var der = comun?.DES_COLUMNA ?? Columnas(1).FirstOrDefault()?.DES_COLUMNA;
        if (izq is null || der is null) return;
        Antes();
        GuardarEnlaces(o, EnlacesDe(o).Append((izq, "{" + der + "}")));
    }

    /// <summary>El enlace de un parámetro del subinforme (vacío: el automático).</summary>
    private void PonerEnlace(ReporteLienzoObjeto o, string parametro, string? expresion)
    {
        Antes();
        var lista = EnlacesDe(o).Where(e => !Igual(e.Nombre, parametro)).ToList();
        if (Vacio(expresion) is { } x) lista.Add((parametro, x));
        GuardarEnlaces(o, lista);
    }

    /// <summary>Las filas que muestra una tabla o una tabla cruzada: las que calzan con la fila que se imprime.</summary>
    private RenderFragment EnlacesTabla(ReporteLienzoObjeto o) => __builder =>
    {
        var lista = EnlacesDe(o);
        var r = o.NUM_RESULTADO ?? 1;
        <div class="lz-prop-sub">Solo las filas de la fila que se imprime</div>
        for (var k = 0; k < lista.Count; k++)
        {
            var i = k;
            var (izq, der) = lista[k];
            <div class="lz-enlace">
                <select class="lz-in" value="@izq" title="@($"La columna del resultado {r}")" @onchange="@(e => CambiarEnlace(o, i, e.Value?.ToString(), null))">
                    @foreach (var c in Columnas(r)) { <option value="@c.DES_COLUMNA">@c.DES_COLUMNA</option> }
                    @if (!Columnas(r).Any(c => Igual(c.DES_COLUMNA, izq))) { <option value="@izq">@($"{izq} (no está)")</option> }
                </select>
                <span>=</span>
                <input class="lz-in mono" list="lz-marcas" value="@der" title="Lo de la fila que se imprime: {COLUMNA} del resultado 1, {@@PARAMETRO}, {F.Formula} o un valor fijo"
                       @onchange="@(e => CambiarEnlace(o, i, null, e.Value?.ToString()))" />
                <button type="button" class="lz-mini" title="Quitar el enlace" @onclick="@(() => QuitarEnlace(o, i))">✕</button>
            </div>
        }
        <div><button type="button" class="lz-mini" disabled="@(Columnas(r).Count == 0)" @onclick="@(() => AgregarEnlace(o))">+ Enlace</button></div>
        <div class="lz-ayuda">@(lista.Count == 0
            ? $"Sin enlaces salen todas las filas{(o.COD_TIPO_OBJETO is "CRU" or "GRA" && r == 1 ? " (del grupo, en un encabezado o pie de grupo)" : "")}. Con un enlace, solo las que calzan con la fila que se imprime: el detalle de cada orden en un listado de órdenes."
            : $"Salen solo las filas del resultado {r} cuyas columnas son iguales a lo de la fila que se imprime (en el detalle, cada fila; en un grupo, su primera fila).")</div>
        if ((o.DES_ENLACES?.Length ?? 0) > 2000) { <div class="lz-aviso">Los enlaces pasan de 2000 caracteres: no se va a poder grabar.</div> }
    };

    /// <summary>De dónde sale cada parámetro del subinforme: el enlace escrito o, si está vacío, el automático (en gris).</summary>
    private RenderFragment ParametrosSub(ReporteLienzoObjeto o) => __builder =>
    {
        if (o.NUM_DISENO_SUB is null) return;
        var fs = FuenteSub(o, out var leyendo);
        if (fs is null)
        {
            <div class="lz-ayuda">@(leyendo ? "Leyendo sus parámetros…" : "No se pudo leer la fuente del subinforme: sus parámetros se enlazan solos por nombre.")</div>
            return;
        }
        var enlaces = EnlacesDe(o);
        var parametros = fs.Parametros.OrderBy(p => p.NUM_ORDEN).ToList();
        if (parametros.Count == 0) { <div class="lz-ayuda">Su fuente no tiene parámetros: sale igual en cada fila.</div> }
        foreach (var p in parametros)
        {
            var campo = SinArroba(p.DES_PARAMETRO);
            var actual = enlaces.FirstOrDefault(e => Igual(e.Nombre, campo)).Expresion;
            <div class="lz-param">
                <label title="@(p.DES_ETIQUETA ?? campo)">@($"@{campo}{(p.FLG_OBLIGATORIO ? " *" : "")}")</label>
                @if (p.FLG_SISTEMA)
                {
                    <span class="lz-ayuda">lo pone el sistema</span>
                }
                else
                {
                    <input class="lz-in mono" list="lz-marcas" value="@actual" placeholder="@Automatico(campo, p)"
                           @onchange="@(e => PonerEnlace(o, campo, e.Value?.ToString()))" />
                }
            </div>
            if (!p.FLG_SISTEMA && actual is null && p.FLG_OBLIGATORIO && Automatico(campo, p) == "(vacío)")
            {
                <div class="lz-aviso">@($"@{campo} es obligatorio y no tiene de dónde salir: enlázalo.")</div>
            }
        }
        foreach (var e in enlaces.Where(e => !parametros.Any(p => Igual(SinArroba(p.DES_PARAMETRO), e.Nombre))))
        {
            var nombre = e.Nombre;
            <div class="lz-aviso">@($"@{nombre} ya no es un parámetro del subinforme.") <button type="button" class="lz-mini" @onclick="@(() => PonerEnlace(o, nombre, null))">Quitar</button></div>
        }
        <div class="lz-ayuda">Vacío: lo de la columna de la fila con su mismo nombre, el parámetro del reporte con su mismo nombre o su valor por defecto (lo que se ve en gris). Puedes escribir {COLUMNA}, {@@PARAMETRO}, {F.Formula}, {R2.COLUMNA} o un valor fijo.</div>
    };

    /// <summary>De dónde sale solo un parámetro del subinforme que no se enlazó (lo mismo que hace el motor).</summary>
    private string Automatico(string campo, ReporteFuenteParametro p)
        => Columnas(1).Any(c => Igual(c.DES_COLUMNA, campo)) ? $"{{{campo}}} de la fila"
         : Fuente?.Parametros.Any(x => Igual(SinArroba(x.DES_PARAMETRO), campo)) == true ? $"{{@{campo}}} del reporte"
         : p.COD_VALOR_DEFECTO is { Length: > 0 } d ? $"su valor por defecto ({d})"
         : "(vacío)";

    /// <summary>La fuente del subinforme (sus parámetros). La primera vez se pide y se dibuja cuando llega.</summary>
    private ReporteFuenteDetalle? FuenteSub(ReporteLienzoObjeto o, out bool leyendo)
    {
        leyendo = false;
        if (o.NUM_DISENO_SUB is not { } n || Disenos.FirstOrDefault(d => d.NUM_DISENO == n)?.NUM_FUENTE is not { } nf) return null;
        if (Fuente is not null && Fuente.Fuente.NUM_FUENTE == nf) return Fuente;
        if (_fuentesSub.TryGetValue(nf, out var f)) return f;
        leyendo = LeerFuente is not null;
        if (leyendo && _leyendo.Add(nf)) _ = Leer(nf);
        return null;
    }

    private async Task Leer(int nf)
    {
        try { _fuentesSub[nf] = await LeerFuente!(nf); }
        catch { _fuentesSub[nf] = null; }
        finally { _leyendo.Remove(nf); }
        await InvokeAsync(StateHasChanged);
    }

    private void CambiarSubinforme(ReporteLienzoObjeto o, int? numero)
    {
        if (numero == o.NUM_DISENO_SUB) return;
        Antes();
        o.NUM_DISENO_SUB = numero;
    }

    /// <summary>Al cambiar el resultado de una tabla cruzada, las columnas que ese resultado no tiene se cambian por las
    /// primeras que sirven (filas y columnas: las que no son números; lo que resume: un número que no sea ninguna de esas).</summary>
    private void CambiarResultadoCruzada(ReporteLienzoObjeto o, int resultado, bool guardar = true)
    {
        if (guardar) Antes();
        o.NUM_RESULTADO = resultado;
        var cols = Columnas(resultado);
        bool Tiene(string? c) => c is not null && cols.Any(x => Igual(x.DES_COLUMNA, c));
        var textos = cols.Where(c => !EsNumero(c.DES_TIPO_DATO)).Select(c => c.DES_COLUMNA).Concat(cols.Select(c => c.DES_COLUMNA)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (!Tiene(o.DES_CRUCE_FILAS)) o.DES_CRUCE_FILAS = textos.FirstOrDefault(c => !Igual(c, o.DES_CRUCE_COLUMNAS));
        if (!Tiene(o.DES_CRUCE_COLUMNAS)) o.DES_CRUCE_COLUMNAS = textos.FirstOrDefault(c => !Igual(c, o.DES_CRUCE_FILAS));
        if (!Tiene(o.DES_ORIGEN))
            o.DES_ORIGEN = cols.Where(c => EsNumero(c.DES_TIPO_DATO)).Select(c => c.DES_COLUMNA)
                               .FirstOrDefault(c => !Igual(c, o.DES_CRUCE_FILAS) && !Igual(c, o.DES_CRUCE_COLUMNAS)) ?? PrimeraColumna(resultado, true);
        // Los enlaces eran de las columnas del resultado anterior.
        if (guardar) GuardarEnlaces(o, EnlacesDe(o).Where(e => Tiene(e.Nombre)));
    }

    // ── Gráficos ────────────────────────────────────────────────────────────────
    // Los colores del motor, en el mismo orden (la primera serie, o la única, en azul).
    private static readonly string[] PaletaGrafico = { "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948" };
    private static readonly (string Codigo, string Nombre)[] TiposGrafico =
        { ("COL", "Columnas"), ("BAR", "Barras horizontales"), ("LIN", "Líneas"), ("TOR", "Torta"), ("ANI", "Anillo") };

    private void CambiarTipoGrafico(ReporteLienzoObjeto o, string? tipo)
    {
        Antes();
        o.COD_GRAFICO = tipo is "BAR" or "LIN" or "TOR" or "ANI" ? tipo : "COL";
        // Una torta o un anillo no tiene series; solo las columnas y las barras se apilan.
        if (o.COD_GRAFICO is "TOR" or "ANI") o.DES_CRUCE_COLUMNAS = null;
        if (o.COD_GRAFICO is not ("COL" or "BAR")) o.FLG_APILADO = false;
        if (o.COD_GRAFICO is "TOR" or "ANI" && o.NUM_MAXIMO_CATEGORIAS > 8) o.NUM_MAXIMO_CATEGORIAS = 8;
    }

    private void CambiarSeriesGrafico(ReporteLienzoObjeto o, string? columna)
    {
        Antes();
        o.DES_CRUCE_COLUMNAS = Vacio(columna);
        if (o.DES_CRUCE_COLUMNAS is null) o.FLG_APILADO = false;
    }

    /// <summary>Al elegir el resultado: las categorías, la primera columna que no es un número (una fecha o un texto); lo
    /// que resume, la primera que sí. Las series y los enlaces que no son de ese resultado se quitan.</summary>
    private void CambiarResultadoGrafico(ReporteLienzoObjeto o, int resultado, bool guardar = true)
    {
        if (guardar) Antes();
        o.NUM_RESULTADO = resultado;
        var cols = Columnas(resultado);
        bool Tiene(string? c) => c is not null && cols.Any(x => Igual(x.DES_COLUMNA, c));
        if (!Tiene(o.DES_CRUCE_FILAS))
            o.DES_CRUCE_FILAS = cols.Where(c => !EsNumero(c.DES_TIPO_DATO)).Select(c => c.DES_COLUMNA).FirstOrDefault() ?? cols.FirstOrDefault()?.DES_COLUMNA;
        if (!Tiene(o.DES_CRUCE_COLUMNAS)) o.DES_CRUCE_COLUMNAS = null;
        if (!Tiene(o.DES_ORIGEN))
            o.DES_ORIGEN = cols.Where(c => EsNumero(c.DES_TIPO_DATO)).Select(c => c.DES_COLUMNA).FirstOrDefault(c => !Igual(c, o.DES_CRUCE_FILAS))
                           ?? PrimeraColumna(resultado, true);
        if (guardar) GuardarEnlaces(o, EnlacesDe(o).Where(e => Tiene(e.Nombre)));
    }

    private string PieGrafico(ReporteLienzoObjeto o)
    {
        var tipo = TiposGrafico.FirstOrDefault(t => t.Codigo == (o.COD_GRAFICO ?? "COL")).Nombre ?? "Gráfico";
        var series = o.DES_CRUCE_COLUMNAS is not null && o.COD_GRAFICO is not ("TOR" or "ANI") ? $" y {o.DES_CRUCE_COLUMNAS}" : "";
        return $"{tipo} R{o.NUM_RESULTADO ?? 1} · {Funcion(o.COD_FUNCION)} {o.DES_ORIGEN} por {o.DES_CRUCE_FILAS}{series}{(EnlacesDe(o).Count > 0 ? " · enlazado" : "")}";
    }

    private static string AyudaGrafico(ReporteLienzoObjeto o)
    {
        var torta = o.COD_GRAFICO is "TOR" or "ANI";
        var r = o.NUM_RESULTADO ?? 1;
        return (torta
                ? "Una porción por cada valor de la columna (solo las que suman algo positivo). Si no dices un máximo, 6: las 5 mayores y las demás juntas en «Otros» (a lo más 8)."
                : "Una columna, barra o punto por cada valor de las categorías y, si eliges series, uno de cada color por cada valor de las series (hasta 8: las demás juntas en «Otros»). "
                  + (o.COD_GRAFICO == "LIN" ? "En líneas, el máximo de categorías deja las últimas." : "Con un máximo de categorías, quedan las de mayor valor y las demás van en «Otros»."))
             + (r == 1 ? " Del resultado 1: en el encabezado o el pie de un grupo resume las filas del grupo; en otra sección, todas." : " De otro resultado: todas sus filas.")
             + " Sale en el PDF y en el Excel con formato, como gráfico de Excel con sus números en la hoja «Datos de gráficos».";
    }

    /// <summary>Un dibujo del tipo de gráfico (no son sus datos), para reconocerlo en el lienzo.</summary>
    private static MarkupString MiniGrafico(ReporteLienzoObjeto o)
    {
        var inv = CultureInfo.InvariantCulture;
        string N(double d) => d.ToString("0.##", inv);
        var tipo = o.COD_GRAFICO ?? "COL";
        var torta = tipo is "TOR" or "ANI";
        var series = o.DES_CRUCE_COLUMNAS is null || torta ? 1 : 3;
        // El color va tal cual en el dibujo: solo si es un #rrggbb.
        var uno = o.DES_COLOR is { } dc && Regex.IsMatch(dc, "^#[0-9A-Fa-f]{6}$") ? dc : PaletaGrafico[0];
        string C(int j) => series == 1 ? uno : PaletaGrafico[j];
        double[][] v = { new[] { .55, .8, .4, .95, .65 }, new[] { .35, .5, .6, .45, .3 }, new[] { .2, .3, .25, .35, .4 } };
        var s = new System.Text.StringBuilder();
        if (torta)
        {
            double[] partes = { .34, .24, .18, .14, .1 };
            double a = -Math.PI / 2;
            for (var i = 0; i < partes.Length; i++)
            {
                var b = a + partes[i] * 2 * Math.PI;
                s.Append($"<path d=\"M50,50 L{N(50 + 46 * Math.Cos(a))},{N(50 + 46 * Math.Sin(a))} A46,46 0 {(partes[i] > .5 ? 1 : 0)} 1 {N(50 + 46 * Math.Cos(b))},{N(50 + 46 * Math.Sin(b))} Z\" fill=\"{PaletaGrafico[i]}\" stroke=\"#fff\" stroke-width=\"1.5\"/>");
                a = b;
            }
            if (tipo == "ANI") s.Append("<circle cx=\"50\" cy=\"50\" r=\"25\" fill=\"#fff\"/>");
            return new MarkupString($"<svg class=\"lz-gra-svg\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"xMidYMid meet\">{s}</svg>");
        }
        var apilado = o.FLG_APILADO && series > 1;
        if (tipo == "LIN")
        {
            for (var j = 0; j < series; j++)
                s.Append($"<polyline points=\"{string.Join(" ", v[j].Select((y, i) => $"{N(10 + i * 20)},{N(58 - y * 52)}"))}\" fill=\"none\" stroke=\"{C(j)}\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\"/>");
        }
        else
        {
            var barras = tipo == "BAR";
            for (var i = 0; i < 5; i++)
            {
                double base0 = 0;
                for (var j = 0; j < series; j++)
                {
                    var largo = v[j][i] * (apilado ? 0.55 : 1);
                    var grueso = apilado || series == 1 ? 12.0 : 4.5;
                    var corrido = apilado || series == 1 ? 0 : (j - 1) * 4.8;
                    // Las barras van en franjas de 12 de alto: más delgadas que las columnas (franjas de 20 de ancho).
                    var gruesoB = apilado || series == 1 ? 7.0 : 3.0;
                    var corridoB = apilado || series == 1 ? 0 : (j - 1) * 3.2;
                    if (barras) s.Append($"<rect x=\"{N(base0 * 96)}\" y=\"{N(i * 12 + 6 - gruesoB / 2 + corridoB)}\" width=\"{N(largo * 96)}\" height=\"{N(gruesoB)}\" fill=\"{C(j)}\"/>");
                    else s.Append($"<rect x=\"{N(i * 20 + 10 - grueso / 2 + corrido)}\" y=\"{N(60 - (base0 + largo) * 58)}\" width=\"{N(grueso)}\" height=\"{N(largo * 58)}\" fill=\"{C(j)}\"/>");
                    if (apilado) base0 += largo;
                }
            }
        }
        s.Append(tipo == "BAR"
            ? "<line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"60\" stroke=\"#c3c2b7\" vector-effect=\"non-scaling-stroke\"/>"
            : "<line x1=\"0\" y1=\"60\" x2=\"100\" y2=\"60\" stroke=\"#c3c2b7\" vector-effect=\"non-scaling-stroke\"/>");
        return new MarkupString($"<svg class=\"lz-gra-svg\" viewBox=\"0 0 100 60\" preserveAspectRatio=\"none\">{s}</svg>");
    }

    private string Ayuda(ReporteLienzoObjeto o)
    {
        if (!Cruza(o))
            return $"{NombreTipo(o.COD_TIPO_OBJETO)} · x {F(o.NUM_X)} y {F(o.NUM_Y)} · {F(o.NUM_ANCHO)} × {F(o.NUM_ALTO)} mm"
                 + (o.FLG_HASTA_ABAJO ? " · llega al pie de la sección si esta crece" : "")
                 + (o.NUM_GIRO != 0 ? $" · girado {o.NUM_GIRO}°" : "")
                 + (o.COD_TIPO_OBJETO == "BAR" ? $" · {(o.COD_CODIGO == "EAN" ? "EAN-13" : o.COD_CODIGO == "QR" ? "QR" : "Code 128")}: {o.DES_ORIGEN}" : "");
        string Nombre(int? n) => L.Bandas.FirstOrDefault(b => b.NUM_BANDA == n) is { } b ? NombreBanda(b) : "?";
        return $"{NombreTipo(o.COD_TIPO_OBJETO)} que cruza · de {Nombre(o.NUM_BANDA)} (y {F(o.NUM_Y)}) a {Nombre(o.NUM_BANDA_FIN)} (y {F(o.NUM_Y_FIN)})"
             + $" · x {F(o.NUM_X)}{(o.COD_TIPO_OBJETO == "CUA" ? $" · {F(o.NUM_ANCHO)} de ancho" : "")} mm";
    }

    private bool Fuera(ReporteLienzoObjeto o) => (double)(o.NUM_X + o.NUM_ANCHO) > Ancho + 0.01;

    private string EstiloObjeto(ReporteLienzoObjeto o)
    {
        var s = new System.Text.StringBuilder();
        s.Append($"left:{Px((double)o.NUM_X)};top:{Px((double)o.NUM_Y)};width:{Px((double)o.NUM_ANCHO)};height:{Px((double)o.NUM_ALTO)};z-index:{Math.Max(1, o.NUM_ORDEN)};");
        if (o.COD_TIPO_OBJETO == "LIN") return s.ToString();
        if (o.DES_COLOR_FONDO is { Length: > 0 } fondo) s.Append($"background-color:{fondo};");
        if (o.COD_TIPO_OBJETO == "CUA")
        {
            var g = (double)(o.NUM_GROSOR_BORDE ?? 0.5m);
            if (g > 0) s.Append($"border:{F(Math.Max(1, Pt(g)))}px solid {o.DES_COLOR_BORDE ?? "#000000"};");
            return s.ToString();
        }
        if (o.COD_TIPO_OBJETO is "IMG" or "TAB" or "CRU" or "SUB" or "GRA") return s.ToString();
        var tam = (double)(o.NUM_TAMANO_LETRA ?? D.NUM_TAMANO_LETRA);
        s.Append($"font-size:{F(Pt(tam))}px;");
        s.Append(o.DES_FUENTE switch { "SERIF" => "font-family:'Times New Roman',Times,serif;", "MONO" => "font-family:'Courier New',Courier,monospace;", _ => "font-family:Arial,Helvetica,sans-serif;" });
        // Un código lleva la letra y el color de su texto (las barras son de ese color); sin bordes.
        if (o.COD_TIPO_OBJETO == "BAR") return s.Append($"color:{o.DES_COLOR ?? "#000000"};").ToString();
        if (o.FLG_NEGRITA) s.Append("font-weight:700;");
        if (o.FLG_CURSIVA) s.Append("font-style:italic;");
        if (o.FLG_SUBRAYADO) s.Append("text-decoration:underline;");
        s.Append($"color:{o.DES_COLOR ?? "#000000"};");
        s.Append((o.COD_ALINEACION ?? "I") switch { "C" => "text-align:center;", "D" => "text-align:right;", "J" => "text-align:justify;", _ => "text-align:left;" });
        var bordes = o.DES_BORDES ?? "";
        if (bordes.Length > 0 || !string.IsNullOrEmpty(o.DES_COLOR_FONDO)) s.Append($"padding:{Px(0.6)};");
        if (bordes.Length > 0)
        {
            var linea = $"{F(Math.Max(1, Pt((double)(o.NUM_GROSOR_BORDE ?? 0.5m))))}px solid {o.DES_COLOR_BORDE ?? "#000000"}";
            if (bordes.Contains('A')) s.Append($"border-top:{linea};");
            if (bordes.Contains('B')) s.Append($"border-bottom:{linea};");
            if (bordes.Contains('I')) s.Append($"border-left:{linea};");
            if (bordes.Contains('D')) s.Append($"border-right:{linea};");
        }
        return s.ToString();
    }

    /// <summary>Un texto girado se ve girado también en el lienzo: a lo alto, su caja tiene el ancho y el alto cambiados y
    /// se gira desde el centro (90: se lee de abajo hacia arriba, como en el PDF).</summary>
    private string Girado(ReporteLienzoObjeto o) => o.NUM_GIRO switch
    {
        90 or 270 => $"position:absolute;left:50%;top:50%;width:{Px((double)o.NUM_ALTO)};height:{Px((double)o.NUM_ANCHO)};"
                   + $"transform:translate(-50%,-50%) rotate({(o.NUM_GIRO == 90 ? -90 : 90)}deg);",
        180 => "transform:rotate(180deg);",
        _ => ""
    };

    /// <summary>Al pasar de horizontal a girado a lo alto (o al revés), el recuadro se gira con el texto si quedaba echado
    /// al otro lado; la sección crece si no entra.</summary>
    private void Girar(ReporteLienzoObjeto o, int giro)
    {
        Antes();
        giro = giro is 90 or 180 or 270 ? giro : 0;
        var vertical = giro is 90 or 270;
        if (vertical != (o.NUM_GIRO is 90 or 270) && (vertical ? o.NUM_ANCHO > o.NUM_ALTO : o.NUM_ALTO > o.NUM_ANCHO))
            (o.NUM_ANCHO, o.NUM_ALTO) = (o.NUM_ALTO, o.NUM_ANCHO);
        o.NUM_GIRO = giro;
        if (vertical) o.FLG_PUEDE_CRECER = false;
        if (L.Bandas.FirstOrDefault(b => b.NUM_BANDA == o.NUM_BANDA) is { } banda && o.NUM_Y + o.NUM_ALTO > banda.NUM_ALTO)
            banda.NUM_ALTO = Math.Min(400, o.NUM_Y + o.NUM_ALTO + 0.5m);
    }

    /// <summary>Lo que se ve antes de imprimir de un código con un valor fijo (sin marcas): lo mismo que diría el reporte.
    /// Con marcas, el valor se sabe al imprimir.</summary>
    private static string? AvisoCodigo(ReporteLienzoObjeto o)
    {
        var v = o.DES_ORIGEN ?? "";
        if (v.Trim().Length == 0) return "Falta qué codifica: sin eso no se graba.";
        if (v.Contains('{')) return null;
        switch (o.COD_CODIGO)
        {
            case "EAN":
                // Los espacios y guiones no cuentan (775-1234-56789).
                var t = v.Replace(" ", "").Replace("-", "");
                if (t.Length is not (12 or 13) || !t.All(char.IsAsciiDigit)) return "EAN-13: 12 o 13 números.";
                var suma = 0;
                for (var i = 0; i < 12; i++) suma += (t[i] - '0') * (i % 2 == 0 ? 1 : 3);
                var control = (10 - suma % 10) % 10;
                return t.Length == 13 && t[12] - '0' != control ? $"EAN-13: el dígito de control no cuadra (debería ser {control})." : null;
            case "QR":
                return null;
            default:
                if (v.Length > 80) return "Code 128: hasta 80 caracteres.";
                return v.Any(c => c < 32 || c > 126) ? "Code 128: solo letras sin tilde, números y signos." : null;
        }
    }

    private static string Lado(string? a) => a switch { "I" => "left", "D" => "right", _ => "center" };

    private static string? MimeImagen(byte[] b)
    {
        if (b.Length < 8) return null;
        if (b[0] == 0x89 && b[1] == 0x50) return "image/png";
        if (b[0] == 0xFF && b[1] == 0xD8) return "image/jpeg";
        if (b[0] == 0x47 && b[1] == 0x49) return "image/gif";
        if (b[0] == 0x42 && b[1] == 0x4D) return "image/bmp";
        return null;
    }

    private static string DataUrl(byte[] b) => $"data:{MimeImagen(b) ?? "image/png"};base64,{Convert.ToBase64String(b)}";

