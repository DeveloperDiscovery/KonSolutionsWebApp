    private ReporteLienzoFormula? FormulaDe(string? nombre) => L.Formulas.FirstOrDefault(f => Igual(f.DES_NOMBRE, nombre));
    private bool SinFormula(ReporteLienzoObjeto o) => o.COD_TIPO_OBJETO == "FOR" && FormulaDe(o.DES_ORIGEN) is null;

    /// <summary>{F.Nombre} escrito como sea ({ F.nombre }...), para renombrar o ver dónde se usa.</summary>
    private static Regex Referencia(string nombre) => new(@"\{\s*F\s*\.\s*" + Regex.Escape(nombre) + @"\s*\}", RegexOptions.IgnoreCase);

    /// <summary>Abre el editor. modo F: una fórmula (nombre, texto, descripción); C: la condición de una propiedad.</summary>
    private async Task<FormulaEditorDialog.Resultado?> AbrirEditor(string modo, string? nombre, string? texto, string? descripcion,
                                                                  char? elemento = null, string? propiedad = null, string? donde = null, bool puedeQuitar = false)
    {
        if (Fuente is null || D.NUM_FUENTE is not { } fuente)
        {
            Snackbar.Add("Elige la fuente en «General»: las fórmulas usan sus datos.", Severity.Warning);
            return null;
        }
        var p = new DialogParameters
        {
            [nameof(FormulaEditorDialog.Modo)] = modo,
            [nameof(FormulaEditorDialog.Nombre)] = nombre,
            [nameof(FormulaEditorDialog.Texto)] = texto,
            [nameof(FormulaEditorDialog.Descripcion)] = descripcion,
            [nameof(FormulaEditorDialog.Elemento)] = elemento?.ToString(),
            [nameof(FormulaEditorDialog.Propiedad)] = propiedad,
            [nameof(FormulaEditorDialog.Donde)] = donde,
            [nameof(FormulaEditorDialog.PuedeQuitar)] = puedeQuitar,
            [nameof(FormulaEditorDialog.NumFuente)] = fuente,
            [nameof(FormulaEditorDialog.Fuente)] = Fuente,
            [nameof(FormulaEditorDialog.Formulas)] = L.Formulas.Select(f => new ReporteLienzoFormula { DES_NOMBRE = f.DES_NOMBRE, DES_FORMULA = f.DES_FORMULA, DES_DESCRIPCION = f.DES_DESCRIPCION }).ToList(),
            [nameof(FormulaEditorDialog.Grupos)] = L.Grupos.OrderBy(g => g.NUM_NIVEL).Select(g => g.DES_COLUMNA).ToList()
        };
        var dlg = await DialogService.ShowAsync<FormulaEditorDialog>("", p,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, BackdropClick = false });
        var res = await dlg.Result;
        return res is { Canceled: false, Data: FormulaEditorDialog.Resultado r } ? r : null;
    }

    private Task NuevaFormula() => CrearFormula();

    private async Task<ReporteLienzoFormula?> CrearFormula()
    {
        var r = await AbrirEditor("F", null, "", null);
        if (r is null) return null;
        Antes();
        var f = new ReporteLienzoFormula { DES_NOMBRE = r.Nombre, DES_FORMULA = r.Texto, DES_DESCRIPCION = r.Descripcion };
        L.Formulas.Add(f);
        StateHasChanged();
        return f;
    }

    /// <summary>«Fórmula» de la barra: se escribe la fórmula y queda su campo donde se soltó (o en la sección elegida).</summary>
    private async Task CrearFormulaYPoner(ReporteLienzoBanda b, double x, double y)
    {
        var f = await CrearFormula();
        if (f is null) return;
        var destino = L.Bandas.FirstOrDefault(z => z.NUM_BANDA == b.NUM_BANDA) ?? BandaDestino();
        if (destino is null) return;
        Poner($"FOR||{f.DES_NOMBRE}", destino, x, y);
        StateHasChanged();
    }

    private async Task EditarFormula(ReporteLienzoFormula? f)
    {
        if (f is null) return;
        var anterior = f.DES_NOMBRE;
        var r = await AbrirEditor("F", f.DES_NOMBRE, f.DES_FORMULA, f.DES_DESCRIPCION);
        if (r is null || FormulaDe(anterior) is not { } actual) return;
        Antes();
        actual.DES_FORMULA = r.Texto;
        actual.DES_DESCRIPCION = r.Descripcion;
        if (!string.Equals(anterior, r.Nombre, StringComparison.Ordinal))
        {
            Renombrar(anterior, r.Nombre);
            actual.DES_NOMBRE = r.Nombre;
        }
        StateHasChanged();
    }

    /// <summary>El nombre nuevo también donde se usa: otras fórmulas, condiciones, textos y campos de fórmula.</summary>
    private void Renombrar(string anterior, string nuevo)
    {
        var rx = Referencia(anterior);
        var marca = "{F." + nuevo + "}";
        foreach (var x in L.Formulas) x.DES_FORMULA = rx.Replace(x.DES_FORMULA ?? "", marca);
        foreach (var c in L.Condiciones) c.DES_FORMULA = rx.Replace(c.DES_FORMULA ?? "", marca);
        foreach (var o in L.Objetos)
        {
            if (o.COD_TIPO_OBJETO == "TXT" && o.DES_ORIGEN is { } t) o.DES_ORIGEN = rx.Replace(t, marca);
            if (o.COD_TIPO_OBJETO == "FOR" && Igual(o.DES_ORIGEN, anterior)) o.DES_ORIGEN = nuevo;
        }
    }

    /// <summary>Una fórmula que usa otra fórmula, una condición o un texto no se elimina (quedarían con error). Los
    /// campos que solo la muestran se quitan con ella, avisando antes.</summary>
    private async Task EliminarFormula(ReporteLienzoFormula f)
    {
        var rx = Referencia(f.DES_NOMBRE);
        var usos = L.Formulas.Where(x => x != f && rx.IsMatch(x.DES_FORMULA ?? "")).Select(x => $"la fórmula {x.DES_NOMBRE}").ToList();
        var conds = L.Condiciones.Count(c => rx.IsMatch(c.DES_FORMULA ?? ""));
        if (conds > 0) usos.Add(conds == 1 ? "una condición" : $"{conds} condiciones");
        var textos = L.Objetos.Count(o => o.COD_TIPO_OBJETO == "TXT" && rx.IsMatch(o.DES_ORIGEN ?? ""));
        if (textos > 0) usos.Add(textos == 1 ? "un texto" : $"{textos} textos");
        if (usos.Count > 0)
        {
            Snackbar.Add($"No se puede eliminar «{f.DES_NOMBRE}»: la usa {string.Join(", ", usos)}. Primero cambia o quita esos usos.", Severity.Warning);
            return;
        }
        var campos = L.Objetos.Where(o => o.COD_TIPO_OBJETO == "FOR" && Igual(o.DES_ORIGEN, f.DES_NOMBRE)).Select(o => o.NUM_OBJETO).ToHashSet();
        var mensaje = campos.Count == 0 ? $"¿Eliminar la fórmula «{f.DES_NOMBRE}»?"
                    : $"¿Eliminar la fórmula «{f.DES_NOMBRE}»? También se quita{(campos.Count == 1 ? " el campo" : $"n los {campos.Count} campos")} del lienzo que la muestra{(campos.Count == 1 ? "" : "n")}.";
        var ok = await DialogService.ShowMessageBox("Eliminar fórmula", mensaje, yesText: "Eliminar", cancelText: "Cancelar");
        if (ok != true) return;
        Antes();
        L.Formulas.RemoveAll(x => Igual(x.DES_NOMBRE, f.DES_NOMBRE));
        L.Objetos.RemoveAll(o => campos.Contains(o.NUM_OBJETO));
        Huerfanas();
        _sel.RemoveAll(campos.Contains);
        StateHasChanged();
    }

