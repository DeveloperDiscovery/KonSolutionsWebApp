    private IEnumerable<ReporteLienzoObjeto> ObjetosDe(ReporteLienzoBanda b)
        => L.Objetos.Where(o => o.NUM_BANDA == b.NUM_BANDA && !Cruza(o)).OrderBy(o => o.NUM_ORDEN).ThenBy(o => o.NUM_OBJETO);
    private int Siguiente() => L.Objetos.Select(o => o.NUM_OBJETO).DefaultIfEmpty(0).Max() + 1;

    /// <summary>La sección donde va lo que se inserta con un clic: la elegida, la del objeto elegido o el detalle.</summary>
    private ReporteLienzoBanda? BandaDestino()
