        var nombres = elementos.Count > 0 ? elementos.Where(e => e.FLG_VISIBLE).Select(e => e.DES_COLUMNA) : Columnas(resultado).Select(c => c.DES_COLUMNA);
        return nombres.Select(n => Etiqueta(resultado, n)).Take(12).ToList();
    }

