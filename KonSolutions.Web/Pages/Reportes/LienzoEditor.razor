    private static bool EsFecha(string? t) => (t ?? "").ToLowerInvariant() is "date" or "datetime" or "datetime2" or "smalldatetime" or "datetimeoffset";
    private static string TipoCorto(string? t) => EsNumero(t) ? "123" : EsFecha(t) ? "📅" : (t ?? "").ToLowerInvariant() == "bit" ? "✓" : "abc";
