    private static readonly Dictionary<string, string> NombresPropiedad = new()
    {
        ["SUPRIMIR"] = "No imprimir", ["NEGRITA"] = "Negrita", ["COLOR"] = "Color", ["FONDO"] = "Fondo",
        ["NUEVA_PAGINA_ANTES"] = "Página nueva antes", ["NUEVA_PAGINA_DESPUES"] = "Página nueva después"
    };

    private ReporteLienzoCondicion? Condicion(char elemento, int numero, string propiedad)
        => L.Condiciones.FirstOrDefault(c => c.COD_ELEMENTO == elemento.ToString() && c.NUM_ELEMENTO == numero && c.COD_PROPIEDAD == propiedad);

    private bool TieneCondiciones(char elemento, int numero) => L.Condiciones.Any(c => c.COD_ELEMENTO == elemento.ToString() && c.NUM_ELEMENTO == numero);

    /// <summary>Las condiciones de una sección u objeto que ya no existe se van con él; lo que terminaba en una sección
    /// que ya no existe deja de cruzar.</summary>
    private void Huerfanas()
    {
        L.Condiciones.RemoveAll(c => c.COD_ELEMENTO == Objeto.ToString()
            ? !L.Objetos.Any(o => o.NUM_OBJETO == c.NUM_ELEMENTO)
            : !L.Bandas.Any(b => b.NUM_BANDA == c.NUM_ELEMENTO));
        foreach (var o in L.Objetos.Where(o => o.NUM_BANDA_FIN is { } f && !L.Bandas.Any(b => b.NUM_BANDA == f)).ToList()) NoCruzar(o);
    }

    private void CopiarCondiciones(int desde, int hacia)
    {
        foreach (var c in L.Condiciones.Where(c => c.COD_ELEMENTO == Objeto.ToString() && c.NUM_ELEMENTO == desde).ToList())
            L.Condiciones.Add(new ReporteLienzoCondicion { COD_ELEMENTO = c.COD_ELEMENTO, NUM_ELEMENTO = hacia, COD_PROPIEDAD = c.COD_PROPIEDAD, DES_FORMULA = c.DES_FORMULA });
    }

    private string DondeCondicion(char elemento, int numero, string propiedad)
    {
        var que = elemento == Seccion
            ? (L.Bandas.FirstOrDefault(b => b.NUM_BANDA == numero) is { } b ? NombreBanda(b) : "Sección")
            : (Obj(numero) is { } o ? $"{NombreTipo(o.COD_TIPO_OBJETO)} {TextoVisible(o)}".Trim() : "Objeto");
        return $"{que} · {NombresPropiedad.GetValueOrDefault(propiedad, propiedad)}";
    }

    private async Task EditarCondicion(char elemento, int numero, string propiedad)
    {
        var c = Condicion(elemento, numero, propiedad);
        var r = await AbrirEditor("C", null, c?.DES_FORMULA ?? "", null, elemento, propiedad, DondeCondicion(elemento, numero, propiedad), c is not null);
        if (r is null) return;
        var existe = elemento == Seccion ? L.Bandas.Any(b => b.NUM_BANDA == numero) : Obj(numero) is not null;
        if (!existe) return;
        Antes();
        c = Condicion(elemento, numero, propiedad);
        if (r.Quitar) { if (c is not null) L.Condiciones.Remove(c); }
        else if (c is not null) c.DES_FORMULA = r.Texto;
        else L.Condiciones.Add(new ReporteLienzoCondicion { COD_ELEMENTO = elemento.ToString(), NUM_ELEMENTO = numero, COD_PROPIEDAD = propiedad, DES_FORMULA = r.Texto });
        StateHasChanged();
    }

    /// <summary>El botón ƒ de una propiedad: naranja si tiene condición.</summary>
    private RenderFragment Fx(char elemento, int numero, string propiedad) => __builder =>
    {
        var c = Condicion(elemento, numero, propiedad);
        <button type="button" class="lz-fx @(c is not null ? "lz-fx-on" : "")"
                title="@(c is null ? "Poner una condición (fórmula) a esta propiedad" : $"Condición: {c.DES_FORMULA}")"
                @onclick="@(() => EditarCondicion(elemento, numero, propiedad))">ƒ</button>
    };

    /// <summary>Las condiciones que tiene una sección u objeto, para verlas de un vistazo (clic para editar).</summary>
    private RenderFragment Condiciones(char elemento, int numero) => __builder =>
    {
        var lista = L.Condiciones.Where(c => c.COD_ELEMENTO == elemento.ToString() && c.NUM_ELEMENTO == numero).OrderBy(c => c.COD_PROPIEDAD).ToList();
        if (lista.Count > 0)
        {
            <div class="lz-prop-sub">Condiciones <span class="lz-ex-f" style="text-transform:none;">ƒ</span></div>
            <div class="lz-conds">
                @foreach (var c in lista)
                {
                    var cc = c;
                    <div class="lz-cond-item" title="Editar la condición" @onclick="@(() => EditarCondicion(elemento, numero, cc.COD_PROPIEDAD))">
                        <span>@NombresPropiedad.GetValueOrDefault(cc.COD_PROPIEDAD, cc.COD_PROPIEDAD)</span>
                        <div class="lz-codigo">@cc.DES_FORMULA</div>
                    </div>
                }
            </div>
        }
    };

    // ── Medidas y entradas ──────────────────────────────────────────────────────
    /// <summary>Alto de una línea de texto en mm (aprox. el de Arial en el PDF).</summary>
    private static double Linea(double puntos, bool negrita = false) => Math.Round(puntos * PtMm * 1.16 + 0.3, 1);

    private double Pt(double puntos) => puntos * PtMm * Escala;
    private string Px(double mm) => F(mm * Escala) + "px";
    private static decimal R(double v) => Math.Round((decimal)Math.Clamp(v, 0, 2000), 2);
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string F(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string F(decimal? v) => v is { } x ? F(x) : "";
    private static decimal? Dec(object? v) => decimal.TryParse(v?.ToString()?.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var n) ? n : null;
    private static int? Ent(object? v) => int.TryParse(v?.ToString(), out var n) ? n : null;
    private static string? Vacio(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    private static bool Igual(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    private static string? ColorHex(string? v) => v is { Length: 7 } c && c[0] == '#' ? c.ToUpperInvariant() : null;

    private void Zoom(double paso) => _zoom = Math.Clamp(Math.Round(_zoom + paso, 2), 0.5, 2.5);

    private void Texto(Action<string?> poner, object? valor) { Antes(); poner(Vacio(valor?.ToString())); }
    private void Bool(Action<bool> poner, object? valor) { Antes(); poner(valor is true); }

    private void Num(Action<decimal> poner, object? valor, decimal min, decimal max)
    {
        if (Dec(valor) is not { } n) return;
        Antes();
        poner(Math.Clamp(Math.Round(n, 2), min, max));
    }

    private void NumMm(Action<decimal> poner, object? valor) => Num(poner, valor, 0, 2000);

    private void NumONulo(Action<decimal?> poner, object? valor, decimal min, decimal max, bool guardar = true)
    {
        if (guardar) Antes();
        poner(Dec(valor) is { } n ? Math.Clamp(Math.Round(n, 2), min, max) : null);
    }
}
