    private void Insertar(string tipo) => SoltarAqui($"NUE|{tipo}");

    /// <summary>Con un clic o doble clic: en la sección elegida, arriba a la izquierda (corrido si ahí ya hay algo).</summary>
    private void SoltarAqui(string valor)
    {
        if (BandaDestino() is not { } b) return;
        double x = 2, y = 1;
        while (L.Objetos.Any(o => o.NUM_BANDA == b.NUM_BANDA && Math.Abs((double)o.NUM_X - x) < 0.5 && Math.Abs((double)o.NUM_Y - y) < 0.5) && x < Ancho - 20) x += 5;
        Poner(valor, b, x, y);
    }

    /// <summary>Lo que se suelta: NUE|TIPO, CAM|resultado|COLUMNA, TAB|resultado|, RES|1|COLUMNA, ESP||ORIGEN, FOR||NOMBRE.</summary>
    private void Poner(string valor, ReporteLienzoBanda b, double x, double y)
    {
        var p = valor.Split('|');
        if (p.Length < 2) return;
        var tipo = p[0] == "NUE" ? p[1] : p[0];
        var resultado = p.Length > 1 && int.TryParse(p[1], out var r) ? r : (int?)null;
        var origen = p.Length > 2 && p[2].Length > 0 ? p[2] : null;
        // Una fórmula nueva desde la barra: primero se escribe, después se pone donde se soltó.
        if (tipo == "FOR" && origen is null)
        {
            _ = CrearFormulaYPoner(b, x, y);
            return;
        }
        if (tipo is "CAM" or "RES" or "CRU" or "GRA" && (tipo is "CRU" or "GRA" ? PrimeraColumna(resultado ?? 1, false) : origen ?? PrimeraColumna(tipo == "RES" ? 1 : resultado ?? 1, tipo == "RES")) is null)
        {
            Snackbar.Add("La fuente no tiene columnas para eso.", Severity.Warning);
            return;
        }
        if (NoVaEn(tipo, b))
        {
            Snackbar.Add($"{NombreTipo(tipo)}: no va en el encabezado ni en el pie de página.", Severity.Warning);
            return;
        }
        if (tipo == "SUB" && origen is null && !Subinformables.Any())
        {
            Snackbar.Add("No hay otros diseños libres para ponerlos adentro: graba primero el que va como subinforme.", Severity.Info);
            return;
        }
        Antes();
        var o = Crear(tipo, b, x, y, origen, resultado);
        _sel.Clear();
        _sel.Add(o.NUM_OBJETO);
        // Como en Crystal: un campo soltado en el detalle pone su título en el encabezado de página, a la misma altura x.
        if (p[0] is "CAM" or "FOR" && _conTitulo && b.COD_TIPO_BANDA == "DE" && (o.NUM_RESULTADO ?? 1) == 1
            && Ordenadas.FirstOrDefault(z => z.COD_TIPO_BANDA == "PH") is { } ph)
        {
            // Si el encabezado ya tiene títulos de columna, el nuevo va a su altura y con su estilo (la franja de
            // títulos de un diseño convertido); si no, abajo del encabezado y en negrita.
            var modelo = L.Objetos.Where(z => z.NUM_BANDA == ph.NUM_BANDA && z.COD_TIPO_OBJETO == "TXT" && !(z.DES_ORIGEN ?? "").Contains('{'))
                                  .OrderByDescending(z => z.NUM_Y).FirstOrDefault();
            var lh = Linea(D.NUM_TAMANO_LETRA, true);
            var yt = modelo is not null ? (double)modelo.NUM_Y : Math.Max(0, (double)ph.NUM_ALTO - lh - 0.5);
            var t = Crear("TXT", ph, (double)o.NUM_X, yt, p[0] == "FOR" ? o.DES_ORIGEN : Etiqueta(1, o.DES_ORIGEN), null);
            t.NUM_ANCHO = o.NUM_ANCHO;
            t.COD_ALINEACION = o.COD_ALINEACION;
            t.FLG_NEGRITA = modelo?.FLG_NEGRITA ?? true;
            if (modelo is not null)
            {
                t.NUM_ALTO = modelo.NUM_ALTO; t.FLG_CURSIVA = modelo.FLG_CURSIVA; t.NUM_TAMANO_LETRA = modelo.NUM_TAMANO_LETRA; t.DES_FUENTE = modelo.DES_FUENTE;
                t.DES_COLOR = modelo.DES_COLOR; t.DES_COLOR_FONDO = modelo.DES_COLOR_FONDO; t.DES_BORDES = modelo.DES_BORDES;
                t.NUM_GROSOR_BORDE = modelo.NUM_GROSOR_BORDE; t.DES_COLOR_BORDE = modelo.DES_COLOR_BORDE;
            }
        }
    }

    private ReporteLienzoObjeto Crear(string tipo, ReporteLienzoBanda b, double x, double y, string? origen, int? resultado)
    {
        var lh = Linea(D.NUM_TAMANO_LETRA);
        var o = new ReporteLienzoObjeto
        {
            NUM_OBJETO = Siguiente(), NUM_BANDA = b.NUM_BANDA, COD_TIPO_OBJETO = tipo, NUM_X = R(x), NUM_Y = R(y),
            NUM_ORDEN = L.Objetos.Where(z => z.NUM_BANDA == b.NUM_BANDA).Select(z => z.NUM_ORDEN).DefaultIfEmpty(0).Max() + 1
        };
        switch (tipo)
        {
            case "TXT":
                o.DES_ORIGEN = origen ?? "Texto";
                o.NUM_ANCHO = 40; o.NUM_ALTO = R(lh);
                break;
            case "CAM":
            {
                o.NUM_RESULTADO = resultado ?? 1;
                o.DES_ORIGEN = origen ?? PrimeraColumna(o.NUM_RESULTADO.Value, false);
                var t = TipoColumna(o.NUM_RESULTADO.Value, o.DES_ORIGEN);
                o.NUM_ANCHO = EsNumero(t) ? 25 : EsFecha(t) ? 20 : 40;
                o.NUM_ALTO = R(lh);
                o.COD_ALINEACION = EsNumero(t) ? "D" : EsFecha(t) ? "C" : "I";
                o.FLG_PUEDE_CRECER = !EsNumero(t) && !EsFecha(t);
                break;
            }
            case "RES":
                o.NUM_RESULTADO = 1;
                o.DES_ORIGEN = origen ?? PrimeraColumna(1, true);
                o.COD_FUNCION = "SUM";
                o.NUM_NIVEL = Nivel(b);
                o.NUM_ANCHO = 25; o.NUM_ALTO = R(lh);
                o.COD_ALINEACION = "D"; o.FLG_NEGRITA = true;
                break;
            case "ESP":
                o.DES_ORIGEN = origen ?? "PAGINA_N_DE_M";
                o.NUM_ANCHO = 40; o.NUM_ALTO = R(lh);
                break;
            case "FOR":
                o.DES_ORIGEN = origen;
                o.NUM_ANCHO = 30; o.NUM_ALTO = R(lh);
                break;
            case "LIN":
                o.NUM_ANCHO = 50; o.NUM_ALTO = 0; o.NUM_GROSOR_BORDE = 0.5m; o.DES_COLOR_BORDE = "#000000";
                break;
            case "CUA":
                o.NUM_ANCHO = 40; o.NUM_ALTO = 15; o.NUM_GROSOR_BORDE = 0.5m; o.DES_COLOR_BORDE = "#000000";
                break;
            case "IMG":
                o.DES_ORIGEN = origen is "LOGO_APLICACION" ? origen : "LOGO"; o.NUM_ANCHO = 30; o.NUM_ALTO = 13; o.COD_ALINEACION = "I";
                break;
            case "BAR":
                o.COD_CODIGO = "C128"; o.FLG_TEXTO_CODIGO = true; o.COD_ALINEACION = "C";
                o.DES_ORIGEN = origen ?? (PrimeraColumna(1, false) is { } columna ? "{" + columna + "}" : "123456");
                o.NUM_ANCHO = 45; o.NUM_ALTO = 12;
                break;
            case "TAB":
                o.NUM_RESULTADO = resultado ?? (Resultados.Count > 1 ? Resultados[1].NUM_RESULTADO : 1);
                o.NUM_ANCHO = R(Math.Max(20, Ancho - x)); o.NUM_ALTO = 12;
                break;
            case "CRU":
                // Filas y columnas: las dos primeras columnas que no son números; lo que resume: la primera que sí.
                o.NUM_RESULTADO = resultado ?? 1;
                CambiarResultadoCruzada(o, o.NUM_RESULTADO.Value, guardar: false);
                o.COD_FUNCION = "SUM";
                o.NUM_ANCHO = R(Math.Max(40, Math.Min(160, Ancho - x))); o.NUM_ALTO = 15;
                break;
            case "GRA":
                // Columnas con la suma de la primera columna numérica por la primera que no lo es (una fecha o un texto).
                o.COD_GRAFICO = "COL";
                o.NUM_RESULTADO = resultado ?? 1;
                CambiarResultadoGrafico(o, o.NUM_RESULTADO.Value, guardar: false);
                o.COD_FUNCION = "SUM";
                o.NUM_ANCHO = R(Math.Max(40, Math.Min(100, Ancho - x))); o.NUM_ALTO = 50;
                break;
            case "SUB":
                o.NUM_DISENO_SUB = int.TryParse(origen, out var sub) ? sub : Subinformables.FirstOrDefault()?.NUM_DISENO;
                o.NUM_ANCHO = R(Math.Max(30, Ancho - x)); o.NUM_ALTO = 15;
                break;
        }
        L.Objetos.Add(o);
        // La sección crece si el objeto no entra.
        var fin = o.NUM_Y + o.NUM_ALTO;
        if (fin > b.NUM_ALTO) b.NUM_ALTO = Math.Min(400, fin + 0.5m);
        return o;
    }

    private void Eliminar()
    {
        if (_sel.Count == 0) return;
        Antes();
        L.Objetos.RemoveAll(o => _sel.Contains(o.NUM_OBJETO));
        Huerfanas();
        _sel.Clear();
    }

    private static ReporteLienzoObjeto Copia(ReporteLienzoObjeto o) => JsonSerializer.Deserialize<ReporteLienzoObjeto>(JsonSerializer.Serialize(o))!;

    private void Duplicar()
    {
        if (_sel.Count == 0) return;
        Antes();
        var nuevos = new List<int>();
        foreach (var o in Seleccion.ToList())
        {
            var c = Copia(o);
            c.NUM_OBJETO = Siguiente();
            c.NUM_X = Math.Min(1990, c.NUM_X + 3); c.NUM_Y += 3;
            L.Objetos.Add(c);
            CopiarCondiciones(o.NUM_OBJETO, c.NUM_OBJETO);
            nuevos.Add(c.NUM_OBJETO);
        }
        _sel.Clear(); _sel.AddRange(nuevos);
    }

    private void Pegar()
    {
        if (_portapapeles.Count == 0 || BandaDestino() is not { } b) return;
        Antes();
        var nuevos = new List<int>();
        foreach (var o in _portapapeles)
        {
            var c = Copia(o);
            c.NUM_OBJETO = Siguiente();
            if (!CambiarBanda(c, b)) continue;
            L.Objetos.Add(c);
            CopiarCondiciones(o.NUM_OBJETO, c.NUM_OBJETO);
            nuevos.Add(c.NUM_OBJETO);
        }
        _sel.Clear(); _sel.AddRange(nuevos);
    }

    private void Desplazar(double dx, double dy)
    {
        if (_sel.Count == 0) return;
        Antes();
        foreach (var o in Seleccion)
        {
            o.NUM_X = R(Math.Max(0, (double)o.NUM_X + dx));
            o.NUM_Y = R(Math.Max(0, (double)o.NUM_Y + dy));
            // Lo que cruza se mueve entero: también donde termina (dentro de su sección final).
            if (Cruza(o) && L.Bandas.FirstOrDefault(b => b.NUM_BANDA == o.NUM_BANDA_FIN) is { } fin)
                o.NUM_Y_FIN = R(Math.Min((double)fin.NUM_ALTO, Math.Max(0, (double)o.NUM_Y_FIN!.Value + dy)));
        }
    }

    /// <summary>Al frente o atrás dentro de su sección (el orden en que se dibujan).</summary>
    private void Capa(bool frente)
    {
        if (_sel.Count == 0) return;
        Antes();
        foreach (var banda in Seleccion.Select(o => o.NUM_BANDA).Distinct().ToList())
        {
            var lista = L.Objetos.Where(o => o.NUM_BANDA == banda).OrderBy(o => o.NUM_ORDEN).ThenBy(o => o.NUM_OBJETO).ToList();
            var elegidos = lista.Where(o => _sel.Contains(o.NUM_OBJETO)).ToList();
            var resto = lista.Except(elegidos).ToList();
            var orden = frente ? resto.Concat(elegidos) : elegidos.Concat(resto);
            var i = 0;
            foreach (var o in orden) o.NUM_ORDEN = ++i;
        }
    }

    /// <summary>Alinea según el primero elegido: I izquierda, D derecha, A arriba, B abajo, W mismo ancho, H mismo alto.</summary>
    private void Alinear(string como)
    {
        var lista = Seleccion.ToList();
        if (lista.Count < 2) return;
        Antes();
        var p = lista[0];
        foreach (var o in lista.Skip(1))
            switch (como)
            {
                case "I": o.NUM_X = p.NUM_X; break;
                case "D": o.NUM_X = Math.Max(0, p.NUM_X + p.NUM_ANCHO - o.NUM_ANCHO); break;
                case "A": o.NUM_Y = p.NUM_Y; break;
                case "B": o.NUM_Y = Math.Max(0, p.NUM_Y + p.NUM_ALTO - o.NUM_ALTO); break;
                case "W": o.NUM_ANCHO = p.NUM_ANCHO; break;
                case "H": o.NUM_ALTO = p.NUM_ALTO; break;
            }
    }

    /// <summary>Reparte 3 o más objetos con el mismo espacio entre ellos: el primero y el último quedan donde están
    /// (de izquierda a derecha, o de arriba abajo dentro de una sección). Si se enciman, reparte sus comienzos.</summary>
    private void Repartir(bool horizontal)
    {
        var lista = Seleccion.ToList();
        if (lista.Count < 3) return;
        if (!horizontal && lista.Select(o => o.NUM_BANDA).Distinct().Count() > 1)
        {
            Snackbar.Add("Para repartir a lo alto, elige objetos de una misma sección.", Severity.Info);
            return;
        }
        Antes();
        decimal Ini(ReporteLienzoObjeto o) => horizontal ? o.NUM_X : o.NUM_Y;
        decimal Tam(ReporteLienzoObjeto o) => horizontal ? o.NUM_ANCHO : o.NUM_ALTO;
        void Poner(ReporteLienzoObjeto o, decimal v) { if (horizontal) o.NUM_X = R((double)v); else o.NUM_Y = R((double)v); }
        var orden = lista.OrderBy(Ini).ThenBy(o => o.NUM_OBJETO).ToList();
        var (primero, ultimo) = (orden[0], orden[^1]);
        var hueco = (Ini(ultimo) + Tam(ultimo) - Ini(primero) - orden.Sum(Tam)) / (orden.Count - 1);
        if (hueco < 0)
        {
            var paso = (Ini(ultimo) - Ini(primero)) / (orden.Count - 1);
            for (var i = 1; i < orden.Count - 1; i++) Poner(orden[i], Ini(primero) + paso * i);
            return;
        }
        var pos = Ini(primero) + Tam(primero) + hueco;
        for (var i = 1; i < orden.Count - 1; i++)
        {
            Poner(orden[i], pos);
            pos += Tam(orden[i]) + hueco;
        }
    }

    private void MoverASeccion(ReporteLienzoObjeto o, int? banda)
    {
        if (banda is not { } n || n == o.NUM_BANDA || L.Bandas.FirstOrDefault(b => b.NUM_BANDA == n) is not { } destino) return;
        Antes();
        if (CambiarBanda(o, destino)) _bandaSel = n;
    }

    /// <summary>Un resumen que cambia de sección pasa a sumar lo de esa sección: el grupo en su pie, todo en el informe.
    /// Una línea o un cuadro que cruza sigue cruzando solo si desde la sección nueva puede llegar a donde terminaba.
    /// Un subinforme o una tabla cruzada no va al encabezado ni al pie de página: se queda donde estaba (false).</summary>
    private bool CambiarBanda(ReporteLienzoObjeto o, ReporteLienzoBanda destino)
    {
        if (NoVaEn(o.COD_TIPO_OBJETO, destino))
        {
            Snackbar.Add($"{NombreTipo(o.COD_TIPO_OBJETO)} N° {o.NUM_OBJETO}: no va en el encabezado ni en el pie de página.", Severity.Warning);
            return false;
        }
        o.NUM_BANDA = destino.NUM_BANDA;
        if (o.COD_TIPO_OBJETO == "RES") o.NUM_NIVEL = Nivel(destino);
        if (o.NUM_BANDA_FIN is { } f && !(L.Bandas.FirstOrDefault(b => b.NUM_BANDA == f) is { } fin && PuedeTerminar(destino, fin)))
        {
            NoCruzar(o);
            Snackbar.Add($"{NombreTipo(o.COD_TIPO_OBJETO)} N° {o.NUM_OBJETO} ya no sigue hasta otra sección: desde «{NombreBanda(destino)}» no llega a donde terminaba.", Severity.Info);
        }
        return true;
    }

    /// <summary>Lo que ocupa filas de otro lado (subinforme, tabla cruzada) o las resume (gráfico) no se repite en cada página.</summary>
    private static bool NoVaEn(string tipo, ReporteLienzoBanda b) => tipo is "SUB" or "CRU" or "GRA" && b.COD_TIPO_BANDA is "PH" or "PF";

    // ── Líneas y cuadros que cruzan secciones ───────────────────────────────────
    /// <summary>¿Sigue hasta otra sección? (Igual que en el motor del PDF.)</summary>
    private static bool Cruza(ReporteLienzoObjeto o)
        => o.COD_TIPO_OBJETO is "LIN" or "CUA" && o.NUM_BANDA_FIN is { } f && f != o.NUM_BANDA && o.NUM_Y_FIN is not null;

    /// <summary>¿Una línea o un cuadro que empieza en i puede terminar en f? Del encabezado al pie del mismo grupo, del
    /// informe o de la página, o en otra parte más abajo de la misma sección (lo mismo que valida el SP al grabar).</summary>
    private static bool PuedeTerminar(ReporteLienzoBanda i, ReporteLienzoBanda f)
        => (i.COD_TIPO_BANDA == f.COD_TIPO_BANDA && i.NUM_NIVEL == f.NUM_NIVEL && f.NUM_SUBSECCION > i.NUM_SUBSECCION)
        || (i.COD_TIPO_BANDA == "RH" && f.COD_TIPO_BANDA == "RF")
        || (i.COD_TIPO_BANDA == "PH" && f.COD_TIPO_BANDA == "PF")
        || (i.COD_TIPO_BANDA == "GH" && f.COD_TIPO_BANDA == "GF" && i.NUM_NIVEL == f.NUM_NIVEL);

    /// <summary>Las secciones donde puede terminar lo que empieza en b, de arriba abajo.</summary>
    private IEnumerable<ReporteLienzoBanda> Socias(ReporteLienzoBanda b) => Ordenadas.Where(f => PuedeTerminar(b, f));

    /// <summary>La línea o el cuadro sigue hasta la sección fin, en yFin (a lo más su borde de abajo). Terminar en la
    /// misma sección donde empieza es dejar de cruzar. Una línea que cruza es vertical. False si no se puede.</summary>
    private bool Cruzar(ReporteLienzoObjeto o, ReporteLienzoBanda fin, double yFin)
    {
        if (L.Bandas.FirstOrDefault(b => b.NUM_BANDA == o.NUM_BANDA) is not { } ini) return false;
        if (fin.NUM_BANDA == ini.NUM_BANDA)
        {
            if (o.NUM_BANDA_FIN is not null) NoCruzar(o, yFin);
            return true;
        }
        if (o.COD_TIPO_OBJETO is not ("LIN" or "CUA") || !PuedeTerminar(ini, fin))
        {
            Snackbar.Add($"Desde «{NombreBanda(ini)}» no puede seguir hasta «{NombreBanda(fin)}». Una línea o un cuadro va del encabezado de un grupo a su pie, del encabezado al pie del informe o de la página, o a otra parte de la misma sección (a → b).", Severity.Warning);
            return false;
        }
        o.NUM_BANDA_FIN = fin.NUM_BANDA;
        o.NUM_Y_FIN = R(Math.Min(yFin, (double)fin.NUM_ALTO));
        o.NUM_Y = R(Math.Min((double)o.NUM_Y, (double)ini.NUM_ALTO));
        if (o.COD_TIPO_OBJETO == "LIN") o.NUM_ANCHO = 0;
        return true;
    }

    /// <summary>Deja de cruzar: vuelve a ser solo de su sección, hasta yFin si se soltó en ella o hasta su borde de abajo.</summary>
    private void NoCruzar(ReporteLienzoObjeto o, double? yFin = null)
    {
        if (o.NUM_BANDA_FIN is null && o.NUM_Y_FIN is null) return;
        o.NUM_BANDA_FIN = null;
        o.NUM_Y_FIN = null;
        var alto = (double)(L.Bandas.FirstOrDefault(b => b.NUM_BANDA == o.NUM_BANDA)?.NUM_ALTO ?? 0);
        o.NUM_ALTO = R(Math.Max(0, (yFin ?? alto) - (double)o.NUM_Y));
    }

    /// <summary>«Termina en» de las propiedades: otra sección (al principio, en su borde de abajo) o la misma.</summary>
    private void TerminarEn(ReporteLienzoObjeto o, int? banda)
    {
        Antes();
        if (banda is not { } n || L.Bandas.FirstOrDefault(b => b.NUM_BANDA == n) is not { } fin) { NoCruzar(o); return; }
        Cruzar(o, fin, (double)(Cruza(o) && o.NUM_BANDA_FIN == n ? o.NUM_Y_FIN!.Value : fin.NUM_ALTO));
    }

    private void YFinal(ReporteLienzoObjeto o, object? valor)
    {
        if (L.Bandas.FirstOrDefault(b => b.NUM_BANDA == o.NUM_BANDA_FIN) is not { } fin) return;
        Num(v => o.NUM_Y_FIN = v, valor, 0, fin.NUM_ALTO);
    }

    /// <summary>Si una sección se achica, lo que termina en ella termina a lo más en su borde de abajo (lo pide el SP).</summary>
    private void Recortar(ReporteLienzoBanda b)
    {
        foreach (var o in L.Objetos.Where(o => o.NUM_BANDA_FIN == b.NUM_BANDA && o.NUM_Y_FIN > b.NUM_ALTO)) o.NUM_Y_FIN = b.NUM_ALTO;
    }

    private static int Nivel(ReporteLienzoBanda b) => b.COD_TIPO_BANDA is "GH" or "GF" ? b.NUM_NIVEL : 0;

    private void CambiarResultadoCampo(ReporteLienzoObjeto o, int resultado)
    {
        Antes();
        o.NUM_RESULTADO = resultado;
        if (!Columnas(resultado).Any(c => Igual(c.DES_COLUMNA, o.DES_ORIGEN))) o.DES_ORIGEN = PrimeraColumna(resultado, false);
    }

    private static bool Opcion(ReporteLienzoObjeto o, string opcion) => (o.DES_ORIGEN ?? "").Contains(opcion, StringComparison.OrdinalIgnoreCase);

    private void PonerOpcion(ReporteLienzoObjeto o, string opcion, bool si)
    {
        Antes();
        var lista = (o.DES_ORIGEN ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(x => !Igual(x, opcion)).ToList();
        if (si) lista.Add(opcion);
        o.DES_ORIGEN = lista.Count == 0 ? null : string.Join(" ", lista);
    }

    /// <summary>Una imagen es un logo de Configuración General (LOGO, el de la empresa; LOGO_APLICACION, el de la aplicación) o
    /// una propia (PROPIA, con su archivo).</summary>
    private static bool EsLogo(ReporteLienzoObjeto o) => !Igual(o.DES_ORIGEN, "PROPIA") && o.IMG_IMAGEN is not { Length: > 0 };

    private void OrigenImagen(ReporteLienzoObjeto o, string? origen)
    {
        Antes();
        o.DES_ORIGEN = origen is "LOGO" or "LOGO_APLICACION" ? origen : "PROPIA";
        if (o.DES_ORIGEN != "PROPIA") o.IMG_IMAGEN = null;
    }

    private async Task SubirImagen(ReporteLienzoObjeto o, InputFileChangeEventArgs e)
    {
        const long max = 2 * 1024 * 1024;
        var f = e.File;
        if (f.Size > max) { Snackbar.Add("La imagen pasa de 2 MB.", Severity.Warning); return; }
        try
        {
            await using var s = f.OpenReadStream(max);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            var bytes = ms.ToArray();
            if (MimeImagen(bytes) is null) { Snackbar.Add("El archivo no es PNG, JPEG, GIF ni BMP.", Severity.Warning); return; }
            Antes();
            o.IMG_IMAGEN = bytes;
            o.DES_ORIGEN = "PROPIA";
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo leer la imagen.", Severity.Warning);
        }
    }

    private void PonerBorde(ReporteLienzoObjeto o, string letra, bool si)
    {
        Antes();
        var b = (o.DES_BORDES ?? "").Replace(letra, "");
        if (si) b += letra;
        o.DES_BORDES = b.Length == 0 ? null : string.Concat("ABID".Where(ch => b.Contains(ch)));
    }

    private void ATodos(List<ReporteLienzoObjeto> lista, Action<ReporteLienzoObjeto> accion)
    {
        Antes();
        foreach (var o in lista) accion(o);
    }

    // ── Secciones y grupos ──────────────────────────────────────────────────────
    private void ElegirBanda(ReporteLienzoBanda? b)
    {
        if (b is null) return;
        _sel.Clear(); _bandaSel = b.NUM_BANDA; _formGrupo = false;
    }

    private List<ReporteLienzoBanda> Hermanas(ReporteLienzoBanda b)
        => L.Bandas.Where(x => x.COD_TIPO_BANDA == b.COD_TIPO_BANDA && x.NUM_NIVEL == b.NUM_NIVEL).OrderBy(x => x.NUM_SUBSECCION).ToList();

    private int SiguienteBanda() => L.Bandas.Select(b => b.NUM_BANDA).DefaultIfEmpty(0).Max() + 1;

    private void AgregarSeccion(string? tipo)
    {
        if (string.IsNullOrEmpty(tipo)) return;
        var hermana = L.Bandas.Where(b => b.COD_TIPO_BANDA == tipo && b.NUM_NIVEL == 0).OrderBy(b => b.NUM_SUBSECCION).LastOrDefault();
        if (hermana is not null) { AgregarSubseccion(hermana); return; }
        Antes();
        var nueva = new ReporteLienzoBanda { NUM_BANDA = SiguienteBanda(), COD_TIPO_BANDA = tipo, NUM_ALTO = 6, FLG_MANTENER_JUNTO = true };
        L.Bandas.Add(nueva);
        ElegirBanda(nueva);
    }

    private void AgregarSubseccion(ReporteLienzoBanda b)
    {
        var hermanas = Hermanas(b);
        if (hermanas.Count >= 9) { Snackbar.Add("Una sección tiene hasta 9 partes (a hasta i).", Severity.Warning); return; }
        Antes();
        // La nueva va justo debajo de esta: las de más abajo corren un lugar.
        foreach (var h in hermanas.Where(h => h.NUM_SUBSECCION > b.NUM_SUBSECCION)) h.NUM_SUBSECCION++;
        var nueva = new ReporteLienzoBanda
        {
            NUM_BANDA = SiguienteBanda(), COD_TIPO_BANDA = b.COD_TIPO_BANDA, NUM_NIVEL = b.NUM_NIVEL, NUM_SUBSECCION = b.NUM_SUBSECCION + 1,
            NUM_ALTO = 6, FLG_MANTENER_JUNTO = true
        };
        L.Bandas.Add(nueva);
        ElegirBanda(nueva);
    }

    private void QuitarSeccion(ReporteLienzoBanda b)
    {
        var hermanas = Hermanas(b);
        if (hermanas.Count <= 1) return;
        Antes();
        L.Objetos.RemoveAll(o => o.NUM_BANDA == b.NUM_BANDA);
        L.Bandas.Remove(b);
        Huerfanas();
        var i = 0;
        foreach (var h in hermanas.Where(h => h != b)) h.NUM_SUBSECCION = ++i;
        _bandaSel = hermanas.First(h => h != b).NUM_BANDA;
    }

    private void AbrirGrupo()
    {
        if (Columnas(1).Count == 0) { Snackbar.Add("Elige la fuente: los grupos son de una columna del resultado 1.", Severity.Warning); return; }
        _formGrupo = true;
        _sel.Clear();
        _grupoColumna ??= Columnas(1)[0].DES_COLUMNA;
    }

    /// <summary>El grupo nuevo va adentro de los que ya hay (nivel siguiente), con su encabezado (el valor del grupo) y su pie.</summary>
    private void InsertarGrupo()
    {
        if (string.IsNullOrEmpty(_grupoColumna)) return;
        if (L.Grupos.Count >= 9) { Snackbar.Add("Hasta 9 niveles de grupo.", Severity.Warning); return; }
        Antes();
        var n = L.Grupos.Count + 1;
        L.Grupos.Add(new ReporteLienzoGrupo { NUM_NIVEL = n, DES_COLUMNA = _grupoColumna, COD_ORDEN = _grupoOrden, FLG_REPETIR_ENCABEZADO = true });
        var gh = new ReporteLienzoBanda { NUM_BANDA = SiguienteBanda(), COD_TIPO_BANDA = "GH", NUM_NIVEL = n, NUM_ALTO = 6, FLG_MANTENER_JUNTO = true };
        L.Bandas.Add(gh);
        L.Bandas.Add(new ReporteLienzoBanda { NUM_BANDA = SiguienteBanda(), COD_TIPO_BANDA = "GF", NUM_NIVEL = n, NUM_ALTO = 0, FLG_MANTENER_JUNTO = true });
        var t = Crear("TXT", gh, 1 + (n - 1) * 3, 1, $"{Etiqueta(1, _grupoColumna)}: {{{_grupoColumna}}}", null);
        t.NUM_ANCHO = R(Math.Max(20, Ancho - (double)t.NUM_X - 1));
        t.FLG_NEGRITA = true;
        t.DES_COLOR = "#163A5F";
        _formGrupo = false;
        ElegirBanda(gh);
    }

    private void QuitarGrupo(int nivel)
    {
        Antes();
        var bandas = L.Bandas.Where(b => b.COD_TIPO_BANDA is "GH" or "GF" && b.NUM_NIVEL == nivel).Select(b => b.NUM_BANDA).ToList();
        L.Objetos.RemoveAll(o => bandas.Contains(o.NUM_BANDA));
        L.Bandas.RemoveAll(b => bandas.Contains(b.NUM_BANDA));
        Huerfanas();
        L.Grupos.RemoveAll(g => g.NUM_NIVEL == nivel);
        foreach (var g in L.Grupos.Where(g => g.NUM_NIVEL > nivel)) g.NUM_NIVEL--;
        foreach (var b in L.Bandas.Where(b => b.COD_TIPO_BANDA is "GH" or "GF" && b.NUM_NIVEL > nivel)) b.NUM_NIVEL--;
        foreach (var o in L.Objetos.Where(o => o.COD_TIPO_OBJETO == "RES"))
            if (o.NUM_NIVEL == nivel) o.NUM_NIVEL = 0;
            else if (o.NUM_NIVEL > nivel) o.NUM_NIVEL--;
        _bandaSel = null;
    }

    /// <summary>Sube o baja un grupo: intercambia su nivel con el vecino (las secciones y los resúmenes lo siguen).</summary>
    private void CambiarNivel(int nivel, int paso)
    {
        var otro = nivel + paso;
        if (otro < 1 || otro > L.Grupos.Count) return;
        Antes();
        int Cambio(int n) => n == nivel ? otro : n == otro ? nivel : n;
        foreach (var g in L.Grupos) g.NUM_NIVEL = Cambio(g.NUM_NIVEL);
        foreach (var b in L.Bandas.Where(b => b.COD_TIPO_BANDA is "GH" or "GF")) b.NUM_NIVEL = Cambio(b.NUM_NIVEL);
        foreach (var o in L.Objetos.Where(o => o.COD_TIPO_OBJETO == "RES" && o.NUM_NIVEL > 0)) o.NUM_NIVEL = Cambio(o.NUM_NIVEL!.Value);
    }

