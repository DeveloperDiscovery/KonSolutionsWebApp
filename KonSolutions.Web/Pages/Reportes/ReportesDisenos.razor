@page "/reportes/reportes-disenos"
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using KONSolutions.Shared.Models.Reportes
@inject ReportesWebService Reportes
@inject ConfigService ConfigSvc
@inject MenuService MenuService
@inject AccessLogService AccessLog
@inject ErrorLogService ErrorLog
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Diseños de reportes · @ConfigSvc.Current.NombreApp</PageTitle>

@* REPORTEADOR · DISEÑOS

   Un diseño es cómo se ve un reporte sobre una fuente:
     - LISTADO (LIS): el resultado 1 como tabla, con grupos (hasta 2 niveles), subtotales, total general y orden;
     - FICHA (FIC): un registro; cada resultado es una sección (campos, tabla, totales u oculto), más las firmas;
     - LIBRE (BAN): un lienzo por secciones (bandas) al estilo de Crystal Reports, con objetos puestos donde se quiera
       (LienzoEditor.razor). Se crea nuevo o con «Convertir a bandas» desde un listado o una ficha grabados; un diseño
       libre no vuelve a ser listado ni ficha. Excel y CSV leen sus datos (los campos del detalle), o el Excel sale
       «con formato», como el PDF (FLG_CON_FORMATO); Word, solo con plantilla propia.
   El PDF sale siempre del diseño. Word y Excel salen del diseño o de una plantilla propia: se descarga la plantilla
   base (el diseño con marcas {{...}} en vez de datos), se edita en Word/Excel y se sube. CSV solo en listados.

   Los textos (título, subtítulo, títulos de sección, pie) admiten {@PARAMETRO} y {COLUMNA} (de la primera fila del
   resultado 1). La vista previa usa el diseño GRABADO. *@
<div>
    <div class="d-flex align-center gap-3 mb-3 grid-header-compacto">
        <div class="grid-header-titulo">
            <TituloPagina Fallback="Diseños de reportes" CodAplicacion="@_codAp" CodOpcionAplicacion="@_codOp" />
            <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">
                Reporteador · listados, fichas y diseños libres sobre una fuente, en PDF, Word, Excel y CSV
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Style="@EstilosBoton.Cancelar" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="_grabando" OnClick="Nuevo">Nuevo diseño</MudButton>
    </div>

    <div class="rep-columnas @(_soloEditor ? "rep-solo" : "")">
        @* ══════════ LISTA ══════════ *@
        <MudPaper Elevation="0" Class="rep-panel" Style="@(_soloEditor ? "display:none;" : "")">
            <div class="pa-2 px-3 rep-cab">Diseños</div>
            <div class="pa-2 d-flex flex-column gap-2">
                <MudSelect T="int?" Value="_filtroFuente" ValueChanged="@(v => _filtroFuente = v)" Label="Fuente" Variant="Variant.Outlined"
                           Clearable="true">
                    @foreach (var f in _fuentes)
                    {
                        <MudSelectItem T="int?" Value="@f.NUM_FUENTE">@f.DES_FUENTE</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_buscar" Label="Buscar" Variant="Variant.Outlined" Immediate="true"
                              Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
            </div>
            @if (_cargandoLista)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            <div style="overflow:auto;max-height:68vh;">
                @foreach (var d in Filtrados)
                {
                    var x = d;
                    <div class="rep-item @(x.NUM_DISENO == _det?.Diseno.NUM_DISENO ? "rep-item-sel" : "")" @onclick="@(() => Abrir(x.NUM_DISENO))">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@IconoTipo(x.COD_TIPO_DISENO)" Size="Size.Small" Style="opacity:.6;" />
                            <span style="font-weight:700;">@x.DES_DISENO</span>
                        </div>
                        <div style="font-size:.72rem;opacity:.7;">@NombreTipo(x.COD_TIPO_DISENO) · @x.DES_FUENTE</div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var (c, ok, propia) in new[] { ("PDF", x.FLG_PDF, false), ("DOC", x.FLG_DOC, x.FLG_PROPIA_DOC), ("XLS", x.FLG_XLS, x.FLG_PROPIA_XLS), ("CSV", x.FLG_CSV, false) })
                            {
                                if (!ok) continue;
                                <span class="rep-chip" title="@(propia ? "Con plantilla propia" : "")">@(ReportesWebService.NombreFormato(c) + (propia ? " ★" : ""))</span>
                            }
                            @if (x.NUM_BOTONES > 0)
                            {
                                <span class="rep-chip rep-chip-b">@($"{x.NUM_BOTONES} botón{(x.NUM_BOTONES == 1 ? "" : "es")}")</span>
                            }
                            @if (!x.FLG_HABILITADO) { <span class="rep-chip">deshabilitado</span> }
                        </div>
                    </div>
                }
                @if (!_cargandoLista && Filtrados.Count == 0)
                {
                    <MudText Class="pa-3" Typo="Typo.body2" Style="opacity:.6;">No hay diseños.</MudText>
                }
            </div>
        </MudPaper>

        @* ══════════ EDITOR ══════════ *@
        <MudPaper Elevation="0" Class="rep-panel">
            @if (_det is not { } det)
            {
                <MudText Class="pa-4" Typo="Typo.body2" Style="opacity:.6;">Elige un diseño de la lista o crea uno nuevo.</MudText>
            }
            else
            {
                var d = det.Diseno;
                var esFicha = d.COD_TIPO_DISENO == "FIC";
                var libre = d.COD_TIPO_DISENO == "BAN";
                <div class="pa-2 px-3 rep-cab d-flex align-center gap-2 flex-wrap">
                    <span>@(d.NUM_DISENO is null ? "Nuevo diseño" : $"Diseño N° {d.NUM_DISENO}")@(libre ? " · libre" : "")</span>
                    <MudSpacer />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Style="@EstilosBoton.Cancelar"
                               StartIcon="@(_soloEditor ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                               OnClick="@(() => _soloEditor = !_soloEditor)">@(_soloEditor ? "Mostrar la lista" : "Más ancho")</MudButton>
                    @if (!libre && d.NUM_DISENO is not null)
                    {
                        <MudTooltip Text="Crea un diseño libre nuevo con el lienzo armado para que salga igual que este (este no cambia)">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Style="@EstilosBoton.Cancelar" StartIcon="@Icons.Material.Filled.Dashboard"
                                       Disabled="_grabando" OnClick="Convertir">Convertir a bandas</MudButton>
                        </MudTooltip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Style="@EstilosBoton.Cancelar" StartIcon="@Icons.Material.Filled.Visibility"
                               Disabled="@(d.NUM_DISENO is null || _grabando)" OnClick="VistaPrevia">Vista previa</MudButton>
                    @if (d.NUM_DISENO is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Style="@EstilosBoton.Eliminar"
                                   StartIcon="@Icons.Material.Filled.Delete" Disabled="_grabando" OnClick="Eliminar">Eliminar</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Style="@EstilosBoton.Confirmar" StartIcon="@Icons.Material.Filled.Save"
                               Disabled="_grabando" OnClick="Grabar">@(_grabando ? "Grabando..." : "Grabar")</MudButton>
                </div>

                @if (_nuevas.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mx-3 mt-2" ShowCloseIcon="true" CloseIconClicked="@(() => _nuevas.Clear())">
                        La fuente trae columnas que este diseño todavía no usa: <b>@string.Join(", ", _nuevas.Select(TextoNueva))</b>.
                        @(libre ? "Ya están en el explorador del lienzo; para que salgan en una tabla, márcalas con «Ver» en «Columnas de las tablas»."
                                : "Para que salgan, márcalas con «Ver» en «Columnas».")
                        Después, graba el diseño.
                    </MudAlert>
                }

                <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pa-3" @bind-ActivePanelIndex="_pestana">
                    @* ── GENERAL ── *@
                    <MudTabPanel Text="General" Icon="@Icons.Material.Filled.Tune">
                        <div class="rep-grid4">
                            <MudSelect T="int?" Value="d.NUM_FUENTE" ValueChanged="ElegirFuente" Label="Fuente *" Variant="Variant.Outlined"
                                       Disabled="@(d.NUM_DISENO is not null)" HelperText="@(d.NUM_DISENO is not null ? "Un diseño grabado no cambia de fuente" : null)">
                                @foreach (var f in _fuentes.Where(f => f.FLG_HABILITADO || f.NUM_FUENTE == d.NUM_FUENTE))
                                {
                                    <MudSelectItem T="int?" Value="@f.NUM_FUENTE">@f.DES_FUENTE</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" @bind-Value="d.DES_DISENO" Label="Descripción *" Variant="Variant.Outlined" MaxLength="100" />
                            <MudSelect T="string" Value="d.COD_TIPO_DISENO" ValueChanged="CambiarTipo" Label="Tipo" Variant="Variant.Outlined"
                                       Disabled="@(libre && d.NUM_DISENO is not null)"
                                       HelperText="@(d.NUM_DISENO is not null && libre ? "Un diseño libre no vuelve a ser listado ni ficha" : null)">
                                <MudSelectItem T="string" Value="@("LIS")">Listado (varias filas)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("FIC")">Ficha (un registro)</MudSelectItem>
                                <MudSelectItem T="string" Value="@("BAN")" Disabled="@(d.NUM_DISENO is not null && !libre)">
                                    @(d.NUM_DISENO is not null && !libre ? "Libre (usa «Convertir a bandas»)" : "Libre (por bandas, como Crystal)")
                                </MudSelectItem>
                            </MudSelect>
                            <MudSwitch T="bool" @bind-Value="d.FLG_HABILITADO" Label="Habilitado" Color="Color.Success" />
                        </div>
                        <div class="rep-grid2b mt-2">
                            <MudTextField T="string" @bind-Value="d.DES_TITULO" Label="Título" Variant="Variant.Outlined" MaxLength="200" />
                            <MudTextField T="string" @bind-Value="d.DES_SUBTITULO" Label="Subtítulo" Variant="Variant.Outlined" MaxLength="300"
                                          HelperText="@AyudaTextos" />
                        </div>
                        <div class="rep-grid4 mt-2">
                            <MudSelect T="string" @bind-Value="d.COD_ORIENTACION" Label="Orientación" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("V")">Vertical</MudSelectItem>
                                <MudSelectItem T="string" Value="@("H")">Horizontal</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="d.COD_PAPEL" Label="Papel" Variant="Variant.Outlined">
                                <MudSelectItem T="string" Value="@("A4")">A4</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CAR")">Carta</MudSelectItem>
                                <MudSelectItem T="string" Value="@("OFI")">Oficio</MudSelectItem>
                            </MudSelect>
                            <MudNumericField T="int" @bind-Value="d.NUM_TAMANO_LETRA" Label="Tamaño de letra" Min="6" Max="14" Variant="Variant.Outlined" />
                            @if (!esFicha)
                            {
                                <MudSelect T="string" Value="@(d.DES_SEPARADOR_CSV ?? ";")" ValueChanged="@(v => d.DES_SEPARADOR_CSV = v)" Label="Separador CSV"
                                           Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@(";")">Punto y coma ( ; )</MudSelectItem>
                                    <MudSelectItem T="string" Value="@(",")">Coma ( , )</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("TAB")">Tabulador</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("|")">Barra ( | )</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                        @if (libre)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                En un diseño libre, el lienzo decide qué sale y dónde: el logo, los datos de la empresa, los totales, las firmas y el pie
                                se ponen como objetos en la pestaña «Lienzo». El título y el subtítulo salen con los campos especiales «Título» y «Subtítulo».
                            </MudAlert>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-4 mt-2">
                                <MudSwitch T="bool" @bind-Value="d.FLG_LOGO" Label="Logo" Color="Color.Primary" />
                                <MudSwitch T="bool" @bind-Value="d.FLG_DATOS_EMPRESA" Label="Datos de la empresa" Color="Color.Primary" />
                                <MudSwitch T="bool" @bind-Value="d.FLG_FILTROS_PIE" Label="Filtros usados al pie" Color="Color.Primary" />
                                @if (!esFicha)
                                {
                                    <MudSwitch T="bool" @bind-Value="d.FLG_SUBTOTAL_GRUPO" Label="Subtotal por grupo" Color="Color.Primary" />
                                    <MudSwitch T="bool" @bind-Value="d.FLG_SALTO_GRUPO" Label="Página nueva por grupo" Color="Color.Primary" />
                                    <MudSwitch T="bool" @bind-Value="d.FLG_TOTAL_GENERAL" Label="Total general" Color="Color.Primary" />
                                }
                            </div>
                            @if (esFicha)
                            {
                                <MudTextField T="string" @bind-Value="d.DES_FIRMAS" Label="Firmas" Variant="Variant.Outlined" Class="mt-2" MaxLength="300"
                                              HelperText="Separadas con | : Elaborado por|Aprobado por|Proveedor (vacío: sin firmas)" />
                            }
                            <MudTextField T="string" @bind-Value="d.DES_PIE" Label="Texto al pie" Variant="Variant.Outlined" Class="mt-2" Lines="2" MaxLength="500" />
                        }
                    </MudTabPanel>

                    @* ── LIENZO (diseño libre) ── *@
                    @if (libre)
                    {
                        <MudTabPanel Text="Lienzo" Icon="@Icons.Material.Filled.Dashboard" Disabled="@(_fuente is null)">
                            @if (_fuente is not null)
                            {
                                <LienzoEditor Detalle="det" Fuente="_fuente" Disenos="_disenos" LeerFuente="LeerFuente" />
                            }
                        </MudTabPanel>
                    }

                    @* ── COLUMNAS ── *@
                    <MudTabPanel Text="@(libre ? "Columnas de las tablas" : "Columnas")" Icon="@Icons.Material.Filled.ViewColumn" Disabled="@(_fuente is null)">
                        @if (_fuente is not null)
                        {
                            @if (libre)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                    Lo que se imprime está en el lienzo. Aquí se eligen las columnas (título, ancho, formato y total) de cada «Tabla de un resultado»,
                                    y el orden de las filas del resultado 1 después de los grupos del lienzo. El ancho de la tabla es el de su objeto en el lienzo;
                                    «Ancho» lo reparte entre las columnas que se ven.
                                </MudAlert>
                            }
                            else if (!esFicha && _fuente.Resultados.Count > 1)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                    El listado imprime el resultado 1. Los demás resultados de la fuente se pueden usar en una plantilla propia con {{R2.COLUMNA}}.
                                </MudAlert>
                            }
                            @foreach (var r in ResultadosVisibles(esFicha || libre))
                            {
                                var rr = r;
                                var s = Seccion(rr.NUM_RESULTADO);
                                var tabla = !esFicha || s.COD_PRESENTACION == "TAB";
                                var conGrupo = !esFicha && !libre;
                                var campos = esFicha && s.COD_PRESENTACION == "CAM";
                                <div class="rep-resultado mb-3">
                                    <div class="d-flex align-center gap-2 pa-2 px-3 rep-cab2">
                                        <span style="font-weight:800;">Resultado @rr.NUM_RESULTADO</span>
                                        <span style="font-size:.78rem;opacity:.7;">@rr.DES_RESULTADO · @Papel(rr.COD_PAPEL)</span>
                                        @if (esFicha)
                                        {
                                            <MudSpacer />
                                            <label class="rep-lbl">Se muestra como</label>
                                            <select class="rep-input" style="max-width:150px;" value="@s.COD_PRESENTACION" @onchange="@(e => s.COD_PRESENTACION = e.Value?.ToString() ?? "TAB")">
                                                <option value="CAM">Campos</option><option value="TAB">Tabla</option><option value="TOT">Totales</option><option value="OCU">No se muestra</option>
                                            </select>
                                            @if (s.COD_PRESENTACION == "CAM")
                                            {
                                                <label class="rep-lbl">Columnas</label>
                                                <select class="rep-input" style="width:60px;" value="@(s.NUM_COLUMNAS ?? 3)" @onchange="@(e => s.NUM_COLUMNAS = Num(e.Value) ?? 3)">
                                                    @for (var i = 1; i <= 4; i++) { <option value="@i">@i</option> }
                                                </select>
                                            }
                                            <label class="rep-lbl">Orden</label>
                                            <input class="rep-input" type="number" style="width:56px;" value="@s.NUM_ORDEN" @onchange="@(e => s.NUM_ORDEN = Num(e.Value) ?? s.NUM_ORDEN)" />
                                            <input class="rep-input" style="max-width:220px;" placeholder="Título de la sección" value="@s.DES_TITULO" @onchange="@(e => s.DES_TITULO = Vacio(e.Value?.ToString()))" />
                                        }
                                    </div>
                                    @if (!esFicha || libre || s.COD_PRESENTACION != "OCU")
                                    {
                                        <div style="overflow:auto;">
                                            <table class="tabla-simple-editable rep-tabla">
                                                <thead>
                                                    <tr>
                                                        <th style="width:54px;"></th><th title="Se imprime">Ver</th><th>Columna</th><th style="min-width:150px;">Etiqueta</th>
                                                        <th style="width:104px;" title="@AyudaAncho(campos)">Ancho</th>
                                                        <th style="width:96px;">Alineación</th><th style="width:130px;">Formato</th>
                                                        @if (tabla) { <th title="Suma la columna">Total</th> }
                                                        @if (conGrupo)
                                                        {
                                                            <th style="width:84px;" title="Agrupa por esta columna (nivel 1 o 2)">Grupo</th>
                                                        }
                                                        @if (!esFicha)
                                                        {
                                                            <th style="width:100px;">Ordenar</th><th style="width:54px;" title="Prioridad del orden (1 primero)">Prior.</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @{ var filas = Elementos(rr.NUM_RESULTADO); }
                                                    @for (var i = 0; i < filas.Count; i++)
                                                    {
                                                        var e = filas[i];
                                                        var idx = i;
                                                        var col = ColumnaFuente(e);
                                                        <tr class="@(e.FLG_VISIBLE ? "" : "rep-oculta")">
                                                            <td style="white-space:nowrap;">
                                                                <button class="rep-flecha" disabled="@(idx == 0)" title="Subir" @onclick="@(() => Mover(rr.NUM_RESULTADO, idx, -1))">▲</button>
                                                                <button class="rep-flecha" disabled="@(idx == filas.Count - 1)" title="Bajar" @onclick="@(() => Mover(rr.NUM_RESULTADO, idx, 1))">▼</button>
                                                            </td>
                                                            <td style="text-align:center;"><input type="checkbox" checked="@e.FLG_VISIBLE" @onchange="@(ev => e.FLG_VISIBLE = (bool)(ev.Value ?? false))" /></td>
                                                            <td>
                                                                <span class="mono" style="font-weight:700;">@e.DES_COLUMNA</span> <span class="mono" style="font-size:.68rem;opacity:.55;">@col?.DES_TIPO_DATO</span>
                                                                @if (_nuevas.Contains((e.NUM_RESULTADO, e.DES_COLUMNA.ToUpperInvariant())))
                                                                {
                                                                    <span class="rep-nueva" title="El procedimiento la trae desde hace poco: márcala con «Ver» para que salga">nueva</span>
                                                                }
                                                            </td>
                                                            <td><input class="rep-input" placeholder="@(col?.DES_ETIQUETA ?? ReportesWebService.EtiquetaDesdeNombre(e.DES_COLUMNA))" value="@e.DES_ETIQUETA" @onchange="@(ev => e.DES_ETIQUETA = Vacio(ev.Value?.ToString()))" /></td>
                                                            <td>
                                                                <div class="d-flex align-center gap-1">
                                                                    <input class="rep-input rep-ancho" type="number" min="1" max="@(campos ? 4 : 100)" placeholder="@(campos ? "1" : "10")"
                                                                           title="@AyudaAncho(campos)" value="@e.NUM_ANCHO" @onchange="@(ev => e.NUM_ANCHO = Num(ev.Value))" />
                                                                    @if (!campos && e.FLG_VISIBLE)
                                                                    {
                                                                        <span class="rep-pct" title="Lo que le toca del ancho de la tabla">@Parte(rr.NUM_RESULTADO, e)</span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <select class="rep-input" value="@(e.COD_ALINEACION ?? "")" @onchange="@(ev => e.COD_ALINEACION = Vacio(ev.Value?.ToString()))">
                                                                    <option value="">@(col?.COD_ALINEACION is { } a ? $"({Alin(a)})" : "(según tipo)")</option>
                                                                    <option value="I">Izquierda</option><option value="C">Centro</option><option value="D">Derecha</option>
                                                                </select>
                                                            </td>
                                                            <td><input class="rep-input mono" list="rep-formatos-d" placeholder="@col?.DES_FORMATO" value="@e.DES_FORMATO" @onchange="@(ev => e.DES_FORMATO = Vacio(ev.Value?.ToString()))" /></td>
                                                            @if (tabla)
                                                            {
                                                                <td style="text-align:center;"><input type="checkbox" checked="@e.FLG_TOTALIZA" @onchange="@(ev => e.FLG_TOTALIZA = (bool)(ev.Value ?? false))" /></td>
                                                            }
                                                            @if (conGrupo)
                                                            {
                                                                <td>
                                                                    <select class="rep-input" value="@e.NUM_NIVEL_GRUPO" @onchange="@(ev => CambiarGrupo(e, Num(ev.Value) ?? 0))">
                                                                        <option value="0">—</option><option value="1">Nivel 1</option><option value="2">Nivel 2</option>
                                                                    </select>
                                                                </td>
                                                            }
                                                            @if (!esFicha)
                                                            {
                                                                <td>
                                                                    <select class="rep-input" value="@(e.COD_ORDEN ?? "")" @onchange="@(ev => CambiarOrden(rr.NUM_RESULTADO, e, Vacio(ev.Value?.ToString())))">
                                                                        <option value="">—</option><option value="A">Ascendente</option><option value="D">Descendente</option>
                                                                    </select>
                                                                </td>
                                                                <td><input class="rep-input" type="number" min="1" max="99" value="@e.NUM_PRIORIDAD_ORDEN" disabled="@(e.COD_ORDEN is null)" @onchange="@(ev => e.NUM_PRIORIDAD_ORDEN = Num(ev.Value))" /></td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!esFicha && !libre)
                            {
                                <MudText Typo="Typo.caption" Style="opacity:.65;">
                                    Una columna de grupo suele ir sin "Ver": sale como título del grupo. El orden de las filas: primero los grupos y luego las
                                    columnas con "Ordenar", según su prioridad; sin nada, el orden en que las devuelve el SP. "Ancho" reparte el ancho de la hoja
                                    entre las columnas que se ven: es un peso (10 si lo dejas vacío), y al lado sale el % que le toca a cada una.
                                </MudText>
                            }
                            <datalist id="rep-formatos-d">
                                <option value="dd/MM/yyyy"></option><option value="dd/MM/yyyy HH:mm"></option><option value="#,##0.00"></option>
                                <option value="#,##0"></option><option value="#,##0.000"></option><option value="0"></option><option value="LETRAS"></option>
                            </datalist>
                        }
                    </MudTabPanel>

                    @* ── FORMATOS Y PLANTILLAS ── *@
                    <MudTabPanel Text="Formatos y plantillas" Icon="@Icons.Material.Filled.Description">
                        @foreach (var c in Codigos)
                        {
                            var f = Formato(c);
                            var csvFicha = c == "CSV" && esFicha;
                            <div class="rep-formato">
                                <MudCheckBox T="bool" Value="@(f.FLG_HABILITADO && !csvFicha)" ValueChanged="@(v => f.FLG_HABILITADO = v)" Disabled="csvFicha" Color="Color.Primary" Dense="true" />
                                <MudIcon Icon="@ReportesWebService.IconoFormato(c)" Style="opacity:.7;" />
                                <div style="flex:1;min-width:200px;">
                                    <div style="font-weight:800;">@ReportesWebService.NombreFormato(c)</div>
                                    <div style="font-size:.76rem;opacity:.75;">
                                        @if (c == "PDF") { <span>@(libre ? "Sale del lienzo, tal como se ve." : "Sale siempre del diseño.")</span> }
                                        else if (c == "CSV") { <span>@(csvFicha ? "Solo en listados." : libre ? "Los campos del detalle del lienzo, con el separador elegido." : "Las columnas visibles del resultado 1, con el separador elegido.")</span> }
                                        else if (libre && c == "DOC" && !f.FLG_PLANTILLA_PROPIA) { <span>En un diseño libre, Word sale solo con plantilla propia: descarga la base, ajústala y súbela.</span> }
                                        else if (f.FLG_PLANTILLA_PROPIA)
                                        {
                                            <span>Con plantilla propia: <b>@f.DES_NOMBRE_ARCHIVO</b> (@Kb(f.NUM_BYTES))@(f.FEC_ACTUALIZACION is { } fa ? $" · {f.COD_USUARIO_ACTUALIZACION} {fa:dd/MM/yyyy HH:mm}" : "")</span>
                                        }
                                        else if (libre && c == "XLS" && f.FLG_CON_FORMATO) { <span>Como el PDF: la hoja copia el lienzo (letra, colores, cuadros, líneas y logo); los números y las fechas siguen siendo números y fechas.</span> }
                                        else { <span>@(libre ? "Sale con los datos del lienzo (sin plantilla propia)." : "Sale del diseño (sin plantilla propia).")</span> }
                                    </div>
                                    @if (libre && c == "XLS")
                                    {
                                        <div title="@(f.FLG_PLANTILLA_PROPIA ? "Con plantilla propia, el Excel sale de la plantilla: quítala para usar esta opción." : "")">
                                            <MudSwitch T="bool" @bind-Value="f.FLG_CON_FORMATO" Disabled="@f.FLG_PLANTILLA_PROPIA" Color="Color.Primary" Size="Size.Small"
                                                       Label="Con formato (como el PDF)" Class="mt-1" />
                                        </div>
                                    }
                                </div>
                                @if (c is "DOC" or "XLS")
                                {
                                    var ext = c == "DOC" ? ".docx" : ".xlsx";
                                    <div class="d-flex flex-wrap gap-1 align-center">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                                                   Disabled="@(d.NUM_DISENO is null || _plantilla)" OnClick="@(() => DescargarBase(c))">Plantilla base</MudButton>
                                        <MudFileUpload T="IBrowserFile" Accept="@ext" FilesChanged="@(a => Subir(c, a))" Disabled="@(d.NUM_DISENO is null || _plantilla)">
                                            <ActivatorContent>
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                                                           Disabled="@(d.NUM_DISENO is null || _plantilla)">Subir propia</MudButton>
                                            </ActivatorContent>
                                        </MudFileUpload>
                                        @if (f.FLG_PLANTILLA_PROPIA)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload"
                                                       Disabled="_plantilla" OnClick="@(() => DescargarPropia(c))">Descargar propia</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.LinkOff"
                                                       Disabled="_plantilla" OnClick="@(() => QuitarPropia(c))">Quitar</MudButton>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (d.NUM_DISENO is null)
                        {
                            <MudText Typo="Typo.caption" Style="opacity:.7;">Las plantillas se manejan cuando el diseño ya está grabado.</MudText>
                        }
                        @if (_avisos is { Count: > 0 })
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-2" ShowCloseIcon="true" CloseIconClicked="@(() => _avisos = null)">
                                <div style="font-weight:700;">La plantilla se grabó, pero revisa:</div>
                                <ul style="margin:4px 0 0 18px;">@foreach (var a in _avisos) { <li>@a</li> }</ul>
                            </MudAlert>
                        }

                        <details class="mt-3 rep-ayuda">
                            <summary>Marcas para las plantillas propias</summary>
                            <div class="pa-2" style="font-size:.78rem;">
                                <p>Se escriben en el Word o en el Excel entre llaves dobles. Con <span class="mono">|formato</span> al final se cambia el formato:
                                    <span class="mono">{{R1.FEC_PEDIDO|dd/MM/yyyy}}</span>.</p>
                                <ul style="margin-left:18px;">
                                    <li><span class="mono">{{R2.COLUMNA}}</span> columna del resultado 2. También <span class="mono">{{CAB.COLUMNA}}</span>, <span class="mono">{{DET.COLUMNA}}</span>, <span class="mono">{{ADI.COLUMNA}}</span> según su papel.</li>
                                    <li>Una fila (de tabla en Word, de hoja en Excel) con marcas de un resultado que no es cabecera <b>se repite</b> por cada fila de datos.</li>
                                    <li><span class="mono">{{TOTAL.R2.COLUMNA}}</span> suma de la columna (en Excel queda como fórmula SUBTOTAL).</li>
                                    <li><span class="mono">{{@@PARAMETRO}}</span> o <span class="mono">{{P.PARAMETRO}}</span> valor de un parámetro.</li>
                                    <li><span class="mono">{{EMPRESA.NOMBRE}}</span>, <span class="mono">{{EMPRESA.RUC}}</span>, <span class="mono">{{EMPRESA.DIRECCION}}</span>, <span class="mono">{{EMPRESA.APLICACION}}</span> (el nombre de la aplicación).</li>
                                    <li><span class="mono">{{TITULO}}</span>, <span class="mono">{{SUBTITULO}}</span>, <span class="mono">{{FILTROS}}</span>, <span class="mono">{{USUARIO}}</span>, <span class="mono">{{FECHA}}</span>, <span class="mono">{{HOY}}</span>.</li>
                                    <li>Formato <span class="mono">LETRAS</span>: el importe en letras con la moneda de la fila (SON: ... CON 50/100 SOLES).</li>
                                </ul>
                                @if (_fuente is not null)
                                {
                                    <div style="font-weight:700;" class="mt-1">De esta fuente:</div>
                                    @foreach (var r in _fuente.Resultados.OrderBy(x => x.NUM_RESULTADO))
                                    {
                                        var rr = r;
                                        <div class="mt-1"><b>@($"R{rr.NUM_RESULTADO}")</b> (@Papel(rr.COD_PAPEL)):
                                            <span class="mono" style="opacity:.8;">@string.Join("  ", _fuente.Columnas.Where(c => c.NUM_RESULTADO == rr.NUM_RESULTADO).OrderBy(c => c.NUM_ORDEN).Select(c => c.DES_COLUMNA))</span>
                                        </div>
                                    }
                                    @if (_fuente.Parametros.Count > 0)
                                    {
                                        <div class="mt-1"><b>Parámetros:</b>
                                            <span class="mono" style="opacity:.8;">@string.Join("  ", _fuente.Parametros.OrderBy(p => p.NUM_ORDEN).Select(p => p.DES_PARAMETRO))</span>
                                        </div>
                                    }
                                }
                            </div>
                        </details>
                    </MudTabPanel>
                </MudTabs>
            }
        </MudPaper>
    </div>
</div>

