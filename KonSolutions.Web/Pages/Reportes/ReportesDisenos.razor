@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private const string Formulario = "Reportes/ReportesDisenos.razor";
    private static readonly string[] Codigos = { "PDF", "DOC", "XLS", "CSV" };
    private const string AyudaTextos = "Admite {@PARAMETRO} y {COLUMNA}: Del {@FEC_DESDE} al {@FEC_HASTA}";
    private const long MaxPlantilla = 5 * 1024 * 1024;

    private string _codAp = "", _codOp = "";
    private List<ReporteDiseno> _disenos = new();
    private List<ReporteFuente> _fuentes = new();
    private ReporteDisenoDetalle? _det;
    private ReporteFuenteDetalle? _fuente;
    private string? _grabado;
    private int? _filtroFuente;
    private string? _buscar;
    private List<string>? _avisos;
    // Las columnas de la fuente que el diseño grabado todavía no tenía (se agregaron al SP): resultado y nombre en mayúsculas.
    private readonly HashSet<(int Resultado, string Columna)> _nuevas = new();
    private int _pestana;
    private bool _cargandoLista, _grabando, _plantilla;
    // El editor a todo el ancho (sin la lista): el lienzo lo agradece.
    private bool _soloEditor;

    private List<ReporteDiseno> Filtrados => _disenos
        .Where(d => _filtroFuente is null || d.NUM_FUENTE == _filtroFuente)
        .Where(d => string.IsNullOrWhiteSpace(_buscar)
                 || (d.DES_DISENO ?? "").Contains(_buscar, StringComparison.OrdinalIgnoreCase)
                 || (d.DES_FUENTE ?? "").Contains(_buscar, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("REPORTES", "ReportesDisenos");
        _codAp = CodAplicacion;
        _codOp = CodOpcionAplicacion;
        if ((string.IsNullOrWhiteSpace(_codAp) || string.IsNullOrWhiteSpace(_codOp)) && MenuService.BuscarCodigosPorFormulario(Formulario) is { } cod)
            (_codAp, _codOp) = cod;
        var (f, err) = await Reportes.GetAsync<List<ReporteFuente>>(ApiRoutes.Reportes.DisenosFuentes);
        _fuentes = f ?? new();
        if (err is not null) Snackbar.Add(err, Severity.Warning);
        await CargarLista();
    }

    private async Task CargarLista()
    {
        _cargandoLista = true;
        var (d, err) = await Reportes.GetAsync<List<ReporteDiseno>>(ApiRoutes.Reportes.Disenos);
        _disenos = d ?? new();
        if (err is not null) Snackbar.Add(err, Severity.Warning);
        _cargandoLista = false;
    }

    private async Task Nuevo()
    {
        _det = new ReporteDisenoDetalle
        {
            Diseno = new ReporteDiseno { NUM_FUENTE = _filtroFuente, DES_SEPARADOR_CSV = ";" },
            Formatos = Codigos.Select(c => new ReporteDisenoPlantilla { COD_FORMATO = c, FLG_HABILITADO = true }).ToList()
        };
        _fuente = null; _avisos = null; _grabado = null; _pestana = 0;
        _nuevas.Clear();
        if (_filtroFuente is { } n) await ElegirFuente(n);
    }

    private async Task Abrir(int? num)
    {
        if (num is not { } n) return;
        var (d, err) = await Reportes.GetAsync<ReporteDisenoDetalle>(ApiRoutes.Reportes.Diseno(n));
        if (d is null) { Snackbar.Add(err ?? "No se pudo leer el diseño.", Severity.Warning); return; }
        _fuente = d.Diseno.NUM_FUENTE is { } nf ? await LeerFuente(nf) : null;
        _det = d; _avisos = null;
        _nuevas.Clear();
        Completar(d, existente: true);
        if (d.Diseno.COD_TIPO_DISENO == "BAN")
        {
            d.Lienzo ??= LienzoEditor.Basico(d.Diseno);
            LienzoEditor.Completar(d.Lienzo);
        }
        _grabado = Foto();
    }

    private async Task<ReporteFuenteDetalle?> LeerFuente(int num)
    {
        var (f, err) = await Reportes.GetAsync<ReporteFuenteDetalle>(ApiRoutes.Reportes.DisenosFuente(num));
        if (f is null) Snackbar.Add(err ?? "No se pudo leer la fuente.", Severity.Warning);
        return f;
    }

    private async Task ElegirFuente(int? num)
    {
        if (_det is null || num is not { } n) return;
        var f = await LeerFuente(n);
        if (f is null) return;
        _fuente = f;
        _det.Diseno.NUM_FUENTE = n;
        if (string.IsNullOrWhiteSpace(_det.Diseno.DES_DISENO)) _det.Diseno.DES_DISENO = f.Fuente.DES_FUENTE;
        if (string.IsNullOrWhiteSpace(_det.Diseno.DES_TITULO)) _det.Diseno.DES_TITULO = f.Fuente.DES_FUENTE;
        // Una fuente con cabecera es, casi siempre, para una ficha (un diseño libre sigue libre).
        if (_det.Diseno.COD_TIPO_DISENO != "BAN")
            _det.Diseno.COD_TIPO_DISENO = f.Resultados.Any(r => r.COD_PAPEL == "CAB") ? "FIC" : "LIS";
        _det.Secciones.Clear();
        _det.Elementos.Clear();
        _nuevas.Clear();
        Completar(_det, existente: false);
        StateHasChanged();
    }

    /// <summary>Al cambiar de tipo, las secciones vuelven a lo habitual del tipo nuevo (las columnas se quedan como están).</summary>
    private void CambiarTipo(string tipo)
    {
        if (_det is null || _det.Diseno.COD_TIPO_DISENO == tipo) return;
        _det.Diseno.COD_TIPO_DISENO = tipo;
        _det.Secciones.Clear();
        Completar(_det, existente: false);
        // Un diseño libre nuevo empieza con el encabezado y el pie de siempre; los otros tipos no llevan lienzo.
        if (tipo == "BAN")
        {
            _det.Lienzo ??= LienzoEditor.Basico(_det.Diseno);
            LienzoEditor.Completar(_det.Lienzo);
        }
        else _det.Lienzo = null;
    }

    /// <summary>Deja una sección por resultado y un elemento por columna de la fuente, para editar sobre la lista completa.
    /// Lo que el diseño no traía: en un diseño grabado queda como estaba (sección oculta, columna sin "Ver"); en uno nuevo
    /// toma lo habitual (la cabecera como campos, lo demás como tablas, todas las columnas visibles).</summary>
    private void Completar(ReporteDisenoDetalle d, bool existente)
    {
        foreach (var c in Codigos)
            if (!d.Formatos.Any(f => f.COD_FORMATO == c)) d.Formatos.Add(new ReporteDisenoPlantilla { COD_FORMATO = c });
        if (_fuente is null) return;
        var esFicha = d.Diseno.COD_TIPO_DISENO == "FIC";
        var sinSecciones = d.Secciones.Count == 0;
        foreach (var r in _fuente.Resultados.OrderBy(x => x.NUM_RESULTADO))
        {
            if (!d.Secciones.Any(s => s.NUM_RESULTADO == r.NUM_RESULTADO))
            {
                var oculta = existente && !sinSecciones && esFicha;
                d.Secciones.Add(new ReporteDisenoSeccion
                {
                    NUM_RESULTADO = r.NUM_RESULTADO,
                    NUM_ORDEN = r.NUM_RESULTADO,
                    COD_PRESENTACION = oculta ? "OCU" : !esFicha ? (r.NUM_RESULTADO == 1 ? "TAB" : "OCU") : r.COD_PAPEL == "CAB" ? "CAM" : "TAB",
                    DES_TITULO = esFicha && r.COD_PAPEL != "CAB" ? r.DES_RESULTADO : null,
                    NUM_COLUMNAS = r.COD_PAPEL == "CAB" ? 3 : null
                });
            }
            var tenia = d.Elementos.Any(e => e.NUM_RESULTADO == r.NUM_RESULTADO);
            var orden = d.Elementos.Where(e => e.NUM_RESULTADO == r.NUM_RESULTADO).Select(e => e.NUM_ORDEN).DefaultIfEmpty(0).Max();
            foreach (var c in _fuente.Columnas.Where(x => x.NUM_RESULTADO == r.NUM_RESULTADO).OrderBy(x => x.NUM_ORDEN))
            {
                if (d.Elementos.Any(e => e.NUM_RESULTADO == r.NUM_RESULTADO && Igual(e.DES_COLUMNA, c.DES_COLUMNA))) continue;
                var n = c.DES_COLUMNA.ToUpperInvariant();
                if (existente && tenia) _nuevas.Add((r.NUM_RESULTADO, n));
                d.Elementos.Add(new ReporteDisenoElemento
                {
                    NUM_RESULTADO = r.NUM_RESULTADO,
                    DES_COLUMNA = c.DES_COLUMNA,
                    NUM_ORDEN = ++orden,
                    FLG_VISIBLE = !(existente && tenia),
                    FLG_TOTALIZA = !tenia && r.COD_PAPEL != "CAB" && (n.StartsWith("IMP_") || n.StartsWith("CAN_"))
                });
            }
        }
        // Una sección que apunta a un resultado que la fuente ya no tiene no se puede grabar.
        d.Secciones.RemoveAll(s => !_fuente.Resultados.Any(r => r.NUM_RESULTADO == s.NUM_RESULTADO));
        if (!esFicha && d.Secciones.FirstOrDefault(s => s.NUM_RESULTADO == 1) is { } s1) s1.COD_PRESENTACION = "TAB";
    }

    private IEnumerable<ReporteFuenteResultado> ResultadosVisibles(bool esFicha)
        => (_fuente?.Resultados ?? new()).Where(r => esFicha || r.NUM_RESULTADO == 1).OrderBy(r => r.NUM_RESULTADO);

    private ReporteDisenoSeccion Seccion(int resultado)
    {
        var s = _det!.Secciones.FirstOrDefault(x => x.NUM_RESULTADO == resultado);
        if (s is null) { s = new ReporteDisenoSeccion { NUM_RESULTADO = resultado, NUM_ORDEN = resultado }; _det.Secciones.Add(s); }
        return s;
    }

    private List<ReporteDisenoElemento> Elementos(int resultado)
        => _det!.Elementos.Where(e => e.NUM_RESULTADO == resultado).OrderBy(e => e.NUM_ORDEN).ToList();

    private ReporteFuenteColumna? ColumnaFuente(ReporteDisenoElemento e)
        => _fuente?.Columnas.FirstOrDefault(c => c.NUM_RESULTADO == e.NUM_RESULTADO && Igual(c.DES_COLUMNA, e.DES_COLUMNA));

    private void Mover(int resultado, int indice, int paso)
    {
        var filas = Elementos(resultado);
        var otro = indice + paso;
        if (otro < 0 || otro >= filas.Count) return;
        (filas[indice], filas[otro]) = (filas[otro], filas[indice]);
        for (var i = 0; i < filas.Count; i++) filas[i].NUM_ORDEN = i + 1;
    }

    /// <summary>Una columna de grupo se ordena (si no tenía orden) y deja de imprimirse como columna: ya sale en el título del grupo.</summary>
    private void CambiarGrupo(ReporteDisenoElemento e, int nivel)
    {
        e.NUM_NIVEL_GRUPO = nivel;
        if (nivel > 0)
        {
            e.FLG_VISIBLE = false;
            if (e.COD_ORDEN is null) { e.COD_ORDEN = "A"; e.NUM_PRIORIDAD_ORDEN = nivel; }
        }
    }

    private void CambiarOrden(int resultado, ReporteDisenoElemento e, string? orden)
    {
        e.COD_ORDEN = orden;
        if (orden is null) e.NUM_PRIORIDAD_ORDEN = null;
        else e.NUM_PRIORIDAD_ORDEN ??= _det!.Elementos.Where(x => x.NUM_RESULTADO == resultado && x.COD_ORDEN is not null && x != e)
                                                       .Select(x => x.NUM_PRIORIDAD_ORDEN ?? 0).DefaultIfEmpty(0).Max() + 1;
    }

    private ReporteDisenoPlantilla Formato(string codigo)
    {
        var f = _det!.Formatos.FirstOrDefault(x => x.COD_FORMATO == codigo);
        if (f is null) { f = new ReporteDisenoPlantilla { COD_FORMATO = codigo }; _det.Formatos.Add(f); }
        return f;
    }

    private async Task Grabar()
    {
        if (_det is null || _grabando) return;
        var d = _det.Diseno;
        if (d.NUM_FUENTE is null) { Snackbar.Add("Elige la fuente.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(d.DES_DISENO)) { Snackbar.Add("Falta la descripción.", Severity.Warning); return; }
        if (d.COD_TIPO_DISENO == "FIC") Formato("CSV").FLG_HABILITADO = false;
        if (!_det.Formatos.Any(f => f.FLG_HABILITADO)) { Snackbar.Add("Marca al menos un formato.", Severity.Warning); return; }
        if (d.COD_TIPO_DISENO == "BAN" && _det.Lienzo is null) { Snackbar.Add("El diseño libre no tiene lienzo.", Severity.Warning); return; }
        if (d.COD_TIPO_DISENO == "LIS" && !_det.Elementos.Any(e => e.NUM_RESULTADO == 1 && e.FLG_VISIBLE))
        { Snackbar.Add("El listado no tiene ninguna columna para ver.", Severity.Warning); return; }
        _grabando = true;
        try
        {
            if (await AlinearConFuente() is { } falta) { Snackbar.Add(falta, Severity.Warning); return; }
            var (num, err) = await Reportes.PostAsync<int>(ApiRoutes.Reportes.Disenos, _det);
            if (err is not null)
            {
                // Las fórmulas con errores vienen una por línea: se leen mejor en un cuadro que en el aviso de abajo.
                if (err.Contains('\n'))
                    await DialogService.ShowMessageBox("No se grabó", new MarkupString(string.Join("<br/>", err.Split('\n').Select(System.Net.WebUtility.HtmlEncode))), yesText: "Entendido");
                else Snackbar.Add(err, Severity.Warning);
                return;
            }
            Snackbar.Add($"Diseño N° {num} grabado.", Severity.Success);
            await CargarLista();
            await Abrir(num);
        }
        finally { _grabando = false; }
    }

    /// <summary>Antes de grabar, la fuente como está ahora en la base: pudo cambiar con la pantalla abierta (otra pestaña grabó
    /// la fuente, o el SP dejó de devolver una columna y se volvió a probar). Las columnas que la fuente ya no tiene y que el
    /// diseño no usa (ocultas, sin grupo ni orden) se quitan sin preguntar; las nuevas se agregan ocultas. Si el diseño usa una
    /// que ya no está, devuelve qué pasa y no se graba.</summary>
    private async Task<string?> AlinearConFuente()
    {
        if (_det?.Diseno.NUM_FUENTE is not { } nf) return null;
        var (f, _) = await Reportes.GetAsync<ReporteFuenteDetalle>(ApiRoutes.Reportes.DisenosFuente(nf));
        if (f is null) return null;
        bool Existe(ReporteDisenoElemento e) => f.Columnas.Any(c => c.NUM_RESULTADO == e.NUM_RESULTADO && Igual(c.DES_COLUMNA, e.DES_COLUMNA));
        var usadas = _det.Elementos.Where(e => !Existe(e) && (e.FLG_VISIBLE || e.NUM_NIVEL_GRUPO > 0 || e.COD_ORDEN is not null)).ToList();
        if (usadas.Count > 0)
            return $"La fuente ya no tiene {string.Join(", ", usadas.Select(e => $"{e.DES_COLUMNA} (resultado {e.NUM_RESULTADO})"))}, y el diseño la usa. "
                 + "Quítale «Ver», el grupo y el orden en «Columnas», o vuelve a probar la fuente si el SP todavía la devuelve.";
        _det.Elementos.RemoveAll(e => !Existe(e));
        // Una columna que llegara dos veces (no debería) se queda una sola vez.
        _det.Elementos = _det.Elementos.GroupBy(e => (e.NUM_RESULTADO, e.DES_COLUMNA.ToUpperInvariant())).Select(g => g.First()).ToList();
        _nuevas.RemoveWhere(n => !f.Columnas.Any(c => c.NUM_RESULTADO == n.Resultado && Igual(c.DES_COLUMNA, n.Columna)));
        _fuente = f;
        Completar(_det, existente: true);
        return null;
    }

    private async Task Eliminar()
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        var botones = _det.Diseno.NUM_BOTONES > 0 ? $" Lo usan {_det.Diseno.NUM_BOTONES} botón(es): primero hay que quitárselo." : "";
        var ok = await DialogService.ShowMessageBox("Eliminar diseño", $"¿Eliminar el diseño «{_det.Diseno.DES_DISENO}» y sus plantillas?{botones}",
                                                    yesText: "Eliminar", cancelText: "Cancelar");
        if (ok != true) return;
        var err = await Reportes.DeleteAsync(ApiRoutes.Reportes.Diseno(n));
        if (err is not null) { Snackbar.Add(err, Severity.Warning); return; }
        Snackbar.Add("Diseño eliminado.", Severity.Success);
        _det = null; _fuente = null;
        await CargarLista();
    }

    /// <summary>Convertir a bandas: la API crea un diseño libre nuevo, copia de este (lo grabado), con el lienzo que lo
    /// dibuja igual. Se abre en su lienzo.</summary>
    private async Task Convertir()
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        var sinGrabar = _grabado != Foto() ? " Hay cambios sin grabar: se convierte lo que está grabado." : "";
        var ok = await DialogService.ShowMessageBox("Convertir a bandas",
            $"Se crea un diseño libre nuevo, «{_det.Diseno.DES_DISENO} (bandas)», con el lienzo armado para que salga igual que este. Este diseño queda como está.{sinGrabar}",
            yesText: "Convertir", cancelText: "Cancelar");
        if (ok != true) return;
        _grabando = true;
        try
        {
            var (num, err) = await Reportes.PostAsync<int>(ApiRoutes.Reportes.DisenoConvertir(n), new { });
            if (err is not null || num == 0) { Snackbar.Add(err ?? "No se pudo convertir el diseño.", Severity.Warning); return; }
            Snackbar.Add($"Diseño libre N° {num} creado: revisa su lienzo y, cuando esté listo, asígnalo a los botones.", Severity.Success);
            await CargarLista();
            await Abrir(num);
            _pestana = 1;
        }
        finally { _grabando = false; }
    }

    private async Task VistaPrevia()
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        if (_grabado != Foto())
        {
            var seguir = await DialogService.ShowMessageBox("Vista previa", "Hay cambios sin grabar: la vista previa usa el diseño grabado.",
                                                            yesText: "Ver lo grabado", cancelText: "Cancelar");
            if (seguir != true) return;
        }
        var p = new DialogParameters
        {
            ["NumDiseno"] = n,
            ["Titulo"] = $"Vista previa · {_det.Diseno.DES_DISENO}",
            ["Contexto"] = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase)
        };
        var dlg = await DialogService.ShowAsync<ReporteEjecutarDialog>("", p,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false });
        await dlg.Result;
        await RefrescarFuente();
    }

    /// <summary>Después de la vista previa. Si el procedimiento trajo columnas nuevas, la API ya las agregó a la fuente: se
    /// vuelve a leer para que aparezcan en el explorador del lienzo y en «Columnas» (sin «Ver»: lo que se imprime no cambia
    /// hasta que las marques). Sin columnas nuevas no cambia nada.</summary>
    private async Task RefrescarFuente()
    {
        if (_det?.Diseno.NUM_FUENTE is not { } nf || _fuente is null) return;
        var (f, _) = await Reportes.GetAsync<ReporteFuenteDetalle>(ApiRoutes.Reportes.DisenosFuente(nf));
        if (f is null || f.Columnas.All(c => _fuente.Columnas.Any(x => x.NUM_RESULTADO == c.NUM_RESULTADO && Igual(x.DES_COLUMNA, c.DES_COLUMNA)))) return;
        // Las columnas que se agregan aquí van ocultas: si el diseño no tenía cambios, sigue sin tenerlos.
        var sinCambios = _grabado == Foto();
        _fuente = f;
        Completar(_det, existente: true);
        if (sinCambios) _grabado = Foto();
        StateHasChanged();
    }

    private string TextoNueva((int Resultado, string Columna) n)
    {
        var r = _fuente?.Resultados.FirstOrDefault(x => x.NUM_RESULTADO == n.Resultado);
        return $"{n.Columna} ({(r?.DES_RESULTADO is { Length: > 0 } d ? d : $"resultado {n.Resultado}")})";
    }

    // ── Plantillas propias ──────────────────────────────────────────────────────

    private async Task DescargarBase(string formato)
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        if (_grabado != Foto()) Snackbar.Add("La plantilla base se arma con el diseño grabado (hay cambios sin grabar).", Severity.Info);
        _plantilla = true;
        try
        {
            var (a, err) = await Reportes.GetAsync<ReporteArchivo>(ApiRoutes.Reportes.PlantillaBase(n, formato));
            if (a is null) { Snackbar.Add(err ?? "No se pudo armar la plantilla.", Severity.Warning); return; }
            await Reportes.DescargarAsync(a);
        }
        finally { _plantilla = false; }
    }

    private async Task DescargarPropia(string formato)
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        _plantilla = true;
        try
        {
            var (a, err) = await Reportes.GetAsync<ReporteArchivo>(ApiRoutes.Reportes.Plantilla(n, formato));
            if (a is null) { Snackbar.Add(err ?? "No se pudo leer la plantilla.", Severity.Warning); return; }
            await Reportes.DescargarAsync(a);
        }
        finally { _plantilla = false; }
    }

    private async Task Subir(string formato, IBrowserFile? archivo)
    {
        if (archivo is null || _det?.Diseno.NUM_DISENO is not { } n) return;
        var ext = formato == "DOC" ? ".docx" : ".xlsx";
        if (!archivo.Name.EndsWith(ext, StringComparison.OrdinalIgnoreCase)) { Snackbar.Add($"La plantilla de {ReportesWebService.NombreFormato(formato)} tiene que ser {ext}.", Severity.Warning); return; }
        if (archivo.Size > MaxPlantilla) { Snackbar.Add("La plantilla pasa de 5 MB. Revisa las imágenes que tiene.", Severity.Warning); return; }
        _plantilla = true; _avisos = null;
        try
        {
            byte[] bytes;
            await using (var s = archivo.OpenReadStream(MaxPlantilla))
            using (var ms = new MemoryStream())
            {
                await s.CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            var (r, err) = await Reportes.PostAsync<ReportePlantillaResultado>(ApiRoutes.Reportes.Plantilla(n, formato),
                new ReportePlantillaDto { DES_NOMBRE_ARCHIVO = archivo.Name, CONTENIDO = bytes });
            if (r is null) { Snackbar.Add(err ?? "No se pudo subir la plantilla.", Severity.Warning); return; }
            Snackbar.Add($"Plantilla grabada ({r.NUM_MARCAS} marca{(r.NUM_MARCAS == 1 ? "" : "s")}).", r.Avisos.Count > 0 ? Severity.Warning : Severity.Success);
            _avisos = r.Avisos.Count > 0 ? r.Avisos : null;
            await RefrescarFormatos(n);
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(ReportesDisenos), nameof(Subir), archivo.Name);
            Snackbar.Add("No se pudo leer el archivo. Ver detalle en el log de errores.", Severity.Error);
        }
        finally { _plantilla = false; }
    }

    private async Task QuitarPropia(string formato)
    {
        if (_det?.Diseno.NUM_DISENO is not { } n) return;
        var ok = await DialogService.ShowMessageBox("Quitar plantilla", $"¿Quitar la plantilla propia de {ReportesWebService.NombreFormato(formato)}? El formato vuelve a salir del diseño.",
                                                    yesText: "Quitar", cancelText: "Cancelar");
        if (ok != true) return;
        _plantilla = true;
        try
        {
            var err = await Reportes.DeleteAsync(ApiRoutes.Reportes.Plantilla(n, formato));
            if (err is not null) { Snackbar.Add(err, Severity.Warning); return; }
            Snackbar.Add("Plantilla quitada.", Severity.Success);
            _avisos = null;
            await RefrescarFormatos(n);
        }
        finally { _plantilla = false; }
    }

    /// <summary>Vuelve a leer solo los formatos: lo demás que se esté editando no se pierde.</summary>
    private async Task RefrescarFormatos(int num)
    {
        var (d, _) = await Reportes.GetAsync<ReporteDisenoDetalle>(ApiRoutes.Reportes.Diseno(num));
        if (d is null || _det is null) return;
        foreach (var f in d.Formatos)
        {
            var mio = Formato(f.COD_FORMATO);
            mio.FLG_PLANTILLA_PROPIA = f.FLG_PLANTILLA_PROPIA; mio.DES_NOMBRE_ARCHIVO = f.DES_NOMBRE_ARCHIVO; mio.NUM_BYTES = f.NUM_BYTES;
            mio.COD_USUARIO_ACTUALIZACION = f.COD_USUARIO_ACTUALIZACION; mio.FEC_ACTUALIZACION = f.FEC_ACTUALIZACION;
        }
        if (_disenos.FirstOrDefault(x => x.NUM_DISENO == num) is { } l) { l.FLG_PROPIA_DOC = d.Diseno.FLG_PROPIA_DOC; l.FLG_PROPIA_XLS = d.Diseno.FLG_PROPIA_XLS; }
    }

    // ── Ayudas ──────────────────────────────────────────────────────────────────

    /// <summary>El diseño como texto, para saber si hay cambios sin grabar (solo lo que se edita, no las plantillas).</summary>
    private string Foto() => _det is null ? "" : JsonSerializer.Serialize(new
    {
        _det.Diseno, Secciones = _det.Secciones.OrderBy(s => s.NUM_RESULTADO), Elementos = _det.Elementos.OrderBy(e => e.NUM_RESULTADO).ThenBy(e => e.DES_COLUMNA),
        Formatos = _det.Formatos.OrderBy(f => f.COD_FORMATO).Select(f => new { f.COD_FORMATO, f.FLG_HABILITADO, f.FLG_CON_FORMATO }),
        _det.Lienzo
    });

    private static string IconoTipo(string? tipo) => tipo switch
    {
        "FIC" => Icons.Material.Filled.Article,
        "BAN" => Icons.Material.Filled.Dashboard,
        _     => Icons.Material.Filled.ListAlt
    };

    private static string NombreTipo(string? tipo) => tipo switch { "FIC" => "Ficha", "BAN" => "Libre", _ => "Listado" };

    private static string Papel(string? p) => p switch { "CAB" => "cabecera", "DET" => "detalle", _ => "adicional" };
    private static string Alin(string a) => a switch { "C" => "centro", "D" => "derecha", _ => "izquierda" };
    private static string Kb(int? bytes) => bytes is { } b ? (b < 1024 ? $"{b} B" : $"{b / 1024.0:0.#} KB") : "";
    private static bool Igual(string? a, string? b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);
    private static int? Num(object? v) => int.TryParse(v?.ToString(), out var n) ? n : null;

    /// <summary>Qué es el ancho de una columna: en una sección de campos de una ficha, cuántas columnas ocupa el campo; en
    /// una tabla (listado, tabla de una ficha o de un diseño libre), su peso al repartir el ancho entre las que se ven.</summary>
    private static string AyudaAncho(bool campos) => campos
        ? "Cuántas columnas de la sección ocupa el campo (1 si lo dejas vacío)."
        : "Peso de la columna al repartir el ancho de la tabla entre las que se ven (10 si lo dejas vacío). Ejemplo: 30 y 10 reparten 75 % y 25 %.";

    /// <summary>El % del ancho que le toca a una columna visible, con los pesos de las demás visibles del resultado.</summary>
    private string Parte(int resultado, ReporteDisenoElemento e)
    {
        static int Peso(ReporteDisenoElemento x) => x.NUM_ANCHO is > 0 ? x.NUM_ANCHO.Value : 10;
        var suma = Elementos(resultado).Where(x => x.FLG_VISIBLE).Sum(Peso);
        return suma <= 0 ? "" : $"{Math.Round(100.0 * Peso(e) / suma):0} %";
    }
    private static string? Vacio(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
