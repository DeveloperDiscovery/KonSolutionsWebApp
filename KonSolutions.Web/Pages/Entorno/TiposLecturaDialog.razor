@using TiposLecturaModel = KONSolutions.Shared.Models.Entorno.TiposLectura
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_LECTURA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            @if (!_esNuevo)
            {
                <CampoTexto Tabla="ENTORNO.TIPOS_LECTURA" Columna="COD_TIPO_LECTURA"
                            @bind-Value="_codigoStr" Disabled="true" />
            }
            <CampoTexto Tabla="ENTORNO.TIPOS_LECTURA" Columna="DES_TIPO_LECTURA"
                        @bind-Value="_model.DES_TIPO_LECTURA"
                        Disabled="_readonly" Obligatorio="true" />
            @* Las tres formas de lectura son independientes: un tipo puede permitir más de una. *@
            <div class="d-flex gap-4 mb-3 flex-wrap">
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" Size="Size.Medium" />
                    <MudSwitch T="bool" Value="@(_model.FLG_MANUAL ?? false)" ValueChanged="@(v => _model.FLG_MANUAL = v)"
                               Color="Color.Primary" Label="Manual" Disabled="_readonly" />
                </div>
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.QrCodeScanner" Color="Color.Primary" Size="Size.Medium" />
                    <MudSwitch T="bool" Value="@(_model.FLG_CODEBAR ?? false)" ValueChanged="@(v => _model.FLG_CODEBAR = v)"
                               Color="Color.Primary" Label="Código de barras" Disabled="_readonly" />
                </div>
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Sensors" Color="Color.Primary" Size="Size.Medium" />
                    <MudSwitch T="bool" Value="@(_model.FLG_RFID ?? false)" ValueChanged="@(v => _model.FLG_RFID = v)"
                               Color="Color.Primary" Label="RFID" Disabled="_readonly" />
                </div>
            </div>
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposLecturaModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    // Opción de menú del diálogo (la pasa quien lo abre: la de la grilla de esta entidad).
    // Con ella el pie muestra los botones marcados como Diálogo (ver CrudDialogActions).
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }

    private TiposLecturaModel _model = new();
    private string? _codigoStr;
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        // Mapeo inicial desde el Item que pasó la grilla: sirve mientras llega el SHOWBYID (OnInitializedAsync) o si ese viaje
        // falla; cuando responde, MapearDesdeModelo() lo pisa con lo fresco de la base.
        if (Item is not null) MapearDesdeModelo(Item);
        else { _model.FLG_MANUAL = false; _model.FLG_CODEBAR = false; _model.FLG_RFID = false; }   // alta: viajan false explícito, no null
    }

    /// <summary>Copia los campos editables del modelo (Item de la grilla, o la respuesta fresca de SHOWBYID) hacia _model.</summary>
    private void MapearDesdeModelo(TiposLecturaModel m)
    {
        _model.COD_TIPO_LECTURA = m.COD_TIPO_LECTURA;
        _model.DES_TIPO_LECTURA = m.DES_TIPO_LECTURA;
        _model.FLG_MANUAL  = m.FLG_MANUAL;
        _model.FLG_CODEBAR = m.FLG_CODEBAR;
        _model.FLG_RFID    = m.FLG_RFID;
        _codigoStr = _model.COD_TIPO_LECTURA?.ToString();
    }

    /// <summary>Trae el registro fresco desde SHOWBYID al abrir (Modificar/Eliminar/Ver, nunca Crear), para no mostrar datos
    /// desactualizados de la grilla.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposLecturaModel>($"{ApiRoutes.Entorno.TiposLectura}/{_model.COD_TIPO_LECTURA}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = ApiRoutes.Entorno.TiposLectura;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{_model.COD_TIPO_LECTURA}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposLecturaDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var resp = await Http.GuardarAsync(ruta, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposLecturaDialog), nameof(Submit));
    }
}
