@* Subgrilla de trazabilidad de una línea del pedido: de qué requerimiento(s) de stock salió
   y con cuánta cantidad. Vive en su propio componente (no inline en el ChildRowContent de
   PedidoComercialDocumento) porque necesita cargar datos por sí sola apenas se monta — que es
   justo cuando el usuario expande la línea — sin depender de un hook de "fila expandida" que
   MudDataGrid no expone de forma simple.

   PROC_COMERCIAL_PEDIDOS_COMERCIALES_DETALLE_REQUERIMIENTOS_STOCK_DETALLE_SHOWALL exige un
   NUM_REQUERIMIENTO_STOCK puntual (no lista "todos los de la línea" de una sola vez), así que
   primero se piden los requerimientos vinculados a la CABECERA del pedido
   (PROC_COMERCIAL_PEDIDOS_COMERCIALES_REQUERIMIENTOS_STOCK_SHOWALL — normalmente uno o pocos)
   y se llama al SP de detalle una vez por cada uno, filtrando por esta línea. Los resultados
   se juntan en una sola tabla. *@
@using KONSolutions.Shared.Models.Comercial
@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@inject HttpClient Http

@if (_cargando)
{
    <MudProgressLinear Indeterminate="true" Class="my-1" />
}
else if (_error is not null)
{
    @* DOS MENSAJES, NO UNO.
       "No viene de ningún requerimiento" es un dato del negocio; "la consulta falló" es
       algo que hay que ir a arreglar a otro lado. Con un texto único para los dos, una
       consulta caída se lee como una línea cargada a mano — que es exactamente lo que
       estuvo pasando: SafeGetAsync convierte cualquier error en null y null se veía igual
       que "no hay nada". *@
    <div class="pa-3 mono" style="font-size:.8rem;color:var(--rust,#b8472d);">
        No se pudo consultar la trazabilidad de esta línea.<br />
        <span style="opacity:.75;">@_error</span>
    </div>
}
else if (_lineas.Count == 0)
{
    <MudText Class="pa-3 mono" Style="opacity:.5;font-size:.8rem;">
        Esta línea no viene de ningún requerimiento de stock.
    </MudText>
}
else
{
    @* Tabla simple con la misma clase que usan las demás subgrillas de la app
       (ver ComparativoPanel.razor): tabla-simple-editable ya toma los colores de
       Configuración General (--grilla-cab-fondo/--grilla-cab-texto/--grilla-fila-par) sin
       depender de cómo MudDataGrid pinte su cabecera dentro de una fila expandida. *@
    <div style="overflow-x:auto;border:1px solid var(--line);border-radius:4px;">
        <table class="tabla-simple-editable" style="width:100%;">
            <thead>
                <tr>
                    <th style="width:120px;text-align:right;">Requerimiento</th>
                    <th style="width:150px;text-align:right;">Línea del requerimiento</th>
                    <th style="width:120px;text-align:right;">Cantidad</th>
                    <th style="width:120px;text-align:right;">Cantidad Atendida</th>
                    <th style="width:70px;text-align:center;">UM</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _lineas)
                {
                    <tr>
                        <td style="text-align:right;" class="mono">@l.NUM_REQUERIMIENTO_STOCK</td>
                        <td style="text-align:right;" class="mono">@l.NUM_SECUENCIA_REQUERIMIENTO_STOCK</td>
                        <td style="text-align:right;" class="mono">@l.CAN_PRODUCTO?.ToString("N4")</td>
                        <td style="text-align:right;" class="mono">@l.CAN_PRODUCTO_ATENDIDA?.ToString("N4")</td>
                        <td style="text-align:center;">@(string.IsNullOrWhiteSpace(l.COD_UNIDAD_MEDIDA) ? "—" : l.COD_UNIDAD_MEDIDA)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public string CodClaseOperacion { get; set; } = "";
    [Parameter, EditorRequired] public string CodTipoOperacion { get; set; } = "";
    [Parameter, EditorRequired] public decimal NumPedidoComercial { get; set; }
    [Parameter, EditorRequired] public int NumSecuencia { get; set; }

    private bool _cargando = true;

    /// <summary>El motivo real cuando la consulta falla. Null = la consulta anduvo.</summary>
    private string? _error;
    private List<PedidoComercialDetalleRequerimientoStockDetalleLinea> _lineas = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // UNA sola consulta, sin pasar por la tabla de cabecera.
            //
            // Antes esto eran dos pasos: primero los requerimientos vinculados a la CABECERA
            // del pedido, y después el detalle de cada uno. El problema es que el vínculo de
            // cabecera NO LO ESCRIBÍA NADIE —el SP, el repositorio y el endpoint existen, y
            // ningún archivo del front los llamaba—, así que el primer paso devolvía cero
            // filas, el bucle del segundo no corría nunca, y la subgrilla concluía que la
            // línea no venía de ningún requerimiento. Los datos estaban; el camino no.
            //
            // Desde el script 61 el SP acepta el requerimiento en NULL y devuelve todos los
            // de la línea de una vez. Además de arreglar el bug, es una consulta en lugar de
            // N+1 cada vez que se expande una fila.
            var url = $"{ApiRoutes.Comercial.PedidosComercialesRequerimientosStockLinkDetalle}" +
                      $"?codClaseOperacion={Uri.EscapeDataString(CodClaseOperacion)}" +
                      $"&codTipoOperacion={Uri.EscapeDataString(CodTipoOperacion)}" +
                      $"&numPedidoComercial={NumPedidoComercial.ToString(System.Globalization.CultureInfo.InvariantCulture)}" +
                      $"&numSecuencia={NumSecuencia}";

            // A mano y no con SafeGetAsync: ese helper hace catch { return null; }, así que
            // un 400 del servidor, un 403 de permisos y "no hay filas" llegan acá siendo la
            // misma cosa. Es lo que hizo que este problema costara encontrar.
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode)
            {
                var cuerpo = await resp.Content.ReadAsStringAsync();
                _error = $"HTTP {(int)resp.StatusCode}. {Resumir(cuerpo)}";
                return;
            }

            var api = await resp.Content.ReadFromJsonAsync<ApiResponse<List<PedidoComercialDetalleRequerimientoStockDetalleLinea>>>();
            if (api is { Success: false })
            {
                _error = api.Message ?? "El servidor respondió sin detalle del error.";
                return;
            }
            _lineas = api?.Data ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _cargando = false; }
    }

    /// <summary>El cuerpo de un error puede venir con la página de error entera. Se recorta
    /// para que entre en la celda sin tapar la grilla.</summary>
    private static string Resumir(string? cuerpo)
    {
        if (string.IsNullOrWhiteSpace(cuerpo)) return "Sin cuerpo en la respuesta.";
        var t = cuerpo.Trim();
        return t.Length <= 300 ? t : t[..300] + "…";
    }
}
