@using KONSolutions.Shared.Common
@using System.Net.Http.Json
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject ErrorLogService ErrorLog

@* El PDF del comprobante en un visor. Si el PDF todavía no se subió (acaba de elegirse y falta grabar) llega en Bytes; si ya está guardado se pide a la API (GET {id}/pdf, con la sesión) y se
   muestra desde una blob: URL, sin rutas de disco ni de red. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" />@(string.IsNullOrWhiteSpace(Nombre) ? "PDF del comprobante" : Nombre)</MudText>
    </TitleContent>
    <DialogContent>
        <div style="height:70vh;min-width:min(900px,90vw);">
            @if (_cargando)
            {
                <div style="height:100%;display:flex;align-items:center;justify-content:center;" data-vacio="pdf-cargando"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else if (string.IsNullOrWhiteSpace(_blobUrl))
            {
                <div style="height:100%;display:flex;align-items:center;justify-content:center;opacity:.6;" data-vacio="pdf"><MudText>@(_error ?? "No se pudo cargar el PDF.")</MudText></div>
            }
            else
            {
                <PdfFrame Src="@_blobUrl" Title="PDF del comprobante" />
            }
        </div>
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-3">
            @if (!string.IsNullOrWhiteSpace(_blobUrl))
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="@_blobUrl" Target="_blank" data-accion="pdf-descargar">Abrir aparte</MudButton>
            }
            <MudButton Variant="Variant.Filled" OnClick="@(() => MudDialog.Close())" data-accion="cerrar">Cerrar</MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public decimal NumRegistro { get; set; }
    [Parameter] public string? Nombre { get; set; }
    /// <summary>El PDF elegido que todavía no se subió; si es nulo se pide el guardado.</summary>
    [Parameter] public byte[]? Bytes { get; set; }

    private string? _blobUrl, _error;
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var bytes = Bytes;
            if (bytes is null)
            {
                var resp = await Http.GetAsync($"{ApiRoutes.Comercial.RegistroCompras}/{NumRegistro:0}/pdf");
                if (!resp.IsSuccessStatusCode)
                {
                    // la API explica el motivo en el cuerpo (ApiResponse): sin PDF guardado, carpeta sin configurar…
                    string? motivo = null;
                    try { motivo = (await resp.Content.ReadFromJsonAsync<ApiResponse<object>>())?.Message; } catch { }
                    _error = string.IsNullOrWhiteSpace(motivo) ? $"No se pudo leer el PDF (HTTP {(int)resp.StatusCode})." : motivo;
                    return;
                }
                bytes = await resp.Content.ReadAsByteArrayAsync();
            }
            _blobUrl = await JS.InvokeAsync<string>("blobViewer.crear", bytes, "application/pdf");
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(RegistroCompraPdfDialog), nameof(OnInitializedAsync));
            _error = "No se pudo leer el PDF. Ver detalle en el log de errores.";
        }
        finally { _cargando = false; }
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrEmpty(_blobUrl)) { try { await JS.InvokeVoidAsync("blobViewer.liberar", _blobUrl); } catch { } }
    }
}
