    /// <summary>Filtra por tipo de Entidad según COD_TIPO_ENTIDAD del Tipo de Operación
    /// elegido (regla 1). Sin Tipo de Operación todavía elegido, no filtra por tipo.</summary>
    private async Task<IEnumerable<ComboboxItem>> BuscarEntidadClienteProveedorAsync(string texto, CancellationToken ct)
    {
        try
        {
            var url = $"{ApiRoutes.Estandar.Entidades}/search?search={Uri.EscapeDataString(texto)}";
            if (!string.IsNullOrWhiteSpace(_model.COD_TIPO_ENTIDAD)) url += $"&desTiposEntidad={Uri.EscapeDataString(_model.COD_TIPO_ENTIDAD + "_")}";
            var r = await Http.GetFromJsonAsync<ApiResponse<List<KONSolutions.Shared.Models.Estandar.Entidad>>>(url, ct);
            var lista = (r?.Data ?? new()).Select(e => new ComboboxItem { Id = e.COD_ENTIDAD?.ToString() ?? "", Texto = string.IsNullOrWhiteSpace(e.DES_COMERCIAL) ? e.DES_NOMBRE_COMPLETO : e.DES_COMERCIAL }).ToList();
            _entidadesCliente = lista;
            return lista;
        }
        catch (OperationCanceledException) { return Enumerable.Empty<ComboboxItem>(); }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(BuscarEntidadClienteProveedorAsync)); return Enumerable.Empty<ComboboxItem>(); }
    }

    /// <summary>Regla 2: si es positiva, la entidad vendedora se restringe a la Entidad de la
    /// Sesión (no se busca libremente); si no, se buscan Entidades Dependientes de la
    /// Entidad Cliente/Proveedor ya elegida — igual que antes, sin esa segunda entidad
    /// elegida no hay universo por el cual filtrar y la búsqueda queda vacía.</summary>
    /// <summary>PROC_ESTANDAR_ENTIDADES_DEPENDIENTES_SHOWCOMBOX — los vendedores del
    /// proveedor: las personas cuya COD_ENTIDAD_DEPENDENCIA es la entidad del pedido.
    ///
    /// Antes esto era una búsqueda remota contra Entidades/search filtrando por dependencia,
    /// que obligaba a tipear dos letras para ver algo. Ahora es una lista cerrada que se
    /// carga al elegir el proveedor: son pocos y el SP ya aplica las reglas del negocio
    /// (sólo personas, y sólo si la entidad de dependencia tiene prefijo comercial).</summary>
    private async Task CargarVendedoresDeEntidadAsync()
    {
        _entidadesVendedor = new();
        if (_model.COD_ENTIDAD is null) return;
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<List<EntidadDependienteLite>>>(
                ApiRoutes.Estandar.EntidadesDependientesDe(_model.COD_ENTIDAD.Value));
            _entidadesVendedor = (r?.Data ?? new())
                .Select(e => new ComboboxItem
                {
                    Id = e.COD_ENTIDAD?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                    Texto = e.DES_ENTIDAD
                }).ToList();

            // Si el proveedor tiene un solo vendedor, no tiene sentido hacerlo elegir. Pero
            // sólo cuando el campo está vacío: al abrir un pedido ya grabado se respeta el
            // vendedor con el que se guardó.
            if (_entidadesVendedor.Count == 1 && _model.COD_ENTIDAD_VENDEDOR is null)
            {
                _model.COD_ENTIDAD_VENDEDOR = decimal.TryParse(_entidadesVendedor[0].Id, out var nv) ? nv : null;
                _textoEntidadVendedorInicial = _entidadesVendedor[0].Texto;
            }
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarVendedoresDeEntidadAsync)); }
    }

