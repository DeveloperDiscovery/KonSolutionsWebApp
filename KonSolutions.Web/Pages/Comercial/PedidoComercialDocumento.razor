        {
            var r = await Http.GetFromJsonAsync<ApiResponse<List<EntidadesTemporadasColecciones>>>(
                $"{ApiRoutes.Comercial.EntidadesTemporadasColecciones}?codEntidad={codEntidad}&numTemporada={numTemporada}");
            _colecciones = (r?.Data ?? new())
