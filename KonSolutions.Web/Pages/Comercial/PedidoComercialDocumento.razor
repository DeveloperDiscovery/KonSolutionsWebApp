    private async Task<IEnumerable<ProductoModel>> BuscarProductoAsync(string texto, CancellationToken ct)
    {
        try
        {
            var url = $"{ApiRoutes.Estandar.ProductosSearch}?search={Uri.EscapeDataString(texto)}";
            var r = await Http.GetFromJsonAsync<ApiResponse<List<ProductoModel>>>(url, ct);
            var lista = r?.Data ?? new();
            _productos = _productos.Where(p => lista.All(l => l.COD_PRODUCTO != p.COD_PRODUCTO)).Concat(lista).ToList();
            return lista;
        }
        catch (OperationCanceledException) { return Enumerable.Empty<ProductoModel>(); }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(BuscarProductoAsync)); return Enumerable.Empty<ProductoModel>(); }
    }

    private void AsignarProducto(Item it, string? cod)
    {
        it.COD_PRODUCTO = cod ?? "";
        var p = _productos.FirstOrDefault(x => x.COD_PRODUCTO == cod);
        it.DES_PRODUCTO = p?.DES_PRODUCTO ?? "";
        it.COD_UNIDAD_MEDIDA = Vacio(p?.COD_UNIDAD_MEDIDA);
    }

    /// <summary>Vuelca al pedido lo que el panel de requerimientos ya acumuló.
    ///
    /// Cada grupo viene con un producto, una unidad y la cantidad sumada. Si el pedido ya
    /// tiene una línea de ese mismo producto y unidad, se le suma encima en vez de crear
    /// una línea repetida; si no, se crea una nueva.
    ///
    /// Devuelve, por clave producto|unidad, la secuencia de la línea que quedó — el panel
    /// la necesita para grabar de qué requerimiento salió cada cantidad. Una línea que no
    /// se pudo grabar no entra en el resultado, así el panel no deja trazabilidad colgando
    /// de algo que no existe.</summary>
    /// <summary>Se dispara cuando cambian las líneas del pedido de una forma que puede
    /// afectar a los vínculos con requerimientos — hoy, al borrar una línea.</summary>
    [Parameter] public EventCallback OnLineasCambiadas { get; set; }

    /// <summary>Recarga el detalle desde la base. Lo llama la ficha de Requerimientos
    /// después de deshacer un vínculo o desvincular un requerimiento, porque esos SP tocan
    /// datos que este documento tiene en memoria.</summary>
    public async Task RecargarDetalleAsync()
    {
        if (_model.NUM_PEDIDO_COMERCIAL is decimal num && num > 0)
        {
            await CargarDetalleAsync(num);
            await CargarCalculoAsync();
            await RefrescarPorRequerimientosAsync();
            StateHasChanged();
        }
    }

    /// <summary>Borra del pedido las líneas con esas secuencias, SIN confirmar ni tocar la
    /// pantalla línea por línea. La usa "Revertir" de la ficha de Requerimientos (que ya
    /// pidió la confirmación). Devuelve false en cuanto una baja falla: no se sigue, para no
    /// dejar el pedido a medias sin avisar.</summary>
    public async Task<bool> QuitarLineasAsync(IEnumerable<int> secuencias)
    {
        if (_readonly || !_cabeceraGrabada) return false;
        foreach (var sec in secuencias.Distinct().OrderByDescending(x => x))
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Comercial.PedidosComercialesDetalle}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}/{sec}");
            if (!rd.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(PedidoComercialDocumento), nameof(QuitarLineasAsync), $"No se pudo eliminar la línea {sec}");
                await RecargarDetalleAsync();
                return false;
            }
            _huboCambios = true;
        }
        _itemsNuevos.Clear();
        await RecargarDetalleAsync();
        return true;
    }

    // ── Lo que la pestaña de Requerimientos necesita saber de este documento ──────
    // Vive al lado de esta pantalla, no adentro, así que la pantalla contenedora la
    // conecta por @ref. Estos tres accesores son todo lo que expone.

    /// <summary>Número del pedido, o null si la cabecera todavía no se grabó.</summary>
    public decimal? NumPedidoActual => _cabeceraGrabada ? _model.NUM_PEDIDO_COMERCIAL : null;
    public string ClaseOperacionActual => _model.COD_CLASE_OPERACION ?? "";

    /// <summary>¿Es una proforma? Es la clase de operación PRFRM (ESTANDAR.CLASES_OPERACION), la que
    /// le pasa la opción del menú («COD_CLASE_OPERACION = 'PRFRM'»).</summary>
    private bool EsProforma => string.Equals(_model.COD_CLASE_OPERACION ?? CodClaseOperacion, "PRFRM", StringComparison.OrdinalIgnoreCase);
    public string TipoOperacionActual => _model.COD_TIPO_OPERACION ?? "";
    public bool EsSoloLectura => _readonly;

    /// <summary>Marca el documento como modificado desde afuera, para que al cerrarlo la
    /// lista se refresque.</summary>
    public void MarcarCambio() => _huboCambios = true;

    public async Task<Dictionary<string, int>> IncorporarRequerimientosAsync(List<GrupoRequerimientoIncorporar> grupos)
    {
        var resultado = new Dictionary<string, int>();
        if (_readonly || !_cabeceraGrabada) return resultado;

        foreach (var g in grupos)
        {
            // La clave la arma el propio grupo (GrupoRequerimientoIncorporar.Clave). Antes se
            // escribía acá a mano, igual que en el panel: dos copias de la misma cadena que
            // tenían que coincidir, y si una cambiaba no había error de compilación sino un
            // diccionario que no encontraba nada.
            var clave = g.Clave;

            // Un grupo CON orden de producción nunca se suma a una línea existente: cada orden
            // es su propia línea del pedido. Y no se puede buscar "la línea de esa orden" en
            // _items porque PEDIDOS_COMERCIALES_DETALLE no tiene esas columnas —la orden vive
            // en el requerimiento y se reconstruye por la tabla de trazabilidad—, así que el
            // grupo con orden siempre crea línea nueva.
            //
            // Los grupos SIN orden mantienen el comportamiento de siempre: se suman a la línea
            // que ya exista para ese producto y unidad.
            var linea = g.SinOrdenProduccion
                ? _items.FirstOrDefault(x =>
                    string.Equals(x.COD_PRODUCTO, g.COD_PRODUCTO, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(x.COD_UNIDAD_MEDIDA ?? "", g.COD_UNIDAD_MEDIDA ?? "", StringComparison.OrdinalIgnoreCase))
                : null;

            if (linea is null)
            {
                var sig = (_items.Count == 0 ? 0 : _items.Max(x => x.NUM_SECUENCIA ?? 0)) + 1;
                linea = new Item
                {
                    NUM_PEDIDO_COMERCIAL = _model.NUM_PEDIDO_COMERCIAL,
                    NUM_SECUENCIA = sig,
                    COD_PRODUCTO = g.COD_PRODUCTO,
                    DES_PRODUCTO = g.DES_PRODUCTO ?? "",
                    COD_UNIDAD_MEDIDA = Vacio(g.COD_UNIDAD_MEDIDA),
                    COD_UNIDAD_MEDIDA_SECUNDARIO = Vacio(g.COD_UNIDAD_MEDIDA_SECUNDARIA),
                    CAN_PRODUCTO = g.CAN_PRODUCTO,
                    CAN_PRODUCTO_ENTIDAD = g.CAN_PRODUCTO_ENTIDAD,
                    // El nombre del campo en esta tabla lleva la doble D (typo real de la
                    // columna); el del grupo viene con una sola D porque así lo escribió el
                    // SP de requerimientos — dos SP, dos alias, cada uno tal cual el suyo.
                    COD_UNIDAD_MEDIDAD_ENTIDAD = Vacio(g.COD_UNIDAD_MEDIDA_ENTIDAD),
                    CAN_PRODUCTO_SECUDARIO = g.CAN_PRODUCTO_SECUNDARIA,
                    // Proceso y orden de producción, tal cual vienen del requerimiento. Son parte
                    // de la IDENTIDAD del grupo (GrupoRequerimientoIncorporar.Clave los incluye),
                    // así que acá no hay nada que decidir: la línea es de esta orden y de ninguna
                    // otra. Sin estas cinco asignaciones el dato moría en el panel — se agrupaba
                    // por orden, se creaba una línea por orden, y la línea salía sin la orden.
                    // Lote de control de la línea del requerimiento: sin esto la línea del pedido sale sin lote
                    // y la Orden de Compra (PROC_COMERCIAL_PEDIDO_COMERCIAL_SINCRONIZA copia el de la línea) también.
                    NUM_LOTE_CONTROL = g.NUM_LOTE_CONTROL,
                    COD_PROCESO = g.COD_PROCESO,
                    DES_PROCESO = g.DES_PROCESO,
                    NUM_ORDEN_PRODUCCION = g.NUM_ORDEN_PRODUCCION,
                    NUM_ORDEN_PRODUCCION_ITEM = g.NUM_ORDEN_PRODUCCION_ITEM,
                    NUM_ORDEN_PRODUCCION_UNIDAD = g.NUM_ORDEN_PRODUCCION_UNIDAD,
                    // El precio lo resuelve el SP de requerimientos contra ENTIDADES_PRODUCTOS y
                    // viaja dentro del grupo. Si viene null, la línea entra sin precio y se
                    // completa a mano — es preferible a inventar un valor.
                    PRE_UNITARIO = g.PRE_UNITARIO,
                    // Descuento por defecto: 0 (no vacío).
                    TAS_DESCUENTO = 0
                };
                _items.Add(linea);
                _itemsNuevos.Add(sig);
            }
            else
            {
                linea.CAN_PRODUCTO = (linea.CAN_PRODUCTO ?? 0) + g.CAN_PRODUCTO;
                linea.CAN_PRODUCTO_ENTIDAD = (linea.CAN_PRODUCTO_ENTIDAD ?? 0) + g.CAN_PRODUCTO_ENTIDAD;
                if (string.IsNullOrWhiteSpace(linea.COD_UNIDAD_MEDIDAD_ENTIDAD))
                    linea.COD_UNIDAD_MEDIDAD_ENTIDAD = Vacio(g.COD_UNIDAD_MEDIDA_ENTIDAD);
                if (g.CAN_PRODUCTO_SECUNDARIA is > 0)
                    linea.CAN_PRODUCTO_SECUDARIO = (linea.CAN_PRODUCTO_SECUDARIO ?? 0) + g.CAN_PRODUCTO_SECUNDARIA;
                // Sólo se completa el precio si la línea no tenía: si alguien ya lo negoció a
                // mano, incorporar más cantidad no debe pisarlo.
                if (linea.PRE_UNITARIO is null or 0) linea.PRE_UNITARIO = g.PRE_UNITARIO;
            }

            if (await GuardarItem(linea) && linea.NUM_SECUENCIA is int sec)
                resultado[clave] = sec;
        }

        // Si entró al menos una línea, el pedido pasa a ser "por requerimientos".
        if (resultado.Count > 0) _model.FLG_POR_REQUERIMIENTO = true;
        StateHasChanged();
        return resultado;
    }

    /// <summary>Mismo cálculo que hace ahora PROC_COMERCIAL_PEDIDOS_COMERCIALES_DETALLE_INSERT
    /// / _UPDATE: PRE_UNITARIO * CAN_PRODUCTO_ENTIDAD, no * CAN_PRODUCTO. Si se dejara
    /// CAN_PRODUCTO acá, el "Total" de la grilla mostraría un número distinto al que la
    /// base termina grabando en cuanto hay conversión de unidad de por medio.</summary>
    private static decimal CalcularTotal(Item it)
    {
        var cantidad = it.CAN_PRODUCTO_ENTIDAD ?? it.CAN_PRODUCTO ?? 0;
        var bruto = cantidad * (it.PRE_UNITARIO ?? 0);
        var desc = bruto * (it.TAS_DESCUENTO ?? 0) / 100;
        return bruto - desc;
    }

    private async Task CargarDetalleAsync(decimal numPedidoComercial)
    {
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComercialesDetallePorCabecera}/{ClaseUrl}/{TipoUrl}/{numPedidoComercial}";
            var r = await Http.GetFromJsonAsync<ApiResponse<List<Item>>>(url);
            _items = r?.Data ?? new();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarDetalleAsync)); }
    }

    /// <summary>Trae los cálculos del pedido. El SP los pide por cabecera completa (clase,
    /// tipo y número), no solo por número: la misma numeración se repite entre clases de
    /// operación, así que con el número suelto traería importes de otro documento.</summary>
    private async Task CargarCalculoAsync()
    {
        if (!_cabeceraGrabada) { _calculos = new(); return; }
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComercialesCalculoPorCabecera}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}";
            var r = await Http.GetFromJsonAsync<ApiResponse<List<CalculoItem>>>(url);
            _calculos = r?.Data ?? new();
        }
        catch (Exception ex)
        {
            // Los cálculos son informativos: si fallan, el detalle sigue siendo usable.
            // Se deja la grilla vacía y queda el rastro en ErrorLog.
            _calculos = new();
            await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarCalculoAsync));
        }
    }

    private void AgregarItem()
    {
        var sig = (_items.Count == 0 ? 0 : _items.Max(x => x.NUM_SECUENCIA ?? 0)) + 1;
        var it = new Item { NUM_PEDIDO_COMERCIAL = _model.NUM_PEDIDO_COMERCIAL, NUM_SECUENCIA = sig, CAN_PRODUCTO = 0, TAS_DESCUENTO = 0 };
        AplicarValoresPorDefecto(it);
        _items.Add(it);
        _itemsNuevos.Add(sig);
    }

    /// <summary>Proceso y orden de producción por defecto, de Configuración General (pestaña
    /// Almacenes) — los mismos cuatro valores que ya aplica Requerimientos.
    ///
    /// Sólo para la línea escrita a mano: la que viene del panel ya trae los suyos, y son los
    /// del requerimiento. Por eso se llama en AgregarItem y NO en IncorporarRequerimientosAsync.
    ///
    /// Los cuatro van juntos o no va ninguno: medio camino no sirve para nada. Y si la
    /// configuración no tiene proceso cargado, no se inventa nada — la línea queda genérica,
    /// que es lo correcto para un pedido que no es de consumo de producción.</summary>
    private void AplicarValoresPorDefecto(Item it)
    {
        var cfg = ConfigSvc.Current;

        if (string.IsNullOrWhiteSpace(it.NUM_LOTE_CONTROL) && !string.IsNullOrWhiteSpace(cfg.LoteControlDefault))
            it.NUM_LOTE_CONTROL = cfg.LoteControlDefault;

        // "Sin producción" es proceso vacío Y orden nula o cero, igual que en Requerimientos.
        var sinProduccion = string.IsNullOrWhiteSpace(it.COD_PROCESO) && it.NUM_ORDEN_PRODUCCION is null or 0;
        if (sinProduccion && !string.IsNullOrWhiteSpace(cfg.ProcesoDefault))
        {
            it.COD_PROCESO                 = cfg.ProcesoDefault;
            it.NUM_ORDEN_PRODUCCION        = cfg.OrdenProduccionDefault;
            it.NUM_ORDEN_PRODUCCION_ITEM   = cfg.OrdenProduccionItemDefault;
            it.NUM_ORDEN_PRODUCCION_UNIDAD = cfg.OrdenProduccionUnidadDefault;
        }
    }

    /// <summary>Abre el diálogo y, sólo si se graba ahí, baja los cuatro valores a la línea y
    /// la manda a la base. Cancelar no toca nada: el diálogo trabaja sobre copias.
    ///
    /// Se le avisa al diálogo si la línea PUEDE tener vínculos con requerimientos, para que
    /// advierta que cambiar la orden no los mueve. No se cuenta cuántos son: el endpoint de
    /// vínculos de detalle exige el número de requerimiento como filtro, así que no hay forma
    /// de pedir "todos los orígenes de esta línea" sin recorrer los requerimientos uno por
    /// uno. La línea recién agregada a mano no tiene orígenes todavía y no lleva el aviso.</summary>
    private async Task AbrirOrdenProduccionAsync(Item it)
    {
        if (!_cabeceraGrabada) return;

        var puedeTenerOrigenes = !_itemsNuevos.Contains(it.NUM_SECUENCIA ?? 0);

        var parametros = new DialogParameters
        {
            ["Lotes"]                 = _lotesControl,
            ["NumLoteControl"]        = it.NUM_LOTE_CONTROL,
            ["CodProceso"]            = it.COD_PROCESO,
            ["NumOrden"]              = it.NUM_ORDEN_PRODUCCION,
            ["NumItem"]               = it.NUM_ORDEN_PRODUCCION_ITEM,
            ["NumUnidad"]             = it.NUM_ORDEN_PRODUCCION_UNIDAD,
            ["NumSecuencia"]          = it.NUM_SECUENCIA,
            ["DesProducto"]           = it.DES_PRODUCTO,
            ["PuedeTenerOrigenes"]    = puedeTenerOrigenes,
            ["SoloLectura"]           = _readonly
        };

        var dlg = await DialogService.ShowAsync<OrdenProduccionPedidoDialog>("Proceso y orden de producción",
            parametros, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

        if ((await dlg.Result) is not { Canceled: false, Data: OrdenProduccionPedidoDialog.Seleccion sel }) return;

        it.NUM_LOTE_CONTROL            = sel.NUM_LOTE_CONTROL;
        it.COD_PROCESO                 = sel.COD_PROCESO;
        it.DES_PROCESO                 = sel.DES_PROCESO;
        it.NUM_ORDEN_PRODUCCION        = sel.NUM_ORDEN_PRODUCCION;
        it.NUM_ORDEN_PRODUCCION_ITEM   = sel.NUM_ORDEN_PRODUCCION_ITEM;
        it.NUM_ORDEN_PRODUCCION_UNIDAD = sel.NUM_ORDEN_PRODUCCION_UNIDAD;

        // Se graba la línea, igual que al confirmar cualquier otra celda. Si no, el botón
        // diría "Grabar" y no grabaría nada.
        if (await GuardarItem(it))
        {
            Snackbar.Add($"Ítem {it.NUM_SECUENCIA}: proceso y orden de producción grabados.", Severity.Success);
            _huboCambios = true;
        }
        StateHasChanged();
    }

    /// <summary>Lo que se lee en la celda: "PROC — Descripción · orden / ítem / unidad".
    ///
    /// El cero NO se descarta: cero es un número de orden real en esta base —hoy es el único
    /// cargado—, y esconderlo haría que esa orden no se viera nunca. "Sin orden" es NULL.</summary>
    /// <summary>Lo que se lee en la celda combinada: el lote primero —es lo que más se busca
    /// al revisar una línea— y detrás el proceso y la orden.</summary>
    private string ResumenLoteOrden(Item it)
    {
        var orden = ResumenOrdenProduccion(it);
        // La DESCRIPCIÓN del lote (la que se ve en el combo "Lote de Control"), no el número
        // interno: se busca en _lotesControl, que ya está cargado para ese mismo combo. El
        // número queda de respaldo si el lote no aparece ahí (p.ej. todavía no cargó la
        // lista) para no dejar la celda vacía.
        var lote  = string.IsNullOrWhiteSpace(it.NUM_LOTE_CONTROL) ? null
                  : _lotesControl.FirstOrDefault(l => string.Equals(l.Id, it.NUM_LOTE_CONTROL, StringComparison.OrdinalIgnoreCase)) is { } l && !string.IsNullOrWhiteSpace(l.Texto)
                      ? l.Texto
                      : it.NUM_LOTE_CONTROL;

        if (lote is null)  return orden;
        if (orden == "—")  return lote;
        return $"{lote} · {orden}";
    }

    private static string ResumenOrdenProduccion(Item it)
    {
        if (string.IsNullOrWhiteSpace(it.COD_PROCESO)) return "—";

        var texto = string.IsNullOrWhiteSpace(it.DES_PROCESO)
            ? it.COD_PROCESO!
            : $"{it.COD_PROCESO} — {it.DES_PROCESO}";

        if (it.NUM_ORDEN_PRODUCCION is { } orden)
        {
            texto += $" · {orden}";
            if (it.NUM_ORDEN_PRODUCCION_ITEM   is { } item)   texto += $" / {item}";
            if (it.NUM_ORDEN_PRODUCCION_UNIDAD is { } unidad) texto += $" / {unidad}";
        }
        return texto;
    }

    private async Task QuitarItem(Item it)
    {
        var sec = it.NUM_SECUENCIA ?? 0;
        if (!_itemsNuevos.Contains(sec))
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Comercial.PedidosComercialesDetalle}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}/{sec}");
            if (!rd.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(PedidoComercialDocumento), nameof(QuitarItem), $"No se pudo eliminar la línea {sec}");
                return;
            }
            _huboCambios = true;
            // El SP de baja borra también los vínculos con requerimientos de esa línea, y el
            // de cabecera si el requerimiento se queda sin ninguna. La ficha de al lado tiene
            // que enterarse.
            await OnLineasCambiadas.InvokeAsync();
        }
        _itemsNuevos.Remove(sec);
        _items.Remove(it);
        await CargarCalculoAsync();
    }

    /// <summary>Clase y tipo de operación listos para un segmento de URL. Son string? en el
    /// modelo, así que se resuelve el null acá y no en cada llamada — de paso desaparecen los
    /// avisos del compilador por pasar una referencia posiblemente nula a EscapeDataString.</summary>
    private string ClaseUrl => Uri.EscapeDataString(_model.COD_CLASE_OPERACION ?? "");
    private string TipoUrl  => Uri.EscapeDataString(_model.COD_TIPO_OPERACION ?? "");

    /// <summary>El número de pedido cuando va dentro de una URL. Invariante a propósito: en
    /// es-PE el separador decimal es la coma, y "1,00" no matchea un segmento decimal de ruta
    /// — la API devuelve 400 sin llegar al procedimiento.</summary>
    private string NumPedidoUrl =>
        (_model.NUM_PEDIDO_COMERCIAL ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static string? Vacio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;

    private async Task GuardarItemConAviso(Item it)
    {
        if (string.IsNullOrWhiteSpace(it.COD_PRODUCTO)) { await ErrorDialogHelper.MostrarAvisoAsync("Elige el producto antes de grabar la línea.", DialogService, nameof(PedidoComercialDocumento)); return; }
        if (await GuardarItem(it)) Snackbar.Add($"Línea {it.NUM_SECUENCIA} grabada.", Severity.Success);
    }

    private async Task<bool> GuardarItem(Item it)
    {
        if (_readonly || string.IsNullOrWhiteSpace(it.COD_PRODUCTO)) return false;
        // La clave de la línea son cuatro columnas: sin clase y tipo de operación el SP la
        // rechaza. Se toman siempre de la cabecera, no de lo que traiga el item.
        it.COD_CLASE_OPERACION = _model.COD_CLASE_OPERACION;
        it.COD_TIPO_OPERACION = _model.COD_TIPO_OPERACION;
        it.NUM_PEDIDO_COMERCIAL = _model.NUM_PEDIDO_COMERCIAL;
        // El SP la exige y recalcula VAL_TOTAL a partir de ella. Si "Cantidad Proveedor"
        // se dejó vacía (línea sin conversión, o cargada antes de este campo existir), se
        // manda igual a Cantidad Propia — asume 1 a 1 en vez de fallar.
        it.CAN_PRODUCTO_ENTIDAD ??= it.CAN_PRODUCTO;
        it.VAL_TOTAL = CalcularTotal(it);
        var sec = it.NUM_SECUENCIA ?? 0;
        var esNuevo = _itemsNuevos.Contains(sec);

        var r = await Http.GuardarAsync(ApiRoutes.Comercial.PedidosComercialesDetalle, it, esNuevo);
        if (!r.IsSuccessStatusCode)
        {
            await ErrorDialogHelper.MostrarAsync(r, ErrorLog, DialogService, nameof(PedidoComercialDocumento), nameof(GuardarItem), $"No se pudo grabar la línea {sec}");
            return false;
        }
        _itemsNuevos.Remove(sec);
        _huboCambios = true;
        // Los importes los arma la base a partir de las líneas, así que después de grabar
        // una hay que volver a leerlos: si no, la grilla de la derecha muestra el total
        // anterior y parece que el sistema no tomó el cambio.
        await CargarCalculoAsync();
        return true;
    }

    private async Task Cerrar() => await OnCerrar.InvokeAsync(_huboCambios);

    /// <summary>Pone en null los campos que las reglas del Tipo de Operación tienen
    /// deshabilitados, justo antes de grabar.
    ///
    /// Desde que los campos condicionales pasaron a verse siempre (deshabilitados en vez de
    /// ocultos), un valor puede quedar cargado en un campo que la regla no admite: lo
    /// autocompleta la pantalla —por ejemplo, cuando la entidad tiene una sola unidad
    /// comercial se elige sola— y después viaja igual al grabar. Eso es lo que hacía saltar
    /// la FK de UNIDADES_COMERCIALES en una compra, donde Unidad Comercial ni siquiera
    /// aplica.
    ///
    /// Se limpia aquí, en un solo lugar, y no en cada autocompletado: así vale para cualquier
    /// camino por el que un campo se llene, incluido el usuario cargando algo y después
    /// cambiando el Tipo de Operación.</summary>
    private void LimpiarCamposQueNoAplican()
    {
        // Sólo en operación positiva (reglas 3, 5, 6 y 17).
        if (_flgPositivo != true)
        {
            _model.NUM_UNIDAD_COMERCIAL = null;
            _model.NUM_TEMPORADA        = null;
            _model.NUM_COLECCION        = null;
            _model.NUM_PURCHASE_ORDER   = null;
        }

        // Sólo en operación NO positiva (reglas 10 a 13 y 18).
        if (_flgPositivo != false)
        {
            _model.COD_CENTRO_COSTO_SOLICITANTE = null;
            _model.COD_CENTRO_COSTO_DESTINO     = null;
            _model.NUM_PROYECTO                 = null;
            _model.NUM_RENDICION_CUENTAS        = null;
            _model.NUM_LOTE_CONTROL             = null;
        }
        else
        {
            // Aun siendo NO positiva, estos dependen además de su propio flag.
            if (_flgCentroCosto != true)
            {
                _model.COD_CENTRO_COSTO_SOLICITANTE = null;
                _model.COD_CENTRO_COSTO_DESTINO     = null;
            }
            if (_flgProyecto != true)
            {
                _model.NUM_PROYECTO          = null;
                _model.NUM_RENDICION_CUENTAS = null;
            }
            if (_flgLoteControl != true) _model.NUM_LOTE_CONTROL = null;
        }

        // Comercio exterior (reglas 9 y 15).
        if (_flgComercioExterior != true)
        {
            _model.COD_PAIS_DESTINO = null;
            _model.COD_INCOTERM     = null;
        }

        // La Dirección de Entrega sale de un origen o del otro, nunca de los dos.
        if (_direccionesDeSucursal) _model.NUM_SECUENCIA_DIRECCION = null;
        else                        _model.COD_SUCURSAL            = null;
    }

    private async Task Submit()
    {
        _model.FEC_PEDIDO = _fecPedido;
        _model.FEC_VECIMIENTO = _fecVencimiento;
        _model.FEC_ENTREGA = _fecEntrega;
        _model.FEC_ENTREGA_PUBLICA = _fecEntregaPublica;
        _model.COD_CLASE_OPERACION = CodClaseOperacion ?? _model.COD_CLASE_OPERACION;
        LimpiarCamposQueNoAplican();

        _saving = true;
        try
        {
            if (Modo == CrudModo.Delete)
            {
                foreach (var it in _items.ToList())
                    await Http.DeleteAsync($"{ApiRoutes.Comercial.PedidosComercialesDetalle}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}/{it.NUM_SECUENCIA}");

                var url = $"{ApiRoutes.Comercial.PedidosComerciales}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}";
                var rd = await Http.DeleteAsync(url);
                if (rd.IsSuccessStatusCode) { Snackbar.Add("Pedido eliminado.", Severity.Success); await OnCerrar.InvokeAsync(true); }
                else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(PedidoComercialDocumento), nameof(Submit), "No se pudo eliminar el pedido");
                return;
            }

            var esAlta = !_cabeceraGrabada;
            HttpResponseMessage resp;
            if (esAlta)
            {
                var dto = new PedidoComercialInsertDto
                {
                    COD_CLASE_OPERACION = _model.COD_CLASE_OPERACION, COD_TIPO_OPERACION = _model.COD_TIPO_OPERACION,
                    DES_PEDIDO_COMERCIAL = _model.DES_PEDIDO_COMERCIAL, COD_TIPO_COMPROBANTE_PAGO = _model.COD_TIPO_COMPROBANTE_PAGO,
                    NUM_DOCUMENTO = _model.NUM_DOCUMENTO, NUM_PROYECTO = _model.NUM_PROYECTO,
                    COD_TIPO_PEDIDO_COMERCIAL = _model.COD_TIPO_PEDIDO_COMERCIAL, FEC_PEDIDO = _model.FEC_PEDIDO,
                    FEC_VECIMIENTO = _model.FEC_VECIMIENTO, FEC_ENTREGA = _model.FEC_ENTREGA, FEC_ENTREGA_PUBLICA = _model.FEC_ENTREGA_PUBLICA,
                    COD_TIPO_ENTIDAD = _model.COD_TIPO_ENTIDAD, COD_ENTIDAD = _model.COD_ENTIDAD,
                    NUM_TEMPORADA = _model.NUM_TEMPORADA, NUM_COLECCION = _model.NUM_COLECCION, COD_MONEDA = _model.COD_MONEDA, FAC_TIPO_CAMBIO = _model.FAC_TIPO_CAMBIO,
                    NUM_UNIDAD_COMERCIAL = _model.NUM_UNIDAD_COMERCIAL, NUM_SECUENCIA_DIRECCION = _model.NUM_SECUENCIA_DIRECCION,
                    COD_CENTRO_COSTO_SOLICITANTE = _model.COD_CENTRO_COSTO_SOLICITANTE, COD_CENTRO_COSTO_DESTINO = _model.COD_CENTRO_COSTO_DESTINO,
                    COD_SUCURSAL = _model.COD_SUCURSAL, COD_FORMA_PAGO = _model.COD_FORMA_PAGO, COD_CONDICION_PAGO = _model.COD_CONDICION_PAGO,
                    COD_TIPO_DESCUENTO = _model.COD_TIPO_DESCUENTO, TAS_DESCUENTO = _model.TAS_DESCUENTO, VAL_TOTAL = _valTotalCalculado,
                    COD_ENTIDAD_VENDEDOR = _model.COD_ENTIDAD_VENDEDOR, NUM_PURCHASE_ORDER = _model.NUM_PURCHASE_ORDER,
                    COD_PAIS_DESTINO = _model.COD_PAIS_DESTINO, NUM_LOTE_CONTROL = _model.NUM_LOTE_CONTROL,
                    NUM_RENDICION_CUENTAS = _model.NUM_RENDICION_CUENTAS, COD_TIPO_MOTIVO = _model.COD_TIPO_MOTIVO, COD_MOTIVO = _model.COD_MOTIVO,
                    DES_OBSERVACION = _model.DES_OBSERVACION, NUM_PEDIDO_COMERCIAL_RELACIONADO = _model.NUM_PEDIDO_COMERCIAL_RELACIONADO,
                    NUM_TRACKING = _model.NUM_TRACKING, COD_INCOTERM = _model.COD_INCOTERM, COD_TIPO_ESTADO = _model.COD_TIPO_ESTADO, COD_ESTADO = _model.COD_ESTADO,
                };
                resp = await Http.PostAsJsonAsync(ApiRoutes.Comercial.PedidosComerciales, dto);
            }
            else
            {
                var dto = new PedidoComercialUpdateDto
                {
                    COD_CLASE_OPERACION = _model.COD_CLASE_OPERACION, COD_TIPO_OPERACION = _model.COD_TIPO_OPERACION,
                    NUM_PEDIDO_COMERCIAL = _model.NUM_PEDIDO_COMERCIAL ?? 0,
                    DES_PEDIDO_COMERCIAL = _model.DES_PEDIDO_COMERCIAL, COD_TIPO_COMPROBANTE_PAGO = _model.COD_TIPO_COMPROBANTE_PAGO,
                    NUM_DOCUMENTO = _model.NUM_DOCUMENTO, NUM_PROYECTO = _model.NUM_PROYECTO,
                    COD_TIPO_PEDIDO_COMERCIAL = _model.COD_TIPO_PEDIDO_COMERCIAL, FEC_PEDIDO = _model.FEC_PEDIDO,
                    FEC_VECIMIENTO = _model.FEC_VECIMIENTO, FEC_ENTREGA = _model.FEC_ENTREGA, FEC_ENTREGA_PUBLICA = _model.FEC_ENTREGA_PUBLICA,
                    COD_TIPO_ENTIDAD = _model.COD_TIPO_ENTIDAD, COD_ENTIDAD = _model.COD_ENTIDAD,
                    NUM_TEMPORADA = _model.NUM_TEMPORADA, NUM_COLECCION = _model.NUM_COLECCION, COD_MONEDA = _model.COD_MONEDA, FAC_TIPO_CAMBIO = _model.FAC_TIPO_CAMBIO,
                    NUM_UNIDAD_COMERCIAL = _model.NUM_UNIDAD_COMERCIAL, NUM_SECUENCIA_DIRECCION = _model.NUM_SECUENCIA_DIRECCION,
                    COD_CENTRO_COSTO_SOLICITANTE = _model.COD_CENTRO_COSTO_SOLICITANTE, COD_CENTRO_COSTO_DESTINO = _model.COD_CENTRO_COSTO_DESTINO,
                    COD_SUCURSAL = _model.COD_SUCURSAL, COD_FORMA_PAGO = _model.COD_FORMA_PAGO, COD_CONDICION_PAGO = _model.COD_CONDICION_PAGO,
                    COD_TIPO_DESCUENTO = _model.COD_TIPO_DESCUENTO, TAS_DESCUENTO = _model.TAS_DESCUENTO, VAL_TOTAL = _valTotalCalculado,
                    COD_ENTIDAD_VENDEDOR = _model.COD_ENTIDAD_VENDEDOR, NUM_PURCHASE_ORDER = _model.NUM_PURCHASE_ORDER,
                    COD_PAIS_DESTINO = _model.COD_PAIS_DESTINO, NUM_LOTE_CONTROL = _model.NUM_LOTE_CONTROL,
                    NUM_RENDICION_CUENTAS = _model.NUM_RENDICION_CUENTAS, COD_TIPO_MOTIVO = _model.COD_TIPO_MOTIVO, COD_MOTIVO = _model.COD_MOTIVO,
                    DES_OBSERVACION = _model.DES_OBSERVACION, NUM_PEDIDO_COMERCIAL_RELACIONADO = _model.NUM_PEDIDO_COMERCIAL_RELACIONADO,
                    NUM_TRACKING = _model.NUM_TRACKING, COD_INCOTERM = _model.COD_INCOTERM, COD_TIPO_ESTADO = _model.COD_TIPO_ESTADO, COD_ESTADO = _model.COD_ESTADO,
                };
                resp = await Http.PutAsJsonAsync(ApiRoutes.Comercial.PedidosComerciales, dto);
            }

            if (!resp.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(PedidoComercialDocumento), nameof(Submit));
                return;
            }

            _huboCambios = true;

            if (esAlta)
            {
                var cuerpo = await resp.Content.ReadFromJsonAsync<ApiResponse<WriteResult>>();
                if (decimal.TryParse(cuerpo?.Data?.Codigo, out var generado))
                {
                    _model.NUM_PEDIDO_COMERCIAL = generado;
                    Snackbar.Add($"Pedido N° {generado} creado. Ya puedes cargar las líneas.", Severity.Success);
                }
                else
                {
                    await ErrorDialogHelper.MostrarAvisoAsync("El pedido se creó, pero la base no devolvió su número: reabre el documento para cargarle líneas.", DialogService, nameof(PedidoComercialDocumento));
                }
            }
            else
            {
                Snackbar.Add("Pedido actualizado.", Severity.Success);
            }

            // El descuento recién llega a la base al grabar la cabecera, así que este es el
            // momento en que los importes pueden haber cambiado de verdad. El refresco que
            // hace CambiarTipoDescuento es para que la grilla no quede mostrando lo de antes
            // mientras editas; el que vale es este.
            await CargarCalculoAsync();

            // Y la cabecera: el SP puede haber movido el Estado o cualquier otro campo que la
            // pantalla no escribe. Es el mismo método que ya se usa al abrir el documento.
            await RecargarCabeceraCompletaAsync();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(Submit));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo grabar. Ver detalle en el log de errores.", DialogService, nameof(PedidoComercialDocumento));
        }
        finally { _saving = false; }
    }
}
