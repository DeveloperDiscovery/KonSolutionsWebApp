    /// <summary>Si el pedido ya está grabado, se reemplaza el modelo por el SHOWBYID
    /// completo antes de cualquier otra carga.
    ///
    /// Item llega de la fila de la grilla, que sale del SHOWALL/SEARCH — un listado, más
    /// liviano a propósito. Columnas que solo trae el SHOWBYID (como DES_PEDIDO_ORIGEN)
    /// llegaban vacías, aunque el dato sí existiera en la base: la pantalla mostraba lo que
    /// tenía la grilla en ese momento, no el registro real. De paso esto también evita abrir
    /// el documento con una fila desactualizada si alguien más lo modificó entre que se
    /// cargó la lista y se hizo clic en Editar.</summary>
    private async Task RecargarCabeceraCompletaAsync()
    {
        if (!_cabeceraGrabada) return;
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComerciales}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}";
            var r = await Http.GetFromJsonAsync<ApiResponse<Modelo>>(url);
            if (r?.Data is null) return;

            _model = r.Data;
            _fecPedido = _model.FEC_PEDIDO;
            _fecVencimiento = _model.FEC_VECIMIENTO;
            _fecEntrega = _model.FEC_ENTREGA;
            _fecEntregaPublica = _model.FEC_ENTREGA_PUBLICA;
            _textoEntidadInicial = string.IsNullOrWhiteSpace(_model.DES_COMERCIAL) ? _model.DES_NOMBRE_COMPLETO : _model.DES_COMERCIAL;
        }
        catch (Exception ex)
        {
            // Si falla, se sigue trabajando con lo que trajo la grilla: es lo mismo que
            // pasaba antes de este cambio, no una regresión.
            await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(RecargarCabeceraCompletaAsync));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await RecargarCabeceraCompletaAsync();

        var tareas = new List<Task>
        {
            // Un solo viaje trae nueve catálogos: tipos de operación, tipos de documento por
            // operación, países, incoterms, monedas, formas y condiciones de pago, tipos de
            // descuento (con su tasa) y proyectos. Antes eran nueve llamadas HTTP.
            CargarCombosAsync(),
            // Los lotes NO se cargan acá: dependen de la entidad del pedido y los trae
            // CargarDependientesDeEntidadAsync. Pedirlos sueltos volvería a llenar el combo
            // con los lotes de todas las entidades, que es justo lo que hay que evitar.
            // Los dos Centros de Costo (Solicitante y Requiriente) salen del mismo catálogo:
            // se carga una sola vez y se comparte entre los dos combos.
            CargarComboAsync($"{ApiRoutes.Contabilidad.CentrosCosto}/combobox", l => _centrosCosto = l),
            ResolverTipoMotivoDesdeClaseAsync(),
        };
        await Task.WhenAll(tareas);

        if (!string.IsNullOrWhiteSpace(_model.COD_TIPO_OPERACION)) AplicarTiposComprobantePago(_model.COD_TIPO_OPERACION);
        if (!string.IsNullOrWhiteSpace(_model.COD_TIPO_MOTIVO)) await CargarMotivosAsync(_model.COD_TIPO_MOTIVO);
        if (_model.COD_ENTIDAD_VENDEDOR is not null) _textoEntidadVendedorInicial = await ResolverTextoEntidadAsync(_model.COD_ENTIDAD_VENDEDOR.Value);
        if (_model.COD_ENTIDAD is not null) await CargarDependientesDeEntidadAsync(_model.COD_ENTIDAD.Value);
        // Sin esto el combo de Vendedor quedaría vacío al abrir un pedido guardado: mostraría
        // el texto del vendedor actual pero no habrea con qué reemplazarlo.
        if (!_vendedorEsDeSesion) await CargarVendedoresDeEntidadAsync();
        if (_model.NUM_TEMPORADA is not null && _model.COD_ENTIDAD is not null) await CargarColeccionesAsync(_model.COD_ENTIDAD.Value, _model.NUM_TEMPORADA.Value);
        if (_cabeceraGrabada) await CargarDetalleAsync(_model.NUM_PEDIDO_COMERCIAL!.Value);
        // Recién acá están las líneas: se repasa la lista de lotes para que los que ya están
        // grabados en el detalle sigan visibles aunque no sean de la entidad del pedido.
        AsegurarLotesEnUso();
        await CargarCalculoAsync();
        if (!_model.FAC_TIPO_CAMBIO.HasValue) await CargarTipoCambioAsync();
    }

    /// <summary>Lo que se lee en el combo de lotes: la descripción, o el NÚMERO cuando no
    /// tiene descripción.
    ///
    /// Sin esto, un lote sin DES_LOTE_CONTROL se dibujaba como una opción EN BLANCO: una
    /// franja de color en la lista, sin texto, que no se puede identificar ni buscar. Existe,
    /// se puede elegir y se graba — pero el usuario no tiene forma de saber cuál es.
    ///
    /// No se oculta el lote: el dato es suyo y tiene derecho a verlo. Se muestra por su
    /// número, que siempre está.</summary>
    private static string EtiquetaLote(ComboboxItem t)
        => string.IsNullOrWhiteSpace(t.Texto) ? (t.Id ?? "") : t.Texto;

    /// <summary>Crea un lote para la entidad del pedido y lo deja elegido en la línea.
    ///
    /// El lote queda GRABADO apenas se confirma el diálogo, aunque después se cancele la
    /// edición de la línea. Es inevitable —el número lo asigna el servidor al insertarlo— y
    /// tampoco es grave: un lote de más sin usar no rompe nada, mientras que pedirle al
    /// usuario que lo cree en otra pantalla sí le hace perder la línea que estaba editando.</summary>
    private async Task CrearLoteAsync(Item it)
    {
        if (_readonly || _model.COD_ENTIDAD is null) return;

        var parametros = new DialogParameters
        {
            ["CodEntidad"] = _model.COD_ENTIDAD.Value,
            ["DesEntidad"] = _textoEntidadInicial
        };

        var dlg = await DialogService.ShowAsync<LoteRapidoDialog>("Nuevo lote de control",
            parametros, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });

        if ((await dlg.Result) is not { Canceled: false, Data: LoteRapidoDialog.Creado creado }) return;

        // Entra a la lista y queda seleccionado en la línea, sin releer todo el combo: el lote
        // es de esta entidad por construcción, así que no hace falta preguntarle a la base si
        // corresponde.
        if (!_lotesControl.Any(x => string.Equals(x.Id, creado.NUM_LOTE_CONTROL, StringComparison.OrdinalIgnoreCase)))
            _lotesControl.Insert(0, new ComboboxItem { Id = creado.NUM_LOTE_CONTROL, Texto = creado.DES_LOTE_CONTROL ?? creado.NUM_LOTE_CONTROL });

        it.NUM_LOTE_CONTROL = creado.NUM_LOTE_CONTROL;
        StateHasChanged();
    }

    /// <summary>Mete en la lista de lotes los que el documento YA tiene grabados y que la
    /// entidad actual no ofrece — el de la cabecera y el de cada línea.
    ///
    /// Es la contracara obligatoria de filtrar por entidad. Un pedido viejo, o uno al que se
    /// le cambió la entidad, puede tener un lote que ya no está en la lista; sin esto el
    /// combo se dibuja con un valor que no está entre sus opciones y se ve VACÍO, mientras el
    /// dato sigue grabado. El usuario creería que no tiene lote y en la base sí lo tiene.
    ///
    /// Se agregan MARCADOS, para que se distingan de los que sí son de la entidad. No se
    /// borran solos: si hay que cambiarlos, que lo decida quien mira la pantalla.</summary>
    private void AsegurarLotesEnUso()
    {
        var enUso = _items.Select(x => x.NUM_LOTE_CONTROL)
                          .Append(_model.NUM_LOTE_CONTROL?.ToString())
                          .Where(v => !string.IsNullOrWhiteSpace(v))
                          .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var lote in enUso)
        {
            if (_lotesControl.Any(x => string.Equals(x.Id, lote, StringComparison.OrdinalIgnoreCase))) continue;
            _lotesControl.Insert(0, new ComboboxItem { Id = lote!, Texto = "(de otra entidad)" });
        }
    }

    private async Task CargarComboAsync(string url, Action<List<ComboboxItem>> asignar)
    {
        try { var r = await Http.GetFromJsonAsync<ApiResponse<List<ComboboxItem>>>(url); asignar(r?.Data ?? new()); }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarComboAsync)); }
    }

    /// <summary>PROC_COMERCIAL_PEDIDOS_COMERCIALES_LOADCOMBOS — los catálogos que no
    /// dependen de nada que el usuario elija dentro de la pantalla, en una sola llamada.
    /// Sigue el mismo patrón que el resto de los módulos (ver TiposOperacion.Loadcombos).
    ///
    /// Tipos de Documento entra igual aunque SÍ dependa del Tipo de Operación: se traen
    /// todos los pares de la clase y después se filtran en memoria, así cambiar de tipo de
    /// operación ya no cuesta un viaje al servidor.</summary>
    private async Task CargarCombosAsync()
    {
        if (string.IsNullOrWhiteSpace(CodClaseOperacion)) return;
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComercialesLoadcombos}?codClaseOperacion={Uri.EscapeDataString(CodClaseOperacion)}";
            var r = await Http.GetFromJsonAsync<ApiResponse<LoadCombosResult>>(url);
            var d = r?.Data;
            if (d is null) return;

            // TiposOperacion viene tipado (con los flags): se arma el combo para la vista y
            // se indexa aparte, porque AplicarTipoOperacion necesita los flags completos.
            _tiposOperacion  = d.TiposOperacion.Select(t => new ComboboxItem { Id = t.COD_TIPO_OPERACION, Texto = t.DES_TIPO_OPERACION }).ToList();
            IndexarTiposOperacion(d.TiposOperacion);
            await AsegurarSucursalesAsync();
            await AplicarVendedorDeSesionAsync();
            _paises          = d.Paises;
            _incoterms       = d.Incoterms;
            _monedas         = d.Monedas;
            _formasPago      = d.FormasPago;
            _condicionesPago = d.CondicionesPago;
            _proyectos       = d.Proyectos;

            _comprobantesPorOperacion = d.TiposComprobantePago
                .GroupBy(x => x.COD_TIPO_OPERACION)
                .ToDictionary(g => g.Key,
                              g => g.Select(x => new ComboboxItem { Id = x.COD_TIPO_COMPROBANTE_PAGO, Texto = x.DES_TIPO_COMPROBANTE_PAGO }).ToList());

            _tiposDescuento = d.TiposDescuento
                .Select(t => new ComboboxItem { Id = t.COD_TIPO_DESCUENTO?.ToString() ?? "", Texto = t.DES_TIPO_DESCUENTO })
                .ToList();
            _tasaPorTipoDescuento.Clear();
            foreach (var t in d.TiposDescuento) _tasaPorTipoDescuento[t.COD_TIPO_DESCUENTO?.ToString() ?? ""] = t.TAS_DESCUENTO;
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarCombosAsync)); }
    }

    private class LoadCombosResult
    {
        public List<TipoOperacionLite> TiposOperacion { get; set; } = new();
        public List<TipoComprobantePagoDeOperacion> TiposComprobantePago { get; set; } = new();
        public List<ComboboxItem> Paises          { get; set; } = new();
        public List<ComboboxItem> Incoterms       { get; set; } = new();
        public List<ComboboxItem> Monedas         { get; set; } = new();
        public List<ComboboxItem> FormasPago      { get; set; } = new();
        public List<ComboboxItem> CondicionesPago { get; set; } = new();
        public List<TipoDescuentoConTasa> TiposDescuento { get; set; } = new();
        public List<ComboboxItem> Proyectos       { get; set; } = new();
    }
