                {
                    Id = codEntidad.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    Texto = _textoEntidadVendedorInicial ?? codEntidad.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
