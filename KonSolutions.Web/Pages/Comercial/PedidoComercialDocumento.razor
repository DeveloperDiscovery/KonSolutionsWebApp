@using Modelo = KONSolutions.Shared.Models.Comercial.PedidoComercial
@using Item = KONSolutions.Shared.Models.Comercial.PedidoComercialDetalle
@using CalculoItem = KONSolutions.Shared.Models.Comercial.PedidoComercialCalculo
@using ProductoModel = KONSolutions.Shared.Models.Estandar.Productos
@using KONSolutions.Shared.Models.Comercial
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService
@inject IAuthService AuthService
@inject ConfigService ConfigSvc

@*
    Documento completo (cabecera + detalle), embebido como segunda solapa de
    PedidosComerciales.razor — mismo patrón que RequerimientoDocumento.razor.

    Layout de cabecera en DOS paneles lado a lado (no en solapas General/Comercial/
    Logística como antes) — replica el boceto aprobado. Panel izquierdo: identificación
    del documento, entidad, temporada/colección, logística y estado. Panel derecho:
    parámetros comerciales (moneda, pago, descuento, centros de costo, proyecto,
    rendición de cuentas), observación y acciones.

    Reglas de negocio numeradas 1-19 (mismas del boceto) resueltas contra el
    Tipo de Operación elegido — ver bloque TipoOperacionLite en @code. Los flags
    FLG_CENTRO_COSTO / FLG_PROYECTO / FLG_LOTE_CONTROL de las reglas 10-11, 12-13 y 18
    se asumen columnas de COMERCIAL.TIPOS_OPERACION igual que FLG_POSITIVO/
    FLG_COMERCIO_EXTERIOR (que ya andan) — si el SP de Tipos de Operación no las
    devuelve todavía, esas reglas puntuales quedan sin efecto (null) hasta agregarlas,
    sin romper nada más. Avisar si hace falta agregarlas al SP.
*@
<style>
    /* Fila 2 de una proforma: descripción, N° de proforma del proveedor y las dos fechas. Con las 12
       columnas de la grilla no se puede repartir: a 2 columnas una fecha mide unos 140 px y «30/10/2026»
       se corta (con la letra de la aplicación necesita unos 170). Por eso la fila se reparte por
       proporción: la descripción 2 partes y cada campo chico 1, sin bajar de 184 px. Si el panel es
       angosto (menos de 760 px), la descripción va sola y los otros tres debajo, a un tercio cada uno.
       La cuenta es con el ancho del panel (container query) y no con el de la pantalla: el zoom de la
       aplicación cambia el ancho del panel y no el de la pantalla.
       La fila va en su propia grilla (pc-fila2): repartida como sea, no se le sube el Proveedor.
       app.css le da la separación vertical (padding) a cada celda de una grilla de formulario:
       las de adentro ya la tienen, así que la celda que las envuelve va sin padding arriba ni
       abajo (si no, la fila 2 baja el doble). A los lados sí lo lleva: el margen negativo de
       la grilla de adentro lo compensa.
       Las clases pc-fila2-desc y pc-fila2-chico solo se usan en una proforma; en las demás
       clases la fila queda como siempre. */
    .documento-logistica .mud-grid-item.pc-fila2 { padding-top: 0 !important; padding-bottom: 0 !important;
                                                   container-type: inline-size; container-name: pcfila2; }
    .documento-logistica .pc-fila2 .mud-grid-item.pc-fila2-desc { flex: 2 1 0; max-width: none; min-width: 0; }
    .documento-logistica .pc-fila2 .mud-grid-item.pc-fila2-chico { flex: 1 1 0; max-width: none; min-width: 184px; }
    @@container pcfila2 (max-width: 760px) {
        .documento-logistica .pc-fila2 .mud-grid-item.pc-fila2-desc { flex: 0 0 100%; max-width: 100%; }
        .documento-logistica .pc-fila2 .mud-grid-item.pc-fila2-chico { flex: 1 1 0; max-width: 33.3333%; min-width: 0; }
    }
</style>
<div class="documento-logistica">
    <EditForm Context="formulario" Model="_model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />

        <MudGrid Spacing="2">
            <!-- ══════════════ PANEL IZQUIERDO ══════════════ -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid var(--line);height:100%;">
                    <MudGrid Spacing="2">
                        @* FILA 1 — Tipo de operación manda sobre casi todo el resto de la
                           cabecera (reglas 1 a 19), así que abre. Tipo de Pedido lo hereda de
                           él (ver AplicarTipoOperacion); Tipo de Documento lo fija él y no se
                           elige (regla 7); N° Pedido lo genera la base al grabar (regla 8).
                           Los cuatro son "de qué documento estamos hablando". *@
                        <MudItem xs="12" md="4">
                            <AriaCombo TItem="ComboboxItem" Items="_tiposOperacion"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_TIPO_OPERACION" ValueChanged="CambiarTipoOperacion"
                                       Label="Tipo de operación" Obligatorio="true" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="2">
                            <MudTextField Variant="Variant.Outlined" T="string" Value="@_model.DES_TIPO_PEDIDO_COMERCIAL"
                                          ReadOnly="true" Label="Tipo de Pedido" Disabled="true" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_tiposComprobantePago"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_TIPO_COMPROBANTE_PAGO" ValueChanged="@(v => _model.COD_TIPO_COMPROBANTE_PAGO = v)"
                                       Label="Tipo de Documento" Disabled="true" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudTextField Variant="Variant.Outlined" T="string" Value="@(_cabeceraGrabada ? _model.NUM_PEDIDO_COMERCIAL?.ToString() : "(automático)")" ReadOnly="true"
                                          Label="N° Pedido" Disabled="true" Class="mb-3" />
                        </MudItem>

                        @* FILA 2 — Descripción + las dos fechas. En una proforma va también el
                           número que le puso el proveedor a su proforma (NUM_DOCUMENTO, hasta 20
                           caracteres), entre la descripción y las fechas, que se achican para
                           darle lugar: ver el <style> del principio (pc-fila2-*).
                           La fila va en su propia grilla, dentro de un MudItem de 12: así, se
                           reparta como se reparta, la fila 3 empieza siempre con el Proveedor.
                           Con los mismos Spacing, la grilla de adentro deja cada campo donde
                           estaba (sus márgenes negativos se comen el padding del MudItem). *@
                        <MudItem xs="12" Class="pc-fila2">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="6" Class="@(EsProforma ? "pc-fila2-desc" : null)">
                                    <CampoTexto Tabla="COMERCIAL.PEDIDOS_COMERCIALES" Columna="DES_PEDIDO_COMERCIAL"
                                                @bind-Value="_model.DES_PEDIDO_COMERCIAL" Obligatorio="true" Disabled="_readonly" Class="mb-3" />
                                </MudItem>
                                @if (EsProforma)
                                {
                                    <MudItem xs="4" Class="pc-fila2-chico">
                                        <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_model.NUM_DOCUMENTO" MaxLength="20"
                                                      Label="Nº Proforma Proveedor" Disabled="_readonly" Class="mb-3" />
                                    </MudItem>
                                }
                                <MudItem xs="6" md="3" Class="@(EsProforma ? "pc-fila2-chico" : null)">
                                    <MudDatePicker Variant="Variant.Outlined" Label="Fecha de pedido" Date="_fecPedido" DateChanged="CambiarFechaPedidoAsync" Editable="true" Disabled="_readonly" Class="mb-3" DateFormat="dd/MM/yyyy" Mask="@(new DateMask("dd/MM/yyyy"))" />
                                </MudItem>
                                <MudItem xs="6" md="3" Class="@(EsProforma ? "pc-fila2-chico" : null)">
                                    <MudDatePicker Variant="Variant.Outlined" Label="Fecha de vencimiento" @bind-Date="_fecVencimiento" Editable="true" Disabled="_readonly" Class="mb-3" DateFormat="dd/MM/yyyy" Mask="@(new DateMask("dd/MM/yyyy"))" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>

                        @* FILA 3 — Regla 1 (Cliente/Proveedor) y regla 2 (Vendedor). *@
                        <MudItem xs="12" md="6">
                            <AriaCombo TItem="ComboboxItem" Items="_entidadesCliente"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.COD_ENTIDAD?.ToString())"
                                       ValueChanged="CambiarEntidad"
                                       SearchFunc="BuscarEntidadClienteProveedorAsync" MinCharacters="2" TextoInicial="@_textoEntidadInicial"
                                       Label="@_labelEntidad" Obligatorio="true" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @* En operación positiva el vendedor es la entidad del usuario
                               logueado: no se elige, se completa sola y queda bloqueada. En las
                               demás se busca entre las entidades que dependen del proveedor del
                               pedido (COD_ENTIDAD_DEPENDENCIA), por eso ahí sí hay SearchFunc.
                               El SearchFunc va en null cuando el vendedor es fijo, para que el
                               combo no ofrezca buscar algo que no se puede cambiar.

                               El cast del SearchFunc es necesario: un ternario entre null y un
                               grupo de métodos no infiere tipo por sí solo. Esta explicación va
                               aquí arriba y no al lado del atributo porque un comentario Razor
                               metido ENTRE los atributos de una etiqueta se interpreta como el
                               nombre de un atributo y revienta al renderizar. *@
                            <AriaCombo TItem="ComboboxItem" Items="_entidadesVendedor"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.COD_ENTIDAD_VENDEDOR?.ToString())"
                                       ValueChanged="@(v => _model.COD_ENTIDAD_VENDEDOR = decimal.TryParse(v, out var n) ? n : null)"
                                       TextoInicial="@_textoEntidadVendedorInicial"
                                       Label="@_labelVendedor" Disabled="@(_readonly || _vendedorEsDeSesion)" Class="mb-3" />
                        </MudItem>

                        @* FILA 4 — Dirección de Entrega (regla 4), País (regla 9) e Incoterm
                           (regla 15), repartida 6/3/3: la Dirección es el texto más largo de
                           los tres, País e Incoterm son códigos cortos. *@
                        <MudItem xs="12" md="6">
                            @* De dónde salen las direcciones lo decide FLG_POSITIVO del Tipo de
                               Operación: en las COMPRAS (false) se entrega en una sucursal propia
                               y en las ventas (true) en una dirección del cliente.
                               El pedido tiene una columna distinta para cada caso —COD_SUCURSAL
                               (texto) y NUM_SECUENCIA_DIRECCION (numérico)—, así que el combo
                               escribe en una o en la otra y deja la que no corresponde en null.
                               Nunca quedan las dos con valor. *@
                            <AriaCombo TItem="ComboboxItem" Items="@(_direccionesDeSucursal ? _sucursales : _direcciones)"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_direccionesDeSucursal ? _model.COD_SUCURSAL : _model.NUM_SECUENCIA_DIRECCION?.ToString())"
                                       ValueChanged="CambiarDireccionEntrega"
                                       Label="@(_direccionesDeSucursal ? "Dirección de Entrega (sucursal)" : "Dirección de Entrega")"
                                       Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_paises"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_PAIS_DESTINO" ValueChanged="@(v => _model.COD_PAIS_DESTINO = v)"
                                       Label="País Destino / Origen" Disabled="@(_readonly || _flgComercioExterior != true)" Class="mb-3" />
                        </MudItem>
                        @* Incoterm (regla 15): se habilita únicamente cuando el Tipo de
                           Operación es de comercio exterior. Queda con la misma condición que
                           País Destino/Origen, que es su vecino y responde a lo mismo: los dos
                           sólo tienen sentido en una operación de importación o exportación.
                           AplicarTipoOperacion ya limpia COD_INCOTERM cuando FLG_COMERCIO_EXTERIOR
                           deja de ser true, así que el campo no puede quedar con un valor viejo
                           mientras está deshabilitado. *@
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_incoterms"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_INCOTERM" ValueChanged="@(v => _model.COD_INCOTERM = v)"
                                       Label="Incoterm" Disabled="@(_readonly || _flgComercioExterior != true)" Class="mb-3" />
                        </MudItem>
                        @* FILA 5 — Los cuatro campos de la operación positiva (reglas 3, 5, 6
                           y 17). Antes se ocultaban cuando FLG_POSITIVO no era true; ahora
                           están SIEMPRE a la vista y se deshabilitan cuando el tipo de
                           operación no los admite. Es el mismo criterio que este formulario ya
                           usa con País Destino, Motivo y los Centros de Costo: el campo se ve,
                           así el usuario sabe que existe, pero no se puede editar si la regla
                           no aplica. Deshabilitado además significa que no se toca el valor
                           guardado. *@
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_unidadesComerciales"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.NUM_UNIDAD_COMERCIAL?.ToString())"
                                       ValueChanged="@(v => _model.NUM_UNIDAD_COMERCIAL = decimal.TryParse(v, out var n) ? n : null)"
                                       Label="Unidad Comercial" Disabled="@(_readonly || _flgPositivo != true)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_temporadas"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.NUM_TEMPORADA?.ToString())"
                                       ValueChanged="CambiarTemporada"
                                       Label="Temporada" Disabled="@(_readonly || _flgPositivo != true)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_colecciones"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.NUM_COLECCION?.ToString())"
                                       ValueChanged="@(v => _model.NUM_COLECCION = int.TryParse(v, out var n) ? n : null)"
                                       Label="Colección" Disabled="@(_readonly || _flgPositivo != true || _model.NUM_TEMPORADA is null)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <CampoTexto Tabla="COMERCIAL.PEDIDOS_COMERCIALES" Columna="NUM_PURCHASE_ORDER"
                                        @bind-Value="_model.NUM_PURCHASE_ORDER"
                                        Disabled="@(_readonly || _flgPositivo != true || _flgComercioExterior != true)" Class="mb-3" />
                        </MudItem>

                        @* FILA 6 — Los cuatro campos cortos, tal como los tienes en pantalla.
                           Lote de Control (regla 18) también pasa a estar siempre visible:
                           se habilita sólo en operaciones NO positivas con FLG_LOTE_CONTROL. *@
                        <MudItem xs="6" md="3">
                            <CampoTexto Tabla="COMERCIAL.PEDIDOS_COMERCIALES" Columna="NUM_TRACKING"
                                        @bind-Value="_model.NUM_TRACKING" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_lotesControl"
                                       TextFunc="@(t => EtiquetaLote(t))" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.NUM_LOTE_CONTROL?.ToString())"
                                       ValueChanged="@(v => _model.NUM_LOTE_CONTROL = decimal.TryParse(v, out var n) ? n : null)"
                                       Label="Lote de Control" Disabled="@(_readonly || _flgPositivo != false || _flgLoteControl != true)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudDatePicker Variant="Variant.Outlined" Label="Entrega Prog. Pública" @bind-Date="_fecEntregaPublica" Editable="true" Disabled="_readonly" Class="mb-3" DateFormat="dd/MM/yyyy" Mask="@(new DateMask("dd/MM/yyyy"))" />
                        </MudItem>
                        <MudItem xs="6" md="3">
                            <MudDatePicker Variant="Variant.Outlined" Label="Fecha de entrega" @bind-Date="_fecEntrega" Editable="true" Disabled="_readonly" Class="mb-3" DateFormat="dd/MM/yyyy" Mask="@(new DateMask("dd/MM/yyyy"))" />
                        </MudItem>

                        @* FILA 7 — Regla 19: Estado, nunca se edita a mano. Si el Tipo de
                           Operación sincroniza con otro (una Orden de Compra que nació de una
                           Proforma, por ejemplo), el SP arma DES_PEDIDO_ORIGEN y se muestra al
                           lado — mismo lugar donde el usuario ya está mirando el estado, que
                           es el otro dato que cambia cuando el pedido viene de una conversión. *@
                        @* Orden: Estado, Origen — Estado abre porque es lo primero que se
                           mira; Origen cierra porque solo aparece cuando el pedido vino de una
                           conversión. Tipo de Pedido se movió a la FILA 1, junto a Tipo de
                           Operación (del que se hereda). *@
                        <MudItem xs="12" md="@(string.IsNullOrWhiteSpace(_model.DES_PEDIDO_ORIGEN) ? 12 : 6)">
                            <div class="d-flex align-end gap-1">
                                <div style="flex:1;min-width:0;">
                                    <EstadoCombo CodTipoEstado="@_codTipoEstadoDesdeOperacion"
                                                 @bind-Value="_model.COD_ESTADO"
                                                 CodTipoEstadoChanged="@(v => _model.COD_TIPO_ESTADO = v)"
                                                 Disabled="true" Class="mb-3" />
                                </div>
                                @* Historial de estados: sólo tiene sentido con la cabecera ya
                                   grabada, porque antes no existe ningún NUM_PEDIDO_COMERCIAL
                                   contra el cual pedirlo. *@
                                @if (_cabeceraGrabada)
                                {
                                    <MudTooltip Text="Ver historial de estados">
                                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                                       Style="@EstilosBoton.Confirmar" Class="mb-3"
                                                       OnClick="AbrirHistorialEstadosAsync" />
                                    </MudTooltip>
                                }
                            </div>
                        </MudItem>
                        @if (!string.IsNullOrWhiteSpace(_model.DES_PEDIDO_ORIGEN))
                        {
                            <MudItem xs="12" md="6">
                                <MudTextField Variant="Variant.Outlined" T="string" Label="Origen" Value="@_model.DES_PEDIDO_ORIGEN"
                                              ReadOnly="true" Disabled="true" Class="mb-3"
                                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CallSplit" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- ══════════════ PANEL DERECHO ══════════════ -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-3 d-flex flex-column" Style="border:1px solid var(--line);height:100%;">
                    <MudGrid Spacing="2">
                        @* FILA 1 — El bloque de pago completo: con qué se paga y en qué
                           condiciones. Tipo de cambio va angosto (md=2) porque es un número
                           corto y además lo completa el sistema (regla 14), no se tipea. *@
                        <MudItem xs="12" md="4">
                            <AriaCombo TItem="ComboboxItem" Items="_monedas"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_MONEDA" ValueChanged="CambiarMonedaAsync"
                                       Label="Moneda" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudNumericField Variant="Variant.Outlined" T="decimal?" Value="_model.FAC_TIPO_CAMBIO" ReadOnly="true" Label="Tipo de cambio" Format="@Decimales.FormatoFactor" Disabled="true" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_formasPago"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_FORMA_PAGO" ValueChanged="@(v => _model.COD_FORMA_PAGO = v)"
                                       Label="Forma de pago" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <AriaCombo TItem="ComboboxItem" Items="_condicionesPago"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_CONDICION_PAGO" ValueChanged="@(v => _model.COD_CONDICION_PAGO = v)"
                                       Label="Condición de pago" Disabled="_readonly" Class="mb-3" />
                        </MudItem>

                        @* FILA 2 — Descuento: el tipo elegido trae la tasa, que no se tipea. *@
                        <MudItem xs="12" md="6">
                            <AriaCombo TItem="ComboboxItem" Items="_tiposDescuento"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_TIPO_DESCUENTO" ValueChanged="CambiarTipoDescuento"
                                       Label="Tipo de descuento" Disabled="_readonly" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField Variant="Variant.Outlined" T="decimal?" Value="_model.TAS_DESCUENTO" ReadOnly="true" Label="Tasa de descuento (%)" Format="@Decimales.FormatoPorcentual" Disabled="true" Class="mb-3" />
                        </MudItem>

                        @* FILA 3 — Motivo (regla 16, habilitado solo si el Tipo de Operación
                           tiene tipo de motivo) junto a los dos Centros de Costo (reglas 10 y
                           11, visibles solo si NO es positiva y habilitados con
                           FLG_CENTRO_COSTO). Los tres responden a "a cuenta de qué va esto". *@
                        <MudItem xs="12" md="4">
                            <AriaCombo TItem="ComboboxItem" Items="_motivos"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_MOTIVO" ValueChanged="@(v => _model.COD_MOTIVO = v)"
                                       Label="Motivo" Disabled="@(_readonly || string.IsNullOrWhiteSpace(_model.COD_TIPO_MOTIVO))" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <AriaCombo TItem="ComboboxItem" Items="_centrosCosto"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_CENTRO_COSTO_SOLICITANTE"
                                       ValueChanged="@(v => _model.COD_CENTRO_COSTO_SOLICITANTE = v)"
                                       Label="Centro de Costo Solicitante" Disabled="@(_readonly || _flgPositivo != false || _flgCentroCosto != true)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <AriaCombo TItem="ComboboxItem" Items="_centrosCosto"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@_model.COD_CENTRO_COSTO_DESTINO"
                                       ValueChanged="@(v => _model.COD_CENTRO_COSTO_DESTINO = v)"
                                       Label="Centro de Costo Requiriente" Disabled="@(_readonly || _flgPositivo != false || _flgCentroCosto != true)" Class="mb-3" />
                        </MudItem>

                        @* FILA 4 — Reglas 12 y 13: Proyecto y Rendición de Cuentas. Igual que
                           los campos de la fila 5 del panel izquierdo, ahora se ven siempre y
                           se habilitan sólo en operaciones NO positivas cuyo Tipo de Operación
                           tenga FLG_PROYECTO. *@
                        <MudItem xs="12" md="6">
                            @* Proyecto pasa de campo numérico a combo: el número suelto obligaba a
                               saberlo de memoria. El catálogo llega en el LOADCOMBOS. *@
                            <AriaCombo TItem="ComboboxItem" Items="_proyectos"
                                       TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                                       Value="@(_model.NUM_PROYECTO?.ToString())"
                                       ValueChanged="@(v => _model.NUM_PROYECTO = decimal.TryParse(v, out var n) ? n : null)"
                                       Label="Proyecto" Disabled="@(_readonly || _flgPositivo != false || _flgProyecto != true)" Class="mb-3" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField Variant="Variant.Outlined" T="decimal?" @bind-Value="_model.NUM_RENDICION_CUENTAS" Label="Rendición de Cuentas"
                                             Disabled="@(_readonly || _flgPositivo != false || _flgProyecto != true)" Class="mb-3" />
                        </MudItem>

                        @* FILA 5 — Observación, a todo el ancho y al final. *@
                        <MudItem xs="12">
                            <CampoTexto Tabla="COMERCIAL.PEDIDOS_COMERCIALES" Columna="DES_OBSERVACION"
                                        @bind-Value="_model.DES_OBSERVACION" Lines="4" Disabled="_readonly" Class="mb-3" />

                            @* Notificación en curso, debajo de la observación. Ya no va
                               alineada a la derecha: ahora es un campo con marco, así que
                               toma el ancho de la fila como cualquier otro. *@
                            <NotificacionLinea Numero="@_model.NUM_NOTIFICACION" Descripcion="@_model.DES_NOTIFICACION"
                                               Fecha="@_model.FEC_NOTIFICACION" Estado="@_model.DES_ESTADO_NOTIFICACION"
                                               BackColor="@_model.DES_BACKCOLOR_NOTIFICACION" ForeColor="@_model.DES_FORECOLOR_NOTIFICACION" />
                        </MudItem>
                    </MudGrid>

                    <MudSpacer />
                    <div class="d-flex align-center gap-2 mt-4">
                        <MudSpacer />
                        @* Botones configurados con FLG_DIALOG. Mismo lugar que en el diálogo
                           modal: a la izquierda de Cerrar y Grabar, separados por una línea.
                           Se muestran sólo con la cabecera ya grabada porque casi todos
                           (imprimir, exportar, aprobar) actúan sobre un documento que existe;
                           antes de grabar no hay número de pedido al que referirse. *@
                        @if (_cabeceraGrabada && !string.IsNullOrWhiteSpace(CodAplicacion))
                        {
                            <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                             Zona="@AccionesBotones.ZonaBotones.Dialog" OnAccion="OnAccionDialog"
                                             CodTipoEstado="@_model.COD_TIPO_ESTADO" CodEstadoActual="@_model.COD_ESTADO" Fila="@_model" />
                            <div style="width:1px;align-self:stretch;background:var(--line);margin:0 4px;"></div>
                        }
                        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cerrar" Disabled="_saving" Variant="Variant.Filled" Style="@EstilosBoton.Cancelar">Cerrar</MudButton>
                        @if (!_readonly)
                        {
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save" Disabled="_saving">
                                @(Modo == CrudModo.Delete ? "Eliminar" : _cabeceraGrabada ? "Guardar cambios" : "Grabar cabecera")
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* ── Detalle ── Vive en su propio marco y no se habilita hasta que la cabecera esté
           grabada: las líneas se insertan contra el número de pedido, que lo genera la base
           recién al grabar. Los requerimientos que originan el pedido están en su propia
           pestaña, al lado de esta pantalla — la maneja PedidosComerciales.razor. *@
        <MudPaper Elevation="0" Class="mt-4 pa-3" Style="border:1px solid var(--line);">
            <div class="d-flex align-center gap-2 mb-2">
                <MudText Typo="Typo.subtitle2">Líneas del pedido</MudText>
                @if (!_cabeceraGrabada)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.Lock">Graba la cabecera para cargar líneas</MudChip>
                }
                <MudSpacer />
                <GridClearFiltersButton OnClear="LimpiarFiltrosDetalle" HasFilters="@(_filtrosDetalle.Any(f => f.Value is not null))" />
                @if (!_readonly && _cabeceraGrabada && !_porRequerimientos)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarItem">Agregar línea</MudButton>
                }
            </div>

            @* Las líneas y los cálculos van lado a lado: 4/5 para el detalle, 1/5 para los
               importes. En pantalla angosta el flex-wrap los apila y cada uno toma el ancho
               completo, así que no hay que mantener breakpoints aparte. *@
            <div class="d-flex gap-3" style="flex-wrap:wrap;align-items:flex-start;">
            <div class="@(_cabeceraGrabada ? "" : "detalle-bloqueado")" data-resizable-grid="pedido-comercial-detalle" style="position:relative;flex:4 1 480px;min-width:0;">
                <MudDataGrid T="Item" Items="@BaseDetalle(-1)" Dense="true" Hover="true" Striped="true"
                             ReadOnly="_readonly" EditMode="DataGridEditMode.Cell"
                             CommittedItemChanges="@(async (Item it) => await GuardarItem(it))"
                             Hierarchy="true" Height="420px" FixedHeader="true">
                    <Columns>
                        <HierarchyColumn T="Item" Width="36px" />
                        <TemplateColumn Sortable="false" Editable="false" Width="45px" CellStyle="text-align:right;">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Sec." Activo="@(_ordenColDetalle == 0)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(0))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(0)" ValorDe="@(x => x.NUM_SECUENCIA?.ToString() ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(0)" ValoresActivosChanged="@(v => FiltroDetalle(0, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate><span class="mono">@context.Item.NUM_SECUENCIA</span></CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Width="420px" Editable="@(!_porRequerimientos)">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Producto" Activo="@(_ordenColDetalle == 1)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(1))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(1)" ValorDe="@(x => x.COD_PRODUCTO ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(1)" ValoresActivosChanged="@(v => FiltroDetalle(1, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var it = context.Item; }
                                <span class="mono" style="opacity:.65;">@it.COD_PRODUCTO</span>
                                <span class="ml-1">@it.DES_PRODUCTO</span>
                            </CellTemplate>
                            <EditTemplate>
                                @{ var it = context.Item; }
                                @* TextoInicial se arma IGUAL que TextFunc ("COD — DES"). Antes era solo
                                   DES_PRODUCTO, así que el código aparecía al elegir un producto y desaparecía
                                   al reabrir el pedido: la misma línea se mostraba de dos formas distintas. *@
                                <AriaCombo TItem="ProductoModel" Items="_productos"
                                           TextFunc="@(x => $"{x.COD_PRODUCTO} — {x.DES_PRODUCTO}")" ValueFunc="@(x => x.COD_PRODUCTO)"
                                           Value="@it.COD_PRODUCTO" ValueChanged="@(v => AsignarProducto(it, v))"
                                           SearchFunc="BuscarProductoAsync" MinCharacters="2"
                                           TextoInicial="@($"{it.COD_PRODUCTO} — {it.DES_PRODUCTO}")"
                                           Disabled="_readonly" Class="" />
                            </EditTemplate>
                        </TemplateColumn>
                        @* Proceso y orden de producción, en UNA celda de resumen, igual que en
                           Requerimientos: cuatro combos en cascada no entran en una grilla que ya
                           lleva producto, lote, unidades, cantidades y precios.

                           Editable="false" es de la GRILLA, no del dato: la celda no entra en
                           edición en línea, se abre el diálogo con un clic. Ahí sí se eligen los
                           cuatro. *@
                        <TemplateColumn Sortable="false" Editable="false" Width="300px">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1">
                                    <EncabezadoOrdenable Texto="Lote / Proceso / Orden" Activo="@(_ordenColDetalle == 2)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(2))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(2)" ValorDe="@(x => ResumenLoteOrden(x))"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(2)" ValoresActivosChanged="@(v => FiltroDetalle(2, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var itOp = context.Item; }
                                <div style="display:flex;align-items:center;gap:2px;">
                                    <div @onclick="@(() => AbrirOrdenProduccionAsync(itOp))"
                                         title="@(_readonly ? "Ver lote, proceso y orden de producción" : "Clic para elegir lote, proceso y orden de producción")"
                                         style="cursor:pointer;min-height:24px;display:flex;align-items:center;gap:6px;flex:1 1 auto;min-width:0;">
                                        <span class="mono">@ResumenLoteOrden(itOp)</span>
                                        @if (!_readonly)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="opacity:.35;" />
                                        }
                                    </div>
                                    @* El "+" de crear lote sobrevive a la fusión de columnas: era
                                       lo que evitaba mandar al usuario a otra pantalla y volver,
                                       perdiendo la línea que estaba editando. Va FUERA del área
                                       clicable del resumen, para que no abra el diálogo de paso. *@
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                       Disabled="@(_model.COD_ENTIDAD is null)"
                                                       Title="@(_model.COD_ENTIDAD is null ? "Elige primero la entidad del pedido" : "Crear un lote nuevo para esta entidad")"
                                                       OnClick="@(() => CrearLoteAsync(itOp))" />
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Editable="false" Width="60px" CellStyle="text-align:center;">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-center gap-1">
                                    <EncabezadoOrdenable Texto="UM" Activo="@(_ordenColDetalle == 3)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(3))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(3)" ValorDe="@(x => x.COD_UNIDAD_MEDIDA ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(3)" ValoresActivosChanged="@(v => FiltroDetalle(3, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate><span class="mono">@(string.IsNullOrWhiteSpace(context.Item.COD_UNIDAD_MEDIDA) ? "—" : context.Item.COD_UNIDAD_MEDIDA)</span></CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.CAN_PRODUCTO" Sortable="false" Editable="@(!_porRequerimientos)" Width="110px" CellStyle="text-align:right;" HeaderStyle="text-align:right;" Format="@Decimales.FormatoCantidad">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Cantidad Propia" Activo="@(_ordenColDetalle == 4)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(4))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(4)" ValorDe="@(x => x.CAN_PRODUCTO?.ToString(Decimales.FormatoCantidad) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(4)" ValoresActivosChanged="@(v => FiltroDetalle(4, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        @* CAN_PRODUCTO_ENTIDAD = "Cantidad Proveedor": la cantidad en la unidad del
                           proveedor (ENTIDADES_PRODUCTOS.COD_UNIDAD_MEDIDA_ATENCION). El SP calcula
                           VAL_TOTAL a partir de ESTA columna, no de Cantidad Propia — por eso se deja
                           editable y no solo informativa, aunque venga precargada. *@
                        <PropertyColumn Property="x => x.CAN_PRODUCTO_ENTIDAD" Sortable="false" Editable="@(!_porRequerimientos)" Width="120px" CellStyle="text-align:right;" HeaderStyle="text-align:right;" Format="@Decimales.FormatoCantidad">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Cantidad Proveedor" Activo="@(_ordenColDetalle == 5)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(5))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(5)" ValorDe="@(x => x.CAN_PRODUCTO_ENTIDAD?.ToString(Decimales.FormatoCantidad) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(5)" ValoresActivosChanged="@(v => FiltroDetalle(5, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        @* Unidad de Cantidad Proveedor. Desnormalizada, no se edita acá: la fija el
                           producto en ENTIDADES_PRODUCTOS, no la línea del pedido. *@
                        <TemplateColumn Sortable="false" Editable="false" Width="100px" CellStyle="text-align:center;">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-center gap-1">
                                    <EncabezadoOrdenable Texto="UM Proveedor" Activo="@(_ordenColDetalle == 6)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(6))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(6)" ValorDe="@(x => x.COD_UNIDAD_MEDIDAD_ENTIDAD ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(6)" ValoresActivosChanged="@(v => FiltroDetalle(6, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@(string.IsNullOrWhiteSpace(context.Item.COD_UNIDAD_MEDIDAD_ENTIDAD) ? "—" : context.Item.COD_UNIDAD_MEDIDAD_ENTIDAD)</CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.PRE_UNITARIO" Sortable="false" Width="100px" CellStyle="text-align:right;" HeaderStyle="text-align:right;" Format="@Decimales.FormatoPrecioUnitario">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="P. Unitario" Activo="@(_ordenColDetalle == 7)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(7))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(7)" ValorDe="@(x => x.PRE_UNITARIO?.ToString(Decimales.FormatoPrecioUnitario) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(7)" ValoresActivosChanged="@(v => FiltroDetalle(7, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TAS_DESCUENTO" Sortable="false" Width="90px" CellStyle="text-align:right;" HeaderStyle="text-align:right;" Format="@Decimales.FormatoPorcentual">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Desc. %" Activo="@(_ordenColDetalle == 8)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(8))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(8)" ValorDe="@(x => x.TAS_DESCUENTO?.ToString(Decimales.FormatoPorcentual) ?? "")"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(8)" ValoresActivosChanged="@(v => FiltroDetalle(8, v))" />
                                </div>
                            </HeaderTemplate>
                        </PropertyColumn>
                        <TemplateColumn Sortable="false" Editable="false" Width="100px" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                            <HeaderTemplate>
                                <div class="d-flex align-center justify-end gap-1">
                                    <EncabezadoOrdenable Texto="Total" Activo="@(_ordenColDetalle == 9)" Ascendente="_ordenAscDetalle" OnClick="@(() => ToggleOrdenDetalle(9))" />
                                    <FiltroExcelColumna T="Item" ItemsBase="@BaseDetalle(9)" ValorDe="@(x => CalcularTotal(x).ToString("N2"))"
                                                        ValoresActivos="_filtrosDetalle.GetValueOrDefault(9)" ValoresActivosChanged="@(v => FiltroDetalle(9, v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate><span class="mono">@(CalcularTotal(context.Item).ToString("N2"))</span></CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Sortable="false" Editable="false" Width="90px" CellStyle="text-align:center;">
                            <CellTemplate>
                                @if (!_readonly)
                                {
                                    var it = context.Item;
                                    <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Primary" OnClick="@(() => GuardarItemConAviso(it))" Title="Grabar línea" />
                                    @if (!_porRequerimientos)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => QuitarItem(it))" Title="Quitar línea" />
                                    }
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent><MudText Class="pa-4 mono" Style="opacity:.5;">Sin líneas.</MudText></NoRecordsContent>
                    @* Trazabilidad: de qué requerimiento(s) de stock salió esta línea. *@
                    <ChildRowContent Context="lineaRow">
                        <LineaRequerimientosStockSubgrid CodClaseOperacion="@(_model.COD_CLASE_OPERACION ?? "")"
                                                          CodTipoOperacion="@(_model.COD_TIPO_OPERACION ?? "")"
                                                          NumPedidoComercial="@(_model.NUM_PEDIDO_COMERCIAL ?? 0)"
                                                          NumSecuencia="@(lineaRow.Item.NUM_SECUENCIA ?? 0)" />
                    </ChildRowContent>
                </MudDataGrid>
                <div class="d-flex align-center gap-4 mt-2 mono" style="font-size:.82rem;opacity:.7;">
                    <span>Líneas <b>@_items.Count</b></span>
                    <span>Total <b>@_valTotalCalculado.ToString("N2")</b></span>
                </div>
                <div class="grid-resize-handle"></div>
            </div>

            @* ── Cálculos del pedido ─────────────────────────────────────────────────
               Solo lectura: los importes los arma la base al grabar las líneas, no esta
               pantalla. Se refresca junto con el detalle (ver CargarCalculoAsync). *@
            @* data-resizable-grid con la MISMA clave que el detalle: así gridAutoAlto y el
               tirador de alto tratan a las dos grillas como un grupo y quedan siempre a la
               misma altura, incluso al arrastrar el borde o cambiar el tamaño de la ventana.
               data-cols-key le da identidad propia SOLO para los anchos de columna, que no se
               pueden compartir porque las columnas no son las mismas. *@
            <div data-resizable-grid="pedido-comercial-detalle" data-cols-key="pedido-comercial-calculo"
                 style="flex:1 1 200px;min-width:0;">
                <MudDataGrid T="CalculoItem" Items="_calculos" Dense="true" Hover="true" Striped="true"
                             ReadOnly="true" Height="420px" FixedHeader="true">
                    <Columns>
                        <TemplateColumn Title="Concepto" Sortable="false" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                            <CellTemplate>@context.Item.DES_TIPO_VALOR_CALCULO</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Tasa" Sortable="false" Width="60px" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                            <CellTemplate>
                                @* Sin tasa la celda va vacía: un guion se leería como "tasa cero". *@
                                <span class="mono">@(context.Item.TAS_IMPUESTO?.ToString("N2"))</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Valor" Sortable="false" Width="90px" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                            <CellTemplate>
                                <span class="mono">@(context.Item.VAL_CALCULO?.ToString("N2") ?? "—")</span>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent>
                        <MudText Class="pa-4 mono" Style="opacity:.5;font-size:.8rem;">
                            @(_cabeceraGrabada ? "Sin cálculos." : "Graba la cabecera.")
                        </MudText>
                    </NoRecordsContent>
                </MudDataGrid>
                <div class="d-flex align-center gap-4 mt-2 mono" style="font-size:.82rem;opacity:.7;">
                    <span>Conceptos <b>@_calculos.Count</b></span>
                </div>
            </div>

            </div>
        </MudPaper>
    </EditForm>
</div>

@code {
    [Parameter] public EventCallback<bool> OnCerrar { get; set; }
    [Parameter] public Modelo? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    [Parameter] public string? CodClaseOperacion { get; set; }
    [Parameter] public string? CodTipoOperacionSugerido { get; set; }
    /// <summary>Códigos de la opción, para resolver los botones marcados con FLG_DIALOG.
    /// Los pasa la pantalla de lista, que es la que los recibe del menú.</summary>
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    /// <summary>Qué hacer con un botón del pie. Por ahora sólo deja el rastro en el log: el
    /// flag define DÓNDE se muestra el botón, no qué hace, y cada acción concreta (imprimir,
    /// exportar, aprobar) se conecta aquí cuando esté definida.</summary>
    private async Task OnAccionDialog(BotonTreeviewItem b)
    {
        if (PedidosComerciales.ReversionDe(b, _model.NUM_PEDIDO_COMERCIAL) is { } rv) { await RevertirAsync(rv); return; }

        await ErrorLog.TraceAsync(
            $"BOTÓN DE DIÁLOGO — {b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION} " +
            $"(método configurado: {b.DES_METODO ?? "sin método"}) sobre el pedido {NumPedidoUrl}");
        await ErrorDialogHelper.MostrarAvisoAsync(
            $"El botón \"{b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION}\" todavía no tiene una acción conectada en esta pantalla.",
            DialogService, nameof(PedidoComercialDocumento), "Acción pendiente");
    }

    /// <summary>Mismo efecto que el botón de la grilla, sobre el documento abierto. Después
    /// relee la cabecera: el SP le cambió el estado.</summary>
    private async Task RevertirAsync(PedidosComerciales.Reversion rv)
    {
        var ok = await DialogService.ShowMessageBox(rv.Titulo, rv.Pregunta, yesText: "Revertir", cancelText: "Cancelar");
        if (ok != true) return;

        var url = $"{rv.Ruta}/{ClaseUrl}/{TipoUrl}/{NumPedidoUrl}";
        var resp = await Http.PostAsync(url, null);
        if (!resp.IsSuccessStatusCode)
        {
            await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(PedidoComercialDocumento),
                nameof(RevertirAsync), $"No se pudo completar: {rv.Titulo.ToLower()}");
            return;
        }
        _huboCambios = true;
        Snackbar.Add(rv.Exito, Severity.Success);
        await RecargarCabeceraCompletaAsync();
        StateHasChanged();
    }

    private Modelo _model = new();
    private List<Item> _items = new();

    // ── Filtro de columna, estilo Excel, para la grilla de líneas ─────────────────────────
    // El buscador de valores por columna vuelve a agrupar los HIJOS con su padre: filtra
    // sobre las líneas de PRIMER nivel (_items), que es lo que la grilla ya trata como filas;
    // la trazabilidad de cada línea (ChildRowContent) sigue viva sin cambios.
    private readonly Dictionary<int, HashSet<string>?> _filtrosDetalle = new();

    private List<Item> BaseDetalle(int col) => AplicarFiltrosDetalle(OrdenarDetalle(_items), col);

    private string ValorDetalle(Item x, int col) => col switch
    {
        0 => x.NUM_SECUENCIA?.ToString() ?? "",
        1 => x.COD_PRODUCTO ?? "",
        2 => ResumenLoteOrden(x),
