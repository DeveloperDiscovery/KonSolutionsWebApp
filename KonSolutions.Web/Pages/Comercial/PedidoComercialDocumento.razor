        public string COD_TIPO_OPERACION        { get; set; } = "";
        public string COD_TIPO_COMPROBANTE_PAGO { get; set; } = "";
        public string DES_TIPO_COMPROBANTE_PAGO { get; set; } = "";
    }
    private class TipoDescuentoConTasa
    {
        public int?     COD_TIPO_DESCUENTO { get; set; }
        public string   DES_TIPO_DESCUENTO { get; set; } = "";
        public decimal? TAS_DESCUENTO      { get; set; }
    }

    /// <summary>Tipos de Operación queda con los datos que ya trajo el LOADCOMBOS; esto sólo
    /// rearma el diccionario de flags que usa AplicarTipoOperacion.</summary>
    private void IndexarTiposOperacion(List<TipoOperacionLite> lista)
    {
        _tiposOperacionPorCodigo.Clear();
        foreach (var t in lista) _tiposOperacionPorCodigo[t.COD_TIPO_OPERACION] = t;
        if (!string.IsNullOrWhiteSpace(_model.COD_TIPO_OPERACION) && _tiposOperacionPorCodigo.TryGetValue(_model.COD_TIPO_OPERACION, out var actual))
            AplicarTipoOperacion(actual);
    }

    /// <summary>El Tipo de Operación decide, sin que el usuario los toque: Tipo de Estado,
    /// Tipo de Entidad a buscar (regla 1, directo de la tabla), visibilidad de Incoterm/
    /// Unidad Comercial/Temporada-Colección/Purchase Order/Lote de Control/Centro de Costo/
    /// Proyecto-Rendición según los flags correspondientes.</summary>
    private void AplicarTipoOperacion(TipoOperacionLite t)
    {
        _codTipoEstadoDesdeOperacion = t.COD_TIPO_ESTADO_RELACIONADO;
        _flgPositivo = t.FLG_POSITIVO;
        _flgComercioExterior = t.FLG_COMERCIO_EXTERIOR;
        _flgCentroCosto = t.FLG_CENTRO_COSTO;
        _flgProyecto = t.FLG_PROYECTO;
        _flgLoteControl = t.FLG_LOTE_CONTROL;
        // Oculto: se guarda igual, solo no se elige a mano — regla 1 toma el tipo directo
        // de la tabla en vez de inferir VEN/PRV desde FLG_POSITIVO.
        _model.COD_TIPO_ENTIDAD = t.COD_TIPO_ENTIDAD;
        if (t.FLG_COMERCIO_EXTERIOR != true) _model.COD_INCOTERM = null;
        // Igual que Tipo de Documento: no se elige a mano, lo fija el Tipo de Operación.
        // Pero acá SÍ hay que cuidar de NO pisar un valor ya grabado (mismo criterio que
        // AplicarVendedorDeSesionAsync): esto se llama también al ABRIR un pedido existente
        // -vía IndexarTiposOperacion, después de que RecargarCabeceraCompletaAsync ya trajo
        // el valor real del SHOWBYID-, y aplicar el default del catálogo encima borraría lo
        // que el pedido tiene grabado. Sólo se completa cuando está vacío: un pedido nuevo, o
        // uno al que CambiarTipoOperacion recién le limpió el campo a propósito.
        if (_model.COD_TIPO_PEDIDO_COMERCIAL is null)
        {
            _model.COD_TIPO_PEDIDO_COMERCIAL = t.COD_TIPO_PEDIDO_COMERCIAL;
            _model.DES_TIPO_PEDIDO_COMERCIAL = t.DES_TIPO_PEDIDO_COMERCIAL ?? "";
        }
    }

    private async Task CambiarTipoOperacion(string? codTipoOperacion)
    {
        _model.COD_TIPO_OPERACION = codTipoOperacion ?? "";
        _model.COD_ESTADO = null;
        _model.COD_ENTIDAD = null;
        _textoEntidadInicial = null;
        _entidadesCliente = new();
        // Sin entidad no hay lotes que ofrecer: el combo se vacía en vez de quedarse con los
        // de la entidad anterior, que ya no corresponden.
        _lotesControl = new();
        _model.COD_TIPO_COMPROBANTE_PAGO = null;
        _tiposComprobantePago = new();
        // Cambiar el tipo de operación puede cambiar el ORIGEN de la Dirección de Entrega
        // (sucursales vs. entidad), así que la elección anterior deja de ser válida: se
        // limpian las dos columnas y se vuelve a elegir.
        _model.NUM_SECUENCIA_DIRECCION = null;
        _model.COD_SUCURSAL = null;
        _direcciones = new();
        // El vendedor también cambia de origen con el tipo de operación (entidad de la sesión
        // vs. dependientes del proveedor), así que el anterior deja de ser válido.
        _model.COD_ENTIDAD_VENDEDOR = null;
        _textoEntidadVendedorInicial = null;
        _entidadesVendedor = new();
        // Cambiar a mano el Tipo de Operación SÍ debe traer el Tipo de Pedido del nuevo tipo,
        // aunque el anterior ya tuviera uno: se limpia acá para que AplicarTipoOperacion (que
        // no pisa un valor existente) lo complete de nuevo con el del tipo recién elegido.
        _model.COD_TIPO_PEDIDO_COMERCIAL = null;
        _model.DES_TIPO_PEDIDO_COMERCIAL = "";

        if (!string.IsNullOrWhiteSpace(codTipoOperacion) && _tiposOperacionPorCodigo.TryGetValue(codTipoOperacion, out var t))
        {
            AplicarTipoOperacion(t);
            await AsegurarSucursalesAsync();
            await AplicarVendedorDeSesionAsync();
            AplicarTiposComprobantePago(codTipoOperacion);
        }
        else
        {
            _codTipoEstadoDesdeOperacion = null;
            _flgPositivo = null;
            _flgComercioExterior = null;
            _flgCentroCosto = null;
            _flgProyecto = null;
            _flgLoteControl = null;
        }
        StateHasChanged();
    }

    /// <summary>Reglas 3 y 4: al elegir la Entidad se cargan sus Unidades Comerciales y
    /// Direcciones — si cualquiera de las dos trae un solo resultado, se autoselecciona.</summary>
    private async Task CambiarEntidad(string? codEntidad)
    {
        _model.COD_ENTIDAD = decimal.TryParse(codEntidad, out var n) ? n : null;
        _model.NUM_UNIDAD_COMERCIAL = null;
        _model.NUM_SECUENCIA_DIRECCION = null;
        _model.NUM_TEMPORADA = null;
        _model.NUM_COLECCION = null;
        _unidadesComerciales = new();
        _direcciones = new();
        _temporadas = new();
        _colecciones = new();
        if (_model.COD_ENTIDAD is not null) await CargarDependientesDeEntidadAsync(_model.COD_ENTIDAD.Value);
        // Los vendedores dependen del proveedor recién elegido; en operación positiva no se
        // usan (ahí el vendedor es la entidad de la sesión), así que ni se piden.
        if (!_vendedorEsDeSesion) await CargarVendedoresDeEntidadAsync();
        await AplicarInformacionComercialAsync();
        StateHasChanged();
    }

    /// <summary>COMERCIAL.ENTIDADES_INFORMACION_COMERCIAL — trae las condiciones pactadas con
    /// esta entidad para ESTE tipo de operación y las propone en la cabecera: moneda,
    /// condición de pago y forma de pago.
    ///
    /// Nota: son datos de la ficha "Información Comercial" de la entidad, no de "Información
    /// Financiera" — esa última guarda cuentas bancarias (banco, número, CCI) y no tiene
    /// ninguno de estos tres campos.
    ///
    /// La clave de la tabla es (entidad, clase de operación, tipo de operación), que es
    /// exactamente el contexto del pedido, así que se pide la fila puntual en vez de traer
    /// la lista y filtrar. Si esa combinación no está configurada, no se toca nada: se deja
    /// lo que el usuario ya haya puesto.</summary>
    private async Task AplicarInformacionComercialAsync()
    {
        if (_model.COD_ENTIDAD is null
            || string.IsNullOrWhiteSpace(CodClaseOperacion)
            || string.IsNullOrWhiteSpace(_model.COD_TIPO_OPERACION)) return;

        try
        {
            var url = $"{ApiRoutes.Comercial.EntidadesInformacionComercial}/{_model.COD_ENTIDAD}"
                    + $"/{Uri.EscapeDataString(CodClaseOperacion)}"
                    + $"/{Uri.EscapeDataString(_model.COD_TIPO_OPERACION)}";
            // SafeGetAsync y no GetFromJsonAsync: cuando la entidad no tiene condiciones
            // configuradas para este tipo de operación la API responde 404, que es un caso
            // esperable y no un error que haya que loguear ni mostrar.
            var info = await Http.SafeGetAsync<KONSolutions.Shared.Models.Comercial.EntidadesInformacionComercial>(url);
            if (info is null) return;

            // Sólo se pisa lo que la ficha tenga cargado: si allá quedó en blanco, no se
            // borra lo que el usuario ya eligió en el pedido.
            // El pedido guarda estos dos códigos como string y la ficha como int (así están
            // declarados en cada modelo): hay que convertir, y con InvariantCulture para que
            // el valor coincida con el Id del combo.
            var monedaCambio = false;
            if (!string.IsNullOrWhiteSpace(info.COD_MONEDA) && info.COD_MONEDA != _model.COD_MONEDA)
            {
                _model.COD_MONEDA = info.COD_MONEDA;
                monedaCambio = true;
            }
            if (info.COD_CONDICION_PAGO is not null)
                _model.COD_CONDICION_PAGO = info.COD_CONDICION_PAGO.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (info.COD_FORMA_PAGO is not null)
                _model.COD_FORMA_PAGO = info.COD_FORMA_PAGO.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

            // Si el proveedor trajo una moneda distinta, la cotización que estuviera puesta
            // es de otra moneda y ya no sirve: se recalcula.
            if (monedaCambio) await CargarTipoCambioAsync();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(AplicarInformacionComercialAsync)); }
    }

    private async Task CargarDependientesDeEntidadAsync(decimal codEntidad)
    {
        try
        {
            var uc = await Http.GetFromJsonAsync<ApiResponse<List<EntidadesUnidadesComerciales>>>(
                $"{ApiRoutes.Comercial.EntidadesUnidadesComerciales}?codEntidad={codEntidad}");
            _unidadesComerciales = (uc?.Data ?? new())
                .Select(u => new ComboboxItem { Id = u.COD_UNIDAD_COMERCIAL?.ToString() ?? "", Texto = u.DES_UNIDAD_COMERCIAL ?? "" }).ToList();
            if (_unidadesComerciales.Count == 1) _model.NUM_UNIDAD_COMERCIAL = decimal.TryParse(_unidadesComerciales[0].Id, out var nu) ? nu : null;

            // Las direcciones de la entidad sólo se piden cuando son las que se van a usar:
            // en una operación positiva la Dirección de Entrega sale de las sucursales y esta
            // lista no se muestra, así que traerla sería una llamada al pedo.
            if (!_direccionesDeSucursal)
            {
                var dir = await Http.GetFromJsonAsync<ApiResponse<List<EntidadesDirecciones>>>(
                    $"{ApiRoutes.Comercial.EntidadesDirecciones}?codEntidad={codEntidad}");
                _direcciones = (dir?.Data ?? new())
                    .Select(d => new ComboboxItem { Id = d.NUM_SECUENCIA?.ToString() ?? "", Texto = d.DES_DIRECCION ?? "" }).ToList();
                if (_direcciones.Count == 1) _model.NUM_SECUENCIA_DIRECCION = decimal.TryParse(_direcciones[0].Id, out var nd) ? nd : null;
            }

            var tmp = await Http.GetFromJsonAsync<ApiResponse<List<KONSolutions.Shared.Models.Comercial.EntidadesTemporadas>>>(
                $"{ApiRoutes.Comercial.EntidadesTemporadas}?codEntidad={codEntidad}");
            _temporadas = (tmp?.Data ?? new())
                .Select(t => new ComboboxItem { Id = t.NUM_TEMPORADA?.ToString() ?? "", Texto = t.DES_TEMPORADA }).ToList();

            // Lotes de control DE ESTA ENTIDAD. Antes venían todos, de todas las entidades,
            // con lo cual se podía asignarle a un pedido de un proveedor el lote de otro —y
            // el lote es de quien lo emitió, no del sistema—.
            await CargarComboAsync(ApiRoutes.Logistica.LotesControlComboboxDe(codEntidad),
                                   l => _lotesControl = l);
            AsegurarLotesEnUso();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarDependientesDeEntidadAsync)); }
    }

    private async Task CambiarTemporada(string? numTemporada)
    {
        _model.NUM_TEMPORADA = decimal.TryParse(numTemporada, out var n) ? n : null;
        _model.NUM_COLECCION = null;
        _colecciones = new();
        if (_model.COD_ENTIDAD is not null && _model.NUM_TEMPORADA is not null)
            await CargarColeccionesAsync(_model.COD_ENTIDAD.Value, _model.NUM_TEMPORADA.Value);
        StateHasChanged();
    }

