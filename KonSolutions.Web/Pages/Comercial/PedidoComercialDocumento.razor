    /// es un dato que falta en su ficha de usuario, no algo que se arregle desde el pedido.</summary>
    private async Task AplicarVendedorDeSesionAsync()
    {
        if (!_vendedorEsDeSesion || _model.COD_ENTIDAD_VENDEDOR is not null) return;
        try
        {
