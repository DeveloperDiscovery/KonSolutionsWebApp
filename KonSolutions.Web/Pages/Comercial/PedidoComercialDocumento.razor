    }

    /// <summary>Completa el Tipo de Cambio (regla 14: no se tipea a mano) con la cotización
    /// de la moneda elegida a la FECHA DEL PEDIDO — resuelta ahora por
    /// PROC_ESTANDAR_MONEDAS_TIPO_CAMBIO_OBTENER, que hace en la base lo que antes se
    /// hacía acá con LINQ (fecha exacta o la última anterior) y de paso resuelve el caso
    /// que la pantalla no cubría: si la moneda del pedido ES la moneda pivot configurada
    /// (ESTANDAR.CONFIGURACION_GENERAL.COD_MONEDA_PIVOT_TIPO_CAMBIO), el tipo de cambio es
    /// 1 — antes quedaba vacío, porque MONEDAS_TIPO_CAMBIO nunca tiene filas para la
    /// pivot (no tendría sentido cotizarla contra sí misma).</summary>
    private async Task CargarTipoCambioAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.COD_MONEDA)) return;
        try
        {
            var fecha = (_fecPedido ?? DateTime.Today).Date.ToString("yyyy-MM-dd");
            var url = $"{ApiRoutes.Estandar.MonedasTipoCambioObtener}?codMoneda={Uri.EscapeDataString(_model.COD_MONEDA)}&fecTipoCambio={fecha}";
            var r = await Http.GetFromJsonAsync<ApiResponse<TipoCambioResultado>>(url);
            // Sin cotización se deja el campo vacío a propósito: mostrar un valor viejo de
            // otra moneda sería peor que no mostrar nada.
            _model.FAC_TIPO_CAMBIO = r?.Data?.FAC_TIPO_CAMBIO;
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidoComercialDocumento), nameof(CargarTipoCambioAsync)); }
    }

    /// <summary>Al cambiar la moneda cambia la cotización que corresponde.</summary>
    private async Task CambiarMonedaAsync(string? codMoneda)
    {
        _model.COD_MONEDA = codMoneda;
        await CargarTipoCambioAsync();
    }

    /// <summary>Al cambiar la fecha del pedido cambia la cotización que corresponde.</summary>
    private async Task CambiarFechaPedidoAsync(DateTime? fecha)
    {
        _fecPedido = fecha;
        await CargarTipoCambioAsync();
    }
    /// <summary>Regla 7: el Tipo de Documento no lo elige el usuario, lo fija el Tipo de
    /// Operación. Si trae uno solo se autoselecciona; el combo queda siempre Disabled.
    /// Ya no va al servidor: los pares vienen todos en el LOADCOMBOS y aquí sólo se filtra
    /// el grupo que corresponde, así cambiar de tipo de operación es instantáneo.</summary>
    private void AplicarTiposComprobantePago(string codTipoOperacion)
    {
        _tiposComprobantePago = _comprobantesPorOperacion.TryGetValue(codTipoOperacion, out var lista)
            ? lista
            : new();
        if (_tiposComprobantePago.Count == 1) _model.COD_TIPO_COMPROBANTE_PAGO = _tiposComprobantePago[0].Id;
    }

    private async Task CambiarTipoDescuento(string? codTipoDescuento)
    {
        _model.COD_TIPO_DESCUENTO = codTipoDescuento;
        _model.TAS_DESCUENTO = string.IsNullOrWhiteSpace(codTipoDescuento) ? null : _tasaPorTipoDescuento.GetValueOrDefault(codTipoDescuento);
        await CargarCalculoAsync();
    }

