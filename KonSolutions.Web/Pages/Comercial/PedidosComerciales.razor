@page "/comercial/pedidos-comerciales"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Comercial
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject ErrorLogService ErrorLog
@inject LimitesService Limites
@inject MenuService MenuSvc
@implements IDisposable

@*
    Fase 1: solo cabecera de COMERCIAL.PEDIDOS_COMERCIALES. Pantalla genérica reutilizada por
    Proformas / Órdenes de Compra / Pedidos de Venta, igual que Entidades con Clientes/
    Proveedores — cada opción de menú fija su COD_CLASE_OPERACION vía DES_PARAMETRO en
    SEGURIDAD.APLICACIONES_OPCIONES (ej. "COD_CLASE_OPERACION = 'PRFRM'").
*@

<PageTitle>Pedidos Comerciales · @ConfigSvc.Current.NombreApp</PageTitle>

@* Dos solapas que nunca están habilitadas a la vez — mismo patrón que Requerimientos de
   Almacén: o se está mirando la lista, o se está trabajando sobre un documento (cabecera +
   líneas). Evita navegar el listado con una edición a medio hacer detrás. *@
@* KeepPanelsAlive: sin esto MudTabs destruye la pestaña que no está activa, y al pasar a
   Requerimientos se perdería lo que el documento tiene sin grabar. Además la pestaña de
   requerimientos le pide líneas al documento por referencia, y esa referencia sólo existe
   mientras el documento siga montado. *@
<MudTabs Elevation="0" ActivePanelIndex="@_tab" ActivePanelIndexChanged="@(i => _tab = i)"
         Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" KeepPanelsAlive="true">

<MudTabPanel Text="@_tituloLista" Icon="@Icons.Material.Filled.List" Disabled="@_enDocumento">
<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Pedidos Comerciales" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema COMERCIAL · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Filtrar" MaxWidth="719px" Class="grid-header-search" />
    @* PROC_COMERCIAL_PEDIDOS_COMERCIALES_SHOWALL/_SEARCH exigen COD_CLASE_OPERACION Y
       COD_TIPO_OPERACION (no lista "toda la clase" de una sola vez) — de ahí este selector,
       que se completa solo con los tipos de esa clase y arranca en el primero disponible. *@
    @* AriaCombo y no MudSelect: MudSelect renderiza su propio popover (mud-list/mud-list-item)
       con la tipografía y los colores de MudBlazor, ajeno al resto de los combos de la app
       — se veía distinto a cualquier otro desplegable del sistema. AriaCombo es el estándar
       aquí y ya toma --control-size/--control-font y la paleta configurada. *@
    @if (_tiposOperacion.Count > 0)
    {
        <AriaCombo TItem="ComboboxItem" Items="_tiposOperacion"
                   TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                   Value="@_codTipoOperacionSeleccionado" ValueChanged="OnCambioTipoOperacion"
                   Label="Tipo de operación" Class="mb-0"
                   Style="min-width:660px;max-width:780px;margin-top:0;" />
    }
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" Fila="@ContextoReportes" />
    </div>
</div>

@* AVISO EN VEZ DE PANTALLA VACÍA.
   Esta pantalla sirve a varias opciones de menú (Proformas, Órdenes de Compra, Pedidos de
   Venta) y lo único que las distingue es la clase de operación, que sale del DES_PARAMETRO
   de la opción. Si falta, antes no pasaba nada: sin clase no se piden los tipos de
   operación, ni los combos del documento, ni la lista — y los tres vacíos se ven igual que
   "no hay datos". Costó una tarde encontrarlo; el mensaje lo dice en un renglón. *@
@if (string.IsNullOrWhiteSpace(_codClaseOperacion))
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        Esta opción de menú no tiene configurada su clase de operación, así que no hay nada
        que mostrar. En Seguridad → Opciones de Aplicación, campo <b>Parámetro</b> de esta
        opción, hay que poner por ejemplo
        <code>COD_CLASE_OPERACION = 'ORDCM'</code>.
    </MudAlert>
}

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    @* Proformas tiene una columna más (Nº Proforma Proveedor): sus anchos se guardan aparte
       (data-cols-key), porque gridColumnas.js los guarda por posición y si no se correrían los
       anchos que cada uno tiene puestos en Órdenes de compra. La clase de operación llega
       después del primer dibujo: el @key rehace la grilla cuando llega, para que el arrastre
       de las columnas guarde con la clave que corresponde. *@
    <div @key="@(_codClaseOperacion ?? "")" data-resizable-grid="pedidos-comerciales" data-cols-key="@(EsProforma ? "pedidos-comerciales-proformas" : null)" style="position:relative;">
    <MudDataGrid T="PedidoComercial" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        @* Orden y contenido de las columnas, tal como se pidió. Cada una lleva encabezado
           ordenable y filtro; la única sin ambos es Acciones, que no es un dato.
           Los índices van 0..9 en el mismo orden en que se ven: al rehacer el bloque
           entero se pudo renumerar prolijo, cosa que antes no convenía porque hubiera roto
           los filtros existentes.
           El ancho de las columnas de fecha es 150 y no 120: con 120 el nombre de la
           columna y el embudo del filtro no entraban juntos y el embudo quedaba tapado. *@
        <Columns>
            <TemplateColumn Sortable="false" Title="Tipo de Operación" Width="200">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Operación" Campo="COD_TIPO_OPERACION" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(0)" ValorDe="@(x=>DescripcionTipoOperacion(x.COD_TIPO_OPERACION))"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@DescripcionTipoOperacion(context.Item.COD_TIPO_OPERACION)</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Tipo de Documento" Width="180">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Documento" Campo="DES_TIPO_COMPROBANTE_PAGO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_COMPROBANTE_PAGO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_COMPROBANTE_PAGO</CellTemplate>
            </TemplateColumn>

            @* Número y descripción en columnas SEPARADAS: antes iban juntos ("1 - PROFORMA BIOS"). *@
            <TemplateColumn Sortable="false" Title="@_tituloColumnaPedido" Width="130">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="@_tituloColumnaPedido" Campo="NUM_PEDIDO_COMERCIAL" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(2)" ValorDe="@(x=>x.NUM_PEDIDO_COMERCIAL?.ToString()??"")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.NUM_PEDIDO_COMERCIAL</span></CellTemplate>
            </TemplateColumn>

            @* Solo en Proformas: el número que el proveedor le puso a su proforma (NUM_DOCUMENTO).
               Hidden y no un @if: una columna que aparece después de dibujar la grilla se va al final. *@
            <TemplateColumn Sortable="false" Title="Nº Proforma Proveedor" Width="200" Hidden="@(!EsProforma)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Nº Proforma Proveedor" Campo="NUM_DOCUMENTO" Activo="@(_ordenColumna == 11)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(11))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(11)" ValorDe="@(x=>x.NUM_DOCUMENTO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(11)" ValoresActivosChanged="@(v=>Filtro(11,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.NUM_DOCUMENTO</span></CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("COMERCIAL.PEDIDOS_COMERCIALES","DES_PEDIDO_COMERCIAL",220,360)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Descripción" Campo="DES_PEDIDO_COMERCIAL" Activo="@(_ordenColumna == 10)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(10))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(10)" ValorDe="@(x=>x.DES_PEDIDO_COMERCIAL ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(10)" ValoresActivosChanged="@(v=>Filtro(10,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_PEDIDO_COMERCIAL</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Entidad" Width="@Limites.ColWidth("COMERCIAL.PEDIDOS_COMERCIALES","DES_NOMBRE_COMPLETO",160,320)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_NOMBRE_COMPLETO" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(3)" ValorDe="@(x=>TextoEntidad(x))"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@TextoEntidad(context.Item)</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Fecha de Pedido" Width="150">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Fecha de Pedido" Campo="FEC_PEDIDO" Activo="@(_ordenColumna == 4)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(4))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(4)" ValorDe="@(x=>x.FEC_PEDIDO?.ToString("dd/MM/yyyy") ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>Filtro(4,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@(context.Item.FEC_PEDIDO?.ToString("dd/MM/yyyy"))</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Fecha de Entrega Pública" Width="150">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Entrega Pública" Campo="FEC_ENTREGA_PUBLICA" Activo="@(_ordenColumna == 5)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(5))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(5)" ValorDe="@(x=>x.FEC_ENTREGA_PUBLICA?.ToString("dd/MM/yyyy") ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(5)" ValoresActivosChanged="@(v=>Filtro(5,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@(context.Item.FEC_ENTREGA_PUBLICA?.ToString("dd/MM/yyyy"))</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Dirección" Width="260">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Dirección" Campo="DES_DIRECCION" Activo="@(_ordenColumna == 6)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(6))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(6)" ValorDe="@(x=>TextoDireccion(x))"
                                            ValoresActivos="_filtros.GetValueOrDefault(6)" ValoresActivosChanged="@(v=>Filtro(6,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@TextoDireccion(context.Item)</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Moneda" Width="120">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Moneda" Campo="DES_MONEDA" Activo="@(_ordenColumna == 7)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(7))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(7)" ValorDe="@(x=>x.DES_MONEDA ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(7)" ValoresActivosChanged="@(v=>Filtro(7,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_MONEDA</CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Valor Total" Width="140" CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Valor Total" Campo="VAL_TOTAL" Activo="@(_ordenColumna == 8)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(8))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(8)" ValorDe="@(x=>x.VAL_TOTAL?.ToString("N2") ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(8)" ValoresActivosChanged="@(v=>Filtro(8,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@(context.Item.VAL_TOTAL?.ToString("N2"))</span></CellTemplate>
            </TemplateColumn>

            <TemplateColumn Sortable="false" Title="Estado" Width="140">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Estado" Campo="DES_ESTADO" Activo="@(_ordenColumna == 9)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(9))" />
                        <FiltroExcelColumna T="PedidoComercial" ItemsBase="@Base(9)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(9)" ValoresActivosChanged="@(v=>Filtro(9,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.DES_ESTADO))
                    {
                        <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                    }
                </CellTemplate>
            </TemplateColumn>

            @* Atención de la orden de compra: lo atendido (recibido) sobre lo pedido, como en el reporte de órdenes de compra. Solo en la clase ORDCM. *@
            <TemplateColumn Sortable="false" Title="Atención" Width="170" Hidden="@(!EsOrdenCompra)">
                <CellTemplate>
                    @{ var at = AtencionDe(context.Item); }
                    @if (_atencionError is not null)
                    {
                        <span title="@_atencionError" data-atencion-error="true" style="opacity:.6;">—</span>
                    }
                    else if (at is not null)
                    {
                        <div title="@($"Atendido {at.CAN_ATENDIDA:0.######} de {at.CAN_PEDIDA:0.######} · {at.NUM_LINEAS} línea(s)")" data-atencion="@at.NUM_PEDIDO_COMERCIAL.ToString("0")" style="min-width:120px;">
                            <MudProgressLinear Value="@((double)Math.Min(at.POR_ATENDIDO, 100m))" Color="@ColorAtencion(at.POR_ATENDIDO)" Size="Size.Medium" Rounded="true" />
                            <span class="mono" style="font-size:.75rem;" data-atencion-texto="true">@at.POR_ATENDIDO.ToString("0.##")%</span>
                        </div>
                    }
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" Fila="@item"
                                     Filtro="@(b => !(b.FLG_ACCION_DELETE == true && item.FLG_POR_REQUERIMIENTO == true))"
                                     CodTipoEstado="@TipoEstadoDe(item)" CodEstadoActual="@item.COD_ESTADO" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="PedidoComercial" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>
</MudTabPanel>

<MudTabPanel Text="@_tituloDocumento" Icon="@Icons.Material.Filled.Description" Disabled="@(!_enDocumento)">
    @if (_enDocumento)
    {
        <PedidoComercialDocumento @ref="_doc" Item="_docItem" Modo="_docModo"
                                   CodClaseOperacion="@_codClaseOperacion"
                                   CodTipoOperacionSugerido="@_codTipoOperacionSeleccionado"
                                   CodAplicacion="@CodAplicacion"
                                   CodOpcionAplicacion="@CodOpcionAplicacion"
                                   OnCerrar="CerrarDocumento"
                                   OnLineasCambiadas="@(async () => { if (_panelReq is not null) await _panelReq.RefrescarAsync(); })" />
    }
</MudTabPanel>

@* Los requerimientos que originan el pedido, al lado del documento y no adentro: es
   información del pedido, pero se trabaja aparte — se eligen, se ven sus líneas y recién
   después se vuelcan. El panel necesita crear líneas en el documento, así que se le pasa
   la referencia al componente de al lado. *@
<MudTabPanel Text="Requerimientos" Icon="@Icons.Material.Filled.Assignment" Disabled="@(!_enDocumento)">
    @if (_enDocumento && _doc is not null)
    {
        <RequerimientosPedidoPanel @ref="_panelReq"
                                   CodClaseOperacion="@_doc.ClaseOperacionActual"
                                   CodTipoOperacion="@_doc.TipoOperacionActual"
                                   NumPedidoComercial="@_doc.NumPedidoActual"
                                   SoloLectura="@_doc.EsSoloLectura"
                                   OnIncorporar="_doc.IncorporarRequerimientosAsync"
                                   OnRevertir="_doc.QuitarLineasAsync"
                                   OnCambio="@(() => _doc.MarcarCambio())"
                                   OnPedidoCambiado="@(async () => { if (_doc is not null) await _doc.RecargarDetalleAsync(); })"
                                   OnIncorporado="@(() => _tab = 1)" />
    }
</MudTabPanel>

@* Cronograma de entregas: cuándo se entrega cada línea del pedido y cuánto. Igual que
   Requerimientos, sólo tiene sentido con un documento abierto, y toma del documento los
   tres códigos que identifican al pedido. *@
<MudTabPanel Text="Cronograma" Icon="@Icons.Material.Filled.EventAvailable" Disabled="@(!_enDocumento)">
    @if (_enDocumento && _doc is not null)
    {
        <KONSolutions.Web.Pages.Logistica.PedidosComercialesCronogramaEntregas
            CodClaseOperacion="@_doc.ClaseOperacionActual"
            CodTipoOperacion="@_doc.TipoOperacionActual"
            NumPedidoComercial="@_doc.NumPedidoActual"
            SoloLectura="@_doc.EsSoloLectura" />
    }
</MudTabPanel>

@* Comparativo: la pestaña aparece SOLO si la opción tiene configurado el sub-módulo
   correspondiente (Seguridad › Opciones de Aplicaciones). Proformas de Compra lo tiene
   ("Comparativo de Proformas"); Órdenes de Compra no. Como las dos opciones abren este
   mismo .razor, sin este control la pestaña salía también en Órdenes, que era el bug.

   Deshabilitada SOLO mientras el diálogo del documento está en modo edición: una vez
   grabado (o si se abrió en consulta) se habilita. Antes esto dependía de
   _doc.EsSoloLectura sin más, y quedaba muerta al volver del documento. *@
@if (_muestraComparativo)
{
    <MudTabPanel Text="Comparativo" Icon="@Icons.Material.Filled.Balance" Disabled="@(_enDocumento && _doc is not null && !_doc.EsSoloLectura)">
        <ComparativoPanel CodClaseOperacion="@_codClaseOperacion" />
    </MudTabPanel>
}
</MudTabs>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    /// <summary>Nombre de la opción de menú con la que se abrió esta pantalla, en cascada
    /// desde WorkspaceTabHost. Esta misma pantalla sirve a Proformas, Órdenes de Compra y
    /// Pedidos de Venta (se diferencian por clase de operación), así que la solapa de la
    /// lista muestra el nombre de la opción abierta en vez del genérico.
    /// Si la pantalla se abriera fuera del workspace no llega nada y se usa el genérico.</summary>
    [CascadingParameter(Name = "TituloOpcion")] public string? TituloOpcion { get; set; }

    /// <summary>La pestaña Comparativo depende de la configuración de la opción, no del
    /// .razor: se muestra solo si esta opción tiene el sub-módulo cargado en el menú. Se
    /// calcula en OnParametersSet y no en una propiedad para no consultar el menú en cada
    /// render de la pantalla.</summary>
    private bool _muestraComparativo;

    private string _tituloLista => string.IsNullOrWhiteSpace(TituloOpcion)
        ? "Pedidos Comerciales"
        : TituloOpcion;

    /// <summary>Encabezado de la columna de número de pedido: "N° de <título de la opción>"
    /// (ej. "N° de Proformas de Compra", "N° de Órdenes de Compra") en vez del genérico
    /// "N° Pedido" — esta misma grilla la reutilizan Proformas/Órdenes/Pedidos de Venta,
    /// diferenciadas solo por CodClaseOperacion, así que toma el mismo título de opción que
    /// ya usa la solapa de la lista (_tituloLista).</summary>
    private string _tituloColumnaPedido => $"N° de {_tituloLista}";

    /// <summary>¿Es la opción de Proformas? (clase de operación PRFRM). Muestra la columna Nº Proforma Proveedor.</summary>
    private bool EsProforma => string.Equals(_codClaseOperacion, "PRFRM", StringComparison.OrdinalIgnoreCase);
    private bool EsOrdenCompra => string.Equals(_codClaseOperacion, "ORDCM", StringComparison.OrdinalIgnoreCase);

    // ── Atención de las órdenes de compra (la barra de la grilla) ─────────────────────────
    private Dictionary<(string Tipo, decimal Num), PedidoComercialAtencion> _atencion = new();
    private string? _atencionError;

    private PedidoComercialAtencion? AtencionDe(PedidoComercial x)
        => x.NUM_PEDIDO_COMERCIAL is { } n && _atencion.TryGetValue(((x.COD_TIPO_OPERACION ?? "").Trim(), n), out var a) ? a : null;

    private static Color ColorAtencion(decimal porcentaje)
        => porcentaje >= 100m ? Color.Success : porcentaje > 0m ? Color.Warning : Color.Default;

    /// <summary>Trae lo atendido de las órdenes del tipo elegido. Si falla no se rompe la grilla: la celda dice «—» y su ayuda, el motivo.</summary>
    private async Task CargarAtencionAsync()
    {
        _atencion = new(); _atencionError = null;
        if (!EsOrdenCompra || string.IsNullOrWhiteSpace(_codTipoOperacionSeleccionado)) return;
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComercialesAtencion}?codClaseOperacion={Uri.EscapeDataString(_codClaseOperacion!)}&codTipoOperacion={Uri.EscapeDataString(_codTipoOperacionSeleccionado)}";
            using var resp = await Http.GetAsync(url);
            KONSolutions.Shared.Common.ApiResponse<List<PedidoComercialAtencion>>? r = null;
            try { r = await resp.Content.ReadFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<PedidoComercialAtencion>>>(); } catch { }
            if (resp.IsSuccessStatusCode && r is { Success: true })
                _atencion = (r.Data ?? new()).ToDictionary(a => ((a.COD_TIPO_OPERACION ?? "").Trim(), a.NUM_PEDIDO_COMERCIAL), a => a);
            else
                _atencionError = "No se pudo leer la atención: " + (!string.IsNullOrWhiteSpace(r?.Message) ? r!.Message : $"la API respondió HTTP {(int)resp.StatusCode}");
        }
        catch (Exception ex) { _atencionError = "No se pudo leer la atención: " + ex.Message; }
    }

    // Resuelto desde DES_PARAMETRO de la opción — igual mecanismo que Entidades/Clientes/
    // Proveedores. Admite "COD_CLASE_OPERACION = 'PRFRM'" (con o sin "@" adelante).
    private static readonly System.Text.RegularExpressions.Regex _reParametroClaseOperacion =
        new(@"COD_CLASE_OPERACION\s*=\s*'([^']+)'", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private string? _codClaseOperacion;
    private List<KONSolutions.Shared.Common.ComboboxItem> _tiposOperacion = new();
    private string? _codTipoOperacionSeleccionado;

    /// <summary>Lo que los botones de cabecera con reporte (un listado) reciben de la pantalla: la clase de la
    /// opción y el tipo de operación elegido. Llenan los parámetros @COD_CLASE_OPERACION y @COD_TIPO_OPERACION.</summary>
    private Dictionary<string, string?> ContextoReportes => new(StringComparer.OrdinalIgnoreCase)
    {
        ["COD_CLASE_OPERACION"] = _codClaseOperacion,
        ["COD_TIPO_OPERACION"]  = _codTipoOperacionSeleccionado
    };

    private class TipoOperacionLite
    {
        public string COD_TIPO_OPERACION { get; set; } = "";
        public string DES_TIPO_OPERACION { get; set; } = "";
        /// <summary>Tipo de estado que gobierna el flujo del documento. NO es un dato de la
        /// fila del pedido: vive en ESTANDAR.TIPOS_OPERACION ("Tipo de estado relacionado"),
        /// igual que lo resuelve PedidoComercialDocumento.razor.</summary>
        public int? COD_TIPO_ESTADO_RELACIONADO { get; set; }
    }

    /// <summary>COD_TIPO_OPERACION → COD_TIPO_ESTADO_RELACIONADO, para poder validar el flujo
    /// de los botones de la grilla. Sin esto, AccionesBotones recibía CodTipoEstado=null
    /// (PEDIDOS_COMERCIALES no trae esa columna) y, por su cláusula de salida temprana,
    /// EJECUTABA la acción sin llamar nunca a PROC_ESTANDAR_OPCIONES_PROCESOS_ESTADOS_
    /// FLUJOS_DEPENDENCIA_VALIDA — de ahí que un pedido ANULADO se dejara modificar.</summary>
    private readonly Dictionary<string, int?> _tipoEstadoPorTipoOperacion = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Tipo de estado a usar para validar los botones de una fila: el propio del
    /// registro si el SP lo devuelve, y si no el del tipo de operación de esa fila.</summary>
    private int? TipoEstadoDe(PedidoComercial x)
        => x.COD_TIPO_ESTADO
        ?? (!string.IsNullOrWhiteSpace(x.COD_TIPO_OPERACION)
            && _tipoEstadoPorTipoOperacion.TryGetValue(x.COD_TIPO_OPERACION, out var te) ? te : null);

    private async Task ResolverClaseOperacionDesdeOpcionAsync()
    {
        if (string.IsNullOrWhiteSpace(CodAplicacion) || string.IsNullOrWhiteSpace(CodOpcionAplicacion)) return;
        try
        {
            var url = $"{ApiRoutes.Seguridad.AplicacionesOpciones}/{Uri.EscapeDataString(CodAplicacion)}/{Uri.EscapeDataString(CodOpcionAplicacion)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<KONSolutions.Shared.Models.Seguridad.AplicacionesOpcionesFormDto>>(url);
            var parametro = r?.Data?.DES_PARAMETRO;
            if (string.IsNullOrWhiteSpace(parametro)) return;

            var m = _reParametroClaseOperacion.Match(parametro);
            _codClaseOperacion = m.Success ? m.Groups[1].Value : parametro.Trim();
        }
        catch { /* sin parámetro accesible, la grilla queda vacía hasta que se configure */ }
    }

    /// <summary>Texto de la Dirección de Entrega. Lo resuelve el SP en
    /// DES_DIRECCION_SUCURSAL: elige la dirección de la sucursal o la de la entidad según el
    /// FLG_POSITIVO del tipo de operación.
    ///
    /// Antes esto lo decidía la pantalla mirando qué columna tenía valor, y por eso podía
    /// mostrar un código. Que lo resuelva la consulta es mejor: es un dato del negocio, no
    /// una decisión de presentación, y así la grilla y cualquier reporte muestran lo mismo.
    /// Se conserva DES_DIRECCION como respaldo por si el SP todavía no está actualizado.</summary>
    private static string TextoDireccion(PedidoComercial x)
        => !string.IsNullOrWhiteSpace(x.DES_DIRECCION_SUCURSAL) ? x.DES_DIRECCION_SUCURSAL
         : (x.DES_DIRECCION ?? "");

    /// <summary>Nombre de la entidad: el comercial si lo tiene, si no el completo. Está
    /// como método para que la celda, el filtro y el orden usen exactamente lo mismo —
    /// tenerlo escrito por separado en cada lugar fue justo lo que hizo que la columna
    /// Dirección mostrara un código durante dos entregas.</summary>
    private static string TextoEntidad(PedidoComercial x)
        => string.IsNullOrWhiteSpace(x.DES_COMERCIAL) ? (x.DES_NOMBRE_COMPLETO ?? "") : x.DES_COMERCIAL;

    /// <summary>Descripción del tipo de operación a partir de su código. Si todavía no
    /// cargaron los tipos, o el pedido apunta a uno que ya no está en la lista, devuelve el
    /// código: es preferible a dejar la celda vacía.</summary>
    private string DescripcionTipoOperacion(string? codTipoOperacion)
    {
        if (string.IsNullOrWhiteSpace(codTipoOperacion)) return "";
        return _tiposOperacion.FirstOrDefault(t => t.Id == codTipoOperacion)?.Texto ?? codTipoOperacion;
    }

    private async Task CargarTiposOperacionAsync()
    {
        if (string.IsNullOrWhiteSpace(_codClaseOperacion)) return;
        try
        {
            var url = $"{ApiRoutes.Estandar.TiposOperacion}?codClaseOperacion={Uri.EscapeDataString(_codClaseOperacion)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TipoOperacionLite>>>(url);
            var tipos = r?.Data ?? new();
            _tiposOperacion = tipos.Select(t => new KONSolutions.Shared.Common.ComboboxItem { Id = t.COD_TIPO_OPERACION, Texto = t.DES_TIPO_OPERACION }).ToList();

            // Se guarda el tipo de estado de cada tipo de operación para validar el flujo de
            // los botones de la grilla (ver TipoEstadoDe / _tipoEstadoPorTipoOperacion).
            _tipoEstadoPorTipoOperacion.Clear();
            foreach (var t in tipos.Where(t => !string.IsNullOrWhiteSpace(t.COD_TIPO_OPERACION)))
                _tipoEstadoPorTipoOperacion[t.COD_TIPO_OPERACION] = t.COD_TIPO_ESTADO_RELACIONADO;

            _codTipoOperacionSeleccionado = _tiposOperacion.FirstOrDefault()?.Id;
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(PedidosComerciales), nameof(CargarTiposOperacionAsync)); }
    }

    private async Task OnCambioTipoOperacion(string? valor)
    {
        _codTipoOperacionSeleccionado = valor;
        await Load();
    }

    private List<PedidoComercial> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<PedidoComercial> Ordenar(List<PedidoComercial> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => DescripcionTipoOperacion(x.COD_TIPO_OPERACION)).ToList() : items.OrderByDescending(x => DescripcionTipoOperacion(x.COD_TIPO_OPERACION)).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_COMPROBANTE_PAGO).ToList() : items.OrderByDescending(x => x.DES_TIPO_COMPROBANTE_PAGO).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.NUM_PEDIDO_COMERCIAL).ToList() : items.OrderByDescending(x => x.NUM_PEDIDO_COMERCIAL).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => TextoEntidad(x)).ToList() : items.OrderByDescending(x => TextoEntidad(x)).ToList(),
        // Las fechas y el total se ordenan por su VALOR, no por el texto formateado: si no,
        // 09/12 iría antes que 28/08 y 9,00 antes que 100,00.
        4 => _ordenAscendente ? items.OrderBy(x => x.FEC_PEDIDO).ToList() : items.OrderByDescending(x => x.FEC_PEDIDO).ToList(),
        5 => _ordenAscendente ? items.OrderBy(x => x.FEC_ENTREGA_PUBLICA).ToList() : items.OrderByDescending(x => x.FEC_ENTREGA_PUBLICA).ToList(),
        6 => _ordenAscendente ? items.OrderBy(x => TextoDireccion(x)).ToList() : items.OrderByDescending(x => TextoDireccion(x)).ToList(),
        7 => _ordenAscendente ? items.OrderBy(x => x.DES_MONEDA).ToList() : items.OrderByDescending(x => x.DES_MONEDA).ToList(),
        8 => _ordenAscendente ? items.OrderBy(x => x.VAL_TOTAL).ToList() : items.OrderByDescending(x => x.VAL_TOTAL).ToList(),
        9 => _ordenAscendente ? items.OrderBy(x => x.DES_ESTADO).ToList() : items.OrderByDescending(x => x.DES_ESTADO).ToList(),
        10 => _ordenAscendente ? items.OrderBy(x => x.DES_PEDIDO_COMERCIAL).ToList() : items.OrderByDescending(x => x.DES_PEDIDO_COMERCIAL).ToList(),
        11 => _ordenAscendente ? items.OrderBy(x => x.NUM_DOCUMENTO).ToList() : items.OrderByDescending(x => x.NUM_DOCUMENTO).ToList(),
        _ => items
    };
    private List<PedidoComercial> _visibles => Ordenar(Aplicar(_items, -1));
    private List<PedidoComercial> Base(int col) => Aplicar(_items, col);

    private List<PedidoComercial> Aplicar(List<PedidoComercial> src, int ex)
    {
        // Sin filtros activos no hay nada que recorrer, y ese es el caso normal: la
        // grilla arranca sin filtros. Cada encabezado llama a este método en CADA
        // redibujado, así que sin esta salida un solo clic recorría la lista entera
        // una vez por columna.
        var hayFiltroKon = false;
        foreach (var (kc, kv) in _filtros) if (kc != ex && kv is not null) { hayFiltroKon = true; break; }
        if (!hayFiltroKon) return src;

        IEnumerable<PedidoComercial> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(DescripcionTipoOperacion(x.COD_TIPO_OPERACION))),
                1 => q.Where(x => v.Contains(x.DES_TIPO_COMPROBANTE_PAGO ?? "")),
                2 => q.Where(x => v.Contains(x.NUM_PEDIDO_COMERCIAL?.ToString() ?? "")),
                3 => q.Where(x => v.Contains(TextoEntidad(x))),
                4 => q.Where(x => v.Contains(x.FEC_PEDIDO?.ToString("dd/MM/yyyy") ?? "")),
                5 => q.Where(x => v.Contains(x.FEC_ENTREGA_PUBLICA?.ToString("dd/MM/yyyy") ?? "")),
                6 => q.Where(x => v.Contains(TextoDireccion(x))),
                7 => q.Where(x => v.Contains(x.DES_MONEDA ?? "")),
                8 => q.Where(x => v.Contains(x.VAL_TOTAL?.ToString("N2") ?? "")),
                9 => q.Where(x => v.Contains(x.DES_ESTADO ?? "")),
                10 => q.Where(x => v.Contains(x.DES_PEDIDO_COMERCIAL ?? "")),
                11 => q.Where(x => v.Contains(x.NUM_DOCUMENTO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }
    private async Task Filtrar() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("COMERCIAL", "PedidosComerciales");

        // La pestaña Comparativo existe solo si la opción tiene ese sub-módulo configurado.
        // Proformas de Compra lo tiene, Órdenes de Compra no — y las dos abren esta misma
        // pantalla, así que sin este control salía en ambas.
        _muestraComparativo = MenuSvc.TieneSubOpcion(CodAplicacion, CodOpcionAplicacion, "COMPARATIVO");

        await ResolverClaseOperacionDesdeOpcionAsync();
        await CargarTiposOperacionAsync();
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("COMERCIAL.PEDIDOS_COMERCIALES", _onCambio);
    }

    private async Task Load() { _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search); }

    private async Task<List<PedidoComercial>> Fetch()
    {
        if (string.IsNullOrWhiteSpace(_codClaseOperacion) || string.IsNullOrWhiteSpace(_codTipoOperacionSeleccionado)) return new();
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComerciales}?codClaseOperacion={Uri.EscapeDataString(_codClaseOperacion)}&codTipoOperacion={Uri.EscapeDataString(_codTipoOperacionSeleccionado)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<PedidoComercial>>>(url);
            await CargarAtencionAsync();
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(PedidosComerciales), nameof(Fetch));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(PedidosComerciales));
            return new();
        }
    }

    private async Task<List<PedidoComercial>> FetchSearch(string s)
    {
        if (string.IsNullOrWhiteSpace(_codClaseOperacion) || string.IsNullOrWhiteSpace(_codTipoOperacionSeleccionado)) return new();
        try
        {
            var url = $"{ApiRoutes.Comercial.PedidosComerciales}/search?codClaseOperacion={Uri.EscapeDataString(_codClaseOperacion)}&codTipoOperacion={Uri.EscapeDataString(_codTipoOperacionSeleccionado)}&search={Uri.EscapeDataString(s)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<PedidoComercial>>>(url);
            await CargarAtencionAsync();
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(PedidosComerciales), nameof(FetchSearch));
            await ErrorDialogHelper.MostrarAvisoAsync("No se pudo cargar la información. Ver detalle en el log de errores.", DialogService, nameof(PedidosComerciales));
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b) { if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create); return Task.CompletedTask; }
    private Task OnAccionGrilla(PedidoComercial item, BotonTreeviewItem b)
    {
        // Botones propios de la pantalla, antes que los CRUD: un botón de acción puede
        // traer también GET marcado y caería en la rama de consulta.
        if (ReversionDe(b, item.NUM_PEDIDO_COMERCIAL) is { } rv) return RevertirAsync(item, rv);

        // Del más específico al más genérico. Un botón de Modificar suele traer
        // marcados GET y PUT a la vez (para editar primero hay que leer), y un
        // Eliminar suele traer GET y DELETE: preguntando por GET primero, esos dos
        // entraban por la rama de consulta y el lápiz y el tacho abrean en sólo
        // lectura. Con DELETE y PUT antes, cada botón hace lo que dice su nombre.
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        // Sin esto, un botón propio que no está conectado no hacía nada y no avisaba.
        return ErrorDialogHelper.MostrarAvisoAsync(
            $"El botón \"{b.DES_BOTON_OPCION ?? b.COD_BOTON_OPCION}\" (opción {b.COD_OPCION_APLICACION}, código {b.COD_BOTON_OPCION}) todavía no tiene una acción conectada en esta pantalla.",
            DialogService, nameof(PedidosComerciales), "Acción pendiente");
    }

    /// <summary>Qué hace un botón de reversión. Ruta = endpoint de la API.</summary>
    public record Reversion(string Ruta, string Titulo, string Pregunta, string Exito);

    /// <summary>Botones de reversión, por opción + código: esta pantalla sirve a varias
    /// opciones de menú y cada una numera sus botones por su cuenta.
    ///   020101 / 08 · Órdenes de Compra · REVERTIR SELECCION COMPARATIVA (clave de la orden)
    ///   020100 / 08 · Proformas de Compra · REVERTIR ORDEN DE COMPRA (clave de la proforma)
    /// Null si el botón no es de reversión.</summary>
    public static Reversion? ReversionDe(BotonTreeviewItem b, decimal? num) =>
        (b.COD_OPCION_APLICACION?.Trim(), b.COD_BOTON_OPCION?.Trim()) switch
        {
            ("020101", "08") => new(ApiRoutes.Comercial.PedidosComercialesCalculoRevertir, "Revertir orden de compra",
                $"Se anulará la orden de compra N° {num}, y la proforma de origen, las proformas rechazadas " +
                "y los requerimientos volverán a su estado anterior. ¿Continuar?", "Orden de compra revertida."),
            ("020100", "08") => new(ApiRoutes.Comercial.PedidosComercialesCalculoRevertirProforma, "Revertir proforma",
                $"Se anulará la orden de compra generada desde la proforma N° {num}, y la proforma, las proformas " +
                "rechazadas y los requerimientos volverán a su estado anterior. ¿Continuar?", "Proforma revertida."),
            _ => null
        };

    private async Task RevertirAsync(PedidoComercial item, Reversion rv)
    {
        var ok = await DialogService.ShowMessageBox(rv.Titulo, rv.Pregunta, yesText: "Revertir", cancelText: "Cancelar");
        if (ok != true) return;

        var url = $"{rv.Ruta}" +
                  $"/{Uri.EscapeDataString(item.COD_CLASE_OPERACION)}" +
                  $"/{Uri.EscapeDataString(item.COD_TIPO_OPERACION)}" +
                  $"/{(item.NUM_PEDIDO_COMERCIAL ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        var resp = await Http.PostAsync(url, null);
        if (!resp.IsSuccessStatusCode)
        {
            await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(PedidosComerciales),
                nameof(RevertirAsync), $"No se pudo completar: {rv.Titulo.ToLower()}");
            return;
        }
        Snackbar.Add(rv.Exito, Severity.Success);
        await Load();
        StateHasChanged();
    }

    private int _tab;
    private bool _enDocumento;
    /// <summary>El documento abierto. Lo necesita la pestaña de Requerimientos, que vive
    /// al lado y le pide crear las líneas del pedido.</summary>
    private PedidoComercialDocumento? _doc;
    /// <summary>La ficha de requerimientos. Las dos se avisan entre ellas a través de
    /// esta pantalla: borrar una línea puede deshacer vínculos, y deshacer un vínculo
    /// puede cambiar lo que el documento tiene cargado.</summary>
    private RequerimientosPedidoPanel? _panelReq;
    private PedidoComercial? _docItem;
    private CrudModo _docModo = CrudModo.Create;

    private string _tituloDocumento => !_enDocumento ? "Documento" : _docModo switch
    {
        CrudModo.Create => "Nuevo",
        CrudModo.Delete => $"Eliminar N° {_docItem?.NUM_PEDIDO_COMERCIAL}",
        CrudModo.Read   => $"Consultar N° {_docItem?.NUM_PEDIDO_COMERCIAL}",
        _               => $"Editar N° {_docItem?.NUM_PEDIDO_COMERCIAL}"
    };

    /// <summary>Pasa a la solapa del documento. La lista queda deshabilitada mientras tanto.</summary>
    private Task Abrir(PedidoComercial? item, CrudModo modo)
    {
        _docItem = item;
        _docModo = modo;
        _enDocumento = true;
        _tab = 1;
        return Task.CompletedTask;
    }

    /// <summary>Vuelve a la lista y apaga la solapa del documento. Recarga solo si se grabó
    /// algo, que es lo que informa el componente al cerrarse.</summary>
    private async Task CerrarDocumento(bool huboCambios)
    {
        _enDocumento = false;
        _docItem = null;
        _tab = 0;
        // El componente sale del árbol (el @if de la pestaña Documento pasa a false), pero
        // Blazor no limpia solo el campo de un @ref al remover el componente. Sin este reset,
        // _doc quedaba apuntando a la instancia cerrada, y "Comparativo" (que ahora depende
        // de _doc.EsSoloLectura) se habilitaba o no según el estado congelado del último
        // documento, en vez de reflejar que no hay ninguno abierto.
        _doc = null;
        if (huboCambios) await Load();
    }

    public void Dispose()
        => Cambios.Desuscribir("COMERCIAL.PEDIDOS_COMERCIALES", _onCambio ?? (() => Task.CompletedTask));
}
