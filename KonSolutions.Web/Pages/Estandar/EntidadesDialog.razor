    /// <summary>Trae la Entidad fresca desde SHOWBYID — evita mostrar datos desactualizados
    /// de la grilla al Modificar/Eliminar/Ver.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<Entidad>($"{ApiRoutes.Estandar.Entidades}/{Uri.EscapeDataString(_model.COD_ENTIDAD?.ToString() ?? "")}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }
    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();

        // PROC_ESTANDAR_ENTIDADES_LOADCOMBOS: tipos de documento de identidad y tipos de
        // medio de contacto en un solo viaje (antes eran dos GET independientes). TiposUso
        // no está entre los result sets de este SP, así que sigue como pedido aparte.
        var tLoadcombos = Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<KONSolutions.Shared.Models.Estandar.EntidadesLoadCombosResult>>(
            $"{ApiRoutes.Estandar.EntidadesLoadcombos}?codTipoEstado={_model.COD_TIPO_ESTADO ?? 0}");
        // SHOWCOMBOX de TIPOS_USO no alias sus columnas como Id/Texto (igual que
        // ClasesDesarrollo), así que se trae el DTO propio y se mapea a ComboboxItem aquí.
        var tTiposUso = Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<KONSolutions.Shared.Models.Estandar.TiposUso>>>(ApiRoutes.Estandar.TiposUsoCombobox);
        var tCfg = CfgSvc.GetCurrentAsync();
        var tParaDepender = CargarEntidadesParaDependerAsync();
        // Combos de la pestaña Información Financiera: se cargan siempre (no solo en
        // Editar) para no bloquear el resto del OnInitializedAsync con un await de más.
        var tBancos = Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Finanzas.BancosCombobox);
        var tTiposCuentaBancaria = Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Finanzas.TiposCuentasBancariasCombobox);
        var tMonedas = Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Estandar.MonedasCombobox);
        await Task.WhenAll(tLoadcombos, tTiposUso, tCfg, tParaDepender, tBancos, tTiposCuentaBancaria, tMonedas);
        var loadcombos = (await tLoadcombos)?.Data;
        _tiposDoc = loadcombos?.TiposDocumentoIdentidad ?? new();
        _tiposMedioContacto = loadcombos?.TiposMedioContacto ?? new();
        _tiposUso = ((await tTiposUso)?.Data ?? new())
            .Select(t => new ComboboxItem { Id = t.COD_TIPO_USO, Texto = t.DES_TIPO_USO }).ToList();
        _cfg = await tCfg;
        _bancos = await tBancos ?? new();
        _tiposCuentaBancaria = await tTiposCuentaBancaria ?? new();
        _monedas = await tMonedas ?? new();

        // Alta nueva con Domiciliado por defecto (true): hereda el País de Configuración General.
        if (_esNuevo && _model.FLG_DOMICILIADO == true)
        {
            _model.COD_PAIS = _cfg?.COD_PAIS ?? "";
            _model.DES_PAIS = _cfg?.DES_PAIS ?? "";
        }

        // Tipos de Entidad, Documentos de Identidad y Medios de Contacto (solo aplica en
        // Editar/Ver/Eliminar, cuando ya existe COD_ENTIDAD).
        if (!_esNuevo)
        {
            await CargarTiposEntidadAsync();
            await CargarDocumentosAsync();
            await CargarMediosContactoAsync();
            await CargarUnidadesComercialesAsync();
            await CargarDireccionesAsync();
            await CargarCuentasBancariasAsync();
            if (BloquearTipoEntidad && CodTipoEntidadFijo == "CLI") await CargarAsesoresComercialesAsync();
            await CargarInformacionComercialAsync();
        }
    }

