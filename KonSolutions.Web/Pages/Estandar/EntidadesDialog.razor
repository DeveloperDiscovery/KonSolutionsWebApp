    private async Task CargarUnidadesComercialesAsync()
    {
        if (_model.COD_ENTIDAD is null) return;
        var lista = await Http.SafeGetAsync<List<KONSolutions.Shared.Models.Comercial.EntidadesUnidadesComerciales>>(
            $"{ApiRoutes.Comercial.EntidadesUnidadesComerciales}?codEntidad={_model.COD_ENTIDAD}") ?? new();
        _unidadesComerciales = lista.Select(u => new UnidadComercialRow
        {
            CodUnidadComercial = u.COD_UNIDAD_COMERCIAL,
            DesUnidadComercial = u.DES_UNIDAD_COMERCIAL,
            CodPais = u.COD_PAIS,
            CodTipoEstado = u.COD_TIPO_ESTADO,
            CodEstado = u.COD_ESTADO,
            DesDireccion = u.DES_DIRECCION,
            EsNueva = false,
            CodUsuarioRegistro = u.COD_USUARIO_REGISTRO,
            CodEstacionRegistro = u.COD_ESTACION_REGISTRO,
            FecRegistro = u.FEC_REGISTRO,
            CodUsuarioActualizacion = u.COD_USUARIO_ACTUALIZACION,
            CodEstacionActualizacion = u.COD_ESTACION_ACTUALIZACION,
            FecActualizacion = u.FEC_ACTUALIZACION
        }).ToList();

        // PROC_COMERCIAL_ENTIDADES_UNIDADES_COMERCIALES_SHOWALL solo trae el código del país,
        // no el nombre (no hace JOIN contra ESTANDAR.PAISES) — sin esto el combo se ve vacío
        // después de recargar aunque el país sí esté guardado. Se resuelve aquí, aparte.
        await Task.WhenAll(_unidadesComerciales
            .Where(r => !string.IsNullOrWhiteSpace(r.CodPais))
            .Select(async r => r.DesPais = await ResolverTextoPaisAsync(r.CodPais!) ?? ""));
    }

    private async Task<string?> ResolverTextoPaisAsync(string codPais)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<KONSolutions.Shared.Models.Estandar.Pais>>($"{ApiRoutes.Estandar.Paises}/{Uri.EscapeDataString(codPais)}");
            return r?.Data?.DES_PAIS;
        }
        catch { return null; }
    }

