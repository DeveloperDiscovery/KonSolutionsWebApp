    private List<ComboboxItem> _clasesOperacionInfoCom = new(), _monedasInfoCom = new(),
                               _condicionesPagoInfoCom = new(), _formasPagoInfoCom = new();
    // Tipos de operación por clase, cacheados: la columna Tipo depende de lo que se elija en
    // la columna Clase de la misma fila, y dos filas pueden estar en clases distintas.
    private readonly Dictionary<string, List<ComboboxItem>> _tiposPorClaseInfoCom = new();

    private List<ComboboxItem> TiposDeClaseInfoCom(string? codClaseOperacion)
        => !string.IsNullOrWhiteSpace(codClaseOperacion) && _tiposPorClaseInfoCom.TryGetValue(codClaseOperacion, out var l)
            ? l : new();

    private async Task CargarCombosInfoComAsync()
    {
        await Task.WhenAll(
            CargarComboInfoComAsync(ApiRoutes.Estandar.ClasesOperacionCombobox, l => _clasesOperacionInfoCom = l),
            CargarComboInfoComAsync(ApiRoutes.Estandar.MonedasCombobox,         l => _monedasInfoCom = l),
            CargarComboInfoComAsync(ApiRoutes.Comercial.CondicionesPagoCombobox, l => _condicionesPagoInfoCom = l),
            CargarComboInfoComAsync(ApiRoutes.Comercial.FormasPagoCombobox,      l => _formasPagoInfoCom = l));
    }

    private async Task CargarComboInfoComAsync(string url, Action<List<ComboboxItem>> asignar)
    {
        try { var r = await Http.GetFromJsonAsync<ApiResponse<List<ComboboxItem>>>(url); asignar(r?.Data ?? new()); }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(EntidadesDialog), nameof(CargarComboInfoComAsync)); }
    }

    private async Task CargarTiposDeClaseInfoComAsync(string codClaseOperacion)
    {
        if (string.IsNullOrWhiteSpace(codClaseOperacion) || _tiposPorClaseInfoCom.ContainsKey(codClaseOperacion)) return;
        try
        {
            var url = $"{ApiRoutes.Estandar.TiposOperacion}?codClaseOperacion={Uri.EscapeDataString(codClaseOperacion)}";
            var r = await Http.GetFromJsonAsync<ApiResponse<List<TipoOperacionInfoComLite>>>(url);
            _tiposPorClaseInfoCom[codClaseOperacion] = (r?.Data ?? new())
                .Select(t => new ComboboxItem { Id = t.COD_TIPO_OPERACION, Texto = t.DES_TIPO_OPERACION }).ToList();
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(EntidadesDialog), nameof(CargarTiposDeClaseInfoComAsync)); }
    }

    private class TipoOperacionInfoComLite
    {
        public string COD_TIPO_OPERACION { get; set; } = "";
        public string DES_TIPO_OPERACION { get; set; } = "";
    }

    private async Task CambiarClaseFilaInfoComAsync(InformacionComercialRow row, string? codClaseOperacion)
    {
        row.CodClaseOperacion = codClaseOperacion;
        // El tipo elegido pertenecía a la clase anterior: dejarlo sería grabar un par
        // (clase, tipo) que no existe.
        row.CodTipoOperacion = null;
        await CargarTiposDeClaseInfoComAsync(codClaseOperacion ?? "");
    }

    private async Task CargarInformacionComercialAsync()
    {
        if (_model.COD_ENTIDAD is null) { _informacionComercial = new(); return; }
        if (_clasesOperacionInfoCom.Count == 0) await CargarCombosInfoComAsync();

        var tareas = _clasesOperacionInfoCom.Select(c =>
            Http.SafeGetAsync<List<KONSolutions.Shared.Models.Comercial.EntidadesInformacionComercial>>(
                $"{ApiRoutes.Comercial.EntidadesInformacionComercial}/{_model.COD_ENTIDAD}/{Uri.EscapeDataString(c.Id)}")).ToList();
        var resultados = await Task.WhenAll(tareas);

        _informacionComercial = resultados
            .Where(r => r is not null).SelectMany(r => r!)
            .OrderBy(x => x.COD_CLASE_OPERACION).ThenBy(x => x.COD_TIPO_OPERACION)
            .Select(x => new InformacionComercialRow
            {
                CodClaseOperacion = x.COD_CLASE_OPERACION,
                CodTipoOperacion  = x.COD_TIPO_OPERACION,
                CodMoneda         = x.COD_MONEDA,
                CodCondicionPago  = x.COD_CONDICION_PAGO,
                CodFormaPago      = x.COD_FORMA_PAGO,
                CodUsuarioRegistro = x.COD_USUARIO_REGISTRO,
                CodEstacionRegistro = x.COD_ESTACION_REGISTRO,
                FecRegistro = x.FEC_REGISTRO,
                CodUsuarioActualizacion = x.COD_USUARIO_ACTUALIZACION,
                CodEstacionActualizacion = x.COD_ESTACION_ACTUALIZACION,
                FecActualizacion = x.FEC_ACTUALIZACION
            }).ToList();

        // Las clases que ya tienen filas necesitan sus tipos cargados para que la columna
        // Tipo de Operación muestre la descripción y no quede en blanco.
        foreach (var clase in _informacionComercial.Select(r => r.CodClaseOperacion!).Distinct())
            await CargarTiposDeClaseInfoComAsync(clase);
    }

    private void AgregarInformacionComercial() => _informacionComercial.Add(new InformacionComercialRow { EsNueva = true });

    private async Task GuardarInformacionComercialAsync(InformacionComercialRow row)
    {
        if (row.Guardando || _model.COD_ENTIDAD is null) return;
        row.Guardando = true;
        try
        {
            var dto = new KONSolutions.Shared.Models.Comercial.EntidadesInformacionComercialSaveDto
            {
                COD_ENTIDAD         = _model.COD_ENTIDAD,
                COD_CLASE_OPERACION = row.CodClaseOperacion ?? "",
                COD_TIPO_OPERACION  = row.CodTipoOperacion ?? "",
                COD_MONEDA          = row.CodMoneda,
                COD_CONDICION_PAGO  = row.CodCondicionPago,
                COD_FORMA_PAGO      = row.CodFormaPago
            };
            var resp = await Http.GuardarAsync(ApiRoutes.Comercial.EntidadesInformacionComercial, dto, row.EsNueva);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(row.EsNueva ? "Creado." : "Modificado.", Severity.Success);
                if (row.EsNueva) await CargarInformacionComercialAsync(); else row.EsNueva = false;
            }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(GuardarInformacionComercialAsync));
        }
        finally { row.Guardando = false; }
    }

    private async Task EliminarInformacionComercialAsync(InformacionComercialRow row)
    {
        // Fila que nunca se grabó: se saca de la lista y listo, no hay nada que borrar.
        if (row.EsNueva) { _informacionComercial.Remove(row); return; }

        var confirmar = await DialogService.ShowMessageBox("Confirmar",
            "¿Eliminar esta condición comercial?", yesText: "Eliminar", cancelText: "Cancelar");
        if (confirmar != true) return;

        row.Guardando = true;
        try
        {
            var resp = await Http.DeleteAsync(
                $"{ApiRoutes.Comercial.EntidadesInformacionComercial}/{_model.COD_ENTIDAD}/{Uri.EscapeDataString(row.CodClaseOperacion!)}/{Uri.EscapeDataString(row.CodTipoOperacion!)}");
            if (resp.IsSuccessStatusCode) await CargarInformacionComercialAsync();
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(EliminarInformacionComercialAsync), "No se pudo eliminar el registro");
        }
        finally { row.Guardando = false; }
    }
