                DES_DIRECCION = row.DesDireccion,
                COD_TIPO_ESTADO = row.CodTipoEstado,
                COD_ESTADO = row.CodEstado
            };
            // PROC_COMERCIAL_ENTIDADES_UNIDADES_COMERCIALES_INSERT es upsert (autonumera el
            // código si no existe) — siempre POST, igual que Medios de Contacto. Tras un alta
            // se recarga la grilla completa para traer el código que asignó el servidor.
            var resp = await Http.PostAsJsonAsync(ApiRoutes.Comercial.EntidadesUnidadesComerciales, dto);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Guardado.", Severity.Success);
                if (row.EsNueva) await CargarUnidadesComercialesAsync(); else row.EsNueva = false;
            }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(GuardarUnidadComercialAsync));
        }
        finally { row.Guardando = false; }
    }

