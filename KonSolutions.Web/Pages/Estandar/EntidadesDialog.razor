@using KONSolutions.Shared.Models.Estandar
@using ConfiguracionGeneralModel = KONSolutions.Shared.Models.Estandar.ConfiguracionGeneral
@using KONSolutions.Web.Pages.Comercial
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService
@inject ConfiguracionGeneralService CfgSvc

<MudDialog Style="width:min(1992px,95vw);">
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_NOMBRE_COMPLETO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0 pt-3" @bind-ActivePanelIndex="_tabActiva">
            <MudTabPanel Text="Información Básica">
            @* align-items:stretch (antes flex-start) para que las dos columnas midan lo
               mismo: es lo que le permite a "Tipos de Entidad" (flex:1 más abajo) llegar
               hasta el borde inferior de Estado, el último campo de la columna izquierda. *@
            <div style="display:flex;gap:var(--input-space-h,16px);align-items:stretch;width:100%;">
            <div style="flex:1 1 auto;min-width:0;">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="_tiposPersona"
                               TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                               Value="@(_model.COD_TIPO_PERSONA?.ToString())"
                               ValueChanged="@(v => { _model.COD_TIPO_PERSONA = int.TryParse(v, out var n) ? n : null; ActualizarNombreCompleto(); LimpiarPrefijoSiNoAplica(); LimpiarDependenciaSiNoAplica(); })"
                               Label="Tipo de Persona" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @* Solo aplica a Persona Jurídica (2) — deshabilitado en Natural (1). *@
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="NUM_DUNS"
                                @bind-Value="_model.NUM_DUNS"
                                Obligatorio="false" Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 2)" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <AriaCombo TItem="ComboboxItem" Items="_tiposDoc"
                               TextFunc="@(td => td.Texto)" ValueFunc="@(td => td.Id)"
                               Value="@(_model.COD_TIPO_DOCUMENTO_IDENTIDAD?.ToString())"
                               ValueChanged="@(v => _model.COD_TIPO_DOCUMENTO_IDENTIDAD = int.TryParse(v, out var n) ? n : null)"
                               Label="Tipo doc. identidad" Obligatorio="true" Disabled="_readonly" Class="mt-1 mb-3" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="NUM_DOCUMENTO_IDENTIDAD"
                                @bind-Value="_model.NUM_DOCUMENTO_IDENTIDAD"
                                Obligatorio="true" Disabled="_readonly" Class="mt-1 mb-3" />
                </MudItem>
                @* Solo aplican a Persona Natural (COD_TIPO_PERSONA = 1) — deshabilitados en Jurídica. *@
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_PATERNO"
                                Value="@_model.DES_PATERNO"
                                ValueChanged="@(v => { _model.DES_PATERNO = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_MATERNO"
                                Value="@_model.DES_MATERNO"
                                ValueChanged="@(v => { _model.DES_MATERNO = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE"
                                Value="@_model.DES_NOMBRE"
                                ValueChanged="@(v => { _model.DES_NOMBRE = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE2"
                                Value="@_model.DES_NOMBRE2"
                                ValueChanged="@(v => { _model.DES_NOMBRE2 = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                @* Persona Natural (1): calculado y deshabilitado. Persona Jurídica (2): editable y obligatorio. *@
                <MudItem xs="12" md="6">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE_COMPLETO"
                                @bind-Value="_model.DES_NOMBRE_COMPLETO"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 1)" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @* Habilitado para los dos tipos de persona. Antes se bloqueaba en Jurídica (2),
                       que es justamente donde el nombre comercial más se usa: no había forma de
                       cargarlo desde la pantalla. A diferencia del prefijo y de la dependencia,
                       este campo no se limpia al cambiar de tipo — aplica a los dos. *@
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_COMERCIAL"
                                @bind-Value="_model.DES_COMERCIAL"
                                Disabled="@_readonly" />
                </MudItem>
                @* Solo aplica a Persona Jurídica (2) — deshabilitado y limpiado en Natural (1),
                   ver LimpiarPrefijoSiNoAplica. *@
                <MudItem xs="12" md="6">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_PREFIJO_USUARIO_COMERCIAL"
                                Label="Prefijo usuario comercial"
                                @bind-Value="_model.DES_PREFIJO_USUARIO_COMERCIAL"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 2)" />
                </MudItem>
                @* Solo aplica a Persona Natural (1) — deshabilitado y limpiado en Jurídica (2),
                   ver LimpiarDependenciaSiNoAplica. Lista precargada desde
                   PROC_ESTANDAR_ENTIDADES_PARADEPENDER (ya viene filtrada a Persona Jurídica
                   por el propio SP, con nombre y prefijo, sin la ambigüedad de columnas que
                   tiene SHOWALL/SHOWBYID — ver Domain/Models/Estandar/Entidades.cs del lado API). *@
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="_entidadesParaDepender"
                               TextFunc="@(x => $"{x.Id} - {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@(_model.COD_ENTIDAD_DEPENDENCIA?.ToString())"
                               ValueChanged="@(v => _model.COD_ENTIDAD_DEPENDENCIA = decimal.TryParse(v, out var n) ? n : null)"
                               Label="Entidad dependencia"
                               Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 1)" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="d-flex align-center gap-1 mt-2"><MudIcon Icon="@Icons.Material.Filled.Home" Color="Color.Primary" Size="Size.Medium" />
                        <MudSwitch T="bool?" Value="_model.FLG_DOMICILIADO" ValueChanged="@(v => OnDomiciliadoChanged(v))"
                                   Label="Domiciliado" Disabled="_readonly" Color="Color.Primary" /></div>
                </MudItem>
                <MudItem xs="12" md="8">
                    @* Si es Domiciliado, País se precarga desde Configuración General, pero queda editable.
                       ItemSelected actualiza DES_PAIS (no solo COD_PAIS): TextoInicial está atado a
                       DES_PAIS, y si no se refresca, el combo remoto revierte el texto mostrado al
                       valor viejo apenas se re-renderiza tras elegir un país nuevo. *@
                    <AriaCombo TItem="ComboboxItem" Items="Enumerable.Empty<ComboboxItem>()"
                               TextFunc="@(x => $"{x.Id} – {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@_model.COD_PAIS" ValueChanged="@(v => _model.COD_PAIS = v ?? "")"
                               ItemSelected="@(item => _model.DES_PAIS = item?.Texto ?? "")"
                               SearchFunc="BuscarPaisAsync" MinCharacters="2"
                               TextoInicial="@(_model.DES_PAIS)"
                               Label="País" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="Enumerable.Empty<ComboboxItem>()"
                               TextFunc="@(x => $"{x.Id} – {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@_model.COD_USUARIO_RELACIONADO" ValueChanged="@(v => _model.COD_USUARIO_RELACIONADO = v ?? "")"
                               SearchFunc="BuscarUsuarioEntidadAsync" MinCharacters="2"
                               TextoInicial="@(_model.COD_USUARIO_RELACIONADO)"
                               Label="Usuario relacionado" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <EstadoCombo DesTabla="ESTANDAR.ENTIDADES"
                                 @bind-Value="_model.COD_ESTADO"
                                 CodTipoEstadoChanged="@(v => _model.COD_TIPO_ESTADO = v)"
                                 Disabled="_readonly" Class="mb-3" />
                </MudItem>
            </MudGrid>
            </div>
            <div style="flex-shrink:0;padding-left:8px;border-left:1px solid rgba(0,0,0,.1);width:290px;display:flex;flex-direction:column;height:100%;">
                <ImagePicker Label="Logo" Image="_model.IMG_LOGO"
                             ImageChanged="@(v => _model.IMG_LOGO = v)"
                             ReadOnly="_readonly" />

                @* Tipos de Entidad: check = INSERT inmediato en ENTIDADES_TIPOS_ENTIDADES,
                   uncheck = DELETE inmediato — no espera al Guardar del formulario principal. *@
                <MudText Typo="Typo.caption" Class="mono mt-3 mb-1"
                          Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Tipos de Entidad:</MudText>
                @if (_esNuevo)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar tipos.</MudAlert>
                }
                else
                {
                    @* flex:1 (antes max-height:225px fijo) para que el borde inferior de este
                       panel llegue hasta el de Estado, en vez de dejar un hueco vacío debajo. *@
                    <div style="border:1px solid var(--line);border-radius:4px;padding:6px 8px;flex:1;min-height:0;overflow-y:auto;">
                        @foreach (var t in _tiposEntidadTodos)
                        {
                            <div class="d-flex align-center">
                                <MudSwitch T="bool"
                                           Value="@(BloquearTipoEntidad ? t.Id == CodTipoEntidadFijo : _tiposEntidadAsignados.Contains(t.Id))"
                                           ValueChanged="@(v => ToggleTipoEntidad(t.Id, v))"
                                           Disabled="@(_readonly || _tipoEntidadGuardando == t.Id || BloquearTipoEntidad)"
                                           Dense="true" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@t.Texto</MudText>
                            </div>
                        }
                    </div>
                }
            </div>
            </div>
            </MudTabPanel>

            <MudTabPanel Text="Documentos de Identidad">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Documentos de Identidad.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_documentos.Count documento(s)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarDocumento">Agregar documento</MudButton>
                    }
                </div>
                @* Tabla HTML simple (sin el wrapper "overflow-x:auto" de MudSimpleTable) —
                   ese wrapper recorta también el overflow vertical (regla CSS: un eje
                   overflow:auto fuerza el otro a auto), lo que ocultaba el desplegable
                   de AriaCombo (position:absolute) apenas se abrea dentro de una fila. *@
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:280px;">Tipo de documento</th>
                            <th>Número de documento</th>
                            <th style="width:190px;">Fecha de caducidad</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _documentos)
                        {
                            <tr>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposDoc"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipo?.ToString())"
                                               ValueChanged="@(v => row.CodTipo = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="@(!row.EsNueva || _readonly)" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="ESTANDAR.ENTIDADES_DOCUMENTOS_IDENTIDAD" Columna="NUM_DOCUMENTO_IDENTIDAD"
                                                    @bind-Value="row.NumDocumento" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <MudDatePicker @bind-Date="row.FecCaducidad" Variant="Variant.Outlined" Disabled="_readonly"
                                                   Margin="Margin.None" Class="mb-0" Editable="true" DateFormat="dd/MM/yyyy" Mask="@(new DateMask("dd/MM/yyyy"))" />
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || row.CodTipo is null || string.IsNullOrWhiteSpace(row.NumDocumento))"
                                                       OnClick="@(() => GuardarDocumentoAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarDocumentoAsync(row))" />
                                    }
                                    @if (!row.EsNueva)
                                    {
                                        <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                        CodEstacionRegistro="@row.CodEstacionRegistro"
                                                        FecRegistro="@row.FecRegistro"
                                                        CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                        CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                        FecActualizacion="@row.FecActualizacion" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            <MudTabPanel Text="Medios de Contacto">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Medios de Contacto.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_mediosContacto.Count medio(s) de contacto</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarMedioContacto">Agregar medio de contacto</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:240px;">Tipo de medio de contacto</th>
                            <th>Dato (correo, teléfono, url, usuario...)</th>
                            <th style="width:180px;">Tipo de uso</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _mediosContacto)
                        {
                            <tr>
                                <td>
                                    @* Ya no es clave (la clave es NUM_SECUENCIA), así que se puede editar
                                       aunque la fila no sea nueva — permite varias filas del mismo tipo. *@
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposMedioContacto"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipo?.ToString())"
                                               ValueChanged="@(v => row.CodTipo = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="COMERCIAL.ENTIDADES_TIPOS_MEDIO_CONTACTO" Columna="DAT_TIPO_MEDIO_CONTACTO"
                                                    @bind-Value="row.Dato" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposUso"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipoUso)"
                                               ValueChanged="@(v => row.CodTipoUso = v)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || row.CodTipo is null || string.IsNullOrWhiteSpace(row.Dato))"
                                                       OnClick="@(() => GuardarMedioContactoAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarMedioContactoAsync(row))" />
                                    }
                                    @if (!row.EsNueva)
                                    {
                                        <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                        CodEstacionRegistro="@row.CodEstacionRegistro"
                                                        FecRegistro="@row.FecRegistro"
                                                        CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                        CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                        FecActualizacion="@row.FecActualizacion" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            @* COMERCIAL.ENTIDADES_UNIDADES_COMERCIALES — el INSERT SÍ es upsert (autonumera
               COD_UNIDAD_COMERCIAL si no existe), igual que Medios de Contacto: siempre POST,
               el código nunca se tipea a mano. *@
            <MudTabPanel Text="Unidades Comerciales">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Unidades Comerciales.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_unidadesComerciales.Count unidad(es) comercial(es)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarUnidadComercial">Agregar unidad comercial</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px;">Código</th>
                            <th style="width:374px;">Descripción</th>
                            <th style="width:160px;">País</th>
                            <th>Dirección</th>
                            <th style="width:170px;">Estado</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _unidadesComerciales)
                        {
                            <tr style="vertical-align:middle;">
                                <td style="vertical-align:middle;">
                                    @* El código lo asigna el SP (autonumera), nunca se tipea a mano. *@
                                    <span class="mono">@(row.EsNueva ? "(auto)" : row.CodUnidadComercial?.ToString())</span>
                                </td>
                                <td style="vertical-align:middle;">
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="COMERCIAL.ENTIDADES_UNIDADES_COMERCIALES" Columna="DES_UNIDAD_COMERCIAL"
                                                    @bind-Value="row.DesUnidadComercial" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td style="vertical-align:middle;">
                                    <AriaCombo TItem="ComboboxItem" Items="Enumerable.Empty<ComboboxItem>()"
                                               TextFunc="@(x => $"{x.Id} – {x.Texto}")" ValueFunc="@(x => x.Id)"
                                               Value="@row.CodPais" ValueChanged="@(v => row.CodPais = v)"
                                               ItemSelected="@(item => row.DesPais = item?.Texto ?? "")"
                                               SearchFunc="BuscarPaisAsync" MinCharacters="2" TextoInicial="@row.DesPais"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td style="vertical-align:middle;">
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="COMERCIAL.ENTIDADES_UNIDADES_COMERCIALES" Columna="DES_DIRECCION"
                                                    @bind-Value="row.DesDireccion" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td style="vertical-align:middle;">
                                    <div style="margin-top:0;">
                                        <EstadoCombo DesTabla="COMERCIAL.ENTIDADES_UNIDADES_COMERCIALES"
                                                     Value="row.CodEstado" ValueChanged="@(v => row.CodEstado = v)"
                                                     CodTipoEstadoChanged="@(v => row.CodTipoEstado = v)"
                                                     Disabled="_readonly" Class="mb-0" />
                                    </div>
                                </td>
                                <td style="vertical-align:middle;">
                                    <div class="d-flex align-center gap-1">
                                        @if (!_readonly)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                           Disabled="@(row.Guardando || string.IsNullOrWhiteSpace(row.DesUnidadComercial))"
                                                           OnClick="@(() => GuardarUnidadComercialAsync(row))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           Disabled="row.Guardando" OnClick="@(() => EliminarUnidadComercialAsync(row))" />
                                        }
                                        @if (!row.EsNueva)
                                        {
                                            <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                            CodEstacionRegistro="@row.CodEstacionRegistro"
                                                            FecRegistro="@row.FecRegistro"
                                                            CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                            CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                            FecActualizacion="@row.FecActualizacion" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            @* Direcciones tiene demasiados campos (17, incluyendo el mapa de ubicación)
               para editarse en una fila de grilla como Documentos/Medios de Contacto —
               aquí cada fila abre EntidadesDireccionesDialog (diálogo CRUD completo,
               mismo patrón que el resto de la app) en vez de edición in-place. *@
            <MudTabPanel Text="Direcciones">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Direcciones.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_direcciones.Count dirección(es)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarDireccion">Agregar dirección</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:170px;">Tipo</th>
                            <th>Dirección</th>
                            <th style="width:170px;">Ubigeo</th>
                            <th style="width:130px;">Coordenadas</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _direcciones)
                        {
                            <tr>
                                <td>@d.DES_TIPO_DIRECCION</td>
                                <td>@d.DES_DIRECCION</td>
                                <td>@d.DES_UBIGEO</td>
                                <td>
                                    @if (d.VAL_LATITUD is not null && d.VAL_LONGITUD is not null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" Size="Size.Small" Title="Tiene coordenadas guardadas" />
                                    }
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditarDireccion(d))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarDireccionAsync(d))" />
                                    }
                                    <PanelAuditoria CodUsuarioRegistro="@d.COD_USUARIO_REGISTRO"
                                                    CodEstacionRegistro="@d.COD_ESTACION_REGISTRO"
                                                    FecRegistro="@d.FEC_REGISTRO"
                                                    CodUsuarioActualizacion="@d.COD_USUARIO_ACTUALIZACION"
                                                    CodEstacionActualizacion="@d.COD_ESTACION_ACTUALIZACION"
                                                    FecActualizacion="@d.FEC_ACTUALIZACION" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            @* FINANZAS.ENTIDADES_CUENTAS_BANCARIAS no tiene columnas de auditoría (no lleva
               PanelAuditoria), y su INSERT no es upsert (POST para alta, PUT para modificar) —
               a diferencia de Documentos/Medios de Contacto de más arriba. El Nº de cuenta es
               parte de la clave: solo se edita mientras la fila es nueva, igual que Área/Cargo
               en el tipo de documento de la pestaña de Documentos. *@
            <MudTabPanel Text="Información Financiera">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Cuentas Bancarias.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_cuentasBancarias.Count cuenta(s) bancaria(s)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarCuentaBancaria">Agregar cuenta bancaria</MudButton>
                    }
                </div>
                @* Con CCI, Descripción y 6 flags de más la fila no entra en el ancho del diálogo:
                   las flags se agrupan en una sola columna de íconos toggle (clic = prende/apaga,
                   igual que el resto de la fila, recién se graba al tocar ✓) y la tabla scrollea
                   horizontal en vez de comprimir las columnas de texto hasta ilegibles. *@
                <div style="overflow-x:auto;">
                <table class="tabla-simple-editable" style="width:100%;min-width:1520px;">
                    <thead>
                        <tr>
                            <th style="width:170px;">Banco</th>
                            <th style="width:340px;">Número de cuenta</th>
                            <th style="width:340px;">CCI</th>
                            <th style="width:200px;">Descripción</th>
                            <th style="width:160px;">Tipo de cuenta</th>
                            <th style="width:120px;">Moneda</th>
                            <th style="width:180px;">Características</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _cuentasBancarias)
                        {
                            <tr>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_bancos"
                                               TextFunc="@(b => $"{b.Id} - {b.Texto}")" ValueFunc="@(b => b.Id)"
                                               Value="@row.CodBanco"
                                               ValueChanged="@(v => row.CodBanco = v ?? "")"
                                               Disabled="@(!row.EsNueva || _readonly)" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="FINANZAS.ENTIDADES_CUENTAS_BANCARIAS" Columna="NUM_CUENTA_BANCARIA"
                                                    @bind-Value="row.NumCuenta" Disabled="@(!row.EsNueva || _readonly)" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="FINANZAS.ENTIDADES_CUENTAS_BANCARIAS" Columna="NUM_CUENTA_BANCARIA_CCI"
                                                    @bind-Value="row.NumCuentaCci" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="FINANZAS.ENTIDADES_CUENTAS_BANCARIAS" Columna="DES_CUENTA_BANCARIA"
                                                    @bind-Value="row.DesCuenta" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposCuentaBancaria"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@row.CodTipoCuenta"
                                               ValueChanged="@(v => row.CodTipoCuenta = v)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_monedas"
                                               TextFunc="@(m => $"{m.Id} - {m.Texto}")" ValueFunc="@(m => m.Id)"
                                               Value="@row.CodMoneda"
                                               ValueChanged="@(v => row.CodMoneda = v)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <MudTooltip Text="Principal">
                                            <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                                           Color="@(row.FlgPrincipal ? Color.Warning : Color.Default)"
                                                           Style="@(row.FlgPrincipal ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgPrincipal = !row.FlgPrincipal)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Habilitada">
                                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                                           Color="@(row.FlgHabilitada ? Color.Success : Color.Default)"
                                                           Style="@(row.FlgHabilitada ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgHabilitada = !row.FlgHabilitada)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Cuenta de la empresa">
                                            <MudIconButton Icon="@Icons.Material.Filled.Business" Size="Size.Small"
                                                           Color="@(row.FlgCuentaEmpresa ? Color.Primary : Color.Default)"
                                                           Style="@(row.FlgCuentaEmpresa ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgCuentaEmpresa = !row.FlgCuentaEmpresa)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Cobros">
                                            <MudIconButton Icon="@Icons.Material.Filled.CallReceived" Size="Size.Small"
                                                           Color="@(row.FlgCobros ? Color.Info : Color.Default)"
                                                           Style="@(row.FlgCobros ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgCobros = !row.FlgCobros)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Pagos">
                                            <MudIconButton Icon="@Icons.Material.Filled.CallMade" Size="Size.Small"
                                                           Color="@(row.FlgPagos ? Color.Info : Color.Default)"
                                                           Style="@(row.FlgPagos ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgPagos = !row.FlgPagos)" />
                                        </MudTooltip>
                                        <MudTooltip Text="Restringida">
                                            <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small"
                                                           Color="@(row.FlgRestringida ? Color.Error : Color.Default)"
                                                           Style="@(row.FlgRestringida ? "" : "opacity:.3;")"
                                                           Disabled="_readonly" OnClick="@(() => row.FlgRestringida = !row.FlgRestringida)" />
                                        </MudTooltip>
                                    </div>
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || string.IsNullOrEmpty(row.CodBanco) || string.IsNullOrWhiteSpace(row.NumCuenta))"
                                                       OnClick="@(() => GuardarCuentaBancariaAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarCuentaBancariaAsync(row))" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            </div>
            </MudTabPanel>

            @* Solo aplica al Catálogo de Clientes (COD_TIPO_ENTIDAD = 'CLI', ver
               CodTipoEntidadFijo/BloquearTipoEntidad) — no tiene sentido en la grilla
               genérica de Entidades ni para otros tipos (Proveedores, Personal, etc.). *@
            @if (BloquearTipoEntidad && CodTipoEntidadFijo == "CLI")
            {
                <MudTabPanel Text="Asesores Comerciales">
                <div style="min-height:40vh;">
                @if (_esNuevo)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda el cliente primero para asignar sus Asesores Comerciales.</MudAlert>
                }
                else
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_asesoresComerciales.Count asesor(es) asignado(s)</MudText>
                        @if (!_readonly)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                       Style="@EstilosBoton.Confirmar" OnClick="AgregarAsesorComercial">Agregar asesor comercial</MudButton>
                        }
                    </div>
                    <table class="tabla-simple-editable" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Asesor comercial</th>
                                <th style="width:130px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _asesoresComerciales)
                            {
                                <tr>
                                    <td>@(a.DES_NOMBRE_COMPLETO ?? a.COD_ENTIDAD_ASESOR_COMERCIAL?.ToString())</td>
                                    <td>
                                        @if (!_readonly)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarAsesorComercialAsync(a))" />
                                        }
                                        <PanelAuditoria CodUsuarioRegistro="@a.COD_USUARIO_REGISTRO"
                                                        CodEstacionRegistro="@a.COD_ESTACION_REGISTRO"
                                                        FecRegistro="@a.FEC_REGISTRO" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                </div>
                </MudTabPanel>
            }
            @* COMERCIAL.ENTIDADES_INFORMACION_COMERCIAL — condiciones comerciales pactadas
               con esta entidad: moneda, condición y forma de pago, por tipo de operación.
               Grilla editable, mismo patrón que Medios de Contacto y Direcciones: se agrega
               una fila vacía, se completa y se graba con el tilde de la propia fila.
               Clase y Tipo de Operación forman parte de la clave junto con la entidad, así
               que sólo se eligen en la fila nueva; una vez grabada quedan bloqueados. *@
            <MudTabPanel Text="Información Comercial">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para cargar su Información Comercial.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_informacionComercial.Count condición(es) comercial(es)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarInformacionComercial">Agregar condición comercial</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:230px;">Clase de operación</th>
                            <th style="width:230px;">Tipo de operación</th>
                            <th style="width:160px;">Moneda</th>
                            <th style="width:190px;">Condición de pago</th>
                            <th style="width:190px;">Forma de pago</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _informacionComercial)
                        {
                            <tr>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_clasesOperacionInfoCom"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@row.CodClaseOperacion"
                                               ValueChanged="@(v => CambiarClaseFilaInfoComAsync(row, v))"
                                               Disabled="@(_readonly || !row.EsNueva)" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="@TiposDeClaseInfoCom(row.CodClaseOperacion)"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@row.CodTipoOperacion"
                                               ValueChanged="@(v => row.CodTipoOperacion = v)"
                                               Disabled="@(_readonly || !row.EsNueva || string.IsNullOrWhiteSpace(row.CodClaseOperacion))"
                                               Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_monedasInfoCom"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@row.CodMoneda"
                                               ValueChanged="@(v => row.CodMoneda = v)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_condicionesPagoInfoCom"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodCondicionPago?.ToString())"
                                               ValueChanged="@(v => row.CodCondicionPago = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_formasPagoInfoCom"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodFormaPago?.ToString())"
                                               ValueChanged="@(v => row.CodFormaPago = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || string.IsNullOrWhiteSpace(row.CodClaseOperacion) || string.IsNullOrWhiteSpace(row.CodTipoOperacion))"
                                                       OnClick="@(() => GuardarInformacionComercialAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarInformacionComercialAsync(row))" />
                                    }
                                    @if (!row.EsNueva)
                                    {
                                        <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                        CodEstacionRegistro="@row.CodEstacionRegistro"
                                                        FecRegistro="@row.FecRegistro"
                                                        CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                        CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                        FecActualizacion="@row.FecActualizacion" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            </MudTabs>

            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())"
                               CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO"
                                    CodUsuarioActualizacion="@Item?.COD_USUARIO_ACTUALIZACION"
                                    CodEstacionActualizacion="@Item?.COD_ESTACION_ACTUALIZACION"
                                    FecActualizacion="@Item?.FEC_ACTUALIZACION" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Entidad? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    // Reutilización de este diálogo con un Tipo de Entidad fijo (ej. "CLI" = Clientes) —
    // ver Entidades.razor y DES_PARAMETRO en SEGURIDAD.APLICACIONES_OPCIONES. Cuando
    // BloquearTipoEntidad es true, el panel "Tipos de Entidad" queda con ese tipo marcado
    // y TODO el panel deshabilitado (no se puede desmarcar ni marcar otro).
    [Parameter] public string? CodTipoEntidadFijo { get; set; }
    [Parameter] public bool BloquearTipoEntidad { get; set; }
    // Solo para resolver el combo de Asesores Comerciales (tab condicional, ver arriba) —
    // identifica la opción de menú actual para encontrar su Área enlazada
    // (ESTANDAR.APLICACIONES_OPCIONES_AREAS) y así los cargos/entidades asignados a ella.
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }

    // FLG_DOMICILIADO por defecto true en Crear — MapearDesdeModelo reemplaza el objeto
    // completo en Editar/Ver, así que este default no pisa el valor real guardado.
    private Entidad _model = new() { FLG_DOMICILIADO = true };
    private bool _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private List<ComboboxItem> _tiposDoc = new();
    private bool _esNuevo;
    private int _tabActiva;


    // ── Documentos de Identidad (pestaña, grilla editable in-place) ──
    private class DocumentoIdentidadRow
    {
        public int? CodTipo { get; set; }
        public string NumDocumento { get; set; } = "";
        public DateTime? FecCaducidad { get; set; }
        public bool EsNueva { get; set; }
        public bool Guardando { get; set; }
        public string? CodUsuarioRegistro { get; set; }
        public string? CodEstacionRegistro { get; set; }
        public DateTime? FecRegistro { get; set; }
        public string? CodUsuarioActualizacion { get; set; }
        public string? CodEstacionActualizacion { get; set; }
        public DateTime? FecActualizacion { get; set; }
    }
    private List<DocumentoIdentidadRow> _documentos = new();

    private async Task CargarDocumentosAsync()
    {
        if (_model.COD_ENTIDAD is null) return;
        var lista = await Http.SafeGetAsync<List<KONSolutions.Shared.Models.Estandar.EntidadesDocumentosIdentidad>>(
            $"{ApiRoutes.Estandar.EntidadesDocumentosIdentidad}?codEntidad={_model.COD_ENTIDAD}") ?? new();
        _documentos = lista.Select(m => new DocumentoIdentidadRow
        {
            CodTipo = m.COD_TIPO_DOCUMENTO_IDENTIDAD,
            NumDocumento = m.NUM_DOCUMENTO_IDENTIDAD,
            FecCaducidad = m.FEC_CADUCIDAD,
            EsNueva = false,
            CodUsuarioRegistro = m.COD_USUARIO_REGISTRO,
            CodEstacionRegistro = m.COD_ESTACION_REGISTRO,
            FecRegistro = m.FEC_REGISTRO,
            CodUsuarioActualizacion = m.COD_USUARIO_ACTUALIZACION,
            CodEstacionActualizacion = m.COD_ESTACION_ACTUALIZACION,
            FecActualizacion = m.FEC_ACTUALIZACION
        }).ToList();
    }

    private void AgregarDocumento() => _documentos.Add(new DocumentoIdentidadRow { EsNueva = true });

    private async Task GuardarDocumentoAsync(DocumentoIdentidadRow row)
    {
        row.Guardando = true;
        try
        {
            var dto = new
            {
                COD_ENTIDAD = _model.COD_ENTIDAD,
                COD_TIPO_DOCUMENTO_IDENTIDAD = row.CodTipo,
                NUM_DOCUMENTO_IDENTIDAD = row.NumDocumento,
                FEC_CADUCIDAD = row.FecCaducidad
            };
            // El comentario que estaba acá decía "_INSERT es upsert — siempre POST". NO LO ES:
            // el SP de alta rechaza una clave que ya existe, así que modificar un documento ya
            // grabado devolvía "Ya existe un registro con esa clave" y no había forma de
            // corregir un número mal tipeado — había que borrar la fila y volver a cargarla.
            //
            // El SP de UPDATE y el verbo PUT existían desde siempre; nadie los llamaba.
            // EsNueva es lo único que sabe la pantalla y la API no: cuál era la intención.
            var resp = await Http.GuardarAsync(ApiRoutes.Estandar.EntidadesDocumentosIdentidad, dto, row.EsNueva);
            if (resp.IsSuccessStatusCode) { row.EsNueva = false; Snackbar.Add("Guardado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(GuardarDocumentoAsync));
        }
        finally { row.Guardando = false; }
    }

    private async Task EliminarDocumentoAsync(DocumentoIdentidadRow row)
    {
        if (row.EsNueva) { _documentos.Remove(row); return; }
        row.Guardando = true;
        try
        {
            var resp = await Http.DeleteAsync($"{ApiRoutes.Estandar.EntidadesDocumentosIdentidad}/{_model.COD_ENTIDAD}/{row.CodTipo}");
            if (resp.IsSuccessStatusCode) { _documentos.Remove(row); Snackbar.Add("Eliminado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(EliminarDocumentoAsync), "No se pudo eliminar el registro");
        }
        finally { row.Guardando = false; }
    }

