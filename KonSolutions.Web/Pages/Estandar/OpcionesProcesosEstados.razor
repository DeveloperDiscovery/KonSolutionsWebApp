    private async Task Eliminar(Modelo item)
    {
        var dlg = await DialogService.ShowAsync<ConfirmarAccionDialog>("Quitar tipo de estado",
            new DialogParameters
            {
                ["Titulo"] = "Quitar tipo de estado",
                ["IconoTitulo"] = Icons.Material.Filled.Delete,
                ["Mensaje"] = $"¿Quitar el tipo de estado '{item.DES_TIPO_ESTADO}' de esta opción?",
                ["TextoConfirmar"] = "Quitar",
                ["IconoConfirmar"] = Icons.Material.Filled.Delete
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is not { Canceled: false }) return;

        var resp = await Http.DeleteAsync($"{EstandarRoute.OpcionesProcesosEstados}/{Uri.EscapeDataString(item.COD_APLICACION)}/{Uri.EscapeDataString(item.COD_OPCION_APLICACION)}/{item.COD_TIPO_ESTADO}");
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Tipo de estado quitado.", Severity.Success);
            if (_tipoEstadoSel?.COD_TIPO_ESTADO == item.COD_TIPO_ESTADO) { _tipoEstadoSel = null; _flujos.Clear(); }
            await CargarAsignados();
        }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(OpcionesProcesosEstados), nameof(Eliminar));
    }

    // ══════════════════════ Panel 3: Flujos ══════════════════════

    private async Task SeleccionarTipoEstado(Modelo tipoEstado)
    {
        _tipoEstadoSel = tipoEstado;
        await CargarFlujos();
    }

    private async Task CargarFlujos()
    {
        if (_nodoSel is null || _tipoEstadoSel is null) return;
        _cargandoFlujos = true;
        _flujos.Clear();
        StateHasChanged();
        try
        {
            var url = $"{EstandarRoute.OpcionesProcesosEstadosFlujos}" +
                      $"?codAplicacion={Uri.EscapeDataString(_nodoSel.COD_APLICACION_ORIGINAL)}" +
                      $"&codOpcionAplicacion={Uri.EscapeDataString(_nodoSel.COD_OPCION_ORIGINAL)}" +
                      $"&codTipoEstado={_tipoEstadoSel.COD_TIPO_ESTADO}";
            var r = await Http.GetFromJsonAsync<ApiResp<List<ModeloFlujo>>>(url);
            _flujos = (r?.Data ?? new()).OrderBy(x => x.NUM_ORDEN_FLUJO).ToList();

            _estadosDelTipo = await EstadoSvc.GetByTipoAsync(_tipoEstadoSel.COD_TIPO_ESTADO);

            var destinoCods = _flujos.Where(f => f.COD_ESTADO.HasValue).Select(f => f.COD_ESTADO!.Value).ToHashSet();
            _estadosSinVincular = _estadosDelTipo.Where(e => e.COD_ESTADO.HasValue && !destinoCods.Contains((short)e.COD_ESTADO.Value)).ToList();

            var botones = await BotonesSvc.GetByOpcionAsync(_nodoSel.COD_APLICACION_ORIGINAL, _nodoSel.COD_OPCION_ORIGINAL);
            _iconosBotones = botones
                .Where(b => b.IMG_ICONO is { Length: > 0 })
                .ToDictionary(b => b.COD_BOTON_OPCION, b => Convert.ToBase64String(b.IMG_ICONO!));

            await CargarDependencias();
        }
        catch (Exception ex) { await ErrorDialogHelper.MostrarMensajeAsync(ex.Message, DialogService, nameof(OpcionesProcesosEstados)); }
        finally { _cargandoFlujos = false; StateHasChanged(); }
    }

