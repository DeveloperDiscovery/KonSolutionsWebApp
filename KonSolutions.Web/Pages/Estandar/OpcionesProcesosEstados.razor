    /// <summary>Resuelve qué botones ya tienen estados previos requeridos, vía el Treelist
    /// (una fila por Botón × Dependencia; COD_ESTADO_DEPENDENCIA no nulo = tiene al menos uno).</summary>
    private async Task CargarDependencias()
    {
        if (_nodoSel is null || _tipoEstadoSel is null) return;
        try
        {
            var url = $"{EstandarRoute.OpcionesProcesosEstadosFlujosTreelist}" +
                      $"?codAplicacion={Uri.EscapeDataString(_nodoSel.COD_APLICACION_ORIGINAL)}" +
                      $"&codOpcionAplicacion={Uri.EscapeDataString(_nodoSel.COD_OPCION_ORIGINAL)}" +
                      $"&codTipoEstado={_tipoEstadoSel.COD_TIPO_ESTADO}";
            var r = await Http.GetFromJsonAsync<ApiResp<List<KONSolutions.Shared.Models.Estandar.OpcionesProcesosEstadosFlujosTreeList>>>(url);
            _dependenciasPorBoton = (r?.Data ?? new())
                .Where(x => x.COD_ESTADO_DEPENDENCIA.HasValue)
                .GroupBy(x => x.COD_BOTON_OPCION)
                .ToDictionary(g => g.Key, g => g.ToList());
        }
        catch { _dependenciasPorBoton = new(); }
        ConstruirDiagrama();
    }

