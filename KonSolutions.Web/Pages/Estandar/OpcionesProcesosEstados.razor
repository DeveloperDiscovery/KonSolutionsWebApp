        };
        var dlg = await DialogService.ShowAsync<OpcionesProcesosEstadosFlujosDependenciaDialog>("Estados previos requeridos", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false, Data: true }) await CargarDependencias();
    }

    private async Task EliminarFlujo(ModeloFlujo item)
    {
        var nombreBoton = string.IsNullOrWhiteSpace(item.DES_ALIAS) ? item.DES_BOTON_OPCION : item.DES_ALIAS;
        var dlg = await DialogService.ShowAsync<ConfirmarAccionDialog>("Eliminar flujo",
            new DialogParameters
            {
                ["Titulo"] = "Eliminar flujo",
                ["IconoTitulo"] = Icons.Material.Filled.Delete,
                ["Mensaje"] = $"¿Eliminar el flujo del botón '{nombreBoton}'?",
                ["TextoConfirmar"] = "Eliminar",
                ["IconoConfirmar"] = Icons.Material.Filled.Delete
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is not { Canceled: false }) return;

        var resp = await Http.DeleteAsync($"{EstandarRoute.OpcionesProcesosEstadosFlujos}/{Uri.EscapeDataString(item.COD_APLICACION)}/{Uri.EscapeDataString(item.COD_OPCION_APLICACION)}/{item.COD_TIPO_ESTADO}/{Uri.EscapeDataString(item.COD_BOTON_OPCION)}");
        if (resp.IsSuccessStatusCode) { Snackbar.Add("Flujo eliminado.", Severity.Success); await CargarFlujos(); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(OpcionesProcesosEstados), nameof(EliminarFlujo));
    }

    /// <summary>El SP _SHOWALL de Flujos no trae el ícono real del botón (solo texto) — se
    /// resuelve por nombre con el mismo heurístico que AccionesBotones.razor.IconoEstandar,
    /// para que la píldora del panel 3 muestre un ícono coherente con el resto de la app.</summary>
    private static string IconoBoton(string? nombre)
    {
        var n = (nombre ?? "").ToUpperInvariant();
        if (n.Contains("NUEVO") || n.Contains("CREAR") || n.Contains("AGREG")) return Icons.Material.Filled.NoteAdd;
        if (n.Contains("MODIF") || n.Contains("EDIT") || n.Contains("ACTUALIZ")) return Icons.Material.Filled.Edit;
        if (n.Contains("ELIM") || n.Contains("BORR") || n.Contains("DELETE")) return Icons.Material.Filled.Delete;
        if (n.Contains("CERRAR")) return Icons.Material.Filled.Lock;
        if (n.Contains("ABRIR")) return Icons.Material.Filled.LockOpen;
        if (n.Contains("APROB") || n.Contains("CONFIRM") || n.Contains("VALID")) return Icons.Material.Filled.CheckCircle;
        if (n.Contains("RECHAZ") || n.Contains("ANULAR") || n.Contains("REJECT")) return Icons.Material.Filled.Block;
        if (n.Contains("ENVIO") || n.Contains("ENVIAR")) return Icons.Material.Filled.Send;
        if (n.Contains("VER") || n.Contains("DETALL") || n.Contains("CONSULT")) return Icons.Material.Filled.Visibility;
        return Icons.Material.Filled.SmartButton;
    }

    private static string IconoPorTipo(string? tipo) => tipo switch
    {
        "ROT" => Icons.Material.Filled.AccountTree,
        "APP" => Icons.Material.Filled.AppsOutage,
        "CRP" => Icons.Material.Filled.Folder,
        "MDL" => Icons.Material.Filled.ViewModule,
        "SMD" => Icons.Material.Filled.ViewQuilt,
        "BTN" => Icons.Material.Filled.SmartButton,
        _     => Icons.Material.Filled.Circle
    };
