@using TiposComprobantesPagoModel = KONSolutions.Shared.Models.Estandar.TiposComprobantesPago
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_COMPROBANTE_PAGO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            @* campos-config y no MudGrid: MudGrid separa con un Spacing propio —24px fijos—
               que no tiene nada que ver con Configuración General. Esta clase usa
               --input-space-h y --input-space-v, y de paso anula el margen propio de cada
               control, que si no se SUMA al hueco y el espacio real nunca coincide con el
               número cargado. *@
            <div class="campos-config" style="grid-template-columns:repeat(12,minmax(0,1fr));">
                <div style="grid-column:span 6;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="COD_TIPO_COMPROBANTE_PAGO"
                                @bind-Value="_model.COD_TIPO_COMPROBANTE_PAGO" Class=""
                                Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
                </div>
                <div style="grid-column:span 3;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="COD_PREFIJO"
                                @bind-Value="_model.COD_PREFIJO" Class=""
                                Disabled="_readonly" Obligatorio="true" />
                </div>
                @* El que SALE IMPRESO en el comprobante. Es el que usa el formato del número;
                   COD_PREFIJO, el interno, queda de respaldo para los tipos que todavía no lo
                   tengan cargado. *@
                <div style="grid-column:span 3;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="COD_PREFIJO_SUNAT"
                                Label="Prefijo SUNAT" @bind-Value="_model.COD_PREFIJO_SUNAT" Class=""
                                Disabled="_readonly" />
                </div>
            </div>
            <div class="campos-config" style="grid-template-columns:repeat(12,minmax(0,1fr));">
                <div style="grid-column:span 12;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="DES_TIPO_COMPROBANTE_PAGO"
                                @bind-Value="_model.DES_TIPO_COMPROBANTE_PAGO" Class=""
                                Disabled="_readonly" Obligatorio="true" />
                </div>
                <div style="grid-column:span 4;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="COD_COMPROBANTE_PAGO_SUNAT"
                                @bind-Value="_codSunatStr" Class="" Disabled="_readonly" />
                </div>
            </div>

            @* ── Formato del número ────────────────────────────────────────────────────
               Con esto, quien registra un documento escribe "T1-453" y la aplicación lo
               convierte en "T001-0000453".

               La longitud de la serie cuenta SÓLO LOS DÍGITOS, sin el prefijo: con prefijo
               "T" y longitud 3, la serie completa es "T001". Dejarlas vacías desactiva la
               normalización para este tipo. *@
            <MudText Typo="Typo.caption" Class="mono mb-2" Style="opacity:.55;display:block;margin-top:8px;">FORMATO DEL NÚMERO</MudText>
            <div class="campos-config" style="grid-template-columns:repeat(12,minmax(0,1fr));">
                <div style="grid-column:span 4;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="VAL_LONGITUD_SERIE"
                                Label="Longitud de serie" @bind-Value="_longSerieStr" Class="" Disabled="_readonly" />
                </div>
                <div style="grid-column:span 4;">
                    <CampoTexto Tabla="ESTANDAR.TIPOS_COMPROBANTES_PAGO" Columna="VAL_LONGITUD_NUMERO"
                                Label="Longitud de número" @bind-Value="_longNumeroStr" Class="" Disabled="_readonly" />
                </div>
                <div style="grid-column:span 4;">
                    @* El ejemplo se arma con el MISMO código que normaliza al digitar, así que
                       lo que se ve acá es exactamente lo que va a pasar después. *@
                    <MudTextField Value="@Ejemplo" Label="Ejemplo" Variant="Variant.Outlined"
                                  Disabled="true" HelperText="Digitando T1-453" />
                </div>
            </div>

            <MudText Typo="Typo.caption" Class="mono mb-2" Style="opacity:.55;display:block;margin-top:8px;">CARACTERÍSTICAS</MudText>
            <div class="campos-config" style="grid-template-columns:repeat(12,minmax(0,1fr));">
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_EMISION" Color="Color.Primary" Disabled="_readonly" Label="Emisión" /></div></div>
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_POSITIVO" Color="Color.Primary" Disabled="_readonly" Label="Positivo" /></div></div>
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_ANTICIPO" Color="Color.Primary" Disabled="_readonly" Label="Anticipo" /></div></div>
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Link" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_PREFIJO_COMPROBANTE_ORIGEN" Color="Color.Primary" Disabled="_readonly" Label="Prefijo comprobante origen" /></div></div>
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_DOCUMENTO_APLICABLE" Color="Color.Primary" Disabled="_readonly" Label="Documento aplicable" /></div></div>
                <div style="grid-column:span 4;"><div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_CONTROL_INTERNO" Color="Color.Primary" Disabled="_readonly" Label="Control interno" /></div></div>
            </div>

            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposComprobantesPagoModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    // Opción de menú del diálogo (la pasa quien lo abre: la de la grilla de esta entidad).
    // Con ella el pie muestra los botones marcados como Diálogo (ver CrudDialogActions).
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }

    private TiposComprobantesPagoModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private string? _codSunatStr
    {
        get => _model.COD_COMPROBANTE_PAGO_SUNAT?.ToString();
        set => _model.COD_COMPROBANTE_PAGO_SUNAT = int.TryParse(value, out var n) ? n : (int?)null;
    }

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(TiposComprobantesPagoModel m) =>
        _model = new TiposComprobantesPagoModel
        {
            COD_TIPO_COMPROBANTE_PAGO      = m.COD_TIPO_COMPROBANTE_PAGO,
            DES_TIPO_COMPROBANTE_PAGO      = m.DES_TIPO_COMPROBANTE_PAGO,
            COD_PREFIJO                    = m.COD_PREFIJO,
            COD_PREFIJO_SUNAT              = m.COD_PREFIJO_SUNAT,
            VAL_LONGITUD_SERIE             = m.VAL_LONGITUD_SERIE,
            VAL_LONGITUD_NUMERO            = m.VAL_LONGITUD_NUMERO,
            COD_COMPROBANTE_PAGO_SUNAT     = m.COD_COMPROBANTE_PAGO_SUNAT,
            FLG_EMISION                    = m.FLG_EMISION,
            FLG_POSITIVO                   = m.FLG_POSITIVO,
            FLG_ANTICIPO                   = m.FLG_ANTICIPO,
            FLG_PREFIJO_COMPROBANTE_ORIGEN = m.FLG_PREFIJO_COMPROBANTE_ORIGEN,
            FLG_DOCUMENTO_APLICABLE        = m.FLG_DOCUMENTO_APLICABLE,
            FLG_CONTROL_INTERNO            = m.FLG_CONTROL_INTERNO
        };

    /// <summary>Las longitudes como texto, igual que COD_COMPROBANTE_PAGO_SUNAT: CampoTexto
    /// trabaja con string y un vacío tiene que poder volver a null, no a cero. Cero sería una
    /// longitud declarada —y una longitud cero no existe—; null es "este tipo no declara
    /// formato", que es lo que corresponde.</summary>
    private string _longSerieStr
    {
        get => _model.VAL_LONGITUD_SERIE?.ToString() ?? "";
        set => _model.VAL_LONGITUD_SERIE = int.TryParse(value, out var n) ? n : null;
    }
    private string _longNumeroStr
    {
        get => _model.VAL_LONGITUD_NUMERO?.ToString() ?? "";
        set => _model.VAL_LONGITUD_NUMERO = int.TryParse(value, out var n) ? n : null;
    }

    /// <summary>Cómo queda "T1-453" con lo que hay cargado ahora mismo.</summary>
    private string Ejemplo
    {
        get
        {
            var r = KONSolutions.Shared.Common.NumeroComprobante.Normalizar(
                "T1-453",
                KONSolutions.Shared.Common.NumeroComprobante.PrefijoDe(_model.COD_PREFIJO_SUNAT, _model.COD_PREFIJO),
                _model.VAL_LONGITUD_SERIE, _model.VAL_LONGITUD_NUMERO);
            return r.Ok ? r.Valor : (r.Error ?? "");
        }
    }

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposComprobantesPagoModel>($"{ApiRoutes.Estandar.TiposComprobantesPago}/{Uri.EscapeDataString(_model.COD_TIPO_COMPROBANTE_PAGO)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.TiposComprobantesPago}/{Uri.EscapeDataString(_model.COD_TIPO_COMPROBANTE_PAGO)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposComprobantesPagoDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        // El controller solo expone POST (el SP hace upsert: inserta o actualiza según el código).
        var resp = await Http.GuardarAsync(ApiRoutes.Estandar.TiposComprobantesPago, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposComprobantesPagoDialog), nameof(Submit));
    }
}
