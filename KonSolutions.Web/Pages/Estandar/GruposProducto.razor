@page "/estandar/grupos-producto"
@attribute [Authorize]
@using GruposProductoModel = KONSolutions.Shared.Models.Estandar.GruposProducto
@using FamiliasProductoModel = KONSolutions.Shared.Models.Estandar.FamiliasProducto
@using SubFamiliasProductoModel = KONSolutions.Shared.Models.Estandar.SubFamiliasProducto
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject ShortcutService ShortcutSvc
@inject MenuService MenuSvc
@implements IDisposable

<PageTitle>Grupos de Producto · @ConfigSvc.Current.NombreApp</PageTitle>

@* Tres solapas, una por nivel (Grupos → Familias → Sub Familias), que nunca están habilitadas a la vez: la flecha de
   la fila abre el nivel siguiente y «Cerrar» vuelve al anterior — mismo mecanismo de exclusión que Inventarios.razor. *@
<MudTabs Elevation="0" ActivePanelIndex="@_tab" ActivePanelIndexChanged="@(i => _tab = i)"
         Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-1" KeepPanelsAlive="true">

    @* ═══════════════ GRUPOS ═══════════════ *@
    <MudTabPanel Text="Grupos" Icon="@Icons.Material.Filled.Folder" Disabled="@_enFamilias">
        <div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
            <div class="grid-header-titulo">
                <TituloPagina Fallback="Grupos de Producto" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
                <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_grupos.Count registros</MudText>
            </div>
            <BarraBusqueda @bind-Value="_searchGrupo" OnSearch="BuscarGrupos" Placeholder="Buscar grupo de producto..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
            <div class="grid-header-divider"></div>
            <div class="d-flex gap-2">
                <GridRefreshButton OnRefresh="LoadGrupos" />
                <AccionesBotones CodAplicacion="@_codApGrupo" CodOpcionAplicacion="@_codOpGrupo"
                                 Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeaderGrupo" />
            </div>
        </div>

        <MudPaper Elevation="0" Style="border:1px solid var(--line);">
            <div data-resizable-grid="grupos-producto" style="position:relative;">
            <MudDataGrid T="GruposProductoModel" Items="_gruposVisibles" Dense="true" Hover="true" Striped="true"
                         FixedHeader="true" Height="100%" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaPadre">
                <Columns>
                    <TemplateColumn Sortable="false" Title="Código" Width="100">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_GRUPO_PRODUCTO" Activo="@(_ordenColumnaGrupo == 0)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(0))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(0)" ValorDe="@(x=>x.COD_GRUPO_PRODUCTO ?? "")"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>FiltroGrupo(0,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.COD_GRUPO_PRODUCTO</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Descripción">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_GRUPO_PRODUCTO" Activo="@(_ordenColumnaGrupo == 1)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(1))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(1)" ValorDe="@(x=>x.DES_GRUPO_PRODUCTO ?? "")"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>FiltroGrupo(1,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.DES_GRUPO_PRODUCTO</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Bien" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;" Width="70">
                        <CellTemplate>
                            <span title="Es un bien" style="display:inline-flex;align-items:center;">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="@(context.Item.FLG_BIEN == true ? Color.Success : Color.Error)"
                                         Style="@(context.Item.FLG_BIEN == true ? "" : "opacity:.2;")" Size="Size.Small" />
                            </span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Partida Arancelaria" Width="140">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_PARTIDA_ARANCELARIA" Activo="@(_ordenColumnaGrupo == 2)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(2))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(2)" ValorDe="@(x=>x.COD_PARTIDA_ARANCELARIA ?? "")"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>FiltroGrupo(2,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@context.Item.COD_PARTIDA_ARANCELARIA</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Unidad de Medida" Width="160">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Unidad de Medida" Campo="COD_UNIDAD_MEDIDA" Activo="@(_ordenColumnaGrupo == 4)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(4))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(4)" ValorDe="@(x=>Unidad(x.COD_UNIDAD_MEDIDA, x.DES_UNIDAD_MEDIDA))"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>FiltroGrupo(4,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@Unidad(context.Item.COD_UNIDAD_MEDIDA, context.Item.DES_UNIDAD_MEDIDA)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Unidad Secundaria" Width="160">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Unidad Secundaria" Campo="COD_UNIDAD_MEDIDA_SECUNDARIA" Activo="@(_ordenColumnaGrupo == 5)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(5))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(5)" ValorDe="@(x=>Unidad(x.COD_UNIDAD_MEDIDA_SECUNDARIA))"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(5)" ValoresActivosChanged="@(v=>FiltroGrupo(5,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@Unidad(context.Item.COD_UNIDAD_MEDIDA_SECUNDARIA)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Tipo de Valor de Cálculo" Width="200">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Valor de Cálculo" Campo="COD_TIPO_VALOR_CALCULO" Activo="@(_ordenColumnaGrupo == 6)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(6))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(6)" ValorDe="@(x=>CodDes(x.COD_TIPO_VALOR_CALCULO, x.DES_TIPO_VALOR_CALCULO))"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(6)" ValoresActivosChanged="@(v=>FiltroGrupo(6,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>@CodDes(context.Item.COD_TIPO_VALOR_CALCULO, context.Item.DES_TIPO_VALOR_CALCULO)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="CUBSO" Width="260">
                        <CellTemplate>
                            @if (!string.IsNullOrEmpty(context.Item.COD_CUBSO))
                            {
                                @($"{context.Item.COD_CUBSO} - {context.Item.DES_CUBSO_ES ?? context.Item.DES_CUBSO}")
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false" Title="Estado" Width="110">
                        <HeaderTemplate>
                            <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumnaGrupo == 3)" Ascendente="_ordenAscendenteGrupo" OnClick="@(() => ToggleOrdenGrupo(3))" />
                                <FiltroExcelColumna T="GruposProductoModel" ItemsBase="@BaseGrupo(3)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                                    ValoresActivos="_filtrosGrupo.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>FiltroGrupo(3,v))" />
                            </div>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (!string.IsNullOrEmpty(context.Item.DES_ESTADO))
                            {
                                <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Acciones" Sortable="false">
                        <CellTemplate>
                            @{ var item = context.Item; }
                            <div class="d-flex align-center">
                                <AccionesBotones CodAplicacion="@_codApGrupo" CodOpcionAplicacion="@_codOpGrupo"
                                                 Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))"
                                                 CodTipoEstado="@item.COD_TIPO_ESTADO" CodEstadoActual="@item.COD_ESTADO" />
                                @* Pasa a la solapa de Familias de este grupo. Fijo en la pantalla: no depende de los botones de la opción. *@
                                <span title="Familias de este grupo" style="display:inline-flex;">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary"
                                                   aria-label="Familias de este grupo" OnClick="@(() => AbrirFamilias(item))" />
                                </span>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
                <PagerContent><MudDataGridPager T="GruposProductoModel" /></PagerContent>
            </MudDataGrid>
            <div class="grid-resize-handle"></div>
            </div>
        </MudPaper>
    </MudTabPanel>

    @* ═══════════════ FAMILIAS ═══════════════
       Arranca deshabilitada: se enciende al pasar desde un grupo y se apaga al cerrar. *@
    <MudTabPanel Text="@_tituloFamilias" Icon="@Icons.Material.Filled.AccountTree" Disabled="@(!_enFamilias || _enSubFamilias)">
        @if (_enFamilias && _grupoSel is not null)
        {
            <div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
                <div class="grid-header-titulo">
                    <TituloPagina Fallback="Familias de Producto" CodAplicacion="@_codApFamilia" CodOpcionAplicacion="@_codOpFamilia" />
                    <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">
                        Grupo: @_grupoSel.COD_GRUPO_PRODUCTO – @_grupoSel.DES_GRUPO_PRODUCTO · @_familias.Count registros
                    </MudText>
                </div>
                <BarraBusqueda @bind-Value="_searchFamilia" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar familia de producto..." DebounceInterval="300" MaxWidth="719px" Class="grid-header-search" />
                <div class="grid-header-divider"></div>
                <div class="d-flex gap-2">
                    <GridRefreshButton OnRefresh="LoadFamiliasDeGrupoSel" />
                    <AccionesBotones CodAplicacion="@_codApFamilia" CodOpcionAplicacion="@_codOpFamilia"
                                     Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeaderFamilia" />
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="CerrarFamilias" Style="@EstilosBoton.Cancelar">Cerrar</MudButton>
                </div>
            </div>

            <MudPaper Elevation="0" Style="border:1px solid var(--line);">
                <div data-resizable-grid="familias-producto" style="position:relative;">
                <MudDataGrid T="FamiliasProductoModel" Items="_familiasFiltradas" Dense="true" Hover="true" Striped="true"
                             FixedHeader="true" Height="100%" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaHijo">
                    <Columns>
                        <TemplateColumn Sortable="false" Title="Código" Width="90">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_FAMILIA_PRODUCTO" Activo="@(_ordenColumnaFamilia == 0)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(0))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(0)" ValorDe="@(x=>x.COD_FAMILIA_PRODUCTO ?? "")"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>FiltroFamilia(0,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@context.Item.COD_FAMILIA_PRODUCTO</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Descripción">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_FAMILIA_PRODUCTO" Activo="@(_ordenColumnaFamilia == 1)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(1))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(1)" ValorDe="@(x=>x.DES_FAMILIA_PRODUCTO ?? "")"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>FiltroFamilia(1,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@context.Item.DES_FAMILIA_PRODUCTO</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bien" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;" Width="70">
                            <CellTemplate>
                                <span title="Es un bien" style="display:inline-flex;align-items:center;">
                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="@(context.Item.FLG_BIEN == true ? Color.Success : Color.Error)"
                                             Style="@(context.Item.FLG_BIEN == true ? "" : "opacity:.2;")" Size="Size.Small" />
                                </span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Tipo de Producto" Width="180">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Producto" Campo="COD_TIPO_PRODUCTO" Activo="@(_ordenColumnaFamilia == 3)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(3))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(3)" ValorDe="@(x=>CodDes(x.COD_TIPO_PRODUCTO, x.DES_TIPO_PRODUCTO))"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>FiltroFamilia(3,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@CodDes(context.Item.COD_TIPO_PRODUCTO, context.Item.DES_TIPO_PRODUCTO)</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Unidad de Medida" Width="160">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Unidad de Medida" Campo="COD_UNIDAD_MEDIDA" Activo="@(_ordenColumnaFamilia == 4)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(4))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(4)" ValorDe="@(x=>Unidad(x.COD_UNIDAD_MEDIDA, x.DES_UNIDAD_MEDIDA))"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>FiltroFamilia(4,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@Unidad(context.Item.COD_UNIDAD_MEDIDA, context.Item.DES_UNIDAD_MEDIDA)</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Unidad Secundaria" Width="160">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Unidad Secundaria" Campo="COD_UNIDAD_MEDIDA_SECUNDARIA" Activo="@(_ordenColumnaFamilia == 5)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(5))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(5)" ValorDe="@(x=>Unidad(x.COD_UNIDAD_MEDIDA_SECUNDARIA))"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(5)" ValoresActivosChanged="@(v=>FiltroFamilia(5,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@Unidad(context.Item.COD_UNIDAD_MEDIDA_SECUNDARIA)</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Tipo de Valor de Cálculo" Width="200">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Valor de Cálculo" Campo="COD_TIPO_VALOR_CALCULO" Activo="@(_ordenColumnaFamilia == 6)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(6))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(6)" ValorDe="@(x=>CodDes(x.COD_TIPO_VALOR_CALCULO, x.DES_TIPO_VALOR_CALCULO))"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(6)" ValoresActivosChanged="@(v=>FiltroFamilia(6,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@CodDes(context.Item.COD_TIPO_VALOR_CALCULO, context.Item.DES_TIPO_VALOR_CALCULO)</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="CUBSO" Width="260">
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.COD_CUBSO))
                                {
                                    @($"{context.Item.COD_CUBSO} - {context.Item.DES_CUBSO_ES ?? context.Item.DES_CUBSO}")
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Estado" Width="100">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumnaFamilia == 2)" Ascendente="_ordenAscendenteFamilia" OnClick="@(() => ToggleOrdenFamilia(2))" />
                                    <FiltroExcelColumna T="FamiliasProductoModel" ItemsBase="@BaseFamilia(2)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                                        ValoresActivos="_filtrosFamilia.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>FiltroFamilia(2,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>
                                @if (!string.IsNullOrEmpty(context.Item.DES_ESTADO))
                                {
                                    <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Acciones" Sortable="false">
                            <CellTemplate>
                                @{ var item = context.Item; }
                                <div class="d-flex align-center">
                                    <AccionesBotones CodAplicacion="@_codApFamilia" CodOpcionAplicacion="@_codOpFamilia"
                                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrillaFamilia(item,b))"
                                                     CodTipoEstado="@item.COD_TIPO_ESTADO" CodEstadoActual="@item.COD_ESTADO" />
                                    @* Pasa a la solapa de Sub Familias de esta familia. *@
                                    <span title="Sub familias de esta familia" style="display:inline-flex;">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary"
                                                       aria-label="Sub familias de esta familia" OnClick="@(() => AbrirSubFamilias(item))" />
                                    </span>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin familias para este grupo.</MudText></NoRecordsContent>
                    <PagerContent><MudDataGridPager T="FamiliasProductoModel" /></PagerContent>
                </MudDataGrid>
                <div class="grid-resize-handle"></div>
                </div>
            </MudPaper>
        }
    </MudTabPanel>

    @* ═══════════════ SUB FAMILIAS ═══════════════
       Arranca deshabilitada: se enciende al pasar desde una familia y se apaga al cerrar (vuelve a Familias). *@
    <MudTabPanel Text="@_tituloSubFamilias" Icon="@Icons.Material.Filled.Category" Disabled="@(!_enSubFamilias)">
        @if (_enSubFamilias && _familiaSel is not null)
        {
            <div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
                <div class="grid-header-titulo">
                    <TituloPagina Fallback="Sub-Familias de Producto" CodAplicacion="@_codApSubFamilia" CodOpcionAplicacion="@_codOpSubFamilia" />
                    <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">
                        Familia: @_familiaSel.COD_FAMILIA_PRODUCTO – @_familiaSel.DES_FAMILIA_PRODUCTO · @_subFamilias.Count registros
                    </MudText>
                </div>
                <BarraBusqueda @bind-Value="_searchSubFamilia" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar sub-familia de producto..." DebounceInterval="300" MaxWidth="719px" Class="grid-header-search" />
                <div class="grid-header-divider"></div>
                <div class="d-flex gap-2">
                    <GridRefreshButton OnRefresh="LoadSubFamiliasDeFamiliaSel" />
                    <AccionesBotones CodAplicacion="@_codApSubFamilia" CodOpcionAplicacion="@_codOpSubFamilia"
                                     Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeaderSubFamilia" />
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="CerrarSubFamilias" Style="@EstilosBoton.Cancelar">Cerrar</MudButton>
                </div>
            </div>

            <MudPaper Elevation="0" Style="border:1px solid var(--line);">
                <div data-resizable-grid="sub-familias-producto" style="position:relative;">
                <MudDataGrid T="SubFamiliasProductoModel" Items="_subFamiliasFiltradas" Dense="true" Hover="true" Striped="true"
                             FixedHeader="true" Height="100%" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaHijo">
                    <Columns>
                        <TemplateColumn Sortable="false" Title="Código" Width="90">
                            <HeaderTemplate>
                                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_SUB_FAMILIA_PRODUCTO" Activo="@(_ordenColumnaSubFamilia == 0)" Ascendente="_ordenAscendenteSubFamilia" OnClick="@(() => ToggleOrdenSubFamilia(0))" />
                                    <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@BaseSubFamilia(0)" ValorDe="@(x=>x.COD_SUB_FAMILIA_PRODUCTO ?? "")"
                                                        ValoresActivos="_filtrosSubFamilia.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>FiltroSubFamilia(0,v))" />
                                </div>
                            </HeaderTemplate>
                            <CellTemplate>@context.Item.COD_SUB_FAMILIA_PRODUCTO</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Sortable="false" Title="Descripción">
                            <HeaderTemplate>
