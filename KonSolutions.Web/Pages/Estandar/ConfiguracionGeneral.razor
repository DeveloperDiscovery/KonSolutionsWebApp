    /// <summary>Longitud del segmento de Grupo dentro del código de producto: 3 dígitos si
    /// usa alias, 5 si no.</summary>
    private const int LargoCodigoTotal = 30;

    /// <summary>Cuántos dígitos le quedan disponibles al Correlativo de una fila, según qué
    /// segmentos participan del código (Grupo + Familia + Sub Familia) y su longitud:
    /// alias = 3, código completo = 5, segmento no incluido = 0. El Correlativo se queda con
    /// lo que sobra hasta el máximo de 30.</summary>
    private static int LongitudMaximaCorrelativo(EstructuraProductoRow row)
    {
        var largoGrupo = row.FlgIncluirAliasGrupoProducto ? 3 : 5;

        var largoFamilia = !row.FlgIncluirFamiliaProducto ? 0
            : row.FlgIncluirAliasFamiliaProducto ? 3 : 5;

        var largoSubFamilia = !row.FlgIncluirSubFamiliaProducto ? 0
            : row.FlgIncluirAliasSubFamiliaProducto ? 3 : 5;

        return Math.Max(0, LargoCodigoTotal - largoGrupo - largoFamilia - largoSubFamilia);
    }

    private async Task GuardarEstructuraProductoConAviso(EstructuraProductoRow row)
    {
        if (string.IsNullOrWhiteSpace(row.CodGrupoProducto))
        {
            if (!row.EsNueva)
                await ErrorDialogHelper.MostrarMensajeAsync("Elige un Grupo antes de grabar.", DialogService, nameof(ConfiguracionGeneral), "Validación");
            return;
        }
        var largoMaximo = LongitudMaximaCorrelativo(row);
        var largoActual = row.LngCorrelativo?.ToString().Length ?? 0;
        if (largoActual > largoMaximo)
        {
            await ErrorDialogHelper.MostrarMensajeAsync(
                $"El Correlativo puede tener como máximo {largoMaximo} dígito(s) con esta combinación de Grupo/Familia/Sub Familia (código total ≤ {LargoCodigoTotal}).",
                DialogService, nameof(ConfiguracionGeneral), "Validación");
            return;
        }
        try
        {
            var dto = new
            {
                COD_GRUPO_PRODUCTO = row.CodGrupoProducto,
                FLG_INCLUIR_ALIAS_GRUPO_PRODUCTO = row.FlgIncluirAliasGrupoProducto,
                FLG_INCLUIR_FAMILIA_PRODUCTO = row.FlgIncluirFamiliaProducto,
                FLG_INCLUIR_ALIAS_FAMILIA_PRODUCTO = row.FlgIncluirAliasFamiliaProducto,
                FLG_INCLUIR_SUB_FAMILIA_PRODUCTO = row.FlgIncluirSubFamiliaProducto,
                FLG_INCLUIR_ALIAS_SUB_FAMILIA_PRODUCTO = row.FlgIncluirAliasSubFamiliaProducto,
                LNG_CORRELATIVO = row.LngCorrelativo
            };
            var resp = row.EsNueva
                ? await Http.PostAsJsonAsync(ApiRoutes.Estandar.EstructuraProducto, dto)
                : await Http.PutAsJsonAsync(ApiRoutes.Estandar.EstructuraProducto, dto);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Guardado.", Severity.Success);
                row.EsNueva = false;
            }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ConfiguracionGeneral), nameof(GuardarEstructuraProductoConAviso));
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(ConfiguracionGeneral), nameof(GuardarEstructuraProductoConAviso));
            await ErrorDialogHelper.MostrarMensajeAsync("No se pudo guardar el registro. Ver detalle en el log de errores.", DialogService, nameof(ConfiguracionGeneral), "Error al guardar");
        }
    }

