                        </div>

                        <div data-resizable-grid="estructura-rfid" style="position:relative;">
                        <MudDataGrid T="EstructuraRfidRow" Items="_estructuraRfid" Dense="true" Hover="true" Striped="true"
                                     ReadOnly="false" EditMode="DataGridEditMode.Cell"
                                     CommittedItemChanges="@(async (EstructuraRfidRow it) => await GuardarEstructuraRfid(it))"
                                     Height="420px" FixedHeader="true">
                            <Columns>
                                <TemplateColumn Title="Código" Sortable="false" Width="160px">
                                    <CellTemplate><span class="mono">@context.Item.CodEstructuraRfid</span></CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <MudTextField @bind-Value="it.CodEstructuraRfid" Disabled="@(!it.EsNueva)"
                                                      Immediate="true" MaxLength="50" Class="mono" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Descripción" Sortable="false">
                                    <CellTemplate>@context.Item.DesEstructuraRfid</CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <MudTextField @bind-Value="it.DesEstructuraRfid" Immediate="true" MaxLength="50" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Longitud" Sortable="false" Width="120px" CellStyle="text-align:right;">
                                    <CellTemplate>@context.Item.ValLongitud</CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <MudNumericField @bind-Value="it.ValLongitud" Immediate="true" Min="0" Class="campo-numerico-derecha" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Orden" Sortable="false" Width="100px" CellStyle="text-align:right;">
                                    <CellTemplate>@context.Item.NumOrden</CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <MudNumericField @bind-Value="it.NumOrden" Immediate="true" Min="0" Class="campo-numerico-derecha" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Acciones" Sortable="false" Editable="false" Width="90px" CellStyle="text-align:center;">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
