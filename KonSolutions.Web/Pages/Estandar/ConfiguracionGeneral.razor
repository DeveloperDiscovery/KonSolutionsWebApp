    @* ════════════════════════════ COMPRAS ════════════════════════════ *@
    @* Compras es una pestaña principal con dos solapas: el Registro de Compras (carpeta de los XML, tolerancias y usuario SOL) y los XML recibidos por correo (carpetas de Outlook y servicio). La carpeta de los archivos es una sola: la de Registro de compras. *@
    <MudTabPanel Text="Compras" Icon="@Icons.Material.Filled.ReceiptLong">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="cfg-tabs" PanelClass="pt-4">

            <MudTabPanel Text="Registro de compras" Icon="@Icons.Material.Filled.ReceiptLong">
                <MudGrid>
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Registro de Compras: de dónde se importan los XML y qué diferencias se aceptan</MudText>
                            <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                                Los XML de las facturas y boletas de los proveedores se leen de una carpeta y entran como comprobantes del Registro de Compras. La carpeta es una de las rutas
                                de Entorno &gt; Rutas de archivos, y es la misma donde el servicio de XML recibidos deja los archivos que baja del correo. Los XML que entran pasan a la subcarpeta de procesados y los que no, a la de errores (con un .txt que dice por qué).
                                Las tolerancias se usan al validar el comprobante contra su orden. El usuario SOL y su clave sirven para validar los comprobantes de pago electrónicos. Se graba con «Guardar».
                            </MudText>
                            <div style="display:flex;flex-direction:column;gap:4px;max-width:720px;">
                                <AriaCombo TItem="ComboboxItem" Items="_rutasPlantillasRfid"
                                           TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                           Value="@_cfg.COD_KEY_PATHFILE_COMPRAS_XML"
                                           ValueChanged="@(v => _cfg.COD_KEY_PATHFILE_COMPRAS_XML = VacioANulo(v))"
                                           Label="Ruta donde están los XML de los proveedores (Entorno > Rutas de archivos)" />
                                @if (_rutasPlantillasRfid.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mb-2" Style="opacity:.8;" data-aviso="rutas-compras">No hay rutas para elegir: registra la carpeta de los XML en Entorno &gt; Rutas de archivos (o no se pudieron leer).</MudText>
                                }
                                <MudTextField T="string" Value="@_cfg.DES_CARPETA_COMPRAS_PROCESADOS" ValueChanged="@(v => _cfg.DES_CARPETA_COMPRAS_PROCESADOS = VacioANulo(v))" Immediate="true" MaxLength="100"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="carpeta-procesados"
                                              Label="Subcarpeta de los XML ya importados (vacío: procesados)" />
                                <MudTextField T="string" Value="@_cfg.DES_CARPETA_COMPRAS_ERRORES" ValueChanged="@(v => _cfg.DES_CARPETA_COMPRAS_ERRORES = VacioANulo(v))" Immediate="true" MaxLength="100"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="carpeta-errores"
                                              Label="Subcarpeta de los XML que no se pudieron importar (vacío: errores)" />
                                <MudTextField T="string" Value="@_cfg.COD_TIPO_OPERACION_COMPRAS_XML" ValueChanged="@(v => _cfg.COD_TIPO_OPERACION_COMPRAS_XML = VacioANulo(v))" Immediate="true" MaxLength="5"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="tipo-operacion-xml"
                                              Label="Tipo de operación por defecto de los XML (si el XML no lo decide)"
                                              HelperText="Es un tipo de operación de la clase del Registro de Compras. Solo se usa si el XML no lo decide: el tipo sale del XML (tipo de operación de SUNAT y unidad ZZ = servicios). Si lo dejas vacío y el XML no lo decide, se elige al importar." />
                                <MudNumericField T="decimal?" Value="@_cfg.TAS_TOLERANCIA_PRECIO_COMPRAS" ValueChanged="@(v => _cfg.TAS_TOLERANCIA_PRECIO_COMPRAS = v)" Min="0" Max="100" Format="0.###"
                                                 Variant="Variant.Outlined" Class="mb-2" HideSpinButtons="true" data-campo="tolerancia-precio"
                                                 Label="Tolerancia de precio (%)" HelperText="Cuánto puede pasar el precio de la factura al de la orden. Vacío: 0." />
                                <MudNumericField T="decimal?" Value="@_cfg.VAL_TOLERANCIA_IMPORTE_COMPRAS" ValueChanged="@(v => _cfg.VAL_TOLERANCIA_IMPORTE_COMPRAS = v)" Min="0" Format="0.##"
                                                 Variant="Variant.Outlined" Class="mb-2" HideSpinButtons="true" data-campo="tolerancia-importe"
                                                 Label="Diferencia de importe que se acepta" HelperText="Por redondeo, entre la suma de las líneas y los totales del comprobante. Vacío: 0.10." />

                                <MudText Typo="Typo.subtitle2" Class="mt-2">Validación de comprobantes de pago electrónicos</MudText>
                                <MudTextField T="string" Value="@_cfg.COD_USUARIO_VCDP" ValueChanged="@(v => _cfg.COD_USUARIO_VCDP = VacioANulo(v))" Immediate="true" MaxLength="50"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="vcdp-usuario" AutoComplete="off"
                                              Label="Usuario SOL" HelperText="El usuario secundario de SUNAT con permiso para consultar comprobantes." />
                                <MudTextField T="string" Value="@_cfg.DES_PASSWORD_VCDP_NUEVO" ValueChanged="@(v => { _cfg.DES_PASSWORD_VCDP_NUEVO = VacioANulo(v); if (_cfg.DES_PASSWORD_VCDP_NUEVO is not null) _cfg.FLG_QUITAR_PASSWORD_VCDP = false; })" Immediate="true" MaxLength="15"
                                              InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-2" data-campo="vcdp-clave" AutoComplete="new-password"
                                              Label="@(_cfg.TIENE_PASSWORD_VCDP && !_cfg.FLG_QUITAR_PASSWORD_VCDP ? "Clave SOL (hay una guardada; escribe otra para cambiarla)" : "Clave SOL")"
                                              Placeholder="@(_cfg.TIENE_PASSWORD_VCDP && !_cfg.FLG_QUITAR_PASSWORD_VCDP ? "••••••••" : null)"
                                              HelperText="Hasta 15 caracteres. Se guarda cifrada en la base de datos y no vuelve a mostrarse." />
                                @if (_cfg.TIENE_PASSWORD_VCDP)
                                {
                                    <MudSwitch T="bool" Value="@_cfg.FLG_QUITAR_PASSWORD_VCDP" ValueChanged="@OnQuitarClaveVcdp" Color="Color.Error" data-campo="vcdp-quitar"
                                               Label="Borrar la clave guardada al guardar" />
                                }
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="XML recibidos" Icon="@Icons.Material.Filled.MarkEmailRead">
                <MudGrid>
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Comprobantes y guías de los proveedores: de qué carpeta del correo se bajan y a dónde pasan</MudText>
                            <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                                El servicio lee los correos de la carpeta de recepción y baja los XML (y los PDF) de los comprobantes y las guías de remisión. Cuando se bajaron, el correo pasa a la carpeta de procesados;
                                el que no se pudo bajar o procesar pasa a la carpeta de errores. Las tres carpetas de Outlook tienen que ser distintas. Se escriben como aparecen en el buzón, separadas por «/»
                                (por ejemplo: Bandeja de entrada/Comprobantes). Se graba con «Guardar».
                            </MudText>
                            <div style="display:flex;flex-direction:column;gap:4px;max-width:720px;">
                                <MudSwitch T="bool" Value="@(_cfg.FLG_XML_RECIBIDOS_ACTIVO ?? false)" ValueChanged="@(v => _cfg.FLG_XML_RECIBIDOS_ACTIVO = v)" Color="Color.Primary" data-campo="xml-activo"
                                           Label="Bajar automáticamente los XML del correo" />
                                <MudNumericField T="int?" Value="@_cfg.CAN_MINUTOS_XML_RECIBIDOS" ValueChanged="@(v => _cfg.CAN_MINUTOS_XML_RECIBIDOS = v)" Min="1" Max="1440"
                                                 Variant="Variant.Outlined" Class="mb-2" HideSpinButtons="true" data-campo="xml-minutos"
                                                 Label="Cada cuántos minutos se revisa el correo" HelperText="Entre 1 y 1440. Vacío: 15." />

                                <MudText Typo="Typo.subtitle2" Class="mt-2">Carpetas de Outlook</MudText>
                                <MudTextField T="string" Value="@_cfg.DES_CARPETA_CORREO_RECEPCION" ValueChanged="@(v => _cfg.DES_CARPETA_CORREO_RECEPCION = VacioANulo(v))" Immediate="true" MaxLength="300"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="correo-recepcion"
                                              Label="Carpeta de recepción" HelperText="Donde llegan los correos con los XML y PDF de los proveedores." />
                                <MudTextField T="string" Value="@_cfg.DES_CARPETA_CORREO_PROCESADOS" ValueChanged="@(v => _cfg.DES_CARPETA_CORREO_PROCESADOS = VacioANulo(v))" Immediate="true" MaxLength="300"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="correo-procesados"
                                              Label="Carpeta de procesados" HelperText="A donde pasa cada correo cuando se bajaron sus XML y PDF." />
                                <MudTextField T="string" Value="@_cfg.DES_CARPETA_CORREO_ERRORES" ValueChanged="@(v => _cfg.DES_CARPETA_CORREO_ERRORES = VacioANulo(v))" Immediate="true" MaxLength="300"
                                              Variant="Variant.Outlined" Class="mb-2" data-campo="correo-errores"
                                              Label="Carpeta de no procesados o con error" HelperText="A donde pasa el correo que no se pudo bajar o procesar." />
                                @if (CarpetasCorreoRepetidas())
                                {
                                    <MudText Typo="Typo.caption" Class="mb-2" Style="color:var(--bad, #c62828);" data-aviso="correo-repetidas">Las tres carpetas de Outlook tienen que ser distintas.</MudText>
                                }

                                <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;color:var(--ink);" data-aviso="xml-ruta-compras">
                                    Los archivos que se bajan se guardan en la ruta de la solapa «Registro de compras» (@(string.IsNullOrWhiteSpace(_cfg.COD_KEY_PATHFILE_COMPRAS_XML) ? "todavía sin elegir" : _cfg.COD_KEY_PATHFILE_COMPRAS_XML)),
                                    con sus mismas subcarpetas de procesados y de errores. Para activar la carga hacen falta esa ruta y las tres carpetas de Outlook. Los datos de la cuenta de correo no se guardan aquí: van en la configuración del servicio.
                                </MudText>
                            </div>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
    </MudTabPanel>

    @* ════════════════════════════ ENTORNO ════════════════════════════ *@
    <MudTabPanel Text="Entorno" Icon="@Icons.Material.Filled.Public">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="cfg-tabs" PanelClass="pt-4">

        <MudTabPanel Text="Apariencia" Icon="@Icons.Material.Filled.Palette">
            <MudGrid>
                <MudItem xs="12" md="6">
                    @* Vista previa en vivo del "Color de fondo": se sobreescriben las variables
                       SOLO dentro de esta tarjeta con el color que se está editando (las globales
                       recién se actualizan al Guardar, ver Guardar() más abajo).
                       Van las DOS: el fondo de las etiquetas outlined ahora se pinta con
                       --dialog-back (ver app.css), así que sin sobreescribir también esa variable
                       las etiquetas de esta tarjeta mostrarían el color de diálogo global en vez
                       del color de pantalla que se está previsualizando aquí. *@
                    <MudPaper Elevation="0" Class="pa-4 cfg-page-labels-paper" Style="@($"border:1px solid var(--line);--paper:{NuloA(_cfg.DES_BACKCOLOR, "#efe9df")};--dialog-back:{NuloA(_cfg.DES_BACKCOLOR, "#efe9df")};")">
                        <MudText Typo="Typo.h6" Class="mb-3">Colores de pantalla</MudText>
                        <ColorConSwatch @bind-Text="_cfg.DES_COLOR_PRIMARY"   Label="Color primario"   Class="mb-3" />
                        <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR"       Label="Color de fondo"   Class="mb-2" />
                        <div class="d-flex align-center gap-1 mb-2"><MudIcon Icon="@Icons.Material.Filled.Gradient" Color="Color.Primary" Size="Size.Medium" />
                            <MudSwitch @bind-Value="_cfg.FLG_DEGRADE_BACKGROUND_COLOR" Color="Color.Primary" Label="Degradar color de fondo" /></div>
                        @if (_cfg.FLG_DEGRADE_BACKGROUND_COLOR && !string.IsNullOrWhiteSpace(_cfg.DES_BACKCOLOR))
                        {
                            <div style="height:24px;border-radius:4px;background:linear-gradient(135deg,@_cfg.DES_BACKCOLOR,color-mix(in srgb,@(_cfg.DES_BACKCOLOR) 40%,white));border:1px solid rgba(0,0,0,.12);margin-bottom:8px;" title="Vista previa degradado fondo"></div>
                        }
                        <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR"       Label="Color de texto"   Class="mb-3" />
                        <ColorConSwatch @bind-Text="_cfg.DES_COLOR_SECONDARY" Label="Color secundario" Class="mb-2" />
                        <div class="d-flex align-center gap-1 mb-2"><MudIcon Icon="@Icons.Material.Filled.Gradient" Color="Color.Primary" Size="Size.Medium" />
                            <MudSwitch @bind-Value="_cfg.FLG_DEGRADE_SECUNDARY_COLOR" Color="Color.Primary" Label="Degradar color secundario" /></div>
                        @if (_cfg.FLG_DEGRADE_SECUNDARY_COLOR && !string.IsNullOrWhiteSpace(_cfg.DES_COLOR_SECONDARY))
                        {
                            <div style="height:24px;border-radius:4px;background:linear-gradient(135deg,@_cfg.DES_COLOR_SECONDARY,color-mix(in srgb,@(_cfg.DES_COLOR_SECONDARY) 40%,white));border:1px solid rgba(0,0,0,.12);" title="Vista previa degradado secundario"></div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Tipografía</MudText>

                        <MudText Typo="Typo.subtitle2" Class="mono mt-1">Títulos</MudText>
                        <div class="d-flex gap-2 mb-3">
                            <MudSelect T="string" @bind-Value="_cfg.DES_TYPOGRAPHY_TITLE_FONT" Label="Fuente" Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudNumericField @bind-Value="_cfg.DES_TYPOGRAPHY_TITLE_SIZE" Label="Tamaño (px)" Variant="Variant.Outlined" Min="8" Max="72" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_TITLE" Label="Color" />
                        </div>

                        <MudText Typo="Typo.subtitle2" Class="mono">Subtítulos</MudText>
                        <div class="d-flex gap-2 mb-3">
                            <MudSelect T="string" @bind-Value="_cfg.DES_TYPOGRAPHY_SUBTITLE_FONT" Label="Fuente" Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudNumericField @bind-Value="_cfg.NUM_TYPOGRAPHY_SUBTITLE_SIZE" Label="Tamaño (px)" Variant="Variant.Outlined" Min="8" Max="48" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_SUBTITLE" Label="Color" />
                        </div>

                        <MudText Typo="Typo.subtitle2" Class="mono">Controles</MudText>
                        <div class="d-flex gap-2">
                            <MudSelect T="string" @bind-Value="_cfg.DES_TYPOGRAPHY_CONTROLS_FONT" Label="Fuente" Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudNumericField @bind-Value="_cfg.NUM_TYPOGRAPHY_CONTROLS_SIZE" Label="Tamaño (px)" Variant="Variant.Outlined" Min="8" Max="32" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Botones de Diálogo y Acciones de Cabecera</MudText>
                        <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                            Color del botón de confirmación (Crear/Modificar/Regresar) en todos los diálogos de la app,
                            y de los botones de Refrescar datos / Imprimir en la cabecera de las grillas.
                            Eliminar siempre usa rojo (color de peligro), independiente de esta configuración.
                            Vacío = usa el color por defecto de la app.
                        </MudText>
                        <div class="d-flex gap-2 mb-2">
                            <ColorConSwatch @bind-Text="_cfg.DES_BUTTON_BACKCOLOR" Label="Fondo del botón" />
                            <ColorConSwatch @bind-Text="_cfg.DES_BUTTON_FORECOLOR" Label="Texto del botón" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_cfg.DES_BUTTON_BACKCOLOR))
                        {
                            @* No usar Disabled="true": MudBlazor sobreescribe fondo/texto con su gris de
                               botón deshabilitado, ignorando el color elegido aquí. Se deja "habilitado"
                               pero sin acción (pointer-events:none) — solo es una vista previa visual. *@
                            <MudButton Variant="Variant.Filled"
                                       Style="@($"background:{_cfg.DES_BUTTON_BACKCOLOR};color:{(string.IsNullOrWhiteSpace(_cfg.DES_BUTTON_FORECOLOR) ? "#fff" : _cfg.DES_BUTTON_FORECOLOR)};font-weight:700;opacity:1;pointer-events:none;")"
                                       StartIcon="@Icons.Material.Filled.Save">
                                Vista previa
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Colores de Diálogos</MudText>
                        <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                            Fondo y texto de las ventanas de Crear / Modificar / Consultar / Eliminar en toda la app —
                            independientes del resto de la pantalla.
                        </MudText>
                        <div class="d-flex gap-2 mb-2">
                            <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_DIALOG" Label="Fondo del diálogo" />
                            <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_DIALOG" Label="Texto del diálogo" />
                        </div>
                        <div class="prev-card" style="@($"border-radius:6px;overflow:hidden;border:1px solid var(--line);background:{(string.IsNullOrWhiteSpace(_cfg.DES_BACKCOLOR_DIALOG) ? "#efe9df" : _cfg.DES_BACKCOLOR_DIALOG)};color:{(string.IsNullOrWhiteSpace(_cfg.DES_FORECOLOR_DIALOG) ? "#16130f" : _cfg.DES_FORECOLOR_DIALOG)};")">
                            <div class="pa-3" style="font-weight:700;">Vista previa · Nuevo registro</div>
                            <div class="pa-3 pt-0" style="font-size:.85rem;opacity:.85;">Así se vería el contenido del diálogo con estos colores.</div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Grillas" Icon="@Icons.Material.Filled.TableChart">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Grillas e imágenes</MudText>
                        <MudText Typo="Typo.subtitle2" Class="mono mb-2">Iconos de acción</MudText>
                        <div class="d-flex gap-2 mb-3">
                            <MudNumericField @bind-Value="_cfg.NUM_ICONS_GRID_WIDTH_SIZE"  Label="Ancho (px)" Variant="Variant.Outlined" Min="12" Max="64" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_ICONS_GRID_HEIGHT_SIZE" Label="Alto (px)"  Variant="Variant.Outlined" Min="12" Max="64" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </div>
                        <div class="d-flex gap-2 mb-3">
                            <ColorConSwatch @bind-Text="_cfg.DES_ICONCOLOR_ACTIONS" Label="Color de iconos de acción" />
                        </div>
                        <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                            Aplica a los íconos de acciones (Editar, Ver, etc.) en las grillas. Dejar vacío usa el color calculado por defecto.
                            El ícono de Eliminar siempre se muestra en rojo, sin importar este color.
                        </MudText>
                        <MudText Typo="Typo.subtitle2" Class="mono mb-2">Imágenes en grilla</MudText>
                        <div class="d-flex gap-2 mb-3">
                            <MudNumericField @bind-Value="_cfg.NUM_IMAGES_GRID_WIDTH_SIZE"  Label="Ancho (px)" Variant="Variant.Outlined" Min="16" Max="200" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_IMAGES_GRID_HEIGHT_SIZE" Label="Alto (px)"  Variant="Variant.Outlined" Min="16" Max="200" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </div>
                        <MudNumericField @bind-Value="_cfg.NUM_IMAGENES_MEGAS_UPLOAD" Label="Tamaño máx. imágenes (MB)" Variant="Variant.Outlined" Min="1" Max="50" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        <MudText Typo="Typo.subtitle2" Class="mono mt-3 mb-2">Filas por página</MudText>
                        <div class="d-flex gap-2">
                            <MudNumericField @bind-Value="_cfg.NUM_ROWS_SHOW_GRID_UNIQUE"   Label="Única"  Variant="Variant.Outlined" Min="5" Max="200" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_ROWS_SHOW_GRID_FATHER"   Label="Padre"  Variant="Variant.Outlined" Min="5" Max="200" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_ROWS_SHOW_GRID_CHILDREN" Label="Hijo"   Variant="Variant.Outlined" Min="5" Max="200" Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Fila con foco / seleccionada</MudText>
                        <div class="d-flex gap-2 mb-3">
                            <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_ROWS_FOCUS" Label="Fondo del foco" />
                            <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_ROWS_FOCUS" Label="Texto del foco" />
                        </div>
                        <MudSelect T="string" @bind-Value="_cfg.DES_TIPOGRAFIA_ROWS_FOCUS" Label="Fuente del foco" Variant="Variant.Outlined" Class="mb-3">
                            @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                        </MudSelect>
                        <MudText Typo="Typo.subtitle2" Class="mono mb-2">Campos obligatorios</MudText>
                        <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_CONTROLS_REQUIRED" Label="Fondo obligatorio" />
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Colores de la grilla</MudText>
                        <MudGrid>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_GRID_HEADER" Label="Cabecera · fondo" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_GRID_HEADER" Label="Cabecera · texto" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_FORECOLOR_GRID_ROWS" Label="Filas · texto" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_GRID_ROWS_EVEN" Label="Fila par (even)" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_BACKCOLOR_GRID_ROWS_ODD" Label="Fila impar (odd)" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_LINECOLOR_GRID_ROWS" Label="Líneas / bordes" />
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.subtitle2" Class="mono mt-3 mb-2">Fuentes de filas</MudText>
                        <div class="d-flex gap-2">
                            <MudSelect T="string" @bind-Value="_cfg.DES_TIPOGRAFIA_GRID_ROWS"      Label="Todas las filas" Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_cfg.DES_TIPOGRAFIA_GRID_ROWS_EVEN" Label="Fila par"        Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_cfg.DES_TIPOGRAFIA_GRID_ROWS_ODD"  Label="Fila impar"      Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_cfg.DES_TYPOGRAPHY_GRID_ROWS"      Label="Tipografía grilla" Variant="Variant.Outlined">
                                @foreach (var f in _fuentes) { <MudSelectItem Value="@f">@f</MudSelectItem> }
                            </MudSelect>
                        </div>

                        <MudText Typo="Typo.subtitle2" Class="mono mt-3 mb-2">Alto y tamaño de fuente</MudText>
                        <MudText Typo="Typo.caption" Style="opacity:.6;display:block;margin-bottom:8px;">
                            Vacío = automático (según el tamaño de fuente de Controles).
                        </MudText>
                        <div class="d-flex gap-2">
                            <MudNumericField @bind-Value="_cfg.NUM_HIGH_ROW_GRID" Label="Alto de fila (px)"
                                             Variant="Variant.Outlined"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_FONT_ROW_SIZE" Label="Fuente de fila (px)"
                                             Variant="Variant.Outlined"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_HIGH_HEAD_GRID" Label="Alto de cabecera (px)"
                                             Variant="Variant.Outlined"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            <MudNumericField @bind-Value="_cfg.NUM_FONT_HEAD_SIZE" Label="Fuente de cabecera (px)"
                                             Variant="Variant.Outlined"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </div>

                        @* Vista previa en vivo: usa los valores actuales de _cfg directamente
                           (no las variables CSS ya guardadas), así refleja los cambios sin
                           grabar todavía — 7 filas de muestra, la 4ª con foco. *@
                        <MudText Typo="Typo.subtitle2" Class="mono mt-4 mb-2">Vista previa (7 filas, foco en la 4ª)</MudText>
                        @{
                            var cabFontSize = _cfg.NUM_FONT_HEAD_SIZE is > 0 ? $"{_cfg.NUM_FONT_HEAD_SIZE}px" : ".8rem";
                            var cabAlto     = _cfg.NUM_HIGH_HEAD_GRID  is > 0 ? $"{_cfg.NUM_HIGH_HEAD_GRID}px"  : "auto";
                            var filaFontSize = _cfg.NUM_FONT_ROW_SIZE is > 0 ? $"{_cfg.NUM_FONT_ROW_SIZE}px" : ".82rem";
                            var filaAlto     = _cfg.NUM_HIGH_ROW_GRID is > 0 ? $"{_cfg.NUM_HIGH_ROW_GRID}px" : "auto";
                        }
                        <div style="border:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");border-radius:4px;overflow:hidden;">
                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;background:@_cfg.DES_BACKCOLOR_GRID_HEADER;color:@_cfg.DES_FORECOLOR_GRID_HEADER;font-weight:700;font-size:@cabFontSize;">
                                <div style="padding:8px 12px;min-height:@cabAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">Código</div>
                                <div style="padding:8px 12px;min-height:@cabAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">Descripción</div>
                                <div style="padding:8px 12px;min-height:@cabAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">Estado</div>
                            </div>
                            @for (var i = 1; i <= 7; i++)
                            {
                                var fila = i;
                                var esFoco = fila == 4;
                                var esPar  = fila % 2 == 0;
                                var fondo   = esFoco ? _cfg.DES_BACKCOLOR_ROWS_FOCUS : (esPar ? _cfg.DES_BACKCOLOR_GRID_ROWS_EVEN : _cfg.DES_BACKCOLOR_GRID_ROWS_ODD);
                                var texto   = esFoco ? _cfg.DES_FORECOLOR_ROWS_FOCUS : _cfg.DES_FORECOLOR_GRID_ROWS;
                                var fuente  = esFoco ? _cfg.DES_TIPOGRAFIA_ROWS_FOCUS : (esPar ? _cfg.DES_TIPOGRAFIA_GRID_ROWS_EVEN : _cfg.DES_TIPOGRAFIA_GRID_ROWS_ODD);
                                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;background:@fondo;color:@texto;font-family:@(string.IsNullOrWhiteSpace(fuente) ? _cfg.DES_TIPOGRAFIA_GRID_ROWS : fuente);font-size:@filaFontSize;">
                                    <div style="padding:6px 12px;min-height:@filaAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">FILA-@fila.ToString("00")</div>
                                    <div style="padding:6px 12px;min-height:@filaAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">@(esFoco ? "Registro con foco" : $"Registro de ejemplo {fila}")</div>
                                    <div style="padding:6px 12px;min-height:@filaAlto;box-sizing:border-box;display:flex;align-items:center;border-bottom:1px solid @(_cfg.DES_LINECOLOR_GRID_ROWS ?? "#ccc");">ACTIVO</div>
                                </div>
                            }
                        </div>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.h6" Class="mb-3">Búsqueda en grillas</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:.7;">
                            Mínimo de caracteres antes de consultar a la base de datos al escribir en el buscador —
                            aplica a todas las pantallas que tienen ese campo.
                        </MudText>
                        <MudNumericField T="int" @bind-Value="_cfg.NUM_CHARACTERS_MIO_SEARCH" Label="Mínimo de caracteres"
                                          Variant="Variant.Outlined" Min="1" Max="10"
                                          Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Inputs" Icon="@Icons.Material.Filled.TextFields">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        @* ── Apariencia de los inputs ──────────────────────────────
                           Los seis campos son opcionales: vacíos, cada uno cae al valor que
                           la app usaba antes (línea var(--line), fondo heredado, texto y
                           etiqueta según el tamaño/color de Controles). *@
                        <MudText Typo="Typo.subtitle2" Class="mono mt-4 mb-2">Apariencia de los inputs</MudText>
                        <MudText Typo="Typo.caption" Style="opacity:.6;display:block;margin-bottom:8px;">
                            Vacío = como estaba (no se toca). Aplica a los campos de texto, combos, fechas y numéricos de toda la app.
                        </MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_INPUTLINECOLOR" Label="Línea / borde" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_INPUTBACKCOLOR" Label="Fondo" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_INPUTFORECOLOR" Label="Color del texto" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <ColorConSwatch @bind-Text="_cfg.DES_INPUTLABELFORECOLOR" Label="Color de la etiqueta" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField @bind-Value="_cfg.NUM_INPUTFORESIZE" Label="Tamaño del texto (px)"
                                                 Variant="Variant.Outlined"
                                                 Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField @bind-Value="_cfg.NUM_INPUTLABELSIZE" Label="Tamaño de la etiqueta (px)"
                                                 Variant="Variant.Outlined"
                                                 Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField @bind-Value="_cfg.NUM_INPUTSPACEHORIZONTAL" Label="Separación horizontal (px)"
                                                 Variant="Variant.Outlined"
                                                 Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudNumericField @bind-Value="_cfg.NUM_INPUTSPACEVERTICAL" Label="Separación vertical (px)"
                                                 Variant="Variant.Outlined"
                                                 Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                            </MudItem>
                        </MudGrid>

                        @* Muestra en vivo. Lee _cfg directamente (no las variables CSS ya
                           guardadas), así refleja lo que estás editando antes de grabar.
                           Son 4 campos en una grilla 2x2: el hueco entre las dos columnas es la
                           separación horizontal y el hueco entre las dos filas la vertical, así
                           las dos se ven de una. *@
                        <MudText Typo="Typo.subtitle2" Class="mono mt-4 mb-2">Muestra</MudText>
                        @{
                            var inLine  = string.IsNullOrWhiteSpace(_cfg.DES_INPUTLINECOLOR) ? "rgba(22,19,15,.14)" : _cfg.DES_INPUTLINECOLOR;
                            var inBack  = string.IsNullOrWhiteSpace(_cfg.DES_INPUTBACKCOLOR) ? "transparent" : _cfg.DES_INPUTBACKCOLOR;
                            var inFore  = string.IsNullOrWhiteSpace(_cfg.DES_INPUTFORECOLOR) ? "inherit" : _cfg.DES_INPUTFORECOLOR;
                            var inLblFo = string.IsNullOrWhiteSpace(_cfg.DES_INPUTLABELFORECOLOR) ? "inherit" : _cfg.DES_INPUTLABELFORECOLOR;
                            var inSize  = _cfg.NUM_INPUTFORESIZE  is > 0 ? $"{_cfg.NUM_INPUTFORESIZE}px"  : "14px";
                            var inLabel = _cfg.NUM_INPUTLABELSIZE is > 0 ? $"{_cfg.NUM_INPUTLABELSIZE}px" : "13px";
                            var espH    = _cfg.NUM_INPUTSPACEHORIZONTAL is > 0 ? _cfg.NUM_INPUTSPACEHORIZONTAL.Value : 16;
                            var espV    = _cfg.NUM_INPUTSPACEVERTICAL   is > 0 ? _cfg.NUM_INPUTSPACEVERTICAL.Value   : 20;
                            var inLblBg = inBack == "transparent" ? "var(--dialog-back,var(--paper,#efe9df))" : inBack;
                            var muestras = new[] { ("Descripción", "Texto de ejemplo"), ("Fecha de pedido", "27/8/2026"),
                                                   ("Proveedor", "ACME S.A."),          ("Moneda", "PEN — Soles") };
                        }
                        @* El row-gap crudo es la separación configurada, y cada campo con etiqueta
                           flotante suma aparte lo que su etiqueta sobresale hacia arriba (0.6 × su
                           tamaño). Así el hueco que se VE entre dos filas es el número configurado,
                           que es exactamente lo que hace el CSS real.

                           La tercera fila —casilla y radio— no lleva ese extra: su texto va al lado
                           del control, no flotando sobre el borde, así que no sobresale nada. Está
                           aquí justamente para que se vea que queda alineada y con el mismo hueco
                           que las filas de campos, sin importar qué números pongas arriba. *@
                        @{ var salienteEtq = $"calc({inLabel} * 0.6)"; }
                        <div style="display:grid;grid-template-columns:1fr 1fr;column-gap:@(espH)px;row-gap:@(espV)px;padding:14px 4px 4px;">
                            @foreach (var m in muestras)
                            {
                                <div style="position:relative;margin-top:@salienteEtq;">
                                    <span style="position:absolute;left:8px;top:0;transform:translateY(-50%);
                                                 font-size:@inLabel;font-weight:700;padding:0 4px;white-space:nowrap;
                                                 color:@inLblFo;background:@inLblBg;">@m.Item1</span>
                                    <div style="border:1px solid @inLine;background:@inBack;border-radius:6px;
                                                height:51.25px;box-sizing:border-box;display:flex;align-items:center;
                                                padding:0 12px;font-size:@inSize;color:@inFore;">@m.Item2</div>
                                </div>
                            }
                            <div style="display:flex;align-items:center;gap:8px;font-size:@inSize;color:@inFore;">
                                <span style="width:18px;height:18px;flex:none;border:2px solid @inLine;border-radius:3px;
                                             display:flex;align-items:center;justify-content:center;
                                             font-size:13px;line-height:1;">✓</span>
                                <span>Afecta al stock</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;font-size:@inSize;color:@inFore;">
                                <span style="width:18px;height:18px;flex:none;border:2px solid @inLine;border-radius:50%;
                                             display:flex;align-items:center;justify-content:center;">
                                    <span style="width:9px;height:9px;border-radius:50%;background:@inLine;"></span>
                                </span>
                                <span>Ingreso</span>
                            </div>
                        </div>
                        <MudText Typo="Typo.caption" Style="opacity:.6;display:block;margin-top:6px;">
                            Separación actual: @(espH)px entre columnas · @(espV)px entre filas.
                            Casillas y radios usan la misma separación.
                        </MudText>

                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Navegación" Icon="@Icons.Material.Filled.Menu">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
