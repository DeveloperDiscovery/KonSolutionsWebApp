    @* ═════════════════════════ CLASES POR DEFECTO ═══════════════════════════ *@
    @* La clase que cada módulo usa cuando no se le indica otra. El mismo combo de
       clases de movimiento se reutiliza para Almacén y Producción, igual que
       TiposValorCalculo se reutiliza arriba para Importe Total y Descuento. *@
    <MudTabPanel Text="Clases por Defecto" Icon="@Icons.Material.Filled.Category">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Clases por defecto</MudText>
                    <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                        La clase que cada módulo usa cuando no se le indica otra.
                    </MudText>
                    @* campos-config: sin esto, el margen fijo de la etiqueta flotante (16px)
                       colapsa con el margen configurado y los tres combos se ven pegados sin
                       importar la Separación vertical que hayas puesto en Inputs. *@
                    <div class="campos-config">
                        <AriaCombo TItem="ComboboxItem"
                                     Items="_clasesOperacion"
                                     ValueFunc="@(x => x.Id)"
                                     TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                     @bind-Value="_cfg.COD_CLASE_OPERACION_ORDEN_COMPRA"
                                     Label="Clase de operación — Orden de Compra" />
                        <AriaCombo TItem="ComboboxItem"
                                     Items="_clasesMovimiento"
                                     ValueFunc="@(x => x.Id)"
                                     TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                     @bind-Value="_cfg.COD_CLASE_MOVIMIENTO_ALMACEN"
                                     Label="Clase de movimiento — Almacén" />
                        <AriaCombo TItem="ComboboxItem"
                                     Items="_clasesMovimiento"
                                     ValueFunc="@(x => x.Id)"
                                     TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                     @bind-Value="_cfg.COD_CLASE_MOVIMIENTO_PRODUCCION"
                                     Label="Clase de movimiento — Producción" />
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>


    @* ═══════════════════════════════ ALMACENES ═══════════════════════════════
       Lo que Reservas y Requerimientos graban en una linea cuando NO se eligio lote,
       proceso u orden de produccion.

       No son "valores sugeridos" para el usuario: son lo que va a la base en lugar de
       NULL. La diferencia importa porque esas cuatro columnas se comparan contra el
       stock, y una comparacion contra NULL no es verdadera ni falsa: no matchea. Un
       valor convenido - un lote "sin lote", un proceso generico - si matchea. *@
    <MudTabPanel Text="Almacenes" Icon="@Icons.Material.Filled.Warehouse">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Valores por Defecto de Producción</MudText>
                    <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                        Lo que Reservas y Requerimientos graban cuando la línea no trae lote,
                        proceso u orden de producción. Dejar un campo vacío es válido: esa
                        columna sigue grabándose en NULL, como hasta hoy.
                    </MudText>
                    @* Combos, y los cuatro de produccion EN CASCADA: sin proceso no hay de
                       donde sacar las ordenes, sin orden no hay items, sin item no hay unidades
                       minimas. Por eso cada uno se habilita solo cuando el de arriba tiene
                       valor, y cambiar uno invalida los de abajo: son de otra orden y
                       combinados no existirian.

                       Es la misma cascada de OrdenProduccionDialog, pero contra los maestros
                       COMPLETOS (los endpoints de PLANEAMIENTO) y no contra el stock de un
                       producto: aca no hay producto, y el valor por defecto es justamente el
                       que se usa cuando no hay nada elegido. *@
                    <div class="campos-config">
                        <AriaCombo TItem="ComboboxItem" Items="_lotesDefault"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.NUM_LOTE_CONTROL_DEFAULT"
                                   ValueChanged="@(v => _cfg.NUM_LOTE_CONTROL_DEFAULT = VacioANulo(v))"
                                   Label="Lote de control por defecto" />

                        <AriaCombo TItem="ComboboxItem" Items="_procesosDefault"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_PROCESO_DEFAULT"
                                   ValueChanged="OnProcesoDefaultChanged"
                                   Label="Proceso por defecto" />

                        <AriaCombo TItem="ComboboxItem" Items="_ordenesDefault"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_cfg.NUM_ORDEN_PRODUCCION_DEFAULT?.ToString())"
                                   ValueChanged="OnOrdenDefaultChanged"
                                   Label="Orden de producción por defecto"
                                   Disabled="@(string.IsNullOrWhiteSpace(_cfg.COD_PROCESO_DEFAULT))" />

                        <AriaCombo TItem="ComboboxItem" Items="_itemsOrdenDefault"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_cfg.NUM_ORDEN_PRODUCCION_ITEM_DEFAULT?.ToString())"
                                   ValueChanged="OnItemOrdenDefaultChanged"
                                   Label="Ítem de orden por defecto"
                                   Disabled="@(_cfg.NUM_ORDEN_PRODUCCION_DEFAULT is null)" />

                        <AriaCombo TItem="ComboboxItem" Items="_unidadesOrdenDefault"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@(_cfg.NUM_ORDEN_PRODUCCION_UNIDAD_DEFAULT?.ToString())"
                                   ValueChanged="@(v => _cfg.NUM_ORDEN_PRODUCCION_UNIDAD_DEFAULT = byte.TryParse(v, out var u) ? u : null)"
                                   Label="Unidad mínima de orden por defecto"
                                   Disabled="@(_cfg.NUM_ORDEN_PRODUCCION_ITEM_DEFAULT is null)" />
                    </div>

                    @* El proceso y los tres números son UNA cadena: una orden sin su proceso no
                       identifica nada. Se avisa acá en vez de dejar que se grabe a medias. *@
                    @if (!string.IsNullOrWhiteSpace(_cfg.COD_PROCESO_DEFAULT)
                         != (_cfg.NUM_ORDEN_PRODUCCION_DEFAULT is > 0))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                            El proceso y la orden de producción se usan juntos: conviene completar
                            los dos, o ninguno.
                        </MudAlert>
                    }
                </MudPaper>
            </MudItem>

            @* Al lado de los valores por defecto de producción. La guía de remisión pide la placa
               y los datos del vehículo, pero TRANSPORTES no tiene esas columnas: se guardan como
               especificaciones técnicas del transporte (TRANSPORTES_ESPECIFICACIONES_TECNICAS).
               Aquí se dice CUÁL especificación es cada dato, para que el SP de la guía la encuentre. *@
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Especificaciones Técnicas del Transporte</MudText>
                    <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                        Qué especificación técnica del vehículo guarda cada dato que pide la guía de
                        remisión. Dejar un campo vacío es válido: ese dato no se podrá sacar del vehículo.
                    </MudText>
                    <div class="campos-config">
                        <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_ESPECIFICACION_TECNICA_PLACA"
                                   ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_PLACA = VacioANulo(v))"
                                   Label="Especificación de la placa" />

                        <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_ESPECIFICACION_TECNICA_CONSTANCIA_INSCRIPCION"
                                   ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_CONSTANCIA_INSCRIPCION = VacioANulo(v))"
                                   Label="Especificación de la constancia de inscripción" />

                        <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_ESPECIFICACION_TECNICA_CERTIFICADO_VEHICULAR"
                                   ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_CERTIFICADO_VEHICULAR = VacioANulo(v))"
                                   Label="Especificación del certificado vehicular" />

                        <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_ESPECIFICACION_TECNICA_CERTIFICADO_HABILITACION_MTC"
                                   ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_CERTIFICADO_HABILITACION_MTC = VacioANulo(v))"
                                   Label="Especificación del certificado de habilitación MTC" />

                        <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                   Value="@_cfg.COD_ESPECIFICACION_TECNICA_VEHICULO_ACARREO"
                                   ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_VEHICULO_ACARREO = VacioANulo(v))"
                                   Label="Especificación del vehículo de acarreo" />
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    @* ════════════════════════════ ADMINISTRACIÓN ════════════════════════════ *@
<MudTabPanel Text="Administración" Icon="@Icons.Material.Filled.AccountTree">
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Etiquetas de Búsqueda por Área</MudText>
                    <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                        Enlaza cada Etiqueta de Búsqueda con el Área responsable y los niveles jerárquicos
                        a los que aplica (tabla ESTANDAR.ETIQUETAS_BUSQUEDA_AREAS).
                    </MudText>

                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.subtitle2">Enlaces registrados</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarFilaEba">Agregar</MudButton>
                    </div>
                    <table class="tabla-simple-editable" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Etiqueta de Búsqueda</th>
                                <th>Área</th>
                                <th style="width:70px;text-align:center;" title="Gerencia">GER</th>
                                <th style="width:70px;text-align:center;" title="Sub Gerencia">SGER</th>
                                <th style="width:70px;text-align:center;" title="Jefatura">JEF</th>
                                <th style="width:70px;text-align:center;" title="Subjefatura">SJEF</th>
                                <th style="width:70px;text-align:center;" title="Supervisor">SUP</th>
                                <th style="width:120px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _filasEba)
                            {
                                <tr>
                                    <td>
                                        <div class="grilla-campo-texto">
                                            <MudTextField T="string" @bind-Value="row.CodEtiquetaBusqueda"
                                                          ReadOnly="@(!row.EditModo)" MaxLength="25"
                                                          Margin="Margin.None"
                                                          Class="mb-0" Style="margin-top:0;" />
                                        </div>
                                    </td>
                                    <td>
                                        <AriaCombo TItem="ComboboxItem"
                                                     Items="_areasEba"
                                                     ValueFunc="@(x => x.Id)"
                                                     TextFunc="@(x => x.Texto)"
                                                     @bind-Value="row.CodAreaId"
                                                     Disabled="@(!row.EditModo)"
                                                     Class="mb-0" Style="margin-top:0;" />
                                    </td>
                                    <td style="text-align:center;"><div class="d-flex justify-center"><MudSwitch T="bool" @bind-Value="row.FlgGerencia" Color="Color.Primary" Disabled="@(!row.EditModo)" Class="ma-0" /></div></td>
                                    <td style="text-align:center;"><div class="d-flex justify-center"><MudSwitch T="bool" @bind-Value="row.FlgSubGerencia" Color="Color.Primary" Disabled="@(!row.EditModo)" Class="ma-0" /></div></td>
                                    <td style="text-align:center;"><div class="d-flex justify-center"><MudSwitch T="bool" @bind-Value="row.FlgJefatura" Color="Color.Primary" Disabled="@(!row.EditModo)" Class="ma-0" /></div></td>
                                    <td style="text-align:center;"><div class="d-flex justify-center"><MudSwitch T="bool" @bind-Value="row.FlgSubjefatura" Color="Color.Primary" Disabled="@(!row.EditModo)" Class="ma-0" /></div></td>
                                    <td style="text-align:center;"><div class="d-flex justify-center"><MudSwitch T="bool" @bind-Value="row.FlgSupervisor" Color="Color.Primary" Disabled="@(!row.EditModo)" Class="ma-0" /></div></td>
                                    <td>
                                        <div class="d-flex align-center">
                                            @if (row.EditModo)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                               Disabled="@(row.Guardando || string.IsNullOrWhiteSpace(row.CodEtiquetaBusqueda))"
                                                               OnClick="@(() => GuardarFilaEbaAsync(row))" />
                                            }
                                            else
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Info"
                                                               OnClick="@(() => row.EditModo = true)" />
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                           Disabled="row.Guardando" OnClick="@(() => EliminarFilaEbaAsync(row))" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_filasEba.Count == 0)
                    {
                        <MudText Class="pa-2 mono" Style="opacity:.5;">Sin registros.</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

</MudTabs>
}
</div>

@code {
    [Parameter] public string CodAplicacion          { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion    { get; set; } = "";

    private SharedCfg _cfg = new();
    private bool _loading = true;
    private bool _saving  = false;

    private List<ComboboxItem> _monedas = new();

    private readonly string[] _fuentes =
    {
        "Archivo", "Spline Sans Mono", "Arial", "Roboto",
