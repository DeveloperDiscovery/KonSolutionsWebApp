                        </MudDataGrid>
                        <div class="grid-resize-handle"></div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Código de barras" Icon="@Icons.Material.Filled.QrCode">
