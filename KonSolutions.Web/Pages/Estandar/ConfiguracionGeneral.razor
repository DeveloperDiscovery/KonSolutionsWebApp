    // XML recibidos: las tres carpetas de Outlook tienen que ser distintas (si no, el servicio leería los mismos correos una y otra vez). Aquí solo se avisa; el servidor es el que lo exige al guardar.
    private bool CarpetasCorreoRepetidas()
    {
        var c = new[] { _cfg.DES_CARPETA_CORREO_RECEPCION, _cfg.DES_CARPETA_CORREO_PROCESADOS, _cfg.DES_CARPETA_CORREO_ERRORES }
                .Select(x => (x ?? "").Trim()).Where(x => x.Length > 0).ToList();
