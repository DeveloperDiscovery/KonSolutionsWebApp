        _estructuraRfid = lista.Select(d => new EstructuraRfidRow
        {
            CodEstructuraRfid = d.COD_ESTRUCTURA_RFID,
            DesEstructuraRfid = d.DES_ESTRUCTURA_RFID,
            ValLongitud = d.VAL_LONGITUD,
            NumOrden = d.NUM_ORDEN
        }).ToList();
    }

    private void AgregarEstructuraRfid() => _estructuraRfid.Add(new EstructuraRfidRow { EsNueva = true });

    /// <summary>Dispara al confirmar una celda (Enter/Tab/click afuera) — mismo trigger que
    /// CommittedItemChanges usa en "Configuraciones de producto".</summary>
    private Task GuardarEstructuraRfid(EstructuraRfidRow it) => GuardarEstructuraRfidConAviso(it);

    private async Task GuardarEstructuraRfidConAviso(EstructuraRfidRow row)
    {
        if (string.IsNullOrWhiteSpace(row.CodEstructuraRfid))
        {
            await ErrorDialogHelper.MostrarMensajeAsync("El código no puede quedar vacío.", DialogService, nameof(ConfiguracionGeneral), "Validación");
            return;
        }
        try
        {
            HttpResponseMessage resp;
            if (row.EsNueva)
            {
                var dto = new { COD_ESTRUCTURA_RFID = row.CodEstructuraRfid, DES_ESTRUCTURA_RFID = row.DesEstructuraRfid, VAL_LONGITUD = row.ValLongitud, NUM_ORDEN = row.NumOrden };
                resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.EstructuraRfid, dto);
            }
            else
            {
                var dto = new { COD_ESTRUCTURA_RFID = row.CodEstructuraRfid, DES_ESTRUCTURA_RFID = row.DesEstructuraRfid, VAL_LONGITUD = row.ValLongitud, NUM_ORDEN = row.NumOrden };
                resp = await Http.PutAsJsonAsync(ApiRoutes.Estandar.EstructuraRfid, dto);
            }
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Guardado.", Severity.Success);
                row.EsNueva = false;
            }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ConfiguracionGeneral), nameof(GuardarEstructuraRfidConAviso));
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(ConfiguracionGeneral), nameof(GuardarEstructuraRfidConAviso));
            await ErrorDialogHelper.MostrarMensajeAsync("No se pudo guardar el registro. Ver detalle en el log de errores.", DialogService, nameof(ConfiguracionGeneral), "Error al guardar");
        }
    }

    private async Task QuitarEstructuraRfid(EstructuraRfidRow row)
    {
        if (row.EsNueva) { _estructuraRfid.Remove(row); return; }
        try
        {
            var resp = await Http.DeleteAsync($"{ApiRoutes.Estandar.EstructuraRfid}/{Uri.EscapeDataString(row.CodEstructuraRfid)}");
            if (resp.IsSuccessStatusCode) { _estructuraRfid.Remove(row); Snackbar.Add("Eliminado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ConfiguracionGeneral), nameof(QuitarEstructuraRfid), "No se pudo eliminar el registro");
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(ConfiguracionGeneral), nameof(QuitarEstructuraRfid));
            await ErrorDialogHelper.MostrarMensajeAsync("No se pudo eliminar el registro. Ver detalle en el log de errores.", DialogService, nameof(ConfiguracionGeneral), "Error al eliminar");
