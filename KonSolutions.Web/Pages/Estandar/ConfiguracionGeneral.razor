    /// <summary>Familias / sub familias cargadas por fila (clave = NUM_SECUENCIA): cada fila
    /// puede tener un Grupo/Familia distinto, así que no alcanza una sola lista compartida
    /// como en un formulario de un solo registro (ver StocksAlmacen.razor).</summary>
    private readonly Dictionary<short, List<ComboboxItem>> _familiasPorFila = new();
    private readonly Dictionary<short, List<ComboboxItem>> _subFamiliasPorFila = new();

    /// <summary>Secuencias que todavía no existen en la base: deciden POST contra PUT al grabar
    /// cada fila.</summary>
    private readonly HashSet<short> _configProductoNuevos = new();

    private List<ComboboxItem> FamiliasDeFila(short sec) => _familiasPorFila.GetValueOrDefault(sec) ?? new();
    private List<ComboboxItem> SubFamiliasDeFila(short sec) => _subFamiliasPorFila.GetValueOrDefault(sec) ?? new();

    /// <summary>Carga inicial: como no hay selector externo, trae las configuraciones de TODOS
    /// los tipos (uno por uno, ya que el SP exige codTipoConfiguracion) y arma una sola grilla.</summary>
    private async Task CargarConfigProductosAsync()
    {
        _configProductos = new();
        _configProductoNuevos.Clear();
        _familiasPorFila.Clear();
        _subFamiliasPorFila.Clear();

        foreach (var tipo in _tiposConfig)
        {
            var lista = (await Http.SafeGetAsync<List<ConfigProductoModel>>(
                ApiRoutes.Estandar.ConfiguracionesProductosPorTipo(tipo.Id))) ?? new();
            _configProductos.AddRange(lista);
        }

        // Precarga, para las filas ya existentes, las familias/sub familias de su Grupo/Familia
        // actual — sin esto el combo de la celda aparecería vacío hasta tocarla. Mismo mapeo
        // Lite que OnGrupoFilaChanged/OnFamiliaFilaChanged: el GET general (?codGrupoProducto=)
        // devuelve la entidad completa, no un ComboboxItem — deserializar directo a ComboboxItem
        // dejaba Id/Texto vacíos ("—" en el combo) porque los nombres de propiedad no matchean.
        foreach (var it in _configProductos)
        {
            if (!string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO))
            {
                var familias = (await Http.SafeGetAsync<List<FamiliaProductoLite>>(
                    ApiRoutes.Estandar.FamiliasProductoPorGrupo(it.COD_GRUPO_PRODUCTO))) ?? new();
                _familiasPorFila[it.NUM_SECUENCIA] = familias
                    .Select(f => new ComboboxItem { Id = f.COD_FAMILIA_PRODUCTO, Texto = f.DES_FAMILIA_PRODUCTO })
                    .ToList();
            }

            if (!string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO) && !string.IsNullOrWhiteSpace(it.COD_FAMILIA_PRODUCTO))
            {
                var subFamilias = (await Http.SafeGetAsync<List<SubFamiliaProductoLite>>(
                    ApiRoutes.Estandar.SubFamiliasProductoPorFamilia(it.COD_GRUPO_PRODUCTO, it.COD_FAMILIA_PRODUCTO))) ?? new();
                _subFamiliasPorFila[it.NUM_SECUENCIA] = subFamilias
                    .Select(s => new ComboboxItem { Id = s.COD_SUB_FAMILIA_PRODUCTO, Texto = s.DES_SUB_FAMILIA_PRODUCTO })
                    .ToList();
            }
        }
    }

    /// <summary>La secuencia es parte de la clave primaria: la asigna la pantalla como el
    /// máximo + 1, igual que en RequerimientoDocumento.razor.</summary>
    private void AgregarConfigProducto()
    {
        var sig = (short)((_configProductos.Count == 0 ? 0 : _configProductos.Max(x => x.NUM_SECUENCIA)) + 1);
        _configProductos.Add(new ConfigProductoModel { NUM_SECUENCIA = sig });
        _configProductoNuevos.Add(sig);
    }

    private void OnTipoFilaChanged(ConfigProductoModel it, string? cod)
    {
        it.COD_TIPO_CONFIGURACION = cod ?? string.Empty;
        it.DES_TIPO_CONFIGURACION = _tiposConfig.FirstOrDefault(t => t.Id == cod)?.Texto;
    }

    /// <summary>Cambiar de grupo invalida la familia y la sub familia elegidas de esa fila:
    /// pertenecen al grupo anterior. Igual criterio que OnGrupoChanged en StocksAlmacen.razor,
    /// pero por fila en vez de sobre un único modelo.</summary>
    /// <summary>El endpoint de familias no tiene un "combobox/{grupo}" dedicado — el GET
    /// general (?codGrupoProducto=) devuelve la entidad completa, así que aquí se mapea a
    /// ComboboxItem (Id=código, Texto=descripción).</summary>
    private sealed class FamiliaProductoLite
    {
        public string COD_FAMILIA_PRODUCTO { get; set; } = "";
        public string DES_FAMILIA_PRODUCTO { get; set; } = "";
    }
    private sealed class SubFamiliaProductoLite
    {
        public string COD_SUB_FAMILIA_PRODUCTO { get; set; } = "";
        public string DES_SUB_FAMILIA_PRODUCTO { get; set; } = "";
    }

    private async Task OnGrupoFilaChanged(ConfigProductoModel it, string? cod)
    {
        it.COD_GRUPO_PRODUCTO = cod;
        it.COD_FAMILIA_PRODUCTO = null;
        it.COD_SUB_FAMILIA_PRODUCTO = null;
        _subFamiliasPorFila[it.NUM_SECUENCIA] = new();
        if (string.IsNullOrWhiteSpace(cod))
        {
            _familiasPorFila[it.NUM_SECUENCIA] = new();
            return;
        }

        var familias = (await Http.SafeGetAsync<List<FamiliaProductoLite>>(
            ApiRoutes.Estandar.FamiliasProductoPorGrupo(cod))) ?? new();
        _familiasPorFila[it.NUM_SECUENCIA] = familias
            .Select(f => new ComboboxItem { Id = f.COD_FAMILIA_PRODUCTO, Texto = f.DES_FAMILIA_PRODUCTO })
            .ToList();
        StateHasChanged();
    }

    private async Task OnFamiliaFilaChanged(ConfigProductoModel it, string? cod)
    {
        it.COD_FAMILIA_PRODUCTO = cod;
        it.COD_SUB_FAMILIA_PRODUCTO = null;
        if (string.IsNullOrWhiteSpace(cod) || string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO))
        {
            _subFamiliasPorFila[it.NUM_SECUENCIA] = new();
            return;
        }

        var subFamilias = (await Http.SafeGetAsync<List<SubFamiliaProductoLite>>(
            ApiRoutes.Estandar.SubFamiliasProductoPorFamilia(it.COD_GRUPO_PRODUCTO!, cod))) ?? new();
        _subFamiliasPorFila[it.NUM_SECUENCIA] = subFamilias
            .Select(s => new ComboboxItem { Id = s.COD_SUB_FAMILIA_PRODUCTO, Texto = s.DES_SUB_FAMILIA_PRODUCTO })
            .ToList();
        StateHasChanged();
    }

    /// <summary>Cadena vacía y "sin valor" son cosas distintas para la base: los códigos
    /// viajan a claves foráneas, y "" no existe en ningún maestro.</summary>
    private static string? Vacio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;

    private async Task QuitarConfigProducto(ConfigProductoModel it)
    {
        var sec = it.NUM_SECUENCIA;
        if (!_configProductoNuevos.Contains(sec))
        {
            var rd = await Http.DeleteAsync(ApiRoutes.Estandar.ConfiguracionesProductosPorId(it.COD_TIPO_CONFIGURACION, sec));
            if (!rd.IsSuccessStatusCode)
            {
                await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService,
                    nameof(ConfiguracionGeneral), nameof(QuitarConfigProducto), $"No se pudo eliminar el registro {sec}");
                return;
            }
        }
        _configProductoNuevos.Remove(sec);
        _familiasPorFila.Remove(sec);
        _subFamiliasPorFila.Remove(sec);
        _configProductos.Remove(it);
    }

    private async Task GuardarConfigProductoConAviso(ConfigProductoModel it)
    {
        if (string.IsNullOrWhiteSpace(it.COD_TIPO_CONFIGURACION) || string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO))
        {
            await ErrorDialogHelper.MostrarMensajeAsync(
                "Elige el Tipo de Configuración y el Grupo de producto antes de grabar la fila.", DialogService,
                nameof(ConfiguracionGeneral), "Falta un dato obligatorio");
            return;
        }
        if (await GuardarConfigProducto(it)) Snackbar.Add($"Fila {it.NUM_SECUENCIA} grabada.", Severity.Success);
    }

    private async Task<bool> GuardarConfigProducto(ConfigProductoModel it)
    {
        // Tipo de Configuración y Grupo son obligatorios: sin ellos el SP igual los aceptaría
        // (columnas nullable), pero la regla de negocio de esta pantalla lo exige — ver
        // Obligatorio="true" de ambos combos.
        if (string.IsNullOrWhiteSpace(it.COD_TIPO_CONFIGURACION) || string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO)) return false;

        it.COD_FAMILIA_PRODUCTO = Vacio(it.COD_FAMILIA_PRODUCTO);
        it.COD_SUB_FAMILIA_PRODUCTO = Vacio(it.COD_SUB_FAMILIA_PRODUCTO);
        var esNuevo = _configProductoNuevos.Contains(it.NUM_SECUENCIA);

        var r = await Http.GuardarAsync(ApiRoutes.Estandar.ConfiguracionesProductos, it, esNuevo);
        if (!r.IsSuccessStatusCode)
        {
            await ErrorDialogHelper.MostrarAsync(r, ErrorLog, DialogService,
                nameof(ConfiguracionGeneral), nameof(GuardarConfigProducto), $"No se pudo grabar la fila {it.NUM_SECUENCIA}");
            return false;
        }
        _configProductoNuevos.Remove(it.NUM_SECUENCIA);
        return true;
    }
}
