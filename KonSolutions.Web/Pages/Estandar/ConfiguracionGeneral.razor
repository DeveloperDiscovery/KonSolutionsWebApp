    private async Task CargarFamiliasEstacionRfidAsync()
        => (_familiasEstacionRfid, _familiasEstacionRfidAviso) = await CargarFamiliasRfidAsync(_cfg.COD_GRUPO_PRODUCTO_ESTACION_RFID);

    private async Task<(List<ComboboxItem> Lista, string? Aviso)> CargarFamiliasRfidAsync(string? grupo)
    {
        if (string.IsNullOrWhiteSpace(grupo)) return (new(), null);
        var (lista, error) = await LeerPrimeraListaRfidAsync(
            new[] { ApiRoutes.Estandar.FamiliasProductoPorGrupo(grupo), $"{ApiRoutes.Estandar.FamiliasProducto}?codGrupoProducto={Uri.EscapeDataString(grupo)}" },
            f => new ComboboxItem { Id = (f.Id ?? f.COD_FAMILIA_PRODUCTO ?? "").Trim(), Texto = (f.Texto ?? f.DES_FAMILIA_PRODUCTO ?? "").Trim() });
        if (lista.Count > 0) return (lista, null);
        return (lista, error is not null
            ? $"No se pudieron leer las familias del grupo {grupo}: {error}"
            : $"El grupo {grupo} no tiene familias registradas.");
    }

    /// <summary>Prueba las rutas en orden y se queda con la primera que trae datos (cada API tiene su ruta: el combo por padre, o la lista con filtros). Si ninguna trae:
    /// sin error si alguna respondió bien (de verdad no hay datos), o con el primer motivo si todas fallaron.</summary>
    private async Task<(List<ComboboxItem> Lista, string? Error)> LeerPrimeraListaRfidAsync(IEnumerable<string> urls, Func<ClasificacionRfidLite, ComboboxItem> mapa)
    {
        string? motivo = null; var respondio = false;
        foreach (var url in urls)
        {
            var (datos, error) = await LeerListaRfidAsync<ClasificacionRfidLite>(url);
            var lista = datos.Select(mapa).Where(i => i.Id.Length > 0).ToList();
            if (lista.Count > 0) return (lista, null);
            if (error is null) respondio = true; else motivo ??= error;
        }
        return (new(), respondio ? null : motivo);
    }

    /// <summary>Las sub familias de la familia elegida de las estaciones (vacío si no hay familia). Primero la lista con filtros (GET sub-familias-producto?codGrupoProducto=&amp;codFamiliaProducto=)
    /// y, si no trae nada o falla, el combo por padre. Si ninguna da sub familias, lo dice debajo.</summary>
    private async Task CargarSubFamiliasEstacionRfidAsync()
    {
        _subFamiliasEstacionRfid = new(); _subFamiliasEstacionRfidAviso = null;
        var (grupo, familia) = (_cfg.COD_GRUPO_PRODUCTO_ESTACION_RFID, _cfg.COD_FAMILIA_PRODUCTO_ESTACION_RFID);
        if (string.IsNullOrWhiteSpace(grupo) || string.IsNullOrWhiteSpace(familia)) return;
        var (lista, error) = await LeerPrimeraListaRfidAsync(
            new[] { ApiRoutes.Estandar.SubFamiliasProductoLista(grupo, familia), ApiRoutes.Estandar.SubFamiliasProductoPorFamilia(grupo, familia) },
            f => new ComboboxItem { Id = (f.Id ?? f.COD_SUB_FAMILIA_PRODUCTO ?? "").Trim(), Texto = (f.Texto ?? f.DES_SUB_FAMILIA_PRODUCTO ?? "").Trim() });
        _subFamiliasEstacionRfid = lista;
        if (lista.Count == 0)
            _subFamiliasEstacionRfidAviso = error is not null
                ? $"No se pudieron leer las sub familias de la familia {familia}: {error}"
                : $"La familia {familia} no tiene sub familias registradas.";
    }

    /// <summary>Los productos que pueden ser la estación: los del grupo, familia y sub familia elegidos (sin grupo, ninguno). La estación ya grabada sigue en la lista
    /// aunque ya no cumpla (con su nota), para que no parezca que se perdió. Si falla o no hay productos, lo dice debajo.</summary>
    private async Task CargarEstacionesRfidAsync()
    {
        _estacionesRfid = new(); _estacionesRfidAviso = null;
        var grupo = _cfg.COD_GRUPO_PRODUCTO_ESTACION_RFID;
        if (string.IsNullOrWhiteSpace(grupo)) return;
        var (datos, error) = await LeerListaRfidAsync<ComboboxItem>(ApiRoutes.Estandar.ConfiguracionGeneralRfidEstaciones(grupo, _cfg.COD_FAMILIA_PRODUCTO_ESTACION_RFID, _cfg.COD_SUB_FAMILIA_PRODUCTO_ESTACION_RFID));
        _estacionesRfid = datos;
        if (datos.Count == 0)
            _estacionesRfidAviso = error is not null
                ? $"No se pudieron leer las estaciones: {error}"
                : "No hay productos con ese grupo, familia y sub familia.";
        var grabada = _cfg.COD_PRODUCTO_ESTACION_RFID;
        if (!string.IsNullOrWhiteSpace(grabada) && !_estacionesRfid.Any(e => e.Id == grabada))
            _estacionesRfid.Insert(0, new ComboboxItem { Id = grabada, Texto = "(no está en este grupo, familia y sub familia)" });
    }

    /// <summary>Los archivos de la carpeta de la ruta elegida (sin ruta, ninguno). Si la API no alcanza la carpeta, avisa y el nombre se escribe a mano; si está vacía, lo dice.
    /// El archivo ya grabado sigue en la lista aunque ya no esté en la carpeta (con su nota).</summary>
    private async Task CargarArchivosPlantillaRfidAsync()
    {
        _archivosPlantillaRfid = new(); _archivosPlantillaRfidAviso = null; _archivosPlantillaRfidFalla = false;
        var ruta = _cfg.COD_KEY_PATHFILE_PLANTILLA_RFID;
        if (string.IsNullOrWhiteSpace(ruta)) return;
        var (datos, error) = await LeerListaRfidAsync<ComboboxItem>(ApiRoutes.Estandar.ConfiguracionGeneralRfidPlantillas(ruta));
        if (error is not null)
        {
            _archivosPlantillaRfidFalla = true;
            _archivosPlantillaRfidAviso = $"No se pudieron leer los archivos de la ruta {ruta}: {error}";
            return;
        }
        _archivosPlantillaRfid = datos;
        if (datos.Count == 0) _archivosPlantillaRfidAviso = $"La carpeta de la ruta {ruta} no tiene archivos.";
        var grabado = _cfg.DES_ARCHIVO_PLANTILLA_RFID;
        if (!string.IsNullOrWhiteSpace(grabado) && !_archivosPlantillaRfid.Any(a => a.Id == grabado))
            _archivosPlantillaRfid.Insert(0, new ComboboxItem { Id = grabado, Texto = $"{grabado} (ya no está en la carpeta)" });
    }

    /// <summary>GET de una lista de la API con el error a la vista: devuelve los datos o el motivo (el de la API si lo dio; si no, el HTTP). No tumba la pantalla.</summary>
    private async Task<(List<T> Lista, string? Error)> LeerListaRfidAsync<T>(string url)
    {
        try
        {
            using var resp = await Http.GetAsync(url);
            ApiResponse<List<T>>? r = null;
            try { r = await resp.Content.ReadFromJsonAsync<ApiResponse<List<T>>>(); } catch { }
            if (!resp.IsSuccessStatusCode || r is not { Success: true })
                return (new(), !string.IsNullOrWhiteSpace(r?.Message) ? r!.Message : $"la API respondió HTTP {(int)resp.StatusCode}");
            return (r.Data ?? new(), null);
        }
        catch (Exception ex) { return (new(), ex.Message); }
    }

    /// <summary>Trae lotes y procesos. Si alguna falla, esa lista queda vacía y el combo
    /// simplemente no ofrece nada: no es motivo para tumbar la pantalla entera, que tiene
    /// otras quince pestañas que no dependen de esto.</summary>
    private async Task CargarCombosAlmacenAsync()
    {
        _lotesDefault    = await PedirComboAsync(ApiRoutes.Logistica.LotesControlCombobox, nameof(CargarCombosAlmacenAsync));
        _procesosDefault = await PedirComboAsync(ApiRoutes.Produccion.ProcesosCombobox,    nameof(CargarCombosAlmacenAsync));
        _especificacionesTecnicas = await PedirComboAsync(ApiRoutes.Ingenieria.EspecificacionesTecnicasCombobox, nameof(CargarCombosAlmacenAsync));
        _rutasPlantillasRfid = await PedirComboAsync(ApiRoutes.Entorno.PathFilesCombobox, nameof(CargarCombosAlmacenAsync));

        // Lo que ya está grabado: sin esto, al abrir la pantalla los tres combos de abajo
        // salen vacíos y parece que el dato se perdió.
        await CargarOrdenesDefaultAsync();
        await CargarItemsOrdenDefaultAsync();
        await CargarUnidadesOrdenDefaultAsync();
    }

    private async Task<List<ComboboxItem>> PedirComboAsync(string ruta, string metodo)
    {
        try   { return (await Http.SafeGetAsync<List<ComboboxItem>>(ruta)) ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(ConfiguracionGeneral), metodo);
            return new();
        }
    }

