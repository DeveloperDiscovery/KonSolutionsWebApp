@page "/estandar/configuracion-general"
@attribute [Authorize]
@implements IDisposable
@inject ConfiguracionGeneralService CfgSvc
@inject ConfigService Config
@inject ControlCambiosClientService Cambios
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject HttpClient Http
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService
@inject JwtAuthStateProvider AuthStateProvider
@using KONSolutions.Shared.Models.Config
@using SharedCfg = KONSolutions.Shared.Models.Estandar.ConfiguracionGeneral
@using ConfigProductoModel = KONSolutions.Shared.Models.Estandar.ConfiguracionesProductos

<PageTitle>Configuración General · @Config.Current.NombreApp</PageTitle>

<div class="cfg-page-labels-paper">
<div class="cfg-titulo-fijo d-flex align-center justify-space-between mb-4">
    <div>
        <TituloPagina Fallback="Configuración General" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">
            Schema ESTANDAR · @(_cfg.DES_NOMBRE_EMPRESA)
        </MudText>
    </div>
    <div class="d-flex align-center gap-2">
        <PanelAuditoria CodUsuarioRegistro="@_cfg.COD_USUARIO_REGISTRO"
                        CodEstacionRegistro="@_cfg.COD_ESTACION_REGISTRO"
                        FecRegistro="@_cfg.FEC_REGISTRO"
                        CodUsuarioActualizacion="@_cfg.COD_USUARIO_ACTUALIZACION"
                        CodEstacionActualizacion="@_cfg.COD_ESTACION_ACTUALIZACION"
                        FecActualizacion="@_cfg.FEC_ACTUALIZACION" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Guardar" Disabled="_saving"
                   Style="font-weight:700;background-color:var(--boton-backcolor,var(--ink));color:var(--boton-forecolor,var(--paper));">
            @(_saving ? "Guardando…" : "Guardar")
        </MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="cfg-tabs" PanelClass="pt-4">

    @* ════════════════════════════ EMPRESA ════════════════════════════ *@
<MudTabPanel Text="Empresa" Icon="@Icons.Material.Filled.Business">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Datos de la empresa</MudText>
                    <div class="campos-config">
                        <CampoTextoEstable @bind-Value="_cfg.DES_NOMBRE_EMPRESA"    Label="Nombre de la empresa"    Variant="Variant.Outlined" Class="mb-3" MaxLength="100" />
                        <CampoTextoEstable @bind-Value="_cfg.DES_NOMBRE_APLICACION" Label="Nombre de la aplicación" Variant="Variant.Outlined" Class="mb-3" MaxLength="100" />
                        <CampoTextoEstable @bind-Value="_cfg.NUM_DOCUMENTO_IDENTIDAD" Label="RUC / Documento"       Variant="Variant.Outlined" Class="mb-3" MaxLength="15" />
                        <CampoTextoEstable @bind-Value="_cfg.DES_DOMICILIO_FISCAL"  Label="Domicilio fiscal"         Variant="Variant.Outlined" Class="mb-3" MaxLength="100" />
                        <CampoTextoEstable @bind-Value="_cfg.DES_REFERENCIA_FISCAL" Label="Referencia fiscal"        Variant="Variant.Outlined" Class="mb-3" MaxLength="100" />
                        <AriaCombo TItem="ComboboxItem"
                                   Items="Enumerable.Empty<ComboboxItem>()"
                                   TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                   ValueFunc="@(x => x.Id)"
                                   Value="@_cfg.COD_PAIS"
                                   ValueChanged="@(v => _cfg.COD_PAIS = v ?? "")"
                                   SearchFunc="BuscarPaisAsync"
                                   MinCharacters="2"
                                   TextoInicial="@_cfg.DES_PAIS"
                                   Label="País" Class="mb-3" />
                        <AriaCombo TItem="ComboboxItem"
                                   Items="Enumerable.Empty<ComboboxItem>()"
                                   TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                   ValueFunc="@(x => x.Id)"
                                   Value="@_cfg.COD_UBIGEO"
                                   ValueChanged="@(v => _cfg.COD_UBIGEO = v ?? "")"
                                   SearchFunc="BuscarUbigeoAsync"
                                   MinCharacters="2"
                                   TextoInicial="@_cfg.DES_UBIGEO"
                                   Label="Ubigeo" />
                        <AriaCombo TItem="ComboboxItem"
                                   Items="Enumerable.Empty<ComboboxItem>()"
                                   TextFunc="@(x => $"{x.Id} – {x.Texto}")"
                                   ValueFunc="@(x => x.Id)"
                                   Value="@_cfg.COD_TIPO_EMPRESA"
                                   ValueChanged="@(v => _cfg.COD_TIPO_EMPRESA = v ?? "")"
                                   SearchFunc="BuscarTipoEmpresaAsync"
                                   MinCharacters="1"
                                   TextoInicial="@_cfg.DES_TIPO_EMPRESA"
                                   Label="Tipo de empresa" />
                        <CampoTextoEstable @bind-Value="_cfg.COD_TIPO_AUTORIZACION_COMERCIAL" Label="Autorización comercial" Variant="Variant.Outlined" MaxLength="3" />
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <MudText Typo="Typo.h6" Class="mb-3">Identidad visual</MudText>

                    <MudText Typo="Typo.caption" Class="mono mb-1" Style="opacity:.6;">Logo de la empresa:</MudText>
                    @if (_cfg.IMG_LOGO_EMPRESA is { Length: > 0 })
                    {
                        <div class="d-flex justify-center mb-2 pa-2" style="border:1px dashed var(--line);border-radius:8px;background:#fff;">
                            <MudImage Src="@($"data:image/png;base64,{Convert.ToBase64String(_cfg.IMG_LOGO_EMPRESA)}")"
                                      Height="80" Style="object-fit:contain;max-width:100%;" />
                        </div>
                    }
                    <ImagePicker Image="_cfg.IMG_LOGO_EMPRESA" ImageChanged="@(b => _cfg.IMG_LOGO_EMPRESA = b)" Label="Logo empresa" />

                    <MudText Typo="Typo.caption" Class="mono mt-3 mb-1" Style="opacity:.6;">Logo de la aplicación:</MudText>
                    @if (_cfg.IMG_LOGO_APLICACION is { Length: > 0 })
                    {
                        <div class="d-flex justify-center mb-2 pa-2" style="border:1px dashed var(--line);border-radius:8px;background:#fff;">
                            <MudImage Src="@($"data:image/png;base64,{Convert.ToBase64String(_cfg.IMG_LOGO_APLICACION)}")"
                                      Height="80" Style="object-fit:contain;max-width:100%;" />
                        </div>
                    }
                    <ImagePicker Image="_cfg.IMG_LOGO_APLICACION" ImageChanged="@(b => _cfg.IMG_LOGO_APLICACION = b)" Label="Logo aplicación" />
                </MudPaper>
            </MudItem>

            @* Dominios de correo de la empresa — CRUD in-place en la misma grilla, sin
               diálogo aparte (tabla mínima: código autonumérico + descripción). Si el
               usuario puede entrar a Configuración General, puede administrar esto —
               no hay un permiso separado. *@
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.h6">Dominios de correo de la empresa</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstilosBoton.Confirmar" OnClick="AgregarDominio">Agregar dominio</MudButton>
                    </div>
                    <table class="tabla-simple-editable" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Dominio (ej. empresa.com)</th>
                                <th style="width:100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _dominios)
                            {
                                <tr>
                                    <td>
                                        <div class="grilla-campo-texto">
                                            <CampoTexto Tabla="ENTORNO.DOMINIOS_EMPRESA" Columna="DES_DOMINIO_EMPRESA"
                                                        Label="Dominio" @bind-Value="row.DesDominio" MostrarLabel="false"
                                                        Margin="Margin.None" Class="mb-0" />
                                        </div>
                                    </td>
                                    <td>
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || string.IsNullOrWhiteSpace(row.DesDominio))"
                                                       OnClick="@(() => GuardarDominioAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarDominioAsync(row))" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_dominios.Count == 0)
                    {
                        <MudText Class="pa-2 mono" Style="opacity:.5;">Sin dominios registrados.</MudText>
                    }
                </MudPaper>
            </MudItem>

        </MudGrid>
    </MudTabPanel>

    @* ════════════════════════════ PRODUCTOS ════════════════════════════ *@
    <MudTabPanel Text="Productos" Icon="@Icons.Material.Filled.Inventory2">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="cfg-tabs" PanelClass="pt-4">

    @* ════════════════════════════ ESTRUCTURA (Productos) ════════════════════════════ *@
    <MudTabPanel Text="Estructura" Icon="@Icons.Material.Filled.AccountTree">
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudText Typo="Typo.subtitle2">Estructura de código de producto</MudText>
                        <MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarEstructuraProducto">Agregar</MudButton>
                    </div>

                    <div data-resizable-grid="estructura-producto" style="position:relative;">
                    <MudDataGrid T="EstructuraProductoRow" Items="_estructuraProducto" Dense="true" Hover="true" Striped="true"
                                 ReadOnly="false" EditMode="DataGridEditMode.Cell"
                                 CommittedItemChanges="@(async (EstructuraProductoRow it) => await GuardarEstructuraProductoConAviso(it))"
                                 Height="420px" FixedHeader="true">
                        <Columns>
                            <TemplateColumn Title="Grupo" Sortable="false" Width="260px">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <span class="mono" style="opacity:.65;">@it.CodGrupoProducto</span>
                                    <span class="ml-1">@it.DesGrupoProducto</span>
                                </CellTemplate>
                                <EditTemplate>
                                    @{ var it = context.Item; }
                                    <AriaCombo TItem="ComboboxItem" Items="_gruposProducto"
                                               TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@it.CodGrupoProducto"
                                               ValueChanged="@(v => OnGrupoEstructuraFilaChanged(it, v))"
                                               Disabled="@(!it.EsNueva)" Obligatorio="true" Class="" />
                                </EditTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Alias Grupo" Sortable="false" Editable="false" Width="100px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudCheckBox T="bool" Value="@it.FlgIncluirAliasGrupoProducto"
                                                 ValueChanged="@(v => { it.FlgIncluirAliasGrupoProducto = v; _ = GuardarEstructuraProductoConAviso(it); })"
                                                 Dense="true" />
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Incluir Familia" Sortable="false" Editable="false" Width="110px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudCheckBox T="bool" Value="@it.FlgIncluirFamiliaProducto"
                                                 ValueChanged="@(v => OnFlgIncluirFamiliaChanged(it, v))"
                                                 Dense="true" />
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Alias Familia" Sortable="false" Editable="false" Width="105px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudCheckBox T="bool" Value="@it.FlgIncluirAliasFamiliaProducto"
                                                 Disabled="@(!it.FlgIncluirFamiliaProducto)"
                                                 ValueChanged="@(v => { it.FlgIncluirAliasFamiliaProducto = v; _ = GuardarEstructuraProductoConAviso(it); })"
                                                 Dense="true" />
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Incluir Sub Familia" Sortable="false" Editable="false" Width="130px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudCheckBox T="bool" Value="@it.FlgIncluirSubFamiliaProducto"
                                                 Disabled="@(!it.FlgIncluirFamiliaProducto)"
                                                 ValueChanged="@(v => OnFlgIncluirSubFamiliaChanged(it, v))"
                                                 Dense="true" />
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Alias Sub Familia" Sortable="false" Editable="false" Width="115px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudCheckBox T="bool" Value="@it.FlgIncluirAliasSubFamiliaProducto"
                                                 Disabled="@(!it.FlgIncluirSubFamiliaProducto)"
                                                 ValueChanged="@(v => { it.FlgIncluirAliasSubFamiliaProducto = v; _ = GuardarEstructuraProductoConAviso(it); })"
                                                 Dense="true" />
                                </CellTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Correlativo" Sortable="false" Width="130px" CellStyle="text-align:right;">
                                <CellTemplate>@context.Item.LngCorrelativo</CellTemplate>
                                <EditTemplate>
                                    @{ var it = context.Item; var largoMax = LongitudMaximaCorrelativo(it); var tope = (int)Math.Pow(10, Math.Min(largoMax, 9)) - 1; }
                                    <MudNumericField @bind-Value="it.LngCorrelativo" Immediate="true" Min="0" Max="@tope"
                                                      HelperText="@($"Máx. {largoMax} dígito(s)")" Class="campo-numerico-derecha" />
                                </EditTemplate>
                            </TemplateColumn>

                            <TemplateColumn Title="Acciones" Sortable="false" Editable="false" Width="90px" CellStyle="text-align:center;">
                                <CellTemplate>
                                    @{ var it = context.Item; }
                                    <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small"
                                                   Color="Color.Primary" OnClick="@(() => GuardarEstructuraProductoConAviso(it))" Title="Grabar" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => QuitarEstructuraProducto(it))" Title="Quitar" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent><MudText Class="pa-4 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
                    </MudDataGrid>
                    <div class="grid-resize-handle"></div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

        <MudTabPanel Text="Configuración de Objetos" Icon="@Icons.Material.Filled.Extension">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <div class="d-flex align-center gap-2 mb-2">
                            <MudText Typo="Typo.subtitle2">Configuraciones de producto</MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add" OnClick="AgregarConfigProducto">Agregar</MudButton>
                        </div>

                        <div data-resizable-grid="configuraciones-productos" style="position:relative;">
                        <MudDataGrid T="ConfigProductoModel" Items="_configProductos" Dense="true" Hover="true" Striped="true"
                                     ReadOnly="false" EditMode="DataGridEditMode.Cell"
                                     CommittedItemChanges="@(async (ConfigProductoModel it) => await GuardarConfigProducto(it))"
                                     Height="420px" FixedHeader="true">
                            <Columns>
                                <TemplateColumn Title="Sec." Sortable="false" Editable="false" Width="55px" CellStyle="text-align:right;">
                                    <CellTemplate><span class="mono">@context.Item.NUM_SECUENCIA</span></CellTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Tipo de Configuración" Sortable="false" Width="260px">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
                                        <span class="mono" style="opacity:.65;">@it.COD_TIPO_CONFIGURACION</span>
                                        <span class="ml-1">@it.DES_TIPO_CONFIGURACION</span>
                                    </CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <AriaCombo TItem="ComboboxItem" Items="_tiposConfig"
                                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                                   Value="@it.COD_TIPO_CONFIGURACION"
                                                   ValueChanged="@(v => OnTipoFilaChanged(it, v))"
                                                   Obligatorio="true" Class="" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Grupo" Sortable="false" Width="280px">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
                                        <span class="mono" style="opacity:.65;">@it.COD_GRUPO_PRODUCTO</span>
                                        <span class="ml-1">@it.DES_GRUPO_PRODUCTO</span>
                                    </CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <AriaCombo TItem="ComboboxItem" Items="_gruposProducto"
                                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                                   Value="@it.COD_GRUPO_PRODUCTO"
                                                   ValueChanged="@(v => OnGrupoFilaChanged(it, v))"
                                                   Obligatorio="true" Class="" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Familia" Sortable="false" Width="280px">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
                                        <span class="mono" style="opacity:.65;">@it.COD_FAMILIA_PRODUCTO</span>
                                        <span class="ml-1">@it.DES_FAMILIA_PRODUCTO</span>
                                    </CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <AriaCombo TItem="ComboboxItem" Items="@FamiliasDeFila(it.NUM_SECUENCIA)"
                                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                                   Value="@it.COD_FAMILIA_PRODUCTO"
                                                   ValueChanged="@(v => OnFamiliaFilaChanged(it, v))"
                                                   Disabled="@(string.IsNullOrWhiteSpace(it.COD_GRUPO_PRODUCTO))" Class="" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Sub Familia" Sortable="false" Width="280px">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
                                        <span class="mono" style="opacity:.65;">@it.COD_SUB_FAMILIA_PRODUCTO</span>
                                        <span class="ml-1">@it.DES_SUB_FAMILIA_PRODUCTO</span>
                                    </CellTemplate>
                                    <EditTemplate>
                                        @{ var it = context.Item; }
                                        <AriaCombo TItem="ComboboxItem" Items="@SubFamiliasDeFila(it.NUM_SECUENCIA)"
                                                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                                   Value="@it.COD_SUB_FAMILIA_PRODUCTO"
                                                   ValueChanged="@(v => it.COD_SUB_FAMILIA_PRODUCTO = Vacio(v))"
                                                   Disabled="@(string.IsNullOrWhiteSpace(it.COD_FAMILIA_PRODUCTO))" Class="" />
                                    </EditTemplate>
                                </TemplateColumn>

                                <TemplateColumn Title="Acciones" Sortable="false" Editable="false" Width="90px" CellStyle="text-align:center;">
                                    <CellTemplate>
                                        @{ var it = context.Item; }
                                        <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small"
                                                       Color="Color.Primary" OnClick="@(() => GuardarConfigProductoConAviso(it))" Title="Grabar" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => QuitarConfigProducto(it))" Title="Quitar" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <NoRecordsContent><MudText Class="pa-4 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
                        </MudDataGrid>
                        <div class="grid-resize-handle"></div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="RFID" Icon="@Icons.Material.Filled.Sensors">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--line);">
                        <MudText Typo="Typo.subtitle2" Class="mb-1">Equipos RFID: qué productos son y qué dice su ficha técnica</MudText>
                        <MudText Typo="Typo.caption" Class="mono mb-3" Style="opacity:.6;color:var(--ink);">
                            Un equipo RFID (impresora, antena de escritura, lector) es un producto: se registra en Productos y sus datos van en su ficha técnica.
                            Aquí se dice QUÉ productos son equipos (su grupo y, si quieres, su familia) y QUÉ especificación técnica guarda cada dato que necesitan la
                            emisión y la impresión de etiquetas. Dejar un dato sin especificación es válido: ese dato no se leerá del equipo. Se graba con «Guardar».
                            El tipo de equipo (fijo, portátil, impresora...) no se configura: sale del grupo, la familia y la sub familia del producto.
                            La estación donde corre el agente (un producto, por ejemplo el PC) y el archivo de la plantilla de impresión (ZPL) son uno solo para todo el sistema.
                        </MudText>
                        <div class="campos-config">
                            <AriaCombo TItem="ComboboxItem" Items="_gruposProducto"
                                       TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                       Value="@_cfg.COD_GRUPO_PRODUCTO_EQUIPO_RFID"
                                       ValueChanged="OnGrupoEquipoRfidChanged"
                                       Label="Grupo de los equipos RFID" />

                            <AriaCombo TItem="ComboboxItem" Items="_familiasEquipoRfid"
                                       TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                       Value="@_cfg.COD_FAMILIA_PRODUCTO_EQUIPO_RFID"
                                       ValueChanged="@(v => _cfg.COD_FAMILIA_PRODUCTO_EQUIPO_RFID = VacioANulo(v))"
                                       Disabled="@string.IsNullOrWhiteSpace(_cfg.COD_GRUPO_PRODUCTO_EQUIPO_RFID)"
                                       Label="Familia (opcional: sin familia son todos los del grupo)" />
                            @if (_familiasEquipoRfidAviso is not null)
                            {
                                <MudText Typo="Typo.caption" Class="mb-2" Style="opacity:.8;" data-aviso="familias-rfid">@_familiasEquipoRfidAviso</MudText>
                            }

                            <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                       TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                       Value="@_cfg.COD_ESPECIFICACION_TECNICA_RFID_MARCA"
                                       ValueChanged="@(v => _cfg.COD_ESPECIFICACION_TECNICA_RFID_MARCA = VacioANulo(v))"
                                       Label="Especificación de la marca (el fabricante)" />

                            <AriaCombo TItem="ComboboxItem" Items="_especificacionesTecnicas"
                                       TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                                       Value="@_cfg.COD_ESPECIFICACION_TECNICA_RFID_MODELO"
