@page "/administracion/areas"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Administracion
@using System.Net.Http.Json
@inject CatalogoService<Area, AreaDto> Service
@inject HttpClient Http
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject ControlCambiosClientService Cambios
@inject MenuService MenuService
@inject ConfigService ConfigSvc
@implements IDisposable

<PageTitle>Áreas · @ConfigSvc.Current.NombreApp</PageTitle>

@* ── Menú contextual (clic derecho) — botones asignados y habilitados ── *@
@if (_ctxVisible)
{
    <div style="position:fixed;left:@(_ctxX)px;top:@(_ctxY)px;z-index:9999;
                background:var(--menu-back,#2b2622);color:var(--menu-fore,#fff);border:1px solid var(--line);border-radius:6px;
                box-shadow:0 4px 20px rgba(0,0,0,.18);min-width:200px;padding:4px 0;"
         @onclick:stopPropagation="true">
        <div class="d-flex align-center gap-2 px-3 py-2" style="cursor:pointer;font-size:.85rem;"
             @onclick="@(() => EjecutarNuevoHijo())">
            <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Style="font-size:1rem;color:inherit;" />
            <span>Nueva sub-área</span>
        </div>
        @foreach (var b in _ctxBotones)
        {
            <div class="d-flex align-center gap-2 px-3 py-2" style="cursor:pointer;font-size:.85rem;"
                 @onclick="@(() => EjecutarContextMenu(b))">
                <MudIcon Icon="@IconoBoton(b)" Style="@($"font-size:1rem;color:{ColorBoton(b)};")" />
                <span>@(b.DES_BOTON_OPCION ?? b.DES_ALIAS ?? "")</span>
            </div>
        }
    </div>
}

<div @onclick="CerrarContextMenu">

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Áreas" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ADMINISTRACION · @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar área..." DebounceInterval="300" Class="grid-header-search" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
            <MudButton OnClick="ExpandirTodo">Expandir todo</MudButton>
            <MudButton OnClick="ColapsarTodo">Colapsar todo</MudButton>
        </MudButtonGroup>
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="areas" style="position:relative;padding:8px 4px;background:var(--grilla-fila-par,#1a1714);">
        @* ── Nodo raíz virtual: no editable ni borrable, solo permite crear ── *@
        <div class="d-flex align-center gap-1 py-1 px-2 tl-toolbar">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:.95rem;flex-shrink:0;color:inherit;" />
            <span style="font-size:.85rem;font-weight:700;">Áreas</span>
            <MudSpacer />
            <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true">
                <MudMenuItem OnClick="@(() => Abrir(null, CrudModo.Create))">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.NoteAdd" Style="font-size:1rem;color:#2b6cb0;" />
                        <span>Nueva área raíz</span>
                    </div>
                </MudMenuItem>
            </MudMenu>
        </div>

        @* El [data-resizable-grid] exterior tiene overflow:hidden (CSS global, pensado para
           que .mud-table-container haga el scroll en las grillas normales) — este árbol no
           usa MudTable, así que sin un contenedor propio con overflow-y:auto el árbol se
           cortaba sin poder bajar a ver el resto de los nodos. *@
        <div class="areas-arbol-scroll">
        @if (!_raices.Any())
        {
            <MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros. Use el menú "…" de arriba para crear la primera área.</MudText>
        }
        else
        {
            <div class="tl-header-spec px-2">
                <div>Descripción</div>
                <div>Sucursal</div>
                <div>Estado</div>
                <div></div>
            </div>
            @foreach (var raiz in _raicesVisibles)
            {
                <NodoArea Nodo="raiz" Nivel="0"
                          NodoActual="_seleccionado"
                          CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                          ForzarExpandido="_forzarExpandido"
                          OnSeleccionar="@(n => _seleccionado = n)"
                          OnAccion="@(t => OnAccionNodo(t.Nodo, t.Boton))"
                          OnContextMenu="MostrarContextMenu"
                          OnAgregarCargo="AgregarCargo"
                          OnAsignarCargo="AsignarEntidad"
                          OnCargoAccion="@(t => AbrirCargoDialog(t.Nodo, t.Modo))"
                          OnDesasignarPersona="Desasignar" />
            }
        }
        </div>
        <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

</div>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Area> _items  = new();
    private List<Area> _raices = new();
    private Area? _seleccionado;
    private string _search = "";
    private bool? _forzarExpandido;

    private bool _ctxVisible;
    private double _ctxX, _ctxY;
    private Area? _ctxNodo;
    private List<BotonTreeviewItem> _ctxBotones =>
        _ctxNodo is null ? new()
        : MenuService.GetBotonesPorOpcion(CodAplicacion, CodOpcionAplicacion)
            .Where(b => b.FLG_GRILLA == true)
            .OrderBy(b => b.COD_BOTON_OPCION)
            .ToList();

    private List<Area> _raicesVisibles =>
        string.IsNullOrWhiteSpace(_search) ? _raices : _raices.Where(FiltroRecursivo).ToList();

    private bool FiltroRecursivo(Area n)
    {
        var coincide = (n.COD_AREA?.ToString() ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || n.DES_AREA.Contains(_search, StringComparison.OrdinalIgnoreCase);
        return coincide || n.Hijos.Any(FiltroRecursivo);
    }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ADMINISTRACION", "Areas");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ADMINISTRACION.AREAS", _onCambio);
        Cambios.Suscribir("ADMINISTRACION.AREAS_CARGOS_ENTIDADES", _onCambio);
        Cambios.Suscribir("ADMINISTRACION.CARGOS", _onCambio);
    }

    private async Task Load()
    {
        _items = await Service.GetAllAsync();
        await CargarCargosAsync();
        ConstruirArbol();
    }

    /// <summary>Fusiona en el árbol de Áreas los Cargos (y sus Entidades asignadas) desde
    /// PROC_ADMINISTRACION_AREAS_CARGOS_ENTIDADES_TREEVIEW — antes vivía en la pantalla
    /// separada "Áreas · Cargos · Entidades".</summary>
    private async Task CargarCargosAsync()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<ApiResponse<List<AreaCargoEntidadNodo>>>(ApiRoutes.Administracion.AreasCargosEntidadesTreeview);
            var nodos = (r?.Data ?? new()).Where(n => n.COD_TIPO is "C" or "P").ToList();
            foreach (var n in nodos) n.Hijos = new();

            // La identidad de un nodo Cargo dentro del árbol es el par (área, cargo), NO su
            // COD_NODO: un mismo cargo puede estar asignado en VARIAS áreas —justamente el
            // propósito de AREAS_CARGOS_ENTIDADES—, así que COD_NODO (COD_CARGO + 10000) se
            // repite entre áreas. Indexar por COD_NODO reventaba con "An item with the same
            // key has already been added", y además habrea colgado a las personas de un área
            // equivocada.
            var cargosPorClave = new Dictionary<(int Area, int Cargo), AreaCargoEntidadNodo>();
            _cargosPorArea = new();

            foreach (var n in nodos.Where(x => x.COD_TIPO == "C"))
            {
                if (n.COD_AREA is null || n.COD_CARGO is null) continue;
                var clave = (n.COD_AREA.Value, n.COD_CARGO.Value);
                if (!cargosPorClave.TryAdd(clave, n)) continue;   // defensivo: el SP ya deduplica

                if (!_cargosPorArea.TryGetValue(n.COD_AREA.Value, out var lista))
                    _cargosPorArea[n.COD_AREA.Value] = lista = new();
                lista.Add(n);
            }

            // Cada persona cuelga del cargo de SU MISMA área, buscado por el mismo par.
            foreach (var n in nodos.Where(x => x.COD_TIPO == "P"))
            {
                if (n.COD_AREA is null || n.COD_CARGO is null) continue;
                if (cargosPorClave.TryGetValue((n.COD_AREA.Value, n.COD_CARGO.Value), out var padre))
                    padre.Hijos.Add(n);
            }
        }
        catch (Exception ex) { await ErrorLog.LogAsync(ex, nameof(Areas), nameof(CargarCargosAsync)); }
    }

    private Dictionary<int, List<AreaCargoEntidadNodo>> _cargosPorArea = new();

    private void ConstruirArbol()
    {
        foreach (var it in _items) it.Hijos = new();
        var porCodigo = _items.Where(x => x.COD_AREA.HasValue).ToDictionary(x => x.COD_AREA!.Value);
        _raices = new();
        foreach (var it in _items)
        {
            it.Cargos = it.COD_AREA.HasValue ? _cargosPorArea.GetValueOrDefault(it.COD_AREA.Value, new()) : new();
            if (it.COD_AREA_PADRE.HasValue && porCodigo.TryGetValue(it.COD_AREA_PADRE.Value, out var padre) && padre != it)
                padre.Hijos.Add(it);
            else
                _raices.Add(it);
        }
    }

    private void ExpandirTodo() { _forzarExpandido = true;  StateHasChanged(); }
    private void ColapsarTodo() { _forzarExpandido = false; StateHasChanged(); }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionNodo(Area item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_POST   == true) return AbrirHijo(item);
        return Task.CompletedTask;
    }

    private async Task AbrirHijo(Area padre)
    {
        var nuevo = new Area { COD_AREA_PADRE = padre.COD_AREA };
        await Abrir(nuevo, CrudModo.Create);
    }

    private async Task Abrir(Area? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva área",
            CrudModo.Delete => $"Eliminar · {item?.DES_AREA}",
            CrudModo.Read   => $"Consultar · {item?.DES_AREA}",
            _               => $"Editar · {item?.DES_AREA}"
        };
        var dlg = await DialogService.ShowAsync<AreaDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["Universo"] = _items, ["CodAplicacion"] = CodAplicacion, ["CodOpcionAplicacion"] = CodOpcionAplicacion },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    private Task MostrarContextMenu((Area Nodo, double X, double Y) args)
    {
        _ctxNodo = args.Nodo; _ctxX = args.X; _ctxY = args.Y; _ctxVisible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CerrarContextMenu() => _ctxVisible = false;

    private Task EjecutarContextMenu(BotonTreeviewItem b)
    {
        _ctxVisible = false;
        return _ctxNodo is not null ? OnAccionNodo(_ctxNodo, b) : Task.CompletedTask;
    }

    private Task EjecutarNuevoHijo()
    {
        _ctxVisible = false;
        return _ctxNodo is not null ? AbrirHijo(_ctxNodo) : Task.CompletedTask;
    }

    private static string IconoBoton(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST   == true) return Icons.Material.Filled.NoteAdd;
        if (b.FLG_ACCION_PUT    == true) return Icons.Material.Filled.Edit;
        if (b.FLG_ACCION_DELETE == true) return Icons.Material.Filled.Delete;
        if (b.FLG_ACCION_GET    == true) return Icons.Material.Filled.Visibility;
        return Icons.Material.Filled.SmartButton;
    }

    private static string ColorBoton(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_DELETE == true) return "#e53e3e";
        if (b.FLG_ACCION_PUT    == true) return "#e6921a";
        if (b.FLG_ACCION_POST   == true) return "#2b6cb0";
        if (b.FLG_ACCION_GET    == true) return "#2f855a";
        return "#888";
    }

    private async Task AgregarCargo(Area areaNodo)
    {
        if (areaNodo.COD_AREA is null) return;
        var dlg = await DialogService.ShowAsync<AgregarCargoAreaDialog>("Agregar cargo",
            new DialogParameters { ["CodArea"] = areaNodo.COD_AREA.Value, ["DesArea"] = areaNodo.DES_AREA },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    private async Task AsignarEntidad(AreaCargoEntidadNodo cargoNodo)
    {
        if (cargoNodo.COD_AREA is null || cargoNodo.COD_CARGO is null) return;
        var dlg = await DialogService.ShowAsync<AsignarEntidadDialog>("Asignar entidad",
            new DialogParameters
            {
                ["CodArea"] = cargoNodo.COD_AREA.Value,
                ["CodCargo"] = cargoNodo.COD_CARGO.Value,
                ["DesCargo"] = cargoNodo.DES_NODO
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    private async Task Desasignar(AreaCargoEntidadNodo entidadNodo)
    {
        if (entidadNodo.COD_AREA is null || entidadNodo.COD_CARGO is null || entidadNodo.COD_ENTIDAD is null) return;
        var confirmado = await DialogService.ShowMessageBox(
            "Desasignar", $"¿Quitar a \"{entidadNodo.DES_NODO}\" de este cargo?",
            yesText: "Desasignar", cancelText: "Cancelar");
        if (confirmado != true) return;

        var resp = await Http.DeleteAsync(
            $"{ApiRoutes.Administracion.AreasCargosEntidades}/{entidadNodo.COD_AREA}/{entidadNodo.COD_CARGO}/{entidadNodo.COD_ENTIDAD}");
        if (resp.IsSuccessStatusCode) { Snackbar.Add("Entidad desasignada.", Severity.Success); await Load(); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(Areas), nameof(Desasignar));
    }

    /// <summary>Modificar/Consultar/Eliminar sobre el nodo Cargo operan directamente en el
    /// catálogo ADMINISTRACION.CARGOS (mismo diálogo que la pantalla de Cargos).</summary>
    private async Task AbrirCargoDialog(AreaCargoEntidadNodo cargoNodo, CrudModo modo)
    {
        if (cargoNodo.COD_CARGO is null) return;
        var item = new Cargo { COD_CARGO = cargoNodo.COD_CARGO, DES_CARGO = cargoNodo.DES_NODO };
        var titulo = modo switch
        {
            CrudModo.Delete => $"Eliminar · {item.DES_CARGO}",
            CrudModo.Read   => $"Consultar · {item.DES_CARGO}",
            _               => $"Editar · {item.DES_CARGO}"
        };
        var dlg = await DialogService.ShowAsync<CargosDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ADMINISTRACION.AREAS", _onCambio ?? (() => Task.CompletedTask));
        Cambios.Desuscribir("ADMINISTRACION.AREAS_CARGOS_ENTIDADES", _onCambio ?? (() => Task.CompletedTask));
        Cambios.Desuscribir("ADMINISTRACION.CARGOS", _onCambio ?? (() => Task.CompletedTask));
    }
}
