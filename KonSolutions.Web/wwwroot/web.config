<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Assets con fingerprint (hash en el nombre): caché máxima de 1 año -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- No-cache para index.html y appsettings para que el browser siempre revalide -->
        <!-- OJO: el patrón incluye la cadena VACÍA (^$) a propósito. Cuando se entra por
             la raíz del sitio (https://servidor/), la URL que ve esta regla es "", no
             "index.html" —el reescrito a index.html lo hace la regla de abajo, después—.
             Sin el ^$, la raíz caía en el clientCache de un año de arriba y el navegador se
             quedaba con el index.html viejo, sin pedirlo de nuevo: los archivos .js y .css
             nuevos podían estar publicados y aun así no cargarse nunca, porque la etiqueta
             que los referencia vive en ese índice cacheado. -->
        <rule name="NoCache-Index" stopProcessing="true">
          <match url="^($|index\.html$|appsettings.*\.json$)" />
          <action type="None" />
          <serverVariables>
            <set name="RESPONSE_Cache-Control" value="no-cache, no-store, must-revalidate" />
            <set name="RESPONSE_Pragma" value="no-cache" />
            <set name="RESPONSE_Expires" value="0" />
          </serverVariables>
        </rule>

        <!-- SPA fallback: redirige rutas de Blazor a index.html -->
        <rule name="BlazorFallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering allowDoubleEscaping="false" />
    </security>
  </system.webServer>
</configuration>
