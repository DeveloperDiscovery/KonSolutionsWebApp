<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Servidor minimo de la web (Blazor WebAssembly) para correr sin IIS: sirve los archivos publicados de KonSolutions.Web, con los .br/.gz ya comprimidos que genera la publicacion, y devuelve index.html
       en las rutas de la aplicacion. Corre como servicio de Windows (KonSolutionsWeb) o en consola. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KonSolutionsWeb</AssemblyName>
    <RootNamespace>KonSolutions.WebHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
